+// Fill a theme's glyph slots from a set. onGui: the textures may have been drawn (VRAM copies to drop),
+// which is only ever done on the GUI thread; a theme still being built has never been drawn.
+static void thmGlyphSetLoad(theme_t *theme, int set, int onGui)
+{
+    int i;
+    for (i = 0; i < GLYPH_SLOTS; i++) {
+        GSTEXTURE *tex = &theme->textures[glyphSlots[i]];
+        if (tex->Mem != NULL) {
+            if (onGui)
+                rmUnloadTexture(tex);
+            texFree(tex);
+        }
+        if (set == RIPPS2_GLYPHSET_STANDARD || set == RIPPS2_GLYPHSET_WHITE)
+            texLoadFromMemory(tex, glyphSetPng[set - RIPPS2_GLYPHSET_STANDARD][i].png, *glyphSetPng[set - RIPPS2_GLYPHSET_STANDARD][i].size);
