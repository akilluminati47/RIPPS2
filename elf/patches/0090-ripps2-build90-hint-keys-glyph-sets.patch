diff --git a/src/ripps2hints.c b/src/ripps2hints.c
new file mode 100644
index 0000000..2a52553
--- /dev/null
+++ b/src/ripps2hints.c
@@ -0,0 +1,346 @@
+/*
+  RIPPS2 build 90: the button hints and glyphs, as a theme sets them and as the user overrides them.
+
+  Theme keys (conf_theme.cfg, top level, all optional):
+    hints_hide=star,view        hints a theme leaves off the hint bar
+    hints_order=run,info,menu   the hints named come first, in that order; the rest follow as the page adds them
+    hints_labels=0              glyphs only (1, the default: glyph and label; badge: each hint one badge, its glyph
+                                and title together on the glyph set's pill, hint_badge.png)
+    hints_layout=column         one hint a line, from the hint element's x/y down (row, the default: one line)
+    hints_spacing=28            a column's line pitch
+    glyph_set=standard          the glyphs every page draws: theme (its own PNGs, the default), ripps2, standard, white
+  Hint names: menu run info options refresh star view source (start, select, r3, l3, cross, circle, square and
+  triangle name the same hints by their buttons).
+
+  Controller Settings > Hints and Glyphs: every row's first choice is Theme, which shows what the theme says. Any
+  other choice is the user's and wins over every theme. Hint Order opens its own page: pick a hint for a place
+  and the one that was there takes the picked hint's old place, so the list is always every hint once.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+
+#ifdef RIPPS2_HINTS_HOST_TEST
+#include "ripps2hints_host.h" // the PC test's stand-ins for the theme, the ids and the settings (elf/tests)
+#else
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/dia.h"
+#include "include/dialogs.h"
+#include "include/lang.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/ripps2.h"
+#endif
+
+int gRipps2HintLayout = 0, gRipps2HintLabels = 0, gRipps2GlyphSet = RIPPS2_GLYPHSET_THEME;
+int gRipps2HintPick[RIPPS2_HINT_COUNT] = {0};
+char gRipps2HintOrder[48] = "";
+
+static const char *const hintNames[RIPPS2_HINT_COUNT] = {"menu", "run", "info", "options", "refresh", "star", "view", "source"};
+static const char *hintTitles[RIPPS2_HINT_COUNT + 1] = {"Menu", "Run", "Info", "Options", "Refresh", "Star", "View", "Source", NULL};
+static const struct
+{
+    const char *name;
+    int token;
+} hintAliases[] = {{"start", RIPPS2_HINT_MENU}, {"select", RIPPS2_HINT_REFRESH}, {"r3", RIPPS2_HINT_STAR}, {"l3", RIPPS2_HINT_VIEW},
+                   {"cross", RIPPS2_HINT_RUN}, {"circle", RIPPS2_HINT_RUN}, {"square", RIPPS2_HINT_INFO}, {"triangle", RIPPS2_HINT_OPTIONS}};
+static const char *const glyphSetNames[RIPPS2_GLYPHSET_COUNT] = {"theme", "ripps2", "standard", "white"};
+
+int ripps2HintToken(int textId, int iconId)
+{
+    if (textId == _STR_RIPPS2_SOURCE)
+        return RIPPS2_HINT_SOURCE;
+    switch (iconId) {
+        case START_ICON:
+            return RIPPS2_HINT_MENU;
+        case SQUARE_ICON:
+            return RIPPS2_HINT_INFO;
+        case TRIANGLE_ICON:
+            return RIPPS2_HINT_OPTIONS;
+        case SELECT_ICON:
+            return RIPPS2_HINT_REFRESH;
+        case R3_ICON:
+            return RIPPS2_HINT_STAR;
+        case L3_ICON:
+            return RIPPS2_HINT_VIEW;
+        default:
+            return RIPPS2_HINT_RUN; // the confirm button: Run, or Start Device
+    }
+}
+
+static int hintByName(const char *s, int len)
+{
+    int i;
+    for (i = 0; i < RIPPS2_HINT_COUNT; i++)
+        if ((int)strlen(hintNames[i]) == len && !strncasecmp(s, hintNames[i], len))
+            return i;
+    for (i = 0; i < (int)(sizeof(hintAliases) / sizeof(hintAliases[0])); i++)
+        if ((int)strlen(hintAliases[i].name) == len && !strncasecmp(s, hintAliases[i].name, len))
+            return hintAliases[i].token;
+    return -1;
+}
+
+int ripps2HintParse(const char *list, int *out, int max)
+{
+    int n = 0, seen = 0;
+    while (list != NULL && *list && n < max) {
+        while (*list == ',' || *list == ' ')
+            list++;
+        const char *end = list;
+        while (*end && *end != ',' && *end != ' ')
+            end++;
+        int t = hintByName(list, end - list);
+        if (t >= 0 && !(seen & (1 << t))) { // a name twice keeps its first place
+            seen |= 1 << t;
+            out[n++] = t;
+        }
+        list = end;
+    }
+    return n;
+}
+
+int ripps2GlyphSetParse(const char *name)
+{
+    int i;
+    for (i = 0; i < RIPPS2_GLYPHSET_COUNT; i++)
+        if (name != NULL && !strcasecmp(name, glyphSetNames[i]))
+            return i;
+    return RIPPS2_GLYPHSET_THEME;
+}
+
+int ripps2GlyphSetFor(int themeSet)
+{
+    return gRipps2GlyphSet != RIPPS2_GLYPHSET_THEME ? gRipps2GlyphSet : themeSet;
+}
+
+int ripps2HintShown(int token)
+{
+    if (token < 0 || token >= RIPPS2_HINT_COUNT)
+        return 1;
+    if (gRipps2HintPick[token] == RIPPS2_PICK_SHOWN)
+        return 1;
+    if (gRipps2HintPick[token] == RIPPS2_PICK_HIDDEN)
+        return 0;
+    return gTheme == NULL || !(gTheme->hintsHide & (1 << token));
+}
+
+int ripps2HintLabels(void)
+{
+    static const int fromRow[4] = {1, 1, 0, 2}; // Theme (unused), Glyph and Label, Glyph Only, Badges
+    if (gRipps2HintLabels > 0 && gRipps2HintLabels < 4)
+        return fromRow[gRipps2HintLabels];
+    return gTheme == NULL || gTheme->hintsLabelsDef < 0 ? 1 : gTheme->hintsLabelsDef;
+}
+
+int ripps2HintColumn(void)
+{
+    if (gRipps2HintLayout)
+        return gRipps2HintLayout == 2;
+    return gTheme != NULL && gTheme->hintsColumnDef > 0;
+}
+
+int ripps2HintRank(int token)
+{
+    // the user's order, parsed again only when it changes; else the theme's. Unnamed hints share one rank
+    // after the named ones, so a stable sort leaves them in the order the page added them.
+    static char parsed[sizeof(gRipps2HintOrder)] = "";
+    static int userOrder[RIPPS2_HINT_COUNT], userCount = 0;
+    const int *order;
+    int count, i;
+
+    if (gRipps2HintOrder[0] != '\0') {
+        if (strcmp(parsed, gRipps2HintOrder)) {
+            snprintf(parsed, sizeof(parsed), "%s", gRipps2HintOrder);
+            userCount = ripps2HintParse(parsed, userOrder, RIPPS2_HINT_COUNT);
+        }
+        order = userOrder;
+        count = userCount;
+    } else if (gTheme != NULL) {
+        order = gTheme->hintsOrder;
+        count = gTheme->hintsOrderCount;
+    } else
+        return RIPPS2_HINT_COUNT;
+    for (i = 0; i < count; i++)
+        if (order[i] == token)
+            return i;
+    return RIPPS2_HINT_COUNT;
+}
+
+#ifndef RIPPS2_HINTS_HOST_TEST
+// ---- Controller Settings > Hints and Glyphs ----
+
+static const char *pickLayout[] = {"Theme", "Row", "Column", NULL};
+static const char *pickLabels[] = {"Theme", "Glyph and Label", "Glyph Only", "Badges", NULL};
+static const char *pickShow[] = {"Theme", "Shown", "Hidden", NULL};
+static const char *pickGlyphs[] = {"Theme", "RIPPS2", "Standard", "White", NULL};
+static const char *pickFollow[] = {"Theme", "Your Order", NULL};
+
+// the four hints with a row of their own, and those rows
+static const int pickHints[4] = {RIPPS2_HINT_MENU, RIPPS2_HINT_REFRESH, RIPPS2_HINT_STAR, RIPPS2_HINT_VIEW};
+static const int pickRows[4] = {UICFG_RIPPS2_HINT_MENU, UICFG_RIPPS2_HINT_REFRESH, UICFG_RIPPS2_HINT_STAR, UICFG_RIPPS2_HINT_VIEW};
+
+static void hintsRead(void)
+{
+    int v, i;
+    if (diaGetInt(diaHintsConfig, UICFG_RIPPS2_HINT_LAYOUT, &v) && v >= 0 && v < 3)
+        gRipps2HintLayout = v;
+    if (diaGetInt(diaHintsConfig, UICFG_RIPPS2_HINT_LABELS, &v) && v >= 0 && v < 4)
+        gRipps2HintLabels = v;
+    for (i = 0; i < 4; i++)
+        if (diaGetInt(diaHintsConfig, pickRows[i], &v) && v >= 0 && v < 3)
+            gRipps2HintPick[pickHints[i]] = v;
+    if (diaGetInt(diaHintsConfig, UICFG_RIPPS2_GLYPH_SET, &v) && v >= 0 && v < RIPPS2_GLYPHSET_COUNT)
+        gRipps2GlyphSet = v; // the next frame loads it (thmGlyphSetRefresh), so the page behind shows it
+}
+
+static int hintsUpdater(int modified)
+{
+    if (modified)
+        hintsRead();
+    return 0;
+}
+
+// the order page: eight places, each one hint; changing a place swaps the two hints
+static int orderShown[RIPPS2_HINT_COUNT];
+
+static void orderInEffect(int *out)
+{
+    int i, j;
+    for (i = 0; i < RIPPS2_HINT_COUNT; i++)
+        out[i] = i;
+    for (i = 1; i < RIPPS2_HINT_COUNT; i++) { // stable insertion sort by rank
+        int t = out[i], r = ripps2HintRank(t);
+        for (j = i; j > 0 && ripps2HintRank(out[j - 1]) > r; j--)
+            out[j] = out[j - 1];
+        out[j] = t;
+    }
+}
+
+static int orderUpdater(int modified)
+{
+    int now[RIPPS2_HINT_COUNT], i, j, follow = 0;
+    if (!modified)
+        return 0;
+    diaGetInt(diaHintOrder, UICFG_RIPPS2_HINT_FOLLOW, &follow);
+    for (i = 0; i < RIPPS2_HINT_COUNT; i++)
+        if (!diaGetInt(diaHintOrder, UICFG_RIPPS2_HINT_SLOT0 + i, &now[i]))
+            now[i] = orderShown[i];
+    for (i = 0; i < RIPPS2_HINT_COUNT; i++) {
+        if (now[i] == orderShown[i])
+            continue;
+        for (j = 0; j < RIPPS2_HINT_COUNT; j++)
+            if (j != i && now[j] == now[i]) {
+                now[j] = orderShown[i];
+                diaSetInt(diaHintOrder, UICFG_RIPPS2_HINT_SLOT0 + j, now[j]);
+            }
+        follow = 1; // a hint moved: the order is the user's now
+        diaSetInt(diaHintOrder, UICFG_RIPPS2_HINT_FOLLOW, 1);
+        break;
+    }
+    memcpy(orderShown, now, sizeof(orderShown));
+    if (follow) {
+        char s[sizeof(gRipps2HintOrder)] = "";
+        for (i = 0; i < RIPPS2_HINT_COUNT; i++)
+            snprintf(s + strlen(s), sizeof(s) - strlen(s), "%s%s", i ? "," : "", hintNames[now[i]]);
+        snprintf(gRipps2HintOrder, sizeof(gRipps2HintOrder), "%s", s);
+    } else {
+        gRipps2HintOrder[0] = '\0';
+        orderInEffect(orderShown); // back on the theme's: show it
+        for (i = 0; i < RIPPS2_HINT_COUNT; i++)
+            diaSetInt(diaHintOrder, UICFG_RIPPS2_HINT_SLOT0 + i, orderShown[i]);
+    }
+    return 0;
+}
+
+static void showOrder(void)
+{
+    char keep[sizeof(gRipps2HintOrder)];
+    int i;
+    snprintf(keep, sizeof(keep), "%s", gRipps2HintOrder);
+    diaSetEnum(diaHintOrder, UICFG_RIPPS2_HINT_FOLLOW, pickFollow);
+    diaSetInt(diaHintOrder, UICFG_RIPPS2_HINT_FOLLOW, gRipps2HintOrder[0] != '\0');
+    orderInEffect(orderShown);
+    for (i = 0; i < RIPPS2_HINT_COUNT; i++) {
+        diaSetEnum(diaHintOrder, UICFG_RIPPS2_HINT_SLOT0 + i, hintTitles);
+        diaSetInt(diaHintOrder, UICFG_RIPPS2_HINT_SLOT0 + i, orderShown[i]);
+    }
+    if (!diaExecuteDialog(diaHintOrder, -1, 1, &orderUpdater))
+        snprintf(gRipps2HintOrder, sizeof(gRipps2HintOrder), "%s", keep); // Back puts the order back
+}
+
+int ripps2ShowHintsConfig(void)
+{
+    int keepLayout = gRipps2HintLayout, keepLabels = gRipps2HintLabels, keepSet = gRipps2GlyphSet, keepPick[RIPPS2_HINT_COUNT];
+    char keepOrder[sizeof(gRipps2HintOrder)];
+    int i, ret;
+
+    memcpy(keepPick, gRipps2HintPick, sizeof(keepPick));
+    snprintf(keepOrder, sizeof(keepOrder), "%s", gRipps2HintOrder);
+    diaSetEnum(diaHintsConfig, UICFG_RIPPS2_HINT_LAYOUT, pickLayout);
+    diaSetEnum(diaHintsConfig, UICFG_RIPPS2_HINT_LABELS, pickLabels);
+    diaSetEnum(diaHintsConfig, UICFG_RIPPS2_GLYPH_SET, pickGlyphs);
+    diaSetInt(diaHintsConfig, UICFG_RIPPS2_HINT_LAYOUT, gRipps2HintLayout);
+    diaSetInt(diaHintsConfig, UICFG_RIPPS2_HINT_LABELS, gRipps2HintLabels);
+    diaSetInt(diaHintsConfig, UICFG_RIPPS2_GLYPH_SET, gRipps2GlyphSet);
+    for (i = 0; i < 4; i++) {
+        diaSetEnum(diaHintsConfig, pickRows[i], pickShow);
+        diaSetInt(diaHintsConfig, pickRows[i], gRipps2HintPick[pickHints[i]]);
+    }
+
+    int focus = -1;
+    for (;;) {
+        ret = diaExecuteDialog(diaHintsConfig, focus, 1, &hintsUpdater);
+        if (ret == RIPPS2_HINT_ORDER_BUTTON) {
+            hintsRead();
+            showOrder();
+            focus = RIPPS2_HINT_ORDER_BUTTON; // back on the page with the cursor where it was
+            continue;
+        }
+        break;
+    }
+    if (ret)
+        hintsRead();
+    else { // Back: everything as it was
+        gRipps2HintLayout = keepLayout;
+        gRipps2HintLabels = keepLabels;
+        gRipps2GlyphSet = keepSet;
+        memcpy(gRipps2HintPick, keepPick, sizeof(keepPick));
+        snprintf(gRipps2HintOrder, sizeof(gRipps2HintOrder), "%s", keepOrder);
+    }
+    return gRipps2HintLayout != keepLayout || gRipps2HintLabels != keepLabels || gRipps2GlyphSet != keepSet ||
+           memcmp(gRipps2HintPick, keepPick, sizeof(keepPick)) || strcmp(gRipps2HintOrder, keepOrder);
+}
+
+// ---- saved with the settings ----
+
+void ripps2HintsLoadConfig(config_set_t *config)
+{
+    static const char *const keys[4] = {"ripps2_hint_menu", "ripps2_hint_refresh", "ripps2_hint_star", "ripps2_hint_view"};
+    int v, i;
+    if (configGetInt(config, "ripps2_hint_layout", &v) && v >= 0 && v < 3)
+        gRipps2HintLayout = v;
+    if (configGetInt(config, "ripps2_hint_labels", &v) && v >= 0 && v < 4)
+        gRipps2HintLabels = v;
+    for (i = 0; i < 4; i++)
+        if (configGetInt(config, keys[i], &v) && v >= 0 && v < 3)
+            gRipps2HintPick[pickHints[i]] = v;
+    if (configGetInt(config, "ripps2_glyph_set", &v) && v >= 0 && v < RIPPS2_GLYPHSET_COUNT)
+        gRipps2GlyphSet = v;
+    if (!configGetStrCopy(config, "ripps2_hint_order", gRipps2HintOrder, sizeof(gRipps2HintOrder)))
+        gRipps2HintOrder[0] = '\0';
+}
+
+void ripps2HintsSaveConfig(config_set_t *config)
+{
+    static const char *const keys[4] = {"ripps2_hint_menu", "ripps2_hint_refresh", "ripps2_hint_star", "ripps2_hint_view"};
+    int i;
+    configSetInt(config, "ripps2_hint_layout", gRipps2HintLayout);
+    configSetInt(config, "ripps2_hint_labels", gRipps2HintLabels);
+    for (i = 0; i < 4; i++)
+        configSetInt(config, keys[i], gRipps2HintPick[pickHints[i]]);
+    configSetInt(config, "ripps2_glyph_set", gRipps2GlyphSet);
+    configSetStr(config, "ripps2_hint_order", gRipps2HintOrder);
+}
+#endif // RIPPS2_HINTS_HOST_TEST
