@@ -93,6 +93,28 @@ float ripps2GlyphsAlpha(int which); // 0..1 this frame; call once a frame while
 float ripps2HintsAlpha(void);       // 0..1
 float ripps2CatBarAlpha(void);      // 0..1
 
+// RIPPS2 build 90: Controller Settings > Hints and Glyphs and the theme keys behind it (ripps2hints.c). Every
+// row's first choice (0) is Theme: what the theme says (conf_theme.cfg hints_hide, hints_order, hints_labels,
+// hints_layout, hints_spacing, glyph_set). Any other choice is the user's and wins over every theme.
+enum { RIPPS2_HINT_MENU = 0, RIPPS2_HINT_RUN, RIPPS2_HINT_INFO, RIPPS2_HINT_OPTIONS, RIPPS2_HINT_REFRESH,
+       RIPPS2_HINT_STAR, RIPPS2_HINT_VIEW, RIPPS2_HINT_SOURCE, RIPPS2_HINT_COUNT };
+enum { RIPPS2_GLYPHSET_THEME = 0, RIPPS2_GLYPHSET_RIPPS2, RIPPS2_GLYPHSET_STANDARD, RIPPS2_GLYPHSET_WHITE, RIPPS2_GLYPHSET_COUNT };
+enum { RIPPS2_PICK_THEME = 0, RIPPS2_PICK_SHOWN, RIPPS2_PICK_HIDDEN }; // a hint's own row
+extern int gRipps2HintLayout;  // 0 Theme, 1 Row, 2 Column
+extern int gRipps2HintLabels;  // 0 Theme, 1 Glyph and Label, 2 Glyph Only, 3 Badges
+extern int gRipps2HintPick[RIPPS2_HINT_COUNT]; // RIPPS2_PICK_*; rows for Menu, Refresh, Star and View
+extern char gRipps2HintOrder[48]; // "" follows the theme; else hint names, comma separated, first to last
+extern int gRipps2GlyphSet;    // RIPPS2_GLYPHSET_*
+int ripps2HintToken(int textId, int iconId);              // which hint a hint bar entry is (RIPPS2_HINT_*)
+int ripps2HintShown(int token);                           // the user's pick, else the theme's hints_hide
+int ripps2HintLabels(void);                               // 1: glyph and label, 0: glyph only, 2: badges
+int ripps2HintColumn(void);                               // 1: one hint a line
+int ripps2HintRank(int token);                            // its place in the order in effect (lower first)
+int ripps2HintParse(const char *list, int *out, int max); // hint names -> RIPPS2_HINT_* in order, each once
+int ripps2GlyphSetParse(const char *name);                // theme | ripps2 | standard | white
+int ripps2GlyphSetFor(int themeSet);                      // the set in effect: the user's, else the theme's
+int ripps2ShowHintsConfig(void);                          // the page; 1 when anything changed (save it)
+
 void ripps2SetCategory(int cat);    // switch screens and fly the PS2 mark
 void ripps2StepCategory(int dir);   // -1 / +1, clamped at the ends
 void ripps2RenderCategoryBar(void); // the three labels plus the mark
@@ -153,6 +175,8 @@ int ripps2KbdPoll(void);
 
