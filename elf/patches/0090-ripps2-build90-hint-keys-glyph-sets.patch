+// RIPPS2 build 90: one hint bar entry: glyph and label (labels 1), the glyph alone (0; a hint whose glyph the
+// theme does not have keeps its label, or it would vanish), or a badge (2: glyph and label together on the
+// glyph set's pill, hint_badge). Returns the x after it.
+#define HINT_BADGE_H     26 // the pill: 3 above and below the 20 px glyph
+#define HINT_BADGE_PAD_L 4
+#define HINT_BADGE_PAD_R 9
+
+static int hintGlyphOnly(menu_hint_item_t *h, int labels)
+{
+    GSTEXTURE *t = thmGetTexture(h->icon_id);
+    return !labels && t != NULL && t->Mem != NULL;
+}
+
+static GSTEXTURE *hintBadge(int labels)
+{
+    GSTEXTURE *b = labels == 2 ? thmGetTexture(RIPPS2_HINT_BADGE) : NULL;
+    return b != NULL && b->Width >= 4 ? b : NULL; // no pill (a theme without one, use_default=0): plain glyph and label
+}
+
+static int hintEntryWidth(menu_hint_item_t *h, int labels, int font)
+{
+    GSTEXTURE *t = thmGetTexture(h->icon_id);
+    int iconW = (t && t->Mem) ? rmWideScale((t->Width * 20) / t->Height) + 2 : 0;
+    if (hintGlyphOnly(h, labels))
+        return iconW;
+    return iconW + rmUnScaleX(fntCalcDimensions(font, _l(h->text_id))) + (hintBadge(labels) ? HINT_BADGE_PAD_L + HINT_BADGE_PAD_R : 0);
+}
+
+static int drawHintEntry(menu_hint_item_t *h, int labels, int font, int x, int y, u64 col, u64 iconCol)
+{
+    GSTEXTURE *badge = hintBadge(labels);
+    if (badge != NULL) {
+        int w = hintEntryWidth(h, labels, font);
+        float half = badge->Width / 2.0f;
+        int capW = (int)(half * HINT_BADGE_H / badge->Height), cap = rmWideScale(capW), mid = w - 2 * cap;
+        int by = y + 10 - HINT_BADGE_H / 2;
+        rmDrawPixmapPart(badge, x, by, ALIGN_NONE, capW, HINT_BADGE_H, SCALING_RATIO, iconCol, 0, 0, half, badge->Height);
+        if (mid > 0)
+            rmDrawPixmapPart(badge, x + cap, by, ALIGN_NONE, mid, HINT_BADGE_H, SCALING_NONE, iconCol, half - 0.5f, 0, half + 0.5f, badge->Height);
+        rmDrawPixmapPart(badge, x + cap + (mid > 0 ? mid : 0), by, ALIGN_NONE, capW, HINT_BADGE_H, SCALING_RATIO, iconCol, half, 0, badge->Width, badge->Height);
+        guiDrawIconAndTextA(h->icon_id, h->text_id, font, x + HINT_BADGE_PAD_L, y, col, iconCol);
+        return x + w;
+    }
+    if (hintGlyphOnly(h, labels)) {
+        GSTEXTURE *t = thmGetTexture(h->icon_id);
+        int w = (t->Width * 20) / t->Height;
+        rmDrawPixmap(t, x, y + 10, ALIGN_VCENTER, w, 20, SCALING_RATIO, iconCol, 0);
+        return x + rmWideScale(w) + 2;
+    }
+    return guiDrawIconAndTextA(h->icon_id, h->text_id, font, x, y, col, iconCol);
+}
+
