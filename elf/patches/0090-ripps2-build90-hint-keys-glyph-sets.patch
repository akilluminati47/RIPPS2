+            texLoadInternal(tex, glyphSlots[i]);
+        else
+            thmLoadResource(tex, glyphSlots[i], theme->glyphPath[0] ? theme->glyphPath : NULL, GS_PSM_CT32, theme->useDefault);
+    }
+    theme->glyphSetLoaded = set;
+}
