+// build 132 (the user, 11/02: "Idle on game for 4.2 seconds fade with cover timing to square info n triangle settings
+// glyphs flank instead of the x and o and stays until game change"): how far a list page's flank hints have turned
+// from RUN / SOURCE to INFO / OPTIONS, 0..1. After 4.2 s on one game they turn over the screenshots' fade time
+// (SLIDE_FADE_S); a move to another game, the sidebar or another page turns them back the same way
+#define FLANK_IDLE_S 4.2f
+static float flankInfo = 0.0f;
+
+static float flankInfoK(struct menu_list *menu)
+{
+    static const void *on = NULL;
+    static clock_t since = 0, last = 0;
+    clock_t now = clock();
+    const void *cur = menu != NULL && menu->item != NULL ? (const void *)menu->item->current : NULL;
+    item_list_t *list = cur != NULL ? menu->item->userdata : NULL;
+    int game = cur != NULL && !(list != NULL && MODE_IS_MIX(list->mode) && mixIsStartRow(list->mode, menu->item->current->item.id));
+    float dt = last != 0 ? (float)(now - last) / CLOCKS_PER_SEC : 0.0f;
+    last = now;
+    if (cur != on || dt > 0.25f) { // another game, or the page was away
+        on = cur;
+        since = now;
+    }
+    if (dt > 0.25f) {
+        flankInfo = 0.0f;
+        dt = 0.0f;
+    }
+    if (game && !ripps2SidebarFocused() && (float)(now - since) / CLOCKS_PER_SEC >= FLANK_IDLE_S)
+        flankInfo = fminf(1.0f, flankInfo + dt / SLIDE_FADE_S);
+    else
+        flankInfo = fmaxf(0.0f, flankInfo - dt / SLIDE_FADE_S);
+    return flankInfo;
+}
