+// build 132 (the user, 11/02: "arts on top of the glass in the viewport for full color"): the info page's art untinted
+// down to clearPct of the glass's height, then the glass's deep shade coming in over 8% so the title and details read
+void ripps2DrawPanelShade(int x, int y, int w, int h, int clearPct)
+{
+    int y1 = y + (h * clearPct) / 100, y2 = y + (h * (clearPct + 8)) / 100;
+    u64 none = RGBA_PRIM(0x03, 0x08, 0x22, 0x00), deep = RGBA_PRIM(0x03, 0x08, 0x22, 0x5C);
+    if (y2 > y + h)
+        y2 = y + h;
+    rmDrawQuadGouraud(x, y1, none, x + w, y1, none, x, y2, deep, x + w, y2, deep);
+    if (y2 < y + h)
+        rmDrawQuadGouraud(x, y2, deep, x + w, y2, deep, x, y + h, deep, x + w, y + h, deep);
+    panelFrame(x, y, w, h);
+}
