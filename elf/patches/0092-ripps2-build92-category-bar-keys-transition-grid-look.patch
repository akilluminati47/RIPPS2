+// ---- build 92: the bar as the theme lays it out ----
+// RIPPS2's own face for the three names on every theme (the RIPPS2 theme's font2 and font7: builtin:ripps2 at
+// 20 and 17), so they look alike everywhere; category_font=theme gives a theme its own back. Loaded once, kept.
+static int catFont(int lit)
+{
+    static int fonts[2] = {FNT_ERROR, FNT_ERROR};
+    if (gTheme->catFontTheme)
+        return gTheme->fonts[lit ? 2 : 7];
+    if (fonts[lit] == FNT_ERROR)
+        fonts[lit] = fntLoadFile("builtin:ripps2", lit ? 20 : 17);
+    return fonts[lit] != FNT_ERROR ? fonts[lit] : gTheme->fonts[lit ? 2 : 7];
+}
+
+static const char *catName(int cat)
+{
+    return gTheme->catLabel[cat][0] ? gTheme->catLabel[cat] : categoryLabel[cat];
+}
+
+// where a place on the bar is: along the bar (x in a row, y in a column) and across it
+static float catAlong(int slot)
+{
+    if (gTheme->catColumn)
+        return (float)((gTheme->catY >= 0 ? gTheme->catY : 140) + slot * (gTheme->catSpacing >= 0 ? gTheme->catSpacing : 34));
+    return (float)categoryX[slot];
+}
+
+static int catAcross(void)
+{
+    if (gTheme->catColumn)
+        return gTheme->catX >= 0 ? gTheme->catX : 40;
+    return gTheme->catY >= 0 ? gTheme->catY : BAR_Y;
+}
+
+// build 92: Colors and More > Page Transition (0 Theme, 1 None, 2 Fade, 3 Flash), else the theme's
+// category_transition: switching category, the new page comes in from the background colour or a flash
+int gRipps2Transition = 0;
+static clock_t catSwitchAt = 0;
+#define CAT_TRANSITION_S 0.30f
+
+static int catTransition(void)
+{
+    if (gRipps2Transition > 0)
+        return gRipps2Transition - 1;
+    return gTheme->catTransitionDef > 0 ? gTheme->catTransitionDef : 0;
+}
+
+static void catTransitionDraw(void)
+{
+    if (catSwitchAt == 0)
+        return;
+    float t = (float)(clock() - catSwitchAt) / (float)CLOCKS_PER_SEC / CAT_TRANSITION_S;
+    int mode = catTransition();
+    if (t >= 1.0f || mode == 0) {
+        catSwitchAt = 0;
+        return;
+    }
+    float k = (1.0f - t) * (1.0f - t);
+    int sw, sh;
+    rmGetScreenExtents(&sw, &sh);
+    if (mode == 1)
+        rmDrawRect(0, 0, sw, sh, GS_SETREG_RGBA(gTheme->bgColor[0], gTheme->bgColor[1], gTheme->bgColor[2], (int)(0x80 * k)));
+    else {
+        rmSetBlendAdditive(1);
+        rmDrawRect(0, 0, sw, sh, GS_SETREG_RGBA(0x70, 0x80, 0x80, (int)(0x50 * k)));
+        rmSetBlendAdditive(0);
+    }
+}
