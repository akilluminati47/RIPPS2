 #define HINT_HEIGHT                  32
@@ -2491,6 +2492,47 @@ static float gridFadeIn(const void *item, const void *tex)
     return 0.0f;
 }
 
+// RIPPS2 build 92: text in the in-game menu's 5x7 pixel font (RIPPS2_PIXFONT, ASCII 32..95 in 6 x 8 cells, 16 a
+// row), `scale` screen pixels a font pixel, centred on (cx, cy). Lower case comes out in capitals, as the font is.
+static void drawPixelText(const char *s, int cx, int cy, int scale, u64 color)
+{
+    GSTEXTURE *f = thmGetTexture(RIPPS2_PIXFONT);
+    int n = (int)strlen(s), i;
+    if (f == NULL || n == 0 || scale < 1)
+        return;
+    int x = cx - rmWideScale(n * 6 * scale - scale) / 2, y = cy - 7 * scale / 2;
+    for (i = 0; i < n; i++) {
+        int c = toupper((unsigned char)s[i]);
+        if (c < 32 || c > 95)
+            c = '?';
+        c -= 32;
+        rmDrawPixmapPart(f, x, y, ALIGN_NONE, 5 * scale, 7 * scale, SCALING_RATIO, color, (c % 16) * 6, (c / 16) * 8,
+                         (c % 16) * 6 + 5, (c / 16) * 8 + 7);
+        x += rmWideScale(6 * scale);
+    }
+}
+
+// A game's serial as its case shows it, "SLUS_204.82" -> "SLUS-20482"; 0 when the startup is not a serial
+static int gridSerial(const char *startup, char *out, int size)
+{
+    int i, o = 0;
+    if (startup == NULL || strlen(startup) < 9)
+        return 0;
+    for (i = 0; i < 4; i++)
+        if (!isalpha((unsigned char)startup[i]))
+            return 0;
+    if (startup[4] != '_' && startup[4] != '-')
+        return 0;
+    for (i = 0; startup[i] && o < size - 1; i++) {
+        char c = startup[i];
+        if (c == '.')
