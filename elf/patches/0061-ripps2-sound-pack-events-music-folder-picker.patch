+// RIPPS2: the folder RIPPS2's MUSIC and SOUND folders sit in: beside the ELF (the same home as the
+// built-in themes' bgm.ogg above), or the HDD home's THM folder on an APA boot
+int oplGetRipps2Dir(char *path, int pathSize)
+{
+    int length;
+    size_t n;
+
+    if (path == NULL || pathSize <= 1)
+        return 0;
+    path[0] = '\0';
+    if (gBootHomeApa) {
+        if (gHDDPrefix == NULL || gHDDPrefix[0] == '\0')
+            return 0;
+        length = snprintf(path, pathSize, "%sTHM/", gHDDPrefix);
+    } else {
+        if ((n = strlen(gBootDir)) == 0)
+            return 0;
+        length = snprintf(path, pathSize, "%s%s", gBootDir,
+                          (gBootDir[n - 1] == ':' || gBootDir[n - 1] == '/' || gBootDir[n - 1] == '\\') ? "" : "/");
+    }
+    if (length < 0 || length >= pathSize) {
+        path[0] = '\0';
+        return 0;
+    }
+    return 1;
+}
