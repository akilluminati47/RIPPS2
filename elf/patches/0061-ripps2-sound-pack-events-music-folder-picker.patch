+// RIPPS2: Audio settings > Music, the MUSIC folder's tracks (sound.c bgmMusicList)
+static char musicFiles[RIPPS2_MUSIC_MAX][RIPPS2_MUSIC_NAME];
+static char musicTitles[RIPPS2_MUSIC_MAX][RIPPS2_MUSIC_NAME];
+static const char *musicEnum[RIPPS2_MUSIC_MAX + 1];
+static int musicCount = 0, musicShown = 0;
+
+static void guiMusicBegin(void)
+{
+    int i;
+    musicShown = 0;
+    musicCount = bgmMusicList(musicFiles, RIPPS2_MUSIC_MAX);
+    for (i = 0; i < musicCount; i++) {
+        bgmMusicTitle(musicFiles[i], musicTitles[i], RIPPS2_MUSIC_NAME);
+        musicEnum[i] = musicTitles[i];
+        if (!strcasecmp(musicFiles[i], gRipps2Music))
+            musicShown = i;
+    }
+    if (musicCount == 0)
+        musicEnum[0] = "None in MUSIC";
+    musicEnum[musicCount > 0 ? musicCount : 1] = NULL;
+    diaSetEnum(diaAudioConfig, UICFG_RIPPS2_MUSIC, musicEnum);
+    diaSetInt(diaAudioConfig, UICFG_RIPPS2_MUSIC, musicShown);
+}
+
+// Another track picked: it plays from its start (the music restarts below, in guiSetAudioSettingsState)
+static void guiMusicPicked(void)
+{
+    int pick = musicShown;
+    diaGetInt(diaAudioConfig, UICFG_RIPPS2_MUSIC, &pick);
+    if (musicCount == 0 || pick == musicShown || pick < 0 || pick >= musicCount)
+        return;
+    musicShown = pick;
+    snprintf(gRipps2Music, sizeof(gRipps2Music), "%s", musicFiles[pick]);
+    if (isBgmPlaying())
+        bgmStop();
+}
