+// build 130: Cross on a START row: its drive starts, and the screen waits until the drive has listed (its games then take
+// the row's place) or did not answer. Never launches anything: 0
+static int mixStartRowRun(struct menu_item *menu, item_list_t *rows, int fam)
+{
+    int backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE, estimate = mixStartEstimate(fam);
+    double since = ripps2Seconds(), poked = since, sibling = 0.0;
+    char line[300];
+    int f2;
+
+    ripps2StartSourceMode(mixFamilyMode(fam));
+    readPads();
+    while (1) {
+        if (!mixAnswered[fam] && ripps2Seconds() - poked > 0.5) {
+            poked = ripps2Seconds();
+            mixPokeFamily(fam);
+        }
+        guiExecDeferredOps(); // the rebuilt list reaches the menu
+        if (mixAnswered[fam] || menu->userdata != rows) {
+            mixStartMeasured(fam, ripps2Seconds() - since);
+            return 0;
+        }
+        // USB, MX4SIO, iLink and the exFAT HDD start together (BDM): once another of them has listed, this one has a
+        // few seconds more, then it is not there
+        for (f2 = 0; sibling == 0.0 && f2 < MIX_FAM_COUNT; f2++)
+            if (f2 != fam && mixAnswered[f2] && mixFamilyMode(f2) == mixFamilyMode(fam))
+                sibling = ripps2Seconds();
+        if (ripps2Seconds() - since > MIX_LAUNCH_WAIT_S || (sibling > 0.0 && ripps2Seconds() - sibling > 5.0)) {
+            snprintf(line, sizeof(line), _t("%s did not answer. Is it connected?"), _t(mixFamName[fam]));
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox(line, 0, NULL);
+            return 0;
+        }
+        mixDrawStarting(fam, NULL, since, estimate);
+        readPads();
+        if (getKeyOn(backKey)) {
+            sfxPlay(SFX_CANCEL);
+            return 0;
+        }
+    }
+}
