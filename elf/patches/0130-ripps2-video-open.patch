+// build 130: the player's steps (smsLiteSetStageLog) to the log, to DIAG.TXT's ring and, until the picture shows, to
+// VIDEO.TXT beside RIPPS2, a line at a time, so a console run that never starts says where it stopped
+static char vpLogPath[300];
+static volatile int vpLogFile = 0;
+
+static void videoStageLog(const char *line)
+{
+    int fd;
+
+    LOG("VIDEO: %s\n", line);
+    ripps2Diag("video: %s", line);
+    if (!vpLogFile)
+        return;
+    if ((fd = open(vpLogPath, O_WRONLY | O_CREAT, 0666)) >= 0) {
+        lseek(fd, 0, SEEK_END);
+        write(fd, line, strlen(line));
+        write(fd, "\r\n", 2);
+        close(fd);
+    }
+    if (!strncmp(line, "playing:", 8) || !strncmp(line, "stopped:", 8))
+        vpLogFile = 0; // from here the drive is the video's
+}
+
+// the largest block malloc gives now that is real memory (below the heap's end and the PS2's 32 MB), in KB
+static unsigned int videoLargestFreeKb(void)
+{
+    unsigned int lo = 0, hi = 32 * 1024, mid;
+    u32 top = (u32)EndOfHeap();
+    void *p;
+
+    if (top > 0x02000000)
+        top = 0x02000000;
+    while (lo < hi) {
+        mid = (lo + hi + 1) / 2;
+        if ((p = malloc(mid * 1024)) != NULL) {
+            int real = (u32)p + mid * 1024 <= top;
+            free(p);
+            if (real) {
+                lo = mid;
+                continue;
+            }
+        }
+        hi = mid - 1;
+    }
+    return lo;
+}
