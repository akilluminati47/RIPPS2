+            char head[96];
+            snprintf(head, sizeof(head), "RIPPS2 build %d: the video player's steps, until the picture shows\r\n", RIPPS2_BUILD);
+            write(fd, head, strlen(head));
+            close(fd);
+            vpLogFile = 1;
+        }
+    }
+    smsLiteSetStageLog(videoStageLog);
