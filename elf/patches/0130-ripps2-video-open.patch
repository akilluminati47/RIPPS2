+// build 130 (ahavasi on 128: a 64 MB card full of saves was painfully slow here, uLaunchELF fast on the same card): a
+// memory card folder in one mcGetDir, its names, folders and sizes together, as uLaunchELF reads it. readdir and a
+// stat for each entry walked the card's folder through mcman once per entry. Entries in fbList[0..), how many, or -1
+// when the card would not answer (then readdir does it)
+static int fbScanMcDir(unsigned char *sized)
+{
+    sceMcTblGetDir *tbl;
+    char path[300];
+    int port = fbPath[2] - '0', got = -1, n = 0, i;
+
+    if ((tbl = (sceMcTblGetDir *)memalign(64, FB_MAX * sizeof(sceMcTblGetDir))) == NULL)
+        return -1;
+    snprintf(path, sizeof(path), "%s*", fbPath + 4); // "mc0:/BASLUS-21050/" -> "/BASLUS-21050/*"
+    if (mcGetDir(port, 0, path, 0, FB_MAX, tbl) == 0)
+        mcSync(0, NULL, &got);
+    for (i = 0; i < got && n < FB_MAX; i++) {
+        const char *name = (const char *)tbl[i].EntryName;
+        if (!name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+            continue;
+        fb_entry_t *e = &fbList[n];
+        memset(e, 0, sizeof(*e));
+        snprintf(e->name, sizeof(e->name), "%.32s", name);
+        e->kind = (tbl[i].AttrFile & sceMcFileAttrSubdir) ? FB_KIND_DIR : FB_KIND_FILE;
+        e->size = tbl[i].FileSizeByte;
+        sized[n++] = 1;
+    }
+    free(tbl);
+    return got < 0 ? -1 : n;
+}
