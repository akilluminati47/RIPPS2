+/* build 130 (ahavasi, 11/01: the names showed once conf_apps.cfg was copied to mc0, so RIPPS2 read only its own):
+   POPStarterGameInstaller writes conf_apps.cfg on the drive it put the games on, at its root (or in its OPL folder).
+   When a drive's PS1 games are listed, the lines there that name one of those games are read too: display only,
+   never written. Each drive keeps a small table of its own, rewritten in place by its next listing */
+#define VCD_DRIVE_SLOTS 4
+#define VCD_DRIVE_MAX   128
+static struct
+{
+    char prefix[24];
+    volatile int count;
+    struct
+    {
+        char base[64];
+        char title[64];
+    } e[VCD_DRIVE_MAX];
+} vcdDrv[VCD_DRIVE_SLOTS];
+
+static void vcdDriveAppsLoad(const char *devPrefix, const vcd_entry_t *vcds, int n)
+{
+    static const char *const where[] = {"conf_apps.cfg", "OPL/conf_apps.cfg"};
+    char path[256], base[64];
+    struct config_value_t *v;
+    int slot, w, i, count = 0;
+
+    if (devPrefix == NULL || n <= 0 || strlen(devPrefix) >= sizeof(vcdDrv[0].prefix) || vcdSep(devPrefix) == '\\')
+        return; // SMB: its share keeps OPL's files elsewhere
+    for (slot = 0; slot < VCD_DRIVE_SLOTS; slot++)
+        if (!vcdDrv[slot].prefix[0] || !strcmp(vcdDrv[slot].prefix, devPrefix))
+            break;
+    if (slot == VCD_DRIVE_SLOTS)
+        slot = VCD_DRIVE_SLOTS - 1;
+    vcdDrv[slot].count = 0;
+    snprintf(vcdDrv[slot].prefix, sizeof(vcdDrv[slot].prefix), "%s", devPrefix);
+    for (w = 0; w < 2; w++) {
+        config_set_t *cfg;
+        snprintf(path, sizeof(path), "%s%s", devPrefix, where[w]);
+        if ((cfg = configAlloc(0, NULL, path)) == NULL)
+            continue;
+        configRead(cfg);
+        for (v = cfg->head; v != NULL && count < VCD_DRIVE_MAX; v = v->next) {
+            if (!vcdAppsBase(v, base))
+                continue;
+            for (i = 0; i < n; i++)
+                if (!strcasecmp(base, vcds[i].name))
+                    break;
+            if (i == n)
+                continue; // a line for something else
+            memcpy(vcdDrv[slot].e[count].base, base, sizeof(base));
+            snprintf(vcdDrv[slot].e[count].title, sizeof(vcdDrv[slot].e[0].title), "%s", v->key);
+            count++;
+        }
+        configFree(cfg);
+    }
+    vcdDrv[slot].count = count;
+    LOG("VCD: %d names from %s's conf_apps.cfg\n", count, devPrefix);
+}
