+    ripps2DrawPagePanel();
+    snprintf(line, sizeof(line), _t("STARTING %s"), _t(mixFamName[fam]));
+    fntRenderStringFit(gTheme->fonts[4], 320, 200, ALIGN_CENTER, 540, line, GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80), 0);
