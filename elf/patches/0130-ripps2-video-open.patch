+            snprintf(line, sizeof(line), _t("Taking longer than its last start (%d s so far)"), gone);
+        fntRenderStringFit(gTheme->fonts[5], 320, 262, ALIGN_CENTER, 540, line, GS_SETREG_RGBA(0x47, 0x4B, 0x59, 0x80), 0);
