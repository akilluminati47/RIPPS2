diff --git a/src/ripps2biossnd.c b/src/ripps2biossnd.c
new file mode 100644
index 0000000..8371c40
--- /dev/null
+++ b/src/ripps2biossnd.c
@@ -0,0 +1,534 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 build 88: Audio settings > BIOS Sounds > RIP. RIPPS2's sound map is the PS2's own browser
+  sounds; this reads them from the console it runs on (rom0:SNDIMAGE, the BIOS's sound module) and
+  writes them into the AUDIO folder as RIPPS2's events, so nobody's sounds have to be passed around:
+  every console carries its own. Nothing from any BIOS is in RIPPS2.
+
+  SNDIMAGE is a small ROM directory of its own; SNDOSDDH and SNDOSDDB in it are the browser's sound
+  bank (a list of 64-byte entries: stereo volumes, pitch, envelope, sample address) and its SPU2 ADPCM
+  samples, each file packed with the BIOS's LZ scheme. Each event's sound is played here the way the
+  SPU2 plays it under the browser, at its own rate: its sample, its envelope (ADSR), its two volumes
+  summed, a little of the hall the console runs under its menus, then encoded as audsrv ADPCM (.adp).
+  The format and the event map are RIPPS2 Audio Studio's (tools/audio-studio/ps2bios.py), matched
+  against the private pack's sounds: the browser's menu sound N in Audio Studio is entry N - 1 here.
+
+  The boot and game launch sounds are the console's system music (sequences on another bank), so
+  they are not ripped; an older BIOS (1.00, SCPH-10000) keeps its sounds elsewhere and is refused.
+
+  RIPPS2_BIOSSND_HOST_TEST builds only the ripper, for elf/tests and checks against Audio Studio.
+*/
+
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#ifndef RIPPS2_BIOSSND_HOST_TEST
+#include <stdio.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/sound.h"
+#include "include/ripps2.h"
+#endif
+#include "include/ripps2biossnd.h"
+
+typedef unsigned char rbs_u8;
+
+// the event map: RIPPS2's file, and the browser's sound list entry it comes from
+static const struct
+{
+    const char *file;
+    int entry;
+} rbsMap[] = {
+    {"cursor.adp", 6}, {"confirm.adp", 4}, {"cancel.adp", 12}, {"page_in.adp", 2}, {"page_out.adp", 1},
+    {"transition.adp", 9}, {"message.adp", 10}, {"disc.adp", 10}, {"error.adp", 3}, {"save.adp", 11},
+    {"bd_connect.adp", 7}, {"bd_disconnect.adp", 8}, {"random.adp", 5},
+};
+#define RBS_EVENTS ((int)(sizeof(rbsMap) / sizeof(rbsMap[0])))
+
+static unsigned int rbsLe32(const rbs_u8 *p) { return p[0] | p[1] << 8 | p[2] << 16 | (unsigned int)p[3] << 24; }
+static unsigned int rbsLe16(const rbs_u8 *p) { return p[0] | p[1] << 8; }
+
+// A ROM directory (the BIOS's own, or SNDIMAGE's): the file's offset and size, 0 when it is there
+int ripps2RomdirFind(const unsigned char *d, int size, const char *name, int *off, int *len)
+{
+    static const rbs_u8 reset[10] = {'R', 'E', 'S', 'E', 'T', 0, 0, 0, 0, 0};
+    int i, j, o = 0, n = (int)strlen(name);
+
+    for (i = 0; i + 16 <= size; i += 16) // the directory's first entry, RESET, sits on a 16-byte boundary
+        if (!memcmp(d + i, reset, 10))
+            break;
+    if (i + 16 > size || n > 10)
+        return -1;
+    for (j = i; j + 16 <= size && d[j]; j += 16) {
+        unsigned int sz = rbsLe32(d + j + 12);
+        if (!memcmp(d + j, name, n) && (n == 10 || d[j + n] == 0)) {
+            if (o < 0 || (unsigned int)o + sz > (unsigned int)size)
+                return -1;
+            *off = o;
+            *len = (int)sz;
+            return 0;
+        }
+        o += (int)((sz + 15) & ~15u);
+    }
+    return -1;
+}
+
+// The BIOS resource compression: u32 size, then groups led by a big-endian 32-bit word whose top 30 bits
+// flag 30 tokens (1: a 2-byte back reference, 0: a literal byte) and whose low 2 bits set how the
+// references split: (14 - mode) bits of distance, the rest length - 3. NULL when it does not add up.
+static rbs_u8 *rbsUnlz(const rbs_u8 *c, int clen, int *outLen)
+{
+    unsigned int n, flags, v;
+    int i = 4, o = 0, b, db, mask, d, k;
+    rbs_u8 *out;
+
+    if (clen < 8 || (n = rbsLe32(c)) == 0 || n > 4 * 1024 * 1024 || (out = malloc(n)) == NULL)
+        return NULL;
+    while (o < (int)n) {
+        if (i + 4 > clen)
+            goto bad;
+        flags = (unsigned int)c[i] << 24 | c[i + 1] << 16 | c[i + 2] << 8 | c[i + 3];
+        i += 4;
+        db = 14 - (flags & 3);
+        mask = (1 << db) - 1;
+        for (b = 31; b > 1 && o < (int)n; b--) {
+            if (flags >> b & 1) {
+                if (i + 2 > clen)
+                    goto bad;
+                v = c[i] << 8 | c[i + 1];
+                i += 2;
+                d = (int)(v & mask) + 1;
+                if (d > o)
+                    goto bad;
+                for (k = (int)(v >> db) + 3; k > 0 && o < (int)n; k--, o++)
+                    out[o] = out[o - d];
+            } else {
+                if (i >= clen)
+                    goto bad;
+                out[o++] = c[i++];
+            }
+        }
+    }
+    *outLen = (int)n;
+    return out;
+bad:
+    free(out);
+    return NULL;
+}
+
+static const int rbsFilter[5][2] = {{0, 0}, {60, 0}, {115, -52}, {98, -55}, {122, -60}};
+
+static int rbsClamp16(int v) { return v < -32768 ? -32768 : v > 32767 ? 32767 : v; }
+
+// SPU2 ADPCM at addr up to its end flag: samples (-1..1), malloc'd; their count in *n
+static float *rbsAdpcm(const rbs_u8 *bd, int size, unsigned int addr, int *n)
+{
+    int blocks = 0, o, s1 = 0, s2 = 0, k = 0, j;
+    float *out;
+
+    for (o = (int)addr; o >= 0 && o + 16 <= size; o += 16) {
+        blocks++;
+        if (bd[o + 1] & 1)
+            break;
+    }
+    if (blocks == 0 || (out = malloc(sizeof(float) * 28 * blocks)) == NULL)
+        return NULL;
+    for (o = (int)addr; k < blocks * 28; o += 16) {
+        int head = bd[o], sh = head & 0xF, k1 = rbsFilter[head >> 4 > 4 ? 4 : head >> 4][0], k2 = rbsFilter[head >> 4 > 4 ? 4 : head >> 4][1];
+        for (j = 2; j < 16; j++) {
+            int q, nib;
+            for (nib = 0; nib < 2; nib++) {
+                q = nib ? bd[o + j] >> 4 : bd[o + j] & 0xF;
+                q = q >= 8 ? q - 16 : q;
+                // (q << 12) >> sh, and the prediction floored, as the chip does
+                int y = rbsClamp16(((q * 4096) >> sh) + ((s1 * k1 + s2 * k2 + 32) >> 6)); // arithmetic shifts, as the chip
+                out[k++] = y / 32768.0f;
+                s2 = s1;
+                s1 = y;
+            }
+        }
+    }
+    *n = k;
+    return out;
+}
+
+// The SPU2's ADSR envelope from its two registers, n values (0..1) at 48 kHz; no key off (a one-shot)
+static void rbsEnvelope(unsigned int a1, unsigned int a2, float *out, int n)
+{
+    struct
+    {
+        int dec, exp, shift, step, target;
+    } ph[3];
+    int value = 0, counter = 0, phase = 0, i = 0, k;
+
+    ph[0].dec = 0;
+    ph[0].exp = a1 >> 15 & 1;
+    ph[0].shift = a1 >> 10 & 0x1F;
+    ph[0].step = 7 - (int)(a1 >> 8 & 3);
+    ph[0].target = 0x7FFF;
+    ph[1].dec = 1;
+    ph[1].exp = 1;
+    ph[1].shift = a1 >> 4 & 0xF;
+    ph[1].step = -8;
+    ph[1].target = (int)((a1 & 0xF) + 1) << 11;
+    ph[2].dec = a2 >> 14 & 1;
+    ph[2].exp = a2 >> 15 & 1;
+    ph[2].shift = a2 >> 8 & 0x1F;
+    ph[2].step = ph[2].dec ? ~(7 - (int)(a2 >> 6 & 3)) : 7 - (int)(a2 >> 6 & 3);
+    ph[2].target = -1;
+
+    memset(out, 0, sizeof(float) * n);
+    while (i < n) {
+        int shift = ph[phase].shift, inc = 0x8000 >> (shift > 11 ? shift - 11 : 0), lev;
+        if (inc < 1)
+            inc = 1;
+        lev = ph[phase].step * (1 << (shift < 11 ? 11 - shift : 0));
+        if (ph[phase].exp && !ph[phase].dec && value > 0x6000)
+            inc = inc >> 2 > 0 ? inc >> 2 : 1;
+        if (ph[phase].exp && ph[phase].dec)
+            lev = (lev * value) >> 15; // the chip's arithmetic shift: it floors, so a decay reaches 0
+        k = (0x8000 - counter + inc - 1) / inc;
+        if (k < 1)
+            k = 1;
+        if (k > n - i)
+            k = n - i;
+        for (; k > 0; k--, i++, counter += inc)
+            out[i] = value / 32767.0f;
+        if (counter >= 0x8000) {
+            counter = 0;
+            value += lev;
+            value = value < 0 ? 0 : value > 0x7FFF ? 0x7FFF : value;
+        }
+        if (phase == 2) {
+            if (value == 0)
+                break;
+            continue;
+        }
+        if ((!ph[phase].dec && value >= ph[phase].target) || (ph[phase].dec && value <= ph[phase].target))
+            phase++;
+    }
+}
+
+// A little of the hall the console runs under its menus (Schroeder: four damped combs, two all-passes,
+// after an 18 ms gap), scaled to wet times the dry peak. y holds n dry samples and room for the tail.
+static int rbsHall(float *y, int n, int cap, int rate, float wet)
+{
+    static const float combMs[4] = {29.7f, 37.1f, 41.1f, 43.7f}, apMs[2] = {5.0f, 1.7f};
+    float *w, *line[6], filt[4] = {0, 0, 0, 0}, peak = 0, wpeak = 0, g[4];
+    int len[6], pos[6] = {0, 0, 0, 0, 0, 0}, pre = rate * 18 / 1000, i, c, total = cap;
+
+    if ((w = calloc(total, sizeof(float))) == NULL)
+        return n;
+    for (c = 0; c < 6; c++) {
+        len[c] = (int)((c < 4 ? combMs[c] : apMs[c - 4]) * rate / 1000) + 1;
+        if ((line[c] = calloc(len[c], sizeof(float))) == NULL) {
+            while (c--)
+                free(line[c]);
+            free(w);
+            return n;
+        }
+    }
+    for (c = 0; c < 4; c++)
+        g[c] = powf(10.0f, -3.0f * combMs[c] / 1000.0f / 1.3f); // a 1.3 s tail
+    for (i = 0; i < total; i++) {
+        float x = (i - pre >= 0 && i - pre < n) ? y[i - pre] : 0, s = 0;
+        for (c = 0; c < 4; c++) {
+            float out = line[c][pos[c]];
+            filt[c] = out * 0.65f + filt[c] * 0.35f; // highs fade first
+            line[c][pos[c]] = x + filt[c] * g[c];
+            pos[c] = (pos[c] + 1) % len[c];
+            s += out;
+        }
+        for (c = 4; c < 6; c++) {
+            float d = line[c][pos[c]], v = s + d * 0.7f;
+            line[c][pos[c]] = v;
+            pos[c] = (pos[c] + 1) % len[c];
+            s = d - v * 0.7f;
+        }
+        w[i] = s;
+        if (fabsf(s) > wpeak)
+            wpeak = fabsf(s);
+        if (i < n && fabsf(y[i]) > peak)
+            peak = fabsf(y[i]);
+    }
+    for (i = n; i < total; i++)
+        y[i] = 0;
+    if (wpeak > 0)
+        for (i = 0; i < total; i++)
+            y[i] += w[i] * (wet * peak / wpeak);
+    for (c = 0; c < 6; c++)
+        free(line[c]);
+    free(w);
+    // the tail ends where it falls 50 dB under the peak
+    peak = 0;
+    for (i = 0; i < total; i++)
+        if (fabsf(y[i]) > peak)
+            peak = fabsf(y[i]);
+    for (i = total; i > n && fabsf(y[i - 1]) < peak * 0.00316f; i--)
+        ;
+    return i;
+}
+
+// 28 samples after history s1, s2: the best of the five filters, each at its best shift (the decoder's
+// exact integer arithmetic, so the error never builds up from block to block). Returns the head byte.
+static int rbsEncodeBlock(const int *x, int *s1, int *s2, rbs_u8 *nibs)
+{
+    int f, best = -1, bestHead = 0, bs1 = 0, bs2 = 0;
+    long long bestErr = 0;
+    rbs_u8 bn[28];
+
+    for (f = 0; f < 5; f++) {
+        int k1 = rbsFilter[f][0], k2 = rbsFilter[f][1], p1 = *s1, p2 = *s2, peak = 0, i, shift, t;
+        for (i = 0; i < 28; i++) {
+            int r = x[i] - ((p1 * k1 + p2 * k2 + 32) >> 6);
+            if (abs(r) > peak)
+                peak = abs(r);
+            p2 = p1;
+            p1 = x[i];
+        }
+        shift = 12;
+        while (shift > 0 && peak > (7 << (12 - shift)))
+            shift--;
+        for (t = 0; t < 2; t++) {
+            int sh = t == 0 ? shift : (shift > 0 ? shift - 1 : -1), scale;
+            long long err = 0;
+            if (sh < 0)
+                continue;
+            scale = 1 << (12 - sh);
+            p1 = *s1;
+            p2 = *s2;
+            for (i = 0; i < 28; i++) {
+                int pred = (p1 * k1 + p2 * k2 + 32) >> 6, d = x[i] - pred, q, y;
+                q = d >= 0 ? (d + scale / 2) >> (12 - sh) : -((-d + scale / 2) >> (12 - sh)); // nearest step
+                q = q < -8 ? -8 : q > 7 ? 7 : q;
+                y = rbsClamp16(((q * 4096) >> sh) + pred);
+                err += (long long)(x[i] - y) * (x[i] - y);
+                bn[i] = q & 0xF;
+                p2 = p1;
+                p1 = y;
+            }
+            if (best < 0 || err < bestErr) {
+                best = f;
+                bestErr = err;
+                bestHead = f << 4 | sh;
+                bs1 = p1;
+                bs2 = p2;
+                memcpy(nibs, bn, 28);
+            }
+        }
+    }
+    *s1 = bs1;
+    *s2 = bs2;
+    return bestHead;
+}
+
+// samples (-1..1) -> audsrv's .adp: "APCM", version 1, one channel, no loop, the SPU2 pitch, the count;
+// then the blocks, the last one flagged, and the silent terminator OPL's own sounds carry. malloc'd.
+static rbs_u8 *rbsEncode(const float *y, int n, unsigned int pitch, float gain, int *outLen)
+{
+    int blocks = n / 28 + 1, b, i, s1 = 0, s2 = 0, head = 0, x[28];
+    rbs_u8 *out = malloc(16 + (blocks + 1) * 16), nibs[28], *p;
+
+    if (out == NULL)
+        return NULL;
+    memcpy(out, "APCM", 4);
+    out[4] = 1;
+    out[5] = 1;
+    out[6] = 0;
+    out[7] = 0;
+    for (i = 0; i < 4; i++) {
+        out[8 + i] = pitch >> (8 * i);
+        out[12 + i] = (unsigned int)n >> (8 * i);
+    }
+    p = out + 16;
+    for (b = 0; b < blocks; b++, p += 16) {
+        for (i = 0; i < 28; i++) {
+            int k = b * 28 + i;
+            x[i] = k < n ? rbsClamp16((int)lrintf(y[k] * gain * 32767.0f)) : 0;
+        }
+        head = rbsEncodeBlock(x, &s1, &s2, nibs);
+        p[0] = head;
+        p[1] = b == blocks - 1;
+        for (i = 0; i < 14; i++)
+            p[2 + i] = nibs[2 * i] | nibs[2 * i + 1] << 4;
+    }
+    p[0] = head;
+    p[1] = 7;
+    memset(p + 2, 0, 14);
+    *outLen = 16 + (blocks + 1) * 16;
+    return out;
+}
+
+// One browser sound as an event's .adp. NULL when the entry or its sample is not there.
+static rbs_u8 *rbsRender(const rbs_u8 *hd, int hdLen, const rbs_u8 *bd, int bdLen, int entry, int *outLen)
+{
+    unsigned int base, count, vl, vr, pitch, a1, a2, addr;
+    const rbs_u8 *e;
+    float *smp, *env, *y, vol, peak = 0;
+    int n, n48, i, rate, cap, len;
+    rbs_u8 *adp;
+
+    if (hdLen < 0x30 || (base = rbsLe32(hd + 0x2C)) + 8 > (unsigned int)hdLen)
+        return NULL;
+    count = rbsLe32(hd + base + 4);
+    if (entry >= (int)count || base + 0x20 + (entry + 1) * 0x40 > (unsigned int)hdLen)
+        return NULL;
+    e = hd + base + 0x20 + entry * 0x40;
+    vl = rbsLe16(e);
+    vr = rbsLe16(e + 2);
+    pitch = rbsLe16(e + 4);
+    a1 = rbsLe16(e + 8);
+    a2 = rbsLe16(e + 10);
+    addr = rbsLe32(e + 16);
+    if (pitch < 0x100 || pitch > 0x4000 || (smp = rbsAdpcm(bd, bdLen, addr, &n)) == NULL)
+        return NULL;
+    rate = (int)(pitch * 48000u / 4096u); // the sample's own rate: the file keeps it, at the same pitch
+    n48 = (int)((long long)n * 4096 / pitch) + 1;
+    cap = n + rate * 3 / 2 + rate / 50; // room for the hall's tail
+    env = malloc(sizeof(float) * n48);
+    y = malloc(sizeof(float) * cap);
+    if (env == NULL || y == NULL) {
+        free(env);
+        free(y);
+        free(smp);
+        return NULL;
+    }
+    rbsEnvelope(a1, a2, env, n48);
+    vol = (vl + vr) / 2.0f / 0x3FFF;
+    for (i = 0; i < n; i++) {
+        int t = (int)((long long)i * 4096 / pitch);
+        y[i] = smp[i] * env[t < n48 ? t : n48 - 1] * vol;
+    }
+    free(env);
+    free(smp);
+    len = rbsHall(y, n, cap, rate, 0.3f);
+    for (i = 0; i < len; i++)
+        if (fabsf(y[i]) > peak)
+            peak = fabsf(y[i]);
+    adp = rbsEncode(y, len, pitch, peak > 0 ? 0.75f / peak : 1.0f, outLen);
+    free(y);
+    return adp;
+}
+
+int ripps2BiosSoundsFromImage(const unsigned char *img, int size, ripps2_biossnd_put_t put, void *ctx)
+{
+    int ho, hl, bo, bl, hdLen, bdLen, i, done = 0;
+    rbs_u8 *hd, *bd;
+
+    if (ripps2RomdirFind(img, size, "SNDOSDDH", &ho, &hl) || ripps2RomdirFind(img, size, "SNDOSDDB", &bo, &bl))
+        return RIPPS2_BIOSSND_NO_BANK;
+    hd = rbsUnlz(img + ho, hl, &hdLen);
+    bd = rbsUnlz(img + bo, bl, &bdLen);
+    if (hd == NULL || bd == NULL) {
+        free(hd);
+        free(bd);
+        return RIPPS2_BIOSSND_BAD_BANK;
+    }
+    for (i = 0; i < RBS_EVENTS; i++) {
+        int len;
+        rbs_u8 *adp = rbsRender(hd, hdLen, bd, bdLen, rbsMap[i].entry, &len);
+        if (adp == NULL)
+            continue;
+        if (put(rbsMap[i].file, adp, len, ctx) == 0)
+            done++;
+        free(adp);
+    }
+    free(hd);
+    free(bd);
+    return done;
+}
+
+#ifndef RIPPS2_BIOSSND_HOST_TEST
+
+static int rbsWrite(const char *file, const unsigned char *adp, int size, void *ctx)
+{
+    char path[320];
+    FILE *f;
+    int ok;
+
+    snprintf(path, sizeof(path), "%s%s", (const char *)ctx, file);
+    if ((f = fopen(path, "wb")) == NULL)
+        return -1;
+    ok = (int)fwrite(adp, 1, size, f) == size;
+    fclose(f);
+    return ok ? 0 : -1;
+}
+
+// the BIOS's SNDIMAGE, malloc'd, through the IOP's rom0 device
+static unsigned char *rbsReadSndImage(int *size)
+{
+    int fd = open("rom0:SNDIMAGE", O_RDONLY), n, got = 0, r;
+    unsigned char *img;
+
+    if (fd < 0)
+        return NULL;
+    n = (int)lseek(fd, 0, SEEK_END);
+    lseek(fd, 0, SEEK_SET);
+    if (n <= 0 || n > 2 * 1024 * 1024 || (img = malloc(n)) == NULL) {
+        close(fd);
+        return NULL;
+    }
+    while (got < n && (r = read(fd, img + got, n - got)) > 0)
+        got += r;
+    close(fd);
+    if (got != n) {
+        free(img);
+        return NULL;
+    }
+    *size = n;
+    return img;
+}
+
+// Audio settings > BIOS Sounds > RIP: ask, rip into the AUDIO folder, load them, say what happened
+void ripps2RipBiosSoundsDialog(void)
+{
+    char base[256], dir[288], msg[512];
+    unsigned char *img;
+    int size = 0, n;
+
+    if (!ripps2AudioBase(base, sizeof(base) - 8, 0)) {
+        guiMsgBox("RIPPS2 cannot tell where its folder is, so there is nowhere to put the sounds.", 0, NULL);
+        return;
+    }
+    snprintf(dir, sizeof(dir), "%sAUDIO/", base);
+    snprintf(msg, sizeof(msg),
+             "RIPPS2 reads the menu sounds from this console's own BIOS and writes them to %s as its sounds: cursor, confirm, "
+             "cancel, pages, category, messages, disc, error, save, drives and random. Files of those names already there are "
+             "replaced. Boot and game launch stay as they are (they are the console's system music).",
+             dir);
+    guiMsgBoxStartOption("RIP");
+    if (guiMsgBox(msg, 0, NULL) != 2)
+        return;
+
+    if ((img = rbsReadSndImage(&size)) == NULL) {
+        guiMsgBox("This console's BIOS has no SNDIMAGE. Consoles from SCPH-30000 on carry one; the first models keep their "
+                  "sounds another way, which RIPPS2 does not read yet.",
+                  0, NULL);
+        return;
+    }
+    dir[strlen(dir) - 1] = '\0';
+    mkdir(dir, 0777);
+    strcat(dir, "/");
+    n = ripps2BiosSoundsFromImage(img, size, rbsWrite, dir);
+    free(img);
+    if (n <= 0) {
+        snprintf(msg, sizeof(msg), n == RIPPS2_BIOSSND_NO_BANK || n == RIPPS2_BIOSSND_BAD_BANK ?
+                                       "This BIOS's sound bank is not the one RIPPS2 knows. Nothing was written." :
+                                       "The sounds could not be written to %s. Is the drive full or write-protected?",
+                 dir);
+        guiMsgBox(msg, 0, NULL);
+        return;
+    }
+    sfxInit(0); // the new sounds, now
+    sfxPlay(SFX_CONFIRM);
+    snprintf(msg, sizeof(msg), "%d sounds from this console's BIOS are in %s and playing now.", n, dir);
+    guiMsgBox(msg, 0, NULL);
+}
+#endif
