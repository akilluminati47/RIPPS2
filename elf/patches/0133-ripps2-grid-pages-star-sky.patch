+// build 133 (the user, 11/02: "Adapt and ripgrid to use sky of theme choice instead of flat bg colors for smoother
+// transitions to storage"): Storage's sky at rest (no glow), in the Color Theme in effect, where a theme without
+// towers filled its bg_color
+void ripps2DrawRestSky(void)
+{
+    ripps2PaletteSync();
+    drawSky(RGBA(0x01, 0x02, 0x09, 0x80), RGBA(0x0B, 0x19, 0x4C, 0x80), RGBA(0x02, 0x04, 0x10, 0x80));
+}
+
+// build 133 ("create a vignette (rip it directly from the sky so it blends) for the upper and lower"): the same sky's
+// top colour fading down from the top edge and its floor colour fading up from the bottom, laid over a game's
+// background art on the list page so the art meets the bar and the hints the way the sky does
+void ripps2DrawSkyVignette(void)
+{
+    u64 top = RGBA(0x01, 0x02, 0x09, 0x70), topClear = RGBA(0x01, 0x02, 0x09, 0x00);
+    u64 floor = RGBA(0x02, 0x04, 0x10, 0x78), floorClear = RGBA(0x02, 0x04, 0x10, 0x00);
+    ripps2PaletteSync();
+    rmDrawQuadGouraud(0, 0, top, 640, 0, top, 0, 130, topClear, 640, 130, topClear);
+    rmDrawQuadGouraud(0, 330, floorClear, 640, 330, floorClear, 0, 480, floor, 640, 480, floor);
+}
+
