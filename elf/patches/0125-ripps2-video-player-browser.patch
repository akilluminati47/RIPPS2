+// ---- RIPPS2 build 125: recent games' settings, kept small ----
+// Each one is a single block: its path, then key and value after key and value, every string with its NUL (a game's
+// is about 0.5 to 2 KB this way; its config_set_t would be 300 bytes a key). At most CFG_CACHE_BYTES in all, the least
+// recently used given up first; a block bigger than an eighth of that is not kept.
+#define CFG_CACHE_BYTES (64 * 1024)
+#define CFG_CACHE_SLOTS 64
+
+typedef struct
+{
+    char *blob;
+    int len, format;
+    unsigned int stamp;
+} cfg_cache_t;
+
+static cfg_cache_t cfgCache[CFG_CACHE_SLOTS];
+static int cfgCacheBytes = 0, cfgCacheSema = -1;
+static unsigned int cfgCacheStamp = 0;
+
+static void cfgCacheDropAt(int i)
+{
+    free(cfgCache[i].blob);
+    cfgCacheBytes -= cfgCache[i].len;
+    memset(&cfgCache[i], 0, sizeof(cfgCache[i]));
+}
+
+static int cfgCacheFind(const char *path)
+{
+    int i;
+    for (i = 0; i < CFG_CACHE_SLOTS; i++)
+        if (cfgCache[i].blob != NULL && !strcmp(cfgCache[i].blob, path))
+            return i;
+    return -1;
+}
+
+int configCacheGet(const char *path, config_set_t *c)
+{
+    int i, ok = 0;
+
+    if (path == NULL || c == NULL || cfgCacheSema < 0)
+        return 0;
+    WaitSema(cfgCacheSema);
+    if ((i = cfgCacheFind(path)) >= 0) {
+        const char *p = cfgCache[i].blob + strlen(path) + 1, *end = cfgCache[i].blob + cfgCache[i].len;
+        ok = 1;
+        while (p < end) {
+            const char *v = p + strlen(p) + 1;
+            if (v >= end || !addConfigValue(c, p, v)) {
+                ok = 0;
+                break;
+            }
+            p = v + strlen(v) + 1;
+        }
+        c->format = cfgCache[i].format;
+        c->modified = 0;
+        cfgCache[i].stamp = ++cfgCacheStamp;
+    }
+    SignalSema(cfgCacheSema);
+    if (!ok) { // a part-filled set (out of memory) goes back empty, and the file is read as before
+        struct config_value_t *it = c->head;
+        while (it != NULL) {
+            struct config_value_t *next = it->next;
+            free(it);
+            it = next;
+        }
+        c->head = c->tail = NULL;
+    }
+    return ok;
+}
+
+void configCachePut(const config_set_t *c)
+{
+    struct config_value_t *it;
+    char *blob, *p;
+    int len, i, slot;
+
+    if (c == NULL || c->filename == NULL || cfgCacheSema < 0)
+        return;
+    len = strlen(c->filename) + 1;
+    for (it = c->head; it != NULL; it = it->next)
+        len += strlen(it->key) + 1 + strlen(it->val) + 1;
+    if (len > CFG_CACHE_BYTES / 8 || (blob = malloc(len)) == NULL)
+        return;
+    p = blob;
+    p += strlen(strcpy(p, c->filename)) + 1;
+    for (it = c->head; it != NULL; it = it->next) {
+        p += strlen(strcpy(p, it->key)) + 1;
+        p += strlen(strcpy(p, it->val)) + 1;
+    }
+    WaitSema(cfgCacheSema);
+    if ((i = cfgCacheFind(c->filename)) >= 0)
+        cfgCacheDropAt(i);
+    for (;;) { // room: a free slot and the bytes, the oldest given up until there is
+        int oldest = -1;
+        slot = -1;
+        for (i = 0; i < CFG_CACHE_SLOTS; i++) {
+            if (cfgCache[i].blob == NULL) {
+                if (slot < 0)
+                    slot = i;
+            } else if (oldest < 0 || cfgCache[i].stamp < cfgCache[oldest].stamp)
+                oldest = i;
+        }
+        if (slot >= 0 && cfgCacheBytes + len <= CFG_CACHE_BYTES)
+            break;
+        if (oldest < 0)
+            break;
+        cfgCacheDropAt(oldest);
+    }
+    if (slot >= 0 && cfgCacheBytes + len <= CFG_CACHE_BYTES) {
+        cfgCache[slot].blob = blob;
+        cfgCache[slot].len = len;
+        cfgCache[slot].format = c->format;
+        cfgCache[slot].stamp = ++cfgCacheStamp;
+        cfgCacheBytes += len;
+        blob = NULL;
+    }
+    SignalSema(cfgCacheSema);
+    free(blob);
+}
+
+void configCacheDrop(const char *path)
+{
+    int i;
+    if (path == NULL || cfgCacheSema < 0)
+        return;
+    WaitSema(cfgCacheSema);
+    if ((i = cfgCacheFind(path)) >= 0)
+        cfgCacheDropAt(i);
+    SignalSema(cfgCacheSema);
+}
+
+void configCacheClear(void)
+{
+    int i;
+    if (cfgCacheSema < 0)
+        return;
+    WaitSema(cfgCacheSema);
+    for (i = 0; i < CFG_CACHE_SLOTS; i++)
+        if (cfgCache[i].blob != NULL)
+            cfgCacheDropAt(i);
+    SignalSema(cfgCacheSema);
+}
