+static unsigned char *tbReadWhole(const char *path, int *len)
+{
+    int fd = open(path, O_RDONLY);
+    long long size;
+    unsigned char *b;
+
+    if (fd < 0)
+        return NULL;
+    size = lseek64(fd, 0, SEEK_END);
+    if (size <= 0 || size > TB_MAX_FILE || lseek64(fd, 0, SEEK_SET) != 0 || (b = malloc((int)size)) == NULL) {
+        close(fd);
+        return NULL;
+    }
+    if (!tmReadAll(fd, b, (int)size)) {
+        free(b);
+        close(fd);
+        return NULL;
+    }
+    close(fd);
+    *len = (int)size;
+    return b;
+}
