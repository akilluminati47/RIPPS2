+int ripps2TarAddFiles(const char *tar, const char *dir, char (*names)[128], int n, int *refused, char *report, int reportSize)
+{
+    char add[260], path[384], member[AP_NAME], msg[300];
+    const char *tars[2] = {tar, add};
+    unsigned char head[512], *data;
+    tm_plan_t p;
+    FILE *out;
+    int i, len, in = 0, r = -1;
+
+    *refused = 0;
+    report[0] = '\0';
+    if (snprintf(add, sizeof(add), "%s.add", tar) >= (int)sizeof(add) - 5 || (out = fopen(add, "wb")) == NULL) {
+        snprintf(report, reportSize, "%s", _t("COULD NOT WRITE"));
+        return -1;
+    }
+    for (i = 0; i < n; i++) {
+        snprintf(msg, sizeof(msg), _t("Getting it ready: %s"), names[i]);
+        guiRenderTextScreen(msg);
+        snprintf(path, sizeof(path), "%s%s", dir, names[i]);
+        data = NULL;
+        if (!tbReady(path, names[i], &data, &len, member, sizeof(member))) {
+            (*refused)++;
+            continue;
+        }
+        apHeader(head, member, (unsigned int)len, (unsigned int)time(NULL));
+        if (fwrite(head, 1, 512, out) != 512 || fwrite(data, 1, len, out) != (size_t)len || !apWriteZeros(out, (512 - len % 512) % 512)) {
+            free(data);
+            fclose(out);
+            remove(add);
+            snprintf(report, reportSize, "%s", _t("COULD NOT WRITE"));
+            return -1;
+        }
+        free(data);
+        in++;
+    }
+    if (!apWriteZeros(out, 1024) || fclose(out) != 0 || in == 0) {
+        remove(add);
+        snprintf(report, reportSize, "%s", in == 0 ? _t("NOTHING TO PUT IN") : _t("COULD NOT WRITE"));
+        return -1;
+    }
+    memset(&p, 0, sizeof(p));
+    if (tmScan(&p, tar, 0) < 0 || tmScan(&p, add, 1) < 0 || !tmPlan(&p))
+        snprintf(report, reportSize, "%s", _t("NOT A .TAR"));
+    else if ((r = tbCommit(&p, tars, tar)) == 1) {
+        if (p.same > 0)
+            snprintf(report, reportSize, _t("%d IN, %d REPLACED"), in, p.same);
+        else
+            snprintf(report, reportSize, _t("%d IN"), in);
+    } else
+        snprintf(report, reportSize, "%s", _t("NOTHING CHANGED"));
+    tmFree(&p);
+    remove(add);
+    return r == 1 ? in : -1;
+}
+
+int ripps2TarRemove(const char *tar, char (*names)[128], int n)
+{
+    const char *tars[2] = {tar, tar};
+    tm_plan_t p;
+    int i, k, gone = 0, r = -1;
+
+    memset(&p, 0, sizeof(p));
+    if (tmScan(&p, tar, 0) < 0) {
+        tmFree(&p);
+        return -1;
+    }
+    for (i = 0; i < p.count; i++)
+        for (k = 0; k < n && p.m[i].drop != 2; k++)
+            if (!strcasecmp(tbBase(p.m[i].name), names[k])) {
+                p.m[i].drop = 1;
+                gone++;
+                break;
+            }
+    if (gone > 0 && tmPlan(&p))
+        r = tbCommit(&p, tars, tar);
+    tmFree(&p);
+    return r == 1 ? gone : -1;
+}
