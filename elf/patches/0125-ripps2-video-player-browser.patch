+// ---------------------------------------------------------------- build 125: a .tar as a folder
+// The user, 10/29: a .tar shows in Memory Files as a blue folder. Opened, it lists what it holds. Files pasted into it go
+// in through the merge above (a member of the same name is replaced), pictures made ready first: PNG and JPG as they
+// are (RIPPS2 reads both) unless bigger than 512 on a side (shrunk to fit, written as a full-colour PNG), a BMP made a
+// PNG, any other kind of picture refused (nothing would read it); other files (a CFG pack's .cfg) as they are. Copied
+// out, a member is written as a file; deleted, the archive is written again without it. Every change is the merge's own
+// write: beside the archive, swapped in only once it is whole.
+
+#define TB_MAX_FILE (16 * 1024 * 1024)
+#define TB_ART_SIDE 512 // what the art loader keeps of a picture: anything bigger is shrunk at every load
+
+static const char *tbBase(const char *name)
+{
+    const char *b = strrchr(name, '/');
+    return b != NULL ? b + 1 : name;
+}
+
+int ripps2TarList(const char *tar, ripps2_tar_entry_t *out, int max)
+{
+    tm_plan_t p;
+    int i, n = 0;
+
+    memset(&p, 0, sizeof(p));
+    if (tmScan(&p, tar, 0) < 0) {
+        tmFree(&p);
+        return -1;
+    }
+    for (i = 0; i < p.count && n < max; i++) {
+        if (p.m[i].drop == 2)
+            continue;
+        snprintf(out[n].name, sizeof(out[n].name), "%s", tbBase(p.m[i].name));
+        out[n].size = p.m[i].size;
+        n++;
+    }
+    tmFree(&p);
+    return n;
+}
+
+int ripps2TarExtract(const char *tar, const char *member, const char *dst)
+{
+    tm_plan_t p;
+    unsigned char *buf = NULL;
+    unsigned int left;
+    int i, fd = -1, out = -1, ok = 0;
+
+    memset(&p, 0, sizeof(p));
+    if (tmScan(&p, tar, 0) < 0)
+        goto done;
+    for (i = 0; i < p.count; i++)
+        if (p.m[i].drop != 2 && !strcasecmp(tbBase(p.m[i].name), member))
+            break;
+    if (i == p.count || (buf = malloc(TM_CHUNK)) == NULL || (fd = open(tar, O_RDONLY)) < 0)
+        goto done;
+    if (lseek64(fd, p.m[i].head + 512, SEEK_SET) != (long long)(p.m[i].head + 512) ||
+        (out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0)
+        goto done;
+    for (left = p.m[i].size; left > 0;) {
+        int k = left > TM_CHUNK ? TM_CHUNK : (int)left;
+        if (!tmReadAll(fd, buf, k) || write(out, buf, k) != k)
+            break;
+        left -= k;
+    }
+    ok = left == 0;
+done:
+    if (out >= 0) {
+        close(out);
+        if (!ok)
+            remove(dst);
+    }
+    if (fd >= 0)
+        close(fd);
+    free(buf);
+    tmFree(&p);
+    return ok;
+}
+
+// the plan written beside target and swapped in, its index beside it, the art engine told: tmRun's steps without its
+// questions. 1 done; else tmRun's codes (0 stopped, -1 not written, -2 read short, -3 / -4 a rename)
+static int tbCommit(tm_plan_t *p, const char *const tars[2], const char *target)
+{
+    char tmp[260], old[260];
+    int r, wasTar = gEnableArtTar;
+
+    snprintf(tmp, sizeof(tmp), "%s.tmp", target);
+    gEnableArtTar = 0;
+    tarInvalidate(TAR_KIND_ART);
+    ioBlockOps(1);
+    tmBegan = clock();
+    tmShown = target;
+    if (!ioWriteBegin())
+        r = -1;
+    else {
+        r = tmWrite(p, tars, tmp, tmProgress);
+        if (r == 1) {
+            r = tmSwap(target, tmp, old, sizeof(old));
+            if (r == 1)
+                tmWriteIndex(p, target);
+            else
+                r = r == -1 ? -3 : -4;
+        }
+        ioWriteEnd();
+    }
+    ioBlockOps(0);
+    if (r == 1 && apSamePath(gRipps2ArtPack, target)) {
+        gRipps2ArtPackCount = p->out;
+        gRipps2ArtPackKb = (int)(p->outBytes >> 10);
+    }
+    gEnableArtTar = wasTar;
+    ripps2ArtPackApplySettings();
+    tarInvalidate(TAR_KIND_ART);
+    tarInvalidate(TAR_KIND_CFG); // a cfg.tar changed here is read again, and the settings cached from it forgotten
+    artIndexInvalidate();
+    cacheInvalidateFailMemo();
+    configCacheClear();
+    return r;
+}
