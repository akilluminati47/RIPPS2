+static int tbHasExt(const char *name, const char *ext)
+{
+    const char *dot = strrchr(name, '.');
+    return dot != NULL && !strcasecmp(dot + 1, ext);
+}
+
+static unsigned int tbLe(const unsigned char *b, int n)
+{
+    unsigned int v = 0;
+    while (n-- > 0)
+        v = (v << 8) | b[n];
+    return v;
+}
+
+// a BMP of 24 or 32 bits, not compressed: RGBA with the GS's alpha (opaque), memalign'd; NULL for any other
+static unsigned char *tbBmp(const unsigned char *b, int len, int *w, int *h)
+{
+    int off, W, H, bpp, comp, flip = 1, stride, x, y;
+    unsigned char *out;
+
+    if (len < 54 || b[0] != 'B' || b[1] != 'M')
+        return NULL;
+    off = (int)tbLe(b + 10, 4);
+    W = (int)tbLe(b + 18, 4);
+    H = (int)tbLe(b + 22, 4);
+    bpp = (int)tbLe(b + 28, 2);
+    comp = (int)tbLe(b + 30, 4);
+    if (H < 0) {
+        H = -H;
+        flip = 0;
+    }
+    if (W <= 0 || H <= 0 || W > 4096 || H > 4096 || (bpp != 24 && bpp != 32) || (comp != 0 && comp != 3))
+        return NULL;
+    stride = (W * (bpp / 8) + 3) & ~3;
+    if (off < 54 || (long long)off + (long long)stride * H > len || (out = memalign(64, W * H * 4)) == NULL)
+        return NULL;
+    for (y = 0; y < H; y++) {
+        const unsigned char *row = b + off + (flip ? H - 1 - y : y) * stride;
+        unsigned char *d = out + y * W * 4;
+        for (x = 0; x < W; x++, row += bpp / 8, d += 4) {
+            d[0] = row[2];
+            d[1] = row[1];
+            d[2] = row[0];
+            d[3] = 0x80;
+        }
+    }
+    *w = W;
+    *h = H;
+    return out;
+}
+
+// at most side on a side, each pixel the average of those it covers (the picture itself when it fits)
+static unsigned char *tbShrink(unsigned char *src, int w, int h, int side, int *nw, int *nh)
+{
+    unsigned char *out;
+    int W, H, x, y;
+
+    if (w <= side && h <= side) {
+        *nw = w;
+        *nh = h;
+        return src;
+    }
+    W = w >= h ? side : w * side / h;
+    H = w >= h ? h * side / w : side;
+    if (W < 1)
+        W = 1;
+    if (H < 1)
+        H = 1;
+    if ((out = memalign(64, W * H * 4)) == NULL)
+        return NULL;
+    for (y = 0; y < H; y++)
+        for (x = 0; x < W; x++) {
+            int x0 = x * w / W, x1 = (x + 1) * w / W, y0 = y * h / H, y1 = (y + 1) * h / H, s[4] = {0, 0, 0, 0}, n = 0, u, v, c;
+            for (v = y0; v < y1; v++)
+                for (u = x0; u < x1; u++, n++)
+                    for (c = 0; c < 4; c++)
+                        s[c] += src[(v * w + u) * 4 + c];
+            for (c = 0; c < 4; c++)
+                out[(y * W + x) * 4 + c] = (unsigned char)(s[c] / (n > 0 ? n : 1));
+        }
+    *nw = W;
+    *nh = H;
+    return out;
+}
+
+typedef struct
+{
+    unsigned char *b;
+    int n, cap;
+} tb_mem_t;
+
+static void tbPngWrite(png_structp png, png_bytep d, png_size_t len)
+{
+    tb_mem_t *m = (tb_mem_t *)png_get_io_ptr(png);
+    if (m->n + (int)len > m->cap) {
+        int cap = (m->n + (int)len) * 2;
+        unsigned char *nb = realloc(m->b, cap);
+        if (nb == NULL)
+            png_error(png, "out of memory");
+        m->b = nb;
+        m->cap = cap;
+    }
+    memcpy(m->b + m->n, d, len);
+    m->n += (int)len;
+}
+
+static void tbPngFlush(png_structp png)
+{
+    (void)png;
+}
+
+// RGBA with the GS's alpha as a PNG in memory (RGB when every pixel is opaque); NULL on a failure
+static unsigned char *tbPng(const unsigned char *rgba, int w, int h, int *len)
+{
+    png_structp png;
+    png_infop info = NULL;
+    tb_mem_t m = {NULL, 0, 0};
+    unsigned char *row;
+    int x, y, alpha = 0;
+
+    for (x = 0; x < w * h && !alpha; x++)
+        alpha = rgba[x * 4 + 3] < 0x80;
+    if ((png = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL)) == NULL)
+        return NULL;
+    info = png_create_info_struct(png);
+    row = malloc(w * 4);
+    if (info == NULL || row == NULL || setjmp(png_jmpbuf(png))) {
+        png_destroy_write_struct(&png, &info);
+        free(row);
+        free(m.b);
+        return NULL;
+    }
+    png_set_write_fn(png, &m, tbPngWrite, tbPngFlush);
+    png_set_IHDR(png, info, w, h, 8, alpha ? PNG_COLOR_TYPE_RGB_ALPHA : PNG_COLOR_TYPE_RGB, PNG_INTERLACE_NONE,
+                 PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
+    png_write_info(png, info);
+    for (y = 0; y < h; y++) {
+        const unsigned char *s = rgba + y * w * 4;
+        unsigned char *d = row;
+        for (x = 0; x < w; x++, s += 4) {
+            *d++ = s[0];
+            *d++ = s[1];
+            *d++ = s[2];
+            if (alpha)
+                *d++ = s[3] >= 0x80 ? 0xFF : (unsigned char)(s[3] * 2);
+        }
+        png_write_row(png, row);
+    }
+    png_write_end(png, NULL);
+    png_destroy_write_struct(&png, &info);
+    free(row);
+    *len = m.n;
+    return m.b;
+}
+
+// one file of the paste as it goes in: its bytes (the file's own, or a PNG made of it) and its name in the .tar. 1 ready,
+// 0 refused (a picture nothing would read, or a file that could not be read)
+static int tbReady(const char *path, const char *name, unsigned char **data, int *len, char *member, int memberSize)
+{
+    static const char *const unread[] = {"gif", "webp", "tga", "tif", "tiff", "ico", "heic", "avif", "psd", NULL};
+    unsigned char *raw, *rgba = NULL, *fit;
+    int rawLen = 0, w = 0, h = 0, ow = 0, oh = 0, fw, fh, i;
+    const char *dot = strrchr(name, '.');
+
+    for (i = 0; unread[i] != NULL; i++)
+        if (tbHasExt(name, unread[i]))
+            return 0;
+    if ((raw = tbReadWhole(path, &rawLen)) == NULL)
+        return 0;
+    snprintf(member, memberSize, "%s", name);
+    if (tbHasExt(name, "bmp"))
+        rgba = tbBmp(raw, rawLen, &w, &h);
+    else if (apIsPicture(name)) {
+        if (!ripps2DecodePicture(raw, rawLen, TB_ART_SIDE, TB_ART_SIDE, &rgba, &w, &h, &ow, &oh, NULL)) {
+            free(raw);
+            return 0;
+        }
+        if (ow <= TB_ART_SIDE && oh <= TB_ART_SIDE) { // it fits: in as it is
+            free(rgba);
+            *data = raw;
+            *len = rawLen;
+            return 1;
+        }
+    } else { // not a picture: in as it is
+        *data = raw;
+        *len = rawLen;
+        return 1;
+    }
+    free(raw);
+    if (rgba == NULL)
+        return 0;
+    fit = tbShrink(rgba, w, h, TB_ART_SIDE, &fw, &fh);
+    *data = fit != NULL ? tbPng(fit, fw, fh, len) : NULL;
+    if (fit != rgba)
+        free(fit);
+    free(rgba);
+    if (*data == NULL)
+        return 0;
+    if (dot != NULL && (int)(dot - name) + 5 < memberSize) // the same name, as a .png
+        snprintf(member + (dot - name), memberSize - (dot - name), ".png");
+    return 1;
+}
