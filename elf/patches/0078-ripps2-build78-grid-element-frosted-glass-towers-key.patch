+// Grid (RIPPS2 build 78) ////////////////////////////////////////////////////////////////////////////////////////////////
+//
+// The game list as a page of covers: <name>_columns across (default 4), <name>_rows down (default 2),
+// <name>_spacing pixels between them (default 14). x is the grid's horizontal centre (POS_MID by
+// default), y the top of its first row, width/height one cover; overlay=, default= and reflection=
+// work as on ItemCover. The selection is the cover drawn larger, framed, and last; the page scrolls by
+// whole rows to keep it in view. Left/Right step one cover, Up/Down one row, and past the top or
+// bottom row they switch drive (menusys.c, menuGridStep).
+
+static int gridTop;              // the first row shown
+static const void *gridTopMenu;  // ... for this menu
+
+int thmGridColumns(void)
+{
+    return (gTheme != NULL && gTheme->grid != NULL) ? gTheme->gridColumns : 0;
+}
+
+static void drawGridCover(struct menu_list *menu, struct submenu_list *it, struct theme_element *elem, item_list_t *src,
+                          int cx, int cy, int w, int h, int selected)
+{
+    theme_element_t *coverElem = thmGetElemForItem(menu, it, elem);
+    mutable_image_t *img = (mutable_image_t *)coverElem->extended;
+    GSTEXTURE *texture;
+
+    if (img == NULL)
+        return;
+    texture = getGameImageTextureEx(img->cache, src, &it->item, selected);
+    if (texture == NULL || texture->Mem == NULL)
+        texture = img->defaultTexture ? &img->defaultTexture->source : thmGetTexture(COVER_DEFAULT);
+    if (texture == NULL || texture->Mem == NULL)
+        return;
+    u64 col = selected ? gDefaultCol : GS_SETREG_RGBA(0x70, 0x70, 0x70, 0x80); // the others a step back
+    if (img->overlayTexture) {
+        image_texture_t *ov = img->overlayTexture;
+        int csw = coverElem->width > 0 ? coverElem->width : 1, csh = coverElem->height > 0 ? coverElem->height : 1;
+        rmDrawOverlayPixmap(&ov->source, cx, cy, ALIGN_CENTER, w, h, SCALING_RATIO, col, texture,
+                            ov->upperLeft_x * w / csw, ov->upperLeft_y * h / csh, ov->upperRight_x * w / csw, ov->upperRight_y * h / csh,
+                            ov->lowerLeft_x * w / csw, ov->lowerLeft_y * h / csh, ov->lowerRight_x * w / csw, ov->lowerRight_y * h / csh, elem->reflection);
+    } else
+        rmDrawPixmap(texture, cx, cy, ALIGN_CENTER, w, h, SCALING_RATIO, col, elem->reflection && selected);
+}
+
+static void drawGrid(struct menu_list *menu, struct submenu_list *item, config_set_t *config, struct theme_element *elem)
+{
+    struct submenu_list *p, *first;
+    int cols = gTheme->gridColumns, rows = gTheme->gridRows, gap = gTheme->gridSpacing;
+    int cur = 0, i, k, w = elem->width, h = elem->height;
+
+    if (item == NULL || elem->extended == NULL || cols < 1 || rows < 1 || w <= 0 || h <= 0)
+        return;
+    item_list_t *src = (item_list_t *)thmGetItemSource(menu, item);
+    for (p = menu->item->submenu; p != NULL && p != item; p = p->next)
+        cur++;
+    if (p == NULL)
+        return;
+
+    // the page keeps the selection's row in view, moving by whole rows
+    if (gridTopMenu != menu) {
+        gridTopMenu = menu;
+        gridTop = 0;
+    }
+    if (cur / cols < gridTop)
+        gridTop = cur / cols;
+    else if (cur / cols >= gridTop + rows)
+        gridTop = cur / cols - rows + 1;
+    for (first = menu->item->submenu, i = 0; first != NULL && i < gridTop * cols; i++)
+        first = first->next;
+
+    int cellW = rmWideScale(w), stepX = cellW + gap, stepY = h + gap;
+    int left = elem->posX - (cols * stepX - gap) / 2 + cellW / 2;
+    int top = elem->posY + h / 2;
+    int selX = 0, selY = 0;
+
+    // the selection's art is asked for first (priority), so a cold page fills from the cover in focus
+    for (p = first, k = 0; p != NULL && k < cols * rows; p = p->next, k++) {
+        if (p == item) {
+            selX = left + (k % cols) * stepX;
+            selY = top + (k / cols) * stepY;
+            continue;
+        }
+        if (!p->item.isFolder)
+            drawGridCover(menu, p, elem, src, left + (k % cols) * stepX, top + (k / cols) * stepY, w, h, 0);
+    }
+    if (!item->item.isFolder && selX) {
+        int sw = w * 112 / 100, sh = h * 112 / 100, fw = rmWideScale(sw) + 6, fh = sh + 6;
+        u64 frame = gTheme->selTextColor;
+        rmDrawRect(selX - fw / 2, selY - fh / 2, fw, 2, frame);
+        rmDrawRect(selX - fw / 2, selY + fh / 2 - 2, fw, 2, frame);
+        rmDrawRect(selX - fw / 2, selY - fh / 2, 2, fh, frame);
+        rmDrawRect(selX + fw / 2 - 2, selY - fh / 2, 2, fh, frame);
+        drawGridCover(menu, item, elem, src, selX, selY, sw, sh, 1);
+    }
+}
+
+static void initGrid(const char *themePath, config_set_t *themeConfig, theme_t *theme, theme_element_t *elem, const char *name)
+{
+    char key[64];
+    int cols = 4, rows = 2, gap = 14;
+
+    snprintf(key, sizeof(key), "%s_columns", name);
+    configGetInt(themeConfig, key, &cols);
+    snprintf(key, sizeof(key), "%s_rows", name);
+    configGetInt(themeConfig, key, &rows);
+    snprintf(key, sizeof(key), "%s_spacing", name);
+    configGetInt(themeConfig, key, &gap);
+    if (cols < 1 || cols > 8)
+        cols = 4;
+    if (rows < 1 || rows > 4)
+        rows = 2;
+    if (gap < 0 || gap > 64)
+        gap = 14;
+
+    // enough cache slots for a page and the row after it
+    int slots = cols * rows + cols;
+    if (slots < COVER_CACHE_SLOTS)
+        slots = COVER_CACHE_SLOTS;
+    mutable_image_t *mutableImage = initMutableImage(themePath, themeConfig, theme, name, elem->type, "COV", slots, NULL, NULL);
+    elem->extended = mutableImage;
+    elem->endElem = &endMutableImage;
+
+    if (mutableImage && mutableImage->cache) {
