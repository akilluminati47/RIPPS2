+// ---- frosted glass (build 78) ----
+// A blur panel shows what is behind it softened. The GS cannot blur live at no cost, but a theme's
+// backdrop is a still image: at load it is shrunk to 80x60 (box average, then a 3x3 soften) and the
+// panel draws its own part of that, stretched with bilinear filtering -- frosted glass for one quad.
+#define FROST_W 80
+#define FROST_H 60
+
+static void frostTexel(const GSTEXTURE *t, int x, int y, int *r, int *g, int *b)
+{
+    const unsigned char *m = (const unsigned char *)t->Mem, *c;
+    int i;
+    switch (t->PSM) {
+        case GS_PSM_CT32:
+            c = m + (y * t->Width + x) * 4;
+            break;
+        case GS_PSM_CT24:
+            c = m + (y * t->Width + x) * 3;
+            break;
+        case GS_PSM_T8:
+            i = m[y * t->Width + x];
+            i = (i & 0x18) == 8 ? i + 8 : (i & 0x18) == 0x10 ? i - 8 : i; // the loader's CSM1 swizzle
+            c = (const unsigned char *)t->Clut + i * 4;
+            break;
+        case GS_PSM_T4:
+            i = m[(y * t->Width + x) / 2];
+            i = (x & 1) ? i >> 4 : i & 0x0F;
+            c = (const unsigned char *)t->Clut + i * 4;
+            break;
+        default:
+            *r = *g = *b = 0;
+            return;
+    }
+    *r = c[0];
+    *g = c[1];
+    *b = c[2];
+}
+
+int ripps2MakeFrost(const GSTEXTURE *src, GSTEXTURE *dst)
+{
+    static unsigned char tmp[FROST_W * FROST_H * 3];
+    int x, y, sx, sy;
+
+    memset(dst, 0, sizeof(*dst));
+    if (src == NULL || src->Mem == NULL || src->Width < FROST_W || src->Height < FROST_H ||
+        ((src->PSM == GS_PSM_T8 || src->PSM == GS_PSM_T4) && src->Clut == NULL))
+        return 0;
+    int bw = src->Width / FROST_W, bh = src->Height / FROST_H, step = bw > 2 ? bw / 2 : 1;
+    for (y = 0; y < FROST_H; y++)
+        for (x = 0; x < FROST_W; x++) {
+            int r = 0, g = 0, b = 0, n = 0, cr, cg, cb;
+            for (sy = 0; sy < bh; sy += step)
+                for (sx = 0; sx < bw; sx += step, n++) {
+                    frostTexel(src, x * bw + sx, y * bh + sy, &cr, &cg, &cb);
+                    r += cr;
+                    g += cg;
+                    b += cb;
+                }
+            unsigned char *o = tmp + (y * FROST_W + x) * 3;
+            o[0] = r / n;
+            o[1] = g / n;
+            o[2] = b / n;
+        }
+    dst->Width = FROST_W;
+    dst->Height = FROST_H;
+    dst->PSM = GS_PSM_CT32;
+    dst->Filter = GS_FILTER_LINEAR;
+    dst->Mem = memalign(128, FROST_W * FROST_H * 4);
+    if (dst->Mem == NULL)
+        return 0;
+    for (y = 0; y < FROST_H; y++) // 3x3 soften, so the stretched copy shows no blocks
+        for (x = 0; x < FROST_W; x++) {
+            int r = 0, g = 0, b = 0, n = 0, dx, dy;
+            for (dy = -1; dy <= 1; dy++)
+                for (dx = -1; dx <= 1; dx++) {
+                    int xx = x + dx, yy = y + dy;
+                    if (xx < 0 || yy < 0 || xx >= FROST_W || yy >= FROST_H)
+                        continue;
+                    const unsigned char *c = tmp + (yy * FROST_W + xx) * 3;
+                    r += c[0];
+                    g += c[1];
+                    b += c[2];
+                    n++;
+                }
+            unsigned char *o = (unsigned char *)dst->Mem + (y * FROST_W + x) * 4;
+            o[0] = r / n;
+            o[1] = g / n;
+            o[2] = b / n;
+            o[3] = 0x80;
+        }
+    return 1;
+}
+
+void ripps2DrawFrost(GSTEXTURE *frost, int x, int y, int w, int h)
+{
+    if (frost == NULL || frost->Mem == NULL || w <= 0 || h <= 0)
+        return;
+    float u0 = (float)x * FROST_W / 640.0f, v0 = (float)y * FROST_H / 480.0f;
+    float u1 = (float)(x + w) * FROST_W / 640.0f, v1 = (float)(y + h) * FROST_H / 480.0f;
+    rmDrawPixmapPart(frost, x, y, ALIGN_NONE, w, h, SCALING_NONE, gDefaultCol, u0, v0, u1, v1);
+}
