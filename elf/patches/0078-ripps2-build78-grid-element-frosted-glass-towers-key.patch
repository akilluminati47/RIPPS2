+static GSTEXTURE *getGameImageCached(image_cache_t *cache, struct submenu_item *item);
+
+// RIPPS2 build 78: the frosted copy of what is behind a blur panel -- its family's Background, the
+// game's own background art once it is loaded, else the theme's default -- made again only when that
+// texture or the game changes
+static GSTEXTURE *thmFrostFor(struct submenu_list *item, struct theme_element *glass)
+{
+    int slot = glass->family == &gTheme->mainElems ? 0 : 1;
+    GSTEXTURE *src = NULL;
+    theme_element_t *e;
+
+    for (e = glass->family->first; e != NULL && e != glass; e = e->next) {
+        if (e->type != ELEM_TYPE_BACKGROUND || e->extended == NULL)
+            continue;
+        mutable_image_t *mi = (mutable_image_t *)e->extended;
+        src = (mi->cache != NULL && item != NULL && !item->item.isFolder) ? getGameImageCached(mi->cache, &item->item) : NULL;
+        if ((src == NULL || src->Mem == NULL) && mi->defaultTexture != NULL)
+            src = &mi->defaultTexture->source;
+    }
+    if (src == NULL || src->Mem == NULL)
+        return NULL;
+    if (gTheme->frostKey[slot][0] != src->Mem || gTheme->frostKey[slot][1] != item) {
+        if (gTheme->frost[slot].Mem != NULL) {
+            rmUnloadTexture(&gTheme->frost[slot]);
+            texFree(&gTheme->frost[slot]);
+        }
+        ripps2MakeFrost(src, &gTheme->frost[slot]);
+        gTheme->frostKey[slot][0] = src->Mem;
+        gTheme->frostKey[slot][1] = item;
+    }
+    return gTheme->frost[slot].Mem != NULL ? &gTheme->frost[slot] : NULL;
+}
