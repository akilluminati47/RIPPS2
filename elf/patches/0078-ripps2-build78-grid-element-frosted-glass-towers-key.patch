+// RIPPS2 build 78: a Grid theme moves in two dimensions. Left/Right step one cover; Up/Down one row
+// (a whole row of steps, so the list's own paging still follows); past the top or bottom row they
+// switch drive, as Up/Down do on Coverflow. A short last row is reached by its last cover.
+static void menuGridStep(int dir)
+{
+    int cols = thmGridColumns(), cur = 0, count = 0, i;
+    submenu_list_t *p;
+
+    for (p = selected_item->item->submenu; p != NULL; p = p->next, count++)
+        if (p == selected_item->item->current)
+            cur = count;
+    if (dir < 0 && cur < cols) {
+        if (getKeyOn(KEY_UP)) // a held arrow stops at the edge; a new press changes drive
+            menuDriveStep(-1);
+        return;
+    }
+    if (dir > 0 && cur / cols == (count - 1) / cols) {
+        if (getKeyOn(KEY_DOWN))
+            menuDriveStep(1);
+        return;
+    }
+    int target = cur + dir * cols;
+    if (target > count - 1)
+        target = count - 1;
+    for (i = cur; i < target; i++)
+        menuNextV();
+    for (i = cur; i > target; i--)
+        menuPrevV();
+}
