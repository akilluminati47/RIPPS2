@@ -61,6 +61,7 @@ harness = r'''
 typedef struct { char arg[NEUTRINO_VMC_SLOTS][160]; } neutrino_vmc_args_t;
 
 static char gNeutrinoArgs[256];
+static char sysNeutrinoCheatArg[24], sysNeutrinoCheatStartup[32]; /* set by sysNeutrinoHandCheats */
