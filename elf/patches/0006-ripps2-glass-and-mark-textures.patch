--- a/include/textures.h
+++ b/include/textures.h
@@ -120,6 +120,8 @@ enum INTERNAL_TEXTURE {
     UDPFS_ICON,
     L1_ICON, // Settings peer-page navigation hint
     R1_ICON, // Settings peer-page navigation hint
+    RIPPS2_GLASS, // RIPPS2: glass info panel (theme name "ripps2_glass")
+    RIPPS2_MARK,  // RIPPS2: PS2 selector mark (theme name "ripps2_mark")
 #ifdef RETROACHIEVEMENTS
     // RA mark over a tracked game's cover (theme override "ra_mark"). Appended last:
     // texId is positional.
diff --git a/src/textures.c b/src/textures.c
index c05f5dc..fd850da 100644
--- a/src/textures.c
