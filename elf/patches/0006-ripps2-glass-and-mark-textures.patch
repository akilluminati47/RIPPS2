 // Not related to screen size, just to limit at some point
@@ -273,6 +275,8 @@ static texture_t internalDefault[TEXTURES_COUNT] = {
     {UDPFS_ICON, "udp_fs", &udp_fs_png},
     {L1_ICON, "L1", &L1_png},
     {R1_ICON, "R1", &R1_png},
