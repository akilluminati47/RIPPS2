diff --git a/Makefile b/Makefile
index 36c3264..2b6730b 100644
--- a/Makefile
+++ b/Makefile
@@ -163,6 +163,9 @@ PNG_ASSETS = load0 load1 load2 load3 load4 load5 load6 load7 usb usb_bd ilk_bd \
 	Index_0 Index_1 Index_2 Index_3 Index_4 fav fav_mark R3 L3 L1 R1 PS1 PS2 case_overlay
