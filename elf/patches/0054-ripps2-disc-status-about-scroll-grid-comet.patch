+// A soft additive point of light (the orbs' motes are drawn the same way)
+static void fbGlowDot(float x, float y, float rad, int a)
+{
+    int k;
+    float px = x + rad, py = y;
+    u64 centre = FB_PRIM(0xB4, 0xD2, 0xFF, a), rim = FB_PRIM(0xB4, 0xD2, 0xFF, 0);
+    for (k = 1; k <= 8; k++) {
+        float ang = 6.2832f * k / 8, nx = x + cosf(ang) * rad, ny = y + sinf(ang) * rad;
+        rmDrawTriGouraud(x, y, centre, px, py, rim, nx, ny, rim);
+        px = nx;
+        py = ny;
+    }
+}
