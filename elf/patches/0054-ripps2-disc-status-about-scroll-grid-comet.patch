 // ---- LAUNCH DISC ----
+//
+// What is in the drive, under START DISC: asked on the IO worker about once a second while the page is
+// up (the drive's own disc type, which costs nothing), and only when that changes is the disc read for
+// its ID, and the ID looked up in the metadata database for a title. Nothing here ever waits on the drive.
+
+static volatile int discPollBusy = 0;
+static clock_t discPolledAt = 0;
+static int discLastType = -1;
+static char discLine[80] = ""; // "" = the drive is empty: say what to insert
+
+// A PS2 disc's title from the metadata database (OPL's home first, then the first USB drive)
+static void discTitle(const char *id, char *out, int size)
+{
+    const char *prefixes[2] = {configGetHomePath(), "mass0:/"}, *v = NULL;
+    int i;
+    out[0] = '\0';
+    for (i = 0; i < 2 && !out[0]; i++) {
+        config_set_t *c;
+        if (prefixes[i] == NULL || prefixes[i][0] == '\0' || (c = configAlloc(0, NULL, NULL)) == NULL)
+            continue;
+        metaDbMerge(c, prefixes[i], "/", id);
+        if (metaDbGetStr(c, "Title", &v) && v != NULL)
+            snprintf(out, size, "%s", v);
+        configFree(c);
+    }
+}
+
+static void discPollWorker(void)
+{
+    char line[80] = "", path[64], id[16], title[48];
+    int type = sceCdGetDiskType(), fd, i;
+
+    if (type == discLastType) {
+        discPollBusy = 0;
+        return;
+    }
+    switch (type) {
+        case SCECdNODISC:
+            break;
+        case SCECdDETCT:
+        case SCECdDETCTCD:
+        case SCECdDETCTDVDS:
+        case SCECdDETCTDVDD:
+            snprintf(line, sizeof(line), "READING THE DISC");
+            type = -1; // ask again until it settles
+            break;
+        case SCECdPSCD:
+        case SCECdPSCDDA:
+            snprintf(line, sizeof(line), "PS1 GAME");
+            break;
+        case SCECdPS2CD:
+        case SCECdPS2CDDA:
+        case SCECdPS2DVD:
+            snprintf(line, sizeof(line), "PS2 GAME");
+            if (sysGetDiscBootPath(path, sizeof(path), NULL) == 0) {
+                const char *s = strrchr(path, '\\');
+                s = s ? s + 1 : path;
+                for (i = 0; s[i] && s[i] != ';' && i < (int)sizeof(id) - 1; i++)
+                    id[i] = s[i];
+                id[i] = '\0';
+                discTitle(id, title, sizeof(title));
+                if (title[0])
+                    snprintf(line, sizeof(line), "PS2 GAME   %s   %s", id, title);
+                else
+                    snprintf(line, sizeof(line), "PS2 GAME   %s", id);
+            }
+            break;
+        case SCECdDVDV:
+            // an ESR-patched game reads as DVD video, its own files beside the video ones
+            fd = open("cdrom0:\\SYSTEM.CNF;1", O_RDONLY);
+            snprintf(line, sizeof(line), fd >= 0 ? "ESR DISC: A PATCHED PS2 GAME" : "DVD VIDEO");
+            if (fd >= 0)
+                close(fd);
+            break;
+        case SCECdCDDA:
+            snprintf(line, sizeof(line), "AUDIO CD: NOT ONE RIPPS2 STARTS");
+            break;
+        default:
+            snprintf(line, sizeof(line), "A DISC RIPPS2 CANNOT START");
+            break;
+    }
+    snprintf(discLine, sizeof(discLine), "%s", line);
+    discLastType = type;
+    discPollBusy = 0;
+}
+
