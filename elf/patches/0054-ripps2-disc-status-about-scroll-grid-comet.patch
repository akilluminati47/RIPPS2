     renderStartPrompt("START DISC", 423);
-    fntRenderString(gTheme->fonts[3], 320, 450, ALIGN_CENTER, 0, 0, "INSERT PS1/PS2 GAME OR CD/DVD MEDIA", COLOR_DIM);
+    if (!discPollBusy && (float)(clock() - discPolledAt) / CLOCKS_PER_SEC > 1.0f) {
+        discPollBusy = 1;
+        discPolledAt = clock();
+        if (ioPutRequest(IO_CUSTOM_SIMPLEACTION, &discPollWorker) != IO_OK)
+            discPollBusy = 0;
+    }
+    if (discLine[0])
+        fntRenderString(gTheme->fonts[3], 320, 450, ALIGN_CENTER, 0, 0, discLine, COLOR_SOFT);
+    else
+        fntRenderString(gTheme->fonts[3], 320, 450, ALIGN_CENTER, 0, 0, "INSERT PS1/PS2 GAME OR CD/DVD MEDIA", COLOR_DIM);
 }
 
