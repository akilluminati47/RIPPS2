+
+/*
+  RIPPS2 build 77: Neutrino on board.
+
+  Neutrino 1.8.0 (rickgaiser, AFL-3.0) rides inside RIPPS2.ELF as a gzip'd tar of its release
+  folder (neutrino.elf, config/, modules/, its README, version and licence; the PC-side udpfs_server
+  stays out). A Neutrino launch that finds no install of the user's own (the path in Settings, the
+  game's drive, the memory cards) asks where to put this one -- the game's drive or a memory card --
+  writes it there and goes on. config/system.toml goes last: the launcher counts a folder with it as
+  complete, so a write cut short is never taken for an install.
+*/
+
+
+extern void *neutrino_tgz; // misc/neutrino.tar.gz: elf/neutrino/neutrino-1.8.0.tar.gz
+extern int size_neutrino_tgz;
+
+#define NEUTRINO_TAR_SIZE 593920 // the tar the build carries, as packed (elf/neutrino/README.md)
+#define NEUTRINO_LAST     "config/system.toml"
+
+static void ntMkdirs(const char *dir)
+{
+    char path[160];
+    int i, n = snprintf(path, sizeof(path), "%s", dir);
+    for (i = 0; i < n; i++) {
+        if (path[i] == '/' && i > 0 && path[i - 1] != ':') {
+            path[i] = '\0';
+            mkdir(path, 0777);
+            path[i] = '/';
+        }
+    }
+    mkdir(path, 0777);
+}
+
+static unsigned int ntOctal(const unsigned char *p, int len)
+{
+    unsigned int v = 0;
+    while (len-- > 0 && *p == ' ')
+        p++;
+    for (; len > 0 && *p >= '0' && *p <= '7'; p++, len--)
+        v = v * 8 + (*p - '0');
+    return v;
+}
+
+// One pass over the tar: every file but NEUTRINO_LAST (last == 0), or only it (last == 1)
+static int ntWrite(const unsigned char *tar, const char *dir, int last, int *written)
+{
+    unsigned int at = 0;
+    char name[256], path[320], status[96];
+    while (at + 512 <= NEUTRINO_TAR_SIZE && tar[at] != 0) {
+        const unsigned char *h = tar + at;
+        unsigned int size = ntOctal(h + 124, 12);
+        char type = (char)h[156];
+        if (h[345])
+            snprintf(name, sizeof(name), "%.155s/%.100s", (const char *)h + 345, (const char *)h);
+        else
+            snprintf(name, sizeof(name), "%.100s", (const char *)h);
+        at += 512;
+        if (at + size > NEUTRINO_TAR_SIZE)
+            return 0;
+        if ((type == '0' || type == '\0') && (!strcmp(name, NEUTRINO_LAST)) == last) {
+            char *slash;
+            snprintf(path, sizeof(path), "%s/%s", dir, name);
+            if ((slash = strrchr(path, '/')) != NULL) {
+                *slash = '\0';
+                ntMkdirs(path);
+                *slash = '/';
+            }
+            snprintf(status, sizeof(status), "NEUTRINO: writing %.60s", name);
+            guiRenderTextScreen(status);
+            int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+            if (fd < 0 || write(fd, tar + at, size) != (int)size) {
+                if (fd >= 0)
+                    close(fd);
+                LOG("NEUTRINO: cannot write %s\n", path);
+                return 0;
+            }
+            close(fd);
+            (*written)++;
+        }
+        at += (size + 511) & ~511u;
+    }
+    return 1;
+}
+
+// dir: "mc0:/neutrino", "mass0:/neutrino"... 1 when every file is there
+static int ripps2NeutrinoUnpack(const char *dir)
+{
+    unsigned char *tar = memalign(64, NEUTRINO_TAR_SIZE);
+    z_stream zs;
+    int ok = 0, written = 0;
+
+    if (tar == NULL)
+        return 0;
+    memset(&zs, 0, sizeof(zs));
+    zs.next_in = (unsigned char *)&neutrino_tgz;
+    zs.avail_in = size_neutrino_tgz;
+    zs.next_out = tar;
+    zs.avail_out = NEUTRINO_TAR_SIZE;
+    guiRenderTextScreen("NEUTRINO: unpacking");
+    if (inflateInit2(&zs, 15 + 16) == Z_OK) {
+        ok = inflate(&zs, Z_FINISH) == Z_STREAM_END && zs.total_out == NEUTRINO_TAR_SIZE;
+        inflateEnd(&zs);
+    }
+    if (ok) {
+        ntMkdirs(dir);
+        ok = ntWrite(tar, dir, 0, &written) && ntWrite(tar, dir, 1, &written);
+    }
+    free(tar);
+    LOG("NEUTRINO: %s %s (%d files)\n", ok ? "installed in" : "install failed in", dir, written);
+    return ok;
+}
+
+// No Neutrino anywhere RIPPS2 looks: offer the one it carries, where the user picks. out gets the
+// installed neutrino.elf. 0 when declined, impossible (no menu, autolaunch) or the write failed.
+int ripps2NeutrinoOffer(const char *activePrefix, char *out, int outSize)
+{
+    char root[32] = "", labels[3][72], dirs[3][48], msg[400];
+    const char *list[3];
+    int n = 0, pick, i;
+    DIR *d;
+
+    if (!guiIsActive())
+        return 0;
+    // the game's drive, when it is one RIPPS2 can write (not a network share)
+    if (activePrefix != NULL) {
+        const char *colon = strchr(activePrefix, ':');
+        if (colon != NULL && colon - activePrefix < (int)sizeof(root) - 1)
+            snprintf(root, sizeof(root), "%.*s", (int)(colon - activePrefix + 1), activePrefix);
+    }
+    if (root[0] && strncmp(root, "mc", 2) && strncmp(root, "smb", 3) && strncmp(root, "udp", 3) && strncmp(root, "http", 4)) {
+        snprintf(dirs[n], sizeof(dirs[n]), "%s/neutrino", root);
+        snprintf(labels[n], sizeof(labels[n]), "THE GAME'S DRIVE  (%s/neutrino)", root);
+        n++;
+    }
+    for (i = 0; i < 2; i++) {
+        snprintf(dirs[n], sizeof(dirs[n]), "mc%d:/neutrino", i);
+        if ((d = opendir(i ? "mc1:/" : "mc0:/")) == NULL)
+            continue;
+        closedir(d);
+        snprintf(labels[n], sizeof(labels[n]), "MEMORY CARD %d  (about 600 KB)", i + 1);
+        n++;
+    }
+    if (n == 0)
+        return 0;
+    snprintf(msg, sizeof(msg),
+             "This game starts through Neutrino, and there is no Neutrino where RIPPS2 looks (Settings, the game's drive, the memory cards). "
+             "RIPPS2 carries Neutrino 1.8.0 by rickgaiser (AFL-3.0). Install it now? Next you pick where.");
+    guiMsgBoxSound(SFX_MESSAGE);
+    if (guiMsgBox(msg, 1, NULL) != 1)
+        return 0;
+    for (i = 0; i < n; i++)
+        list[i] = labels[i];
+    if ((pick = ripps2PickList(list, n)) < 0)
+        return 0;
+    if (!ripps2NeutrinoUnpack(dirs[pick])) {
+        guiMsgBoxSound(SFX_ERROR);
+        snprintf(msg, sizeof(msg), "Neutrino could not be written to %s. Check its free space and that it is not write protected, then try again.", dirs[pick]);
+        guiMsgBox(msg, 0, NULL);
+        return 0;
+    }
+    return snprintf(out, outSize, "%s/neutrino.elf", dirs[pick]) < outSize;
+}
