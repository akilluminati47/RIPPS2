+// ---- Screen switches: one glass panel moves between pages (no fade through black) ----
+#define MORPH_GLASS_A 0x60 // the travelling panel's tint: a veiled panel's depth, so the hand-offs match
+
+// Deep glass over a panel, `amount` 0..1: how a page's content dims before its panel moves off, and
+// how the next page's content comes up once the panel has arrived
+void ripps2DrawPanelVeil(int x, int y, int w, int h, float amount)
+{
+    if (amount <= 0.0f)
+        return;
+    u64 veil = RGBA_PRIM(0x03, 0x08, 0x22, (int)(MORPH_GLASS_A * fminf(1.0f, amount)));
+    rmDrawQuadGouraud(x, y, veil, x + w, y, veil, x, y + h, veil, x + w, y + h, veil);
+}
+
+// The pillars, and the glass panel p (0..1) of the way from rect a to rect b: it glides and resizes,
+// easing out of the first page's place and into the next one's
+void ripps2DrawPanelMorph(int ax, int ay, int aw, int ah, int bx, int by, int bw, int bh, float p)
+{
+    float e = easeInOutCubic(p < 0.0f ? 0.0f : p > 1.0f ? 1.0f : p);
+    int x = (int)(ax + (bx - ax) * e), y = (int)(ay + (by - ay) * e);
+    int w = (int)(aw + (bw - aw) * e), h = (int)(ah + (bh - ah) * e);
+    u64 glass = RGBA_PRIM(0x03, 0x08, 0x22, MORPH_GLASS_A);
+
+    ripps2DrawBackground();
+    rmDrawQuadGouraud(x, y, glass, x + w, y, glass, x, y + h, glass, x + w, y + h, glass);
+    panelFrame(x, y, w, h);
+}
