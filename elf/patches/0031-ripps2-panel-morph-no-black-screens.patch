+// RIPPS2: status screens and prompts stand on the moving pillars behind the glass page panel, where
+// RiptOPL painted the screen black with two white rules
+static void guiDrawStatusBackdrop(void)
+{
+    ripps2DrawBackground();
+    ripps2DrawPagePanel();
+}
+
+// RIPPS2: screen switches morph instead of fading through black. The old screen's panel dims, the
+// panel glides and resizes into the new screen's panel over the moving pillars (the art viewport
+// opening out into the Start menu's page, and back), and the new screen's content comes up inside it
+// once it has arrived.
+#define MORPH_CONCEAL_S 0.08f
+#define MORPH_MOVE_S    0.30f
+#define MORPH_REVEAL_S  0.14f
+
+// The glass panel a screen's content sits in: the art viewport on the Storage and info pages, the
+// page panel on every menu
+static void guiScreenPanel(gui_screen_handler_t *handler, int *x, int *y, int *w, int *h)
+{
+    if (handler == &screenHandlers[GUI_SCREEN_MAIN] && thmGetPanelRect(0, x, y, w, h))
+        return;
+    if (handler == &screenHandlers[GUI_SCREEN_INFO] && thmGetPanelRect(1, x, y, w, h))
+        return;
+    *x = 14;
+    *y = 10;
+    *w = 612;
+    *h = 460;
+}
