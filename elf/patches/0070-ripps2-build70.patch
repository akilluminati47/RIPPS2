         for (k = 0; k < 4; k++) {
@@ -791,6 +811,12 @@ static void lorenzStep(float dt)
             p->y += dy * h;
             p->z += dz * h;
         }
+        // the attractor lives within |x|, |y| < 30, 0 < z < 60: a point outside it (or NaN) starts again
