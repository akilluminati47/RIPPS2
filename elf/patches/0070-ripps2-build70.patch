+// RIPPS2 build 70: RIPPSettings (Controller Settings > RIPPSettings): how RIPPS2's own pages look.
+// Each row shows live behind the page as it changes; Cancel puts back what was there.
+static const char *guiRipps2GlyphNames[] = {"Hidden", "Shown", "Fade In", "Fade Out", NULL};
+static const char *guiRipps2ShowNames[] = {"Shown", "Fade When Idle", "Hidden", NULL};
