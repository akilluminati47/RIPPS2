+
+// The Color Theme: one colour matrix over everything RIPPS2 draws itself (ripps2tint.h). Each theme
+// is a turn of the hue with a change of saturation, the two built so a grey stays the same grey.
+static const struct
+{
+    const char *name;
+    float hue, sat;
+} paletteDef[RIPPS2_PALETTE_COUNT] = {
+    {"RIPPS2", 0.0f, 1.0f}, {"Ember", 150.0f, 1.6f}, {"Blood", 130.0f, 1.8f},
+    {"Ectoplasm", 250.0f, 1.2f}, {"Amethyst", 40.0f, 1.1f}, {"Bone", 180.0f, 0.25f}};
+static int paletteBuilt = -1, paletteM[9]; // x1024
+
+const char *ripps2PaletteName(int p)
+{
+    return p >= 0 && p < RIPPS2_PALETTE_COUNT ? paletteDef[p].name : paletteDef[0].name;
+}
+
+static void paletteBuild(int p)
+{
+    const float L[3] = {0.213f, 0.715f, 0.072f};
+    float rad = paletteDef[p].hue * 3.14159265f / 180.0f, c = cosf(rad), s = sinf(rad), sat = paletteDef[p].sat;
+    float h[9] = {0.213f + c * 0.787f - s * 0.213f, 0.715f - c * 0.715f - s * 0.715f, 0.072f - c * 0.072f + s * 0.928f,
+                  0.213f - c * 0.213f + s * 0.143f, 0.715f + c * 0.285f + s * 0.140f, 0.072f - c * 0.072f - s * 0.283f,
+                  0.213f - c * 0.213f - s * 0.787f, 0.715f - c * 0.715f + s * 0.715f, 0.072f + c * 0.928f + s * 0.072f};
+    int i, j, k;
+    for (i = 0; i < 3; i++) {
+        for (j = 0; j < 3; j++) {
+            float v = 0.0f;
+            for (k = 0; k < 3; k++)
+                v += ((i == k ? sat : 0.0f) + L[k] * (1.0f - sat)) * h[k * 3 + j];
+            paletteM[i * 3 + j] = (int)(v * 1024.0f + (v >= 0.0f ? 0.5f : -0.5f));
+        }
+    }
+    paletteBuilt = p;
+}
+
+u64 ripps2TintSlow(int r, int g, int b, int a, u64 q)
+{
+    int p = gRipps2Palette, o[3], i;
+    if (p <= 0 || p >= RIPPS2_PALETTE_COUNT)
+        return (u64)(r & 0xFF) | ((u64)(g & 0xFF) << 8) | ((u64)(b & 0xFF) << 16) | ((u64)(a & 0xFF) << 24) | (q << 32);
+    if (paletteBuilt != p)
+        paletteBuild(p);
+    for (i = 0; i < 3; i++) {
+        int v = (paletteM[i * 3] * r + paletteM[i * 3 + 1] * g + paletteM[i * 3 + 2] * b) >> 10;
+        o[i] = v < 0 ? 0 : v > 255 ? 255 : v;
+    }
+    return (u64)o[0] | ((u64)o[1] << 8) | ((u64)o[2] << 16) | ((u64)(a & 0xFF) << 24) | (q << 32);
+}
