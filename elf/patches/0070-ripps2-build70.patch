+// RIPPS2 build 70: button hints read in sentence case ("Copy to audio", not "COPY TO AUDIO") in the
+// theme's lowercase font: the menus name things, the hints explain. Short codes stay in capitals.
+static const char *hintCase(const char *s, char *out, int size)
+{
+    static const char *const keep[] = {"CD", "PC", "HDD", "ELF", "RA", "OK", "USB", "VMC", "PSU", "PS1", "PS2", "DVD", "ISO",
+                                       "MC", "NBD", "BIBLE", "RIPPS2", "APA", "IGR", "L1", "R1", "L2", "R2", "L3", "R3", NULL};
+    int n = 0, first = 1;
+    while (*s && n < size - 1) {
+        if (isalnum((unsigned char)*s)) {
+            char word[24];
+            int k = 0, i, kept = 0;
+            while (isalnum((unsigned char)s[k]) && k < (int)sizeof(word) - 1) {
+                word[k] = s[k];
+                k++;
+            }
+            word[k] = '\0';
+            for (i = 0; keep[i] != NULL && !kept; i++)
+                kept = strcasecmp(word, keep[i]) == 0;
+            for (i = 0; i < k && n < size - 1; i++)
+                out[n++] = kept ? toupper((unsigned char)word[i]) : (i == 0 && first) ? toupper((unsigned char)word[i]) : tolower((unsigned char)word[i]);
+            s += k;
+            first = 0;
+        } else {
+            if (*s == '.' || *s == ':' || *s == '!' || *s == '?')
+                first = 1;
+            out[n++] = *s++;
+        }
+    }
+    out[n] = '\0';
+    return out;
+}
+
+int ripps2HintWidth(const char *text)
+{
+    char b[96];
+    return fntCalcDimensions(RIPPS2_CASE_FONT, hintCase(text, b, sizeof(b)));
+}
+
+int ripps2HintText(int x, int y, const char *text, u64 colour)
+{
+    char b[96];
+    hintCase(text, b, sizeof(b));
+    fntRenderString(RIPPS2_CASE_FONT, x, y, ALIGN_VCENTER, 0, 0, b, colour);
+    return x + fntCalcDimensions(RIPPS2_CASE_FONT, b);
 }
 
