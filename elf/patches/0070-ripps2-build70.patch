+}
+
+#ifdef RETROACHIEVEMENTS
+enum { RA_ROW_TELEMETRY = 0, RA_ROW_BADGES, RA_ROW_TEST, RA_ROW_DISC_CHECK, RA_ROW_DISC_LAUNCH, RA_ROW_HOW, RA_ROW_COUNT };
+static const char *const raRowName[RA_ROW_COUNT] = {"TELEMETRY", "BADGES", "TEST THE PC LINK", "CHECK THE DISC", "PLAY THE DISC WITH ACHIEVEMENTS", "HOW IT WORKS"};
+#endif
+
+void ripps2Achievements(void)
+{
+    int openKey = gSelectButton == KEY_CIRCLE ? KEY_CIRCLE : KEY_CROSS, backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+#ifdef RETROACHIEVEMENTS
+    int sel = 0, changed = 0, i;
+#endif
+
+    readPads();
+    while (1) {
+        readPads();
+        rmStartFrame();
+        ripps2DrawBackground();
+        ripps2DrawPagePanel();
+        fntRenderString(gTheme->fonts[5], RA_X, 44, ALIGN_VCENTER, 0, 0, "SPIRIT OF RA", RA_GOLD);
+        fntRenderString(RIPPS2_CASE_TITLE_FONT, RA_X, 66, ALIGN_VCENTER, 0, 0, "RetroAchievements", RA_LIT); // build 70: its full name
+        rmDrawLine(RA_X, 82, RA_X + RA_W, 82, RA_PRIM(0x4A, 0x72, 0xDC, 0x60));
+#ifdef RETROACHIEVEMENTS
+        // build 70: in the lowercase font, short enough for the page either way (the ON line ran off it)
+        fntRenderString(RIPPS2_CASE_FONT, RA_X, 98, ALIGN_VCENTER, RA_W, 0,
+                        gRATelemetry ? "On: tracked games report their unlocks to xeRAbora on your PC." : "Off: games start just as they would without it.", RA_SOFT);
+        for (i = 0; i < RA_ROW_COUNT; i++) {
+            int y = RA_Y + i * RA_ROW_H + (i >= RA_ROW_TEST ? 12 : 0), cur = i == sel;
+            if (cur) {
+                rmDrawRect(RA_X - 8, y - 2, RA_W + 16, RA_ROW_H - 4, RA_PRIM(0x1E, 0x3C, 0x96, 0x58));
+                rmDrawRect(RA_X - 8, y - 2, 3, RA_ROW_H - 4, RA_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+            }
+            fntRenderString(gTheme->fonts[8], RA_X + 6, y + 11, ALIGN_VCENTER, 0, 0, raRowName[i], cur ? RA_LIT : RA_SOFT);
+            if (i == RA_ROW_TELEMETRY || i == RA_ROW_BADGES) {
+                int on = i == RA_ROW_TELEMETRY ? gRATelemetry : gRABadges;
+                const char *v = on ? "ON" : "OFF";
+                fntRenderString(gTheme->fonts[5], RA_X + RA_W - fntCalcDimensions(gTheme->fonts[5], v), y + 11, ALIGN_VCENTER, 0, 0, v,
+                                on ? RA_GOLD : RA_DIM);
+            }
+        }
+        guiShowRANotices(); // the answers to the tests, as they come back
+#else
+        fntRenderString(gTheme->fonts[4], 320, 220, ALIGN_CENTER, 0, 0, "This RIPPS2 build was made without achievements.", RA_SOFT);
+#endif
+        {
+            int hx = RA_X, hy = 448;
+#ifdef RETROACHIEVEMENTS
+            raHint(gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, "SELECT", &hx, hy);
+#endif
+            raHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, "BACK", &hx, hy);
+        }
+        rmEndFrame();
+
+        if (getKeyOn(backKey) || getKeyOn(KEY_TRIANGLE)) {
+            sfxPlay(SFX_CANCEL);
+            break;
+        }
+#ifdef RETROACHIEVEMENTS
+        if (getKey(KEY_UP) && sel > 0) {
+            sel--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && sel < RA_ROW_COUNT - 1) {
+            sel++;
+            sfxPlay(SFX_CURSOR);
+        } else if ((sel == RA_ROW_TELEMETRY || sel == RA_ROW_BADGES) && (getKeyOn(openKey) || getKeyOn(KEY_LEFT) || getKeyOn(KEY_RIGHT))) {
+            if (sel == RA_ROW_TELEMETRY)
+                gRATelemetry = !gRATelemetry;
+            else
+                gRABadges = !gRABadges;
+            changed = 1;
+            sfxPlay(SFX_CONFIRM);
+        } else if (getKeyOn(openKey)) {
+            sfxPlay(SFX_CONFIRM);
+            if (sel == RA_ROW_TEST) {
+                sbTestPCLinkDeferred();
+                guiShowRANotice(_l(_STR_RA_LOOKING_FOR_PC), NULL);
+            } else if (sel == RA_ROW_DISC_CHECK) {
+                if (discCheckSupportDeferred())
+                    guiShowRANotice(_l(_STR_RA_DISC_CHECKING), NULL);
+                else
+                    guiShowRANotice(_l(_STR_RA_CHECK_RUNNING), NULL);
+            } else if (sel == RA_ROW_DISC_LAUNCH) {
+                if (!gRATelemetry) {
+                    guiMsgBoxSound(SFX_ERROR);
+                    guiMsgBox("Turn TELEMETRY on first: with it off, the game starts without achievements.", 0, NULL);
+                } else
+                    discLaunch(&guiRenderProbeFrame); // success never returns
+            } else if (sel == RA_ROW_HOW) {
+                guiMsgBox("Run the xeRAbora client on a PC on the same network, signed in to your RetroAchievements account. "
+                          "Then, for a game on USB, MMCE, SMB or the HDD: open its game menu (TRIANGLE) and CHECK GAME SUPPORT. "
+                          "A tracked game gets the RA badge; with TELEMETRY on, start it and unlocks pop up over the game. "
+                          "For a disc in the tray, use CHECK THE DISC, then PLAY THE DISC WITH ACHIEVEMENTS. "
+                          "Games started through Neutrino, POPSTARTER or Ember are not tracked yet.",
+                          0, NULL);
+            }
+            readPads();
+        }
+#else
+        (void)openKey;
+#endif
+    }
+#ifdef RETROACHIEVEMENTS
+    if (changed)
+        ripps2SaveSettingsInBackground();
+#endif
+    readPads();
+}
