+// Seconds since the first frame drawn, from the EE's 64-bit bus-clock counter. Build 70: this was
+// clock(), which on the EE is a 32-bit count of microseconds and wraps every 71.6 minutes. At the wrap
+// the time jumped back 4295 s: the orbs' frame step went hugely negative, the right-stick spin's
+// expf(-dt) became inf, the attractor ran backwards and blew up, and every orb went to NaN -- the
+// "leave Memory Files on and the orbs glitch, then the console crashes" report (build 69, hardware).
+// Counted from the first call, a float keeps sub-millisecond steps for many hours.
+double ripps2Seconds(void)
+{
+    static u64 base = 0;
+    u64 now = GetTimerSystemTime();
+    if (base == 0)
+        base = now;
+    return (double)(now - base) / (double)kBUSCLK;
+}
+
 static float nowSeconds(void)
 {
-    return (float)clock() / (float)CLOCKS_PER_SEC;
+    return (float)ripps2Seconds();
 }
 
 static inline unsigned int cpuTicks(void)
