diff --git a/include/ripps2tint.h b/include/ripps2tint.h
new file mode 100644
index 0000000..569d7ff
--- /dev/null
+++ b/include/ripps2tint.h
@@ -0,0 +1,29 @@
+#ifndef __RIPPS2TINT_H
+#define __RIPPS2TINT_H
+
+/*
+  RIPPSettings Color Theme. Included LAST by the files that draw RIPPS2's own pages (the towers, the
+  orbs, the glass, the CD player, the browser and its tools), so every colour they make, with
+  GS_SETREG_RGBA / GS_SETREG_RGBAQ or the macros built on them, goes through the theme's colour
+  matrix (ripps2ui.c). Greys come through unchanged, so text and the 0x80 grey that draws a texture
+  as it is never change: only the blues move. RIPPS2 blue (theme 0) costs a test and nothing else.
+*/
+
+#include <tamtypes.h>
+
+extern int gRipps2Palette;
+u64 ripps2TintSlow(int r, int g, int b, int a, u64 q);
+
+static inline u64 ripps2Tint(int r, int g, int b, int a, u64 q)
+{
+    if (gRipps2Palette == 0)
+        return (u64)(r & 0xFF) | ((u64)(g & 0xFF) << 8) | ((u64)(b & 0xFF) << 16) | ((u64)(a & 0xFF) << 24) | (q << 32);
+    return ripps2TintSlow(r, g, b, a, q);
+}
+
+#undef GS_SETREG_RGBA
+#undef GS_SETREG_RGBAQ
+#define GS_SETREG_RGBA(r, g, b, a)     ripps2Tint((int)(r), (int)(g), (int)(b), (int)(a), 0)
+#define GS_SETREG_RGBAQ(r, g, b, a, q) ripps2Tint((int)(r), (int)(g), (int)(b), (int)(a), (u64)(q))
+
+#endif
