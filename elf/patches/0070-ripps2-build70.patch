+#define ART_FADE_S   0.35f // the art's fade in (themes.c ART_FADE_S): the glyphs and the idle fades come in at its pace
+#define GLYPH_HOLD_S 2.5f  // the glyphs stay this long after a press (or the page opening, for Fade Out)
