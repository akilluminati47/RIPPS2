+static void guiRipps2SettingsRead(void)
+{
+    int v;
+    if (diaGetInt(diaRipps2Config, UICFG_RIPPS2_GLYPHS, &v) && v >= 0 && v < RIPPS2_GLYPHS_COUNT)
