+// RIPPS2 cannot see a player hang once it has handed the console over, so a DVD video is checked
+// first. It must have its VIDEO_TS.IFO (a disc without one is not a DVD video any player can play),
+// and the IFO's region mask (byte 0x23: bit n set = not for region n + 1) should allow the console's
+// region, which ROMVER's fifth character names. Consoles of one ROM region ship in more than one DVD
+// region (an E console is region 2, or 4 in Australia), so every region a ROM region covers counts.
+static int r2ConsoleDvdRegions(void)
+{
+    char ver[16];
+    int fd = open("rom0:ROMVER", O_RDONLY), n;
+    if (fd < 0)
+        return 0;
+    n = read(fd, ver, sizeof(ver) - 1);
+    close(fd);
+    if (n < 5)
+        return 0;
+    switch (ver[4]) {
+        case 'A': return (1 << 0) | (1 << 3); // the Americas: 1, 4
+        case 'J': return 1 << 1;              // Japan: 2
+        case 'E': return (1 << 1) | (1 << 3); // Europe, Oceania: 2, 4
+        case 'H': return 1 << 2;              // Asia: 3
+        case 'R': return 1 << 4;              // Russia: 5
+        case 'C': return 1 << 5;              // China: 6
+    }
+    return 0; // unknown: do not guess
+}
+
+// 1 when the DVD video in the drive should play; else says why not and returns 0
+static int r2DvdPlayable(void)
+{
+    unsigned char ifo[0x24];
+    char msg[200];
+    int fd = open("cdrom0:\\VIDEO_TS\\VIDEO_TS.IFO;1", O_RDONLY), n = -1, regions, disc, r;
+
+    if (fd >= 0) {
+        n = read(fd, ifo, sizeof(ifo));
+        close(fd);
+    }
+    if (n < (int)sizeof(ifo) || memcmp(ifo, "DVDVIDEO-VMG", 12) != 0) {
+        guiMsgBox("This disc is not compatible: it reads as DVD video but has no DVD video on it (no VIDEO_TS), so a DVD player cannot play it.", 0, NULL);
+        return 0;
+    }
+    regions = r2ConsoleDvdRegions();
+    disc = ~ifo[0x23] & 0xFF; // the regions the disc plays in
+    if (regions != 0 && disc != 0 && (disc & regions) == 0) {
+        for (r = 0; r < 8 && !(disc & (1 << r)); r++)
+            ;
+        snprintf(msg, sizeof(msg), "This disc is not compatible: it is a region %d DVD, and this console plays another region's DVDs. Start it anyway?", r + 1);
+        return guiMsgBox(msg, 1, NULL);
+    }
+    return 1;
+}
