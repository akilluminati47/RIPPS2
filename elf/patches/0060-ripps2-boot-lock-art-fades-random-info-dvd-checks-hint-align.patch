+// RIPPS2: art fades in when it arrives (a game's art loads a moment after the game is picked) instead
+// of popping in: each image element remembers which game and texture it last drew, and a new one
+// eases up from nothing over ART_FADE_S. The slideshow's first slide fades in the same way; after
+// that the slides crossfade on their own.
+#define ART_FADE_S 0.35f
+#define ART_FADES  8
+
+static struct
+{
+    void *elem, *item;
+    GSTEXTURE *tex;
+    clock_t since;
+    int frame;
+} artFades[ART_FADES];
+
+static float artEase(float f)
+{
+    if (f <= 0.0f)
+        return 0.0f;
+    if (f >= 1.0f)
+        return 1.0f;
+    return f * f * (3.0f - 2.0f * f);
+}
+
+static float artFadeIn(void *elem, void *item, GSTEXTURE *tex)
+{
+    int i, slot = -1, oldest = 0;
+    for (i = 0; i < ART_FADES; i++) {
+        if (artFades[i].elem == elem) {
+            slot = i;
+            break;
+        }
+        if (artFades[i].frame < artFades[oldest].frame)
+            oldest = i;
+    }
+    if (slot < 0) {
+        slot = oldest;
+        artFades[slot].elem = elem;
+        artFades[slot].tex = NULL;
+    }
+    // another game or other art, or the element was off screen a while: ease in again
+    if (artFades[slot].tex != tex || artFades[slot].item != item || guiFrameId - artFades[slot].frame > 2) {
+        artFades[slot].tex = tex;
+        artFades[slot].item = item;
+        artFades[slot].since = clock();
+    }
+    artFades[slot].frame = guiFrameId;
+    return artEase((float)(clock() - artFades[slot].since) / (float)CLOCKS_PER_SEC / ART_FADE_S);
+}
