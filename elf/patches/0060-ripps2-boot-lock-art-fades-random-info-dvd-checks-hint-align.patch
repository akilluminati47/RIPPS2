diff --git a/src/ripps2boot.c b/src/ripps2boot.c
new file mode 100644
index 0000000..d9afa3c
--- /dev/null
+++ b/src/ripps2boot.c
@@ -0,0 +1,253 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  BOOT LOCK (Settings > General & System): the console starts straight into RIPPS2, through PS2BBL,
+  the PlayStation 2 Basic BootLoader by El Isra (israpps), or saildot4k's PS2BBL Extended. RIPPS2
+  carries no part of either. It edits the boot loader's own config file, the one PS2BBL already
+  reads at power on:
+
+    on   RIPPS2 becomes the first automatic entry (LK_AUTO_E1, named RIPPS2). The lines it takes the
+         place of stay in the file, commented out with a #RIPPS2# prefix under a marker line.
+    off  the marker and RIPPS2's lines go, and the #RIPPS2# lines come back exactly as they were.
+
+  A hotkey held at power on still reaches every other PS2BBL entry, so the lock shuts nothing out.
+  The first time a config is changed, its original is kept beside it as <name>.RIPPS2-BACKUP.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/ripps2.h"
+#include "include/bdmsupport.h"
+
+#define BL_MAX    32768 // a PS2BBL config is a few KB
+#define BL_MARKER "#RIPPS2 BOOT LOCK"
+#define BL_KEPT   "#RIPPS2# "
+
+// Where PS2BBL and PS2BBL Extended look for their config (the Extended README's search order, the
+// device-boot and memory card places a console can reach without mounting an HDD partition)
+static const char *blConfigs[] = {
+    "mc0:/SYS-CONF/PS2BBL.INI",
+    "mc1:/SYS-CONF/PS2BBL.INI",
+    "mc0:/BOOT/CONFIG.INI",
+    "mc1:/BOOT/CONFIG.INI",
+    "mass0:/PS2BBL/CONFIG.INI",
+    "mmce0:/PS2BBL/CONFIG.INI",
+    "mmce1:/PS2BBL/CONFIG.INI",
+    NULL};
+
+static char blText[BL_MAX + 1], blOut[BL_MAX + 512];
+static char blFound[96];
+
+// The whole file, or -1. Only a file with PS2BBL launch keys in it counts as a PS2BBL config.
+static int blRead(const char *path)
+{
+    int fd = open(path, O_RDONLY), n;
+    if (fd < 0)
+        return -1;
+    n = read(fd, blText, BL_MAX);
+    close(fd);
+    if (n <= 0 || n >= BL_MAX)
+        return -1;
+    blText[n] = '\0';
+    return strstr(blText, "LK_") != NULL ? n : -1;
+}
+
+static int blWrite(const char *path, const char *text, int len)
+{
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666), n;
+    if (fd < 0)
+        return -1;
+    n = write(fd, text, len);
+    close(fd);
+    return n == len ? 0 : -1;
+}
+
+// The line's key: what stands before '=', trimmed ("" for a comment or a blank line)
+static void blKey(const char *line, int len, char *key, int size)
+{
+    int i = 0, n = 0;
+    while (i < len && (line[i] == ' ' || line[i] == '\t'))
+        i++;
+    if (i < len && line[i] == '#') {
+        key[0] = '\0';
+        return;
+    }
+    while (i < len && line[i] != '=' && line[i] != ' ' && line[i] != '\t' && n < size - 1)
+        key[n++] = line[i++];
+    key[n] = '\0';
+}
+
+static int blTaken(const char *key)
+{
+    return !strcmp(key, "LK_AUTO_E1") || !strcmp(key, "ARG_AUTO_E1") || !strcmp(key, "NAME_AUTO");
+}
+
+// Builds the file without the lock (as it was before it) into blOut; its length
+static int blUnlocked(const char *text)
+{
+    const char *p = text;
+    int o = 0, skip = 0;
+    while (*p) {
+        const char *e = strchr(p, '\n');
+        int len = e ? (int)(e - p) + 1 : (int)strlen(p);
+        char key[32];
+        blKey(p, len, key, sizeof(key));
+        if (!strncmp(p, BL_MARKER, strlen(BL_MARKER)))
+            skip = 2; // the marker and RIPPS2's NAME_AUTO and LK_AUTO_E1 after it
+        else if (skip > 0 && (!strcmp(key, "NAME_AUTO") || !strcmp(key, "LK_AUTO_E1")))
+            skip--;
+        else {
+            skip = 0;
+            if (!strncmp(p, BL_KEPT, strlen(BL_KEPT))) { // a kept line comes back
+                p += strlen(BL_KEPT);
+                len -= strlen(BL_KEPT);
+            }
+            memcpy(blOut + o, p, len);
+            o += len;
+        }
+        p += len;
+    }
+    blOut[o] = '\0';
+    return o;
+}
+
+// Builds the locked file from an unlocked one into blOut; its length
+static int blLocked(const char *text, const char *ripps2)
+{
+    const char *p = text, *eol = strstr(text, "\r\n") ? "\r\n" : "\n";
+    int o = 0, placed = 0;
+    char ours[320];
+    int oursLen = snprintf(ours, sizeof(ours), "%s: RIPPS2 starts first. Turn BOOT LOCK off in RIPPS2 to bring back the lines marked #RIPPS2#.%s"
+                                               "NAME_AUTO = RIPPS2%sLK_AUTO_E1 = %s%s",
+                           BL_MARKER, eol, eol, ripps2, eol);
+    while (*p) {
+        const char *e = strchr(p, '\n');
+        int len = e ? (int)(e - p) + 1 : (int)strlen(p);
+        char key[32];
+        blKey(p, len, key, sizeof(key));
+        if (blTaken(key)) {
+            if (!placed) { // RIPPS2's lines go where the automatic entry was
+                memcpy(blOut + o, ours, oursLen);
+                o += oursLen;
+                placed = 1;
+            }
+            o += sprintf(blOut + o, "%s", BL_KEPT);
+        }
+        if (o + len >= (int)sizeof(blOut) - (int)sizeof(ours))
+            return -1;
+        memcpy(blOut + o, p, len);
+        o += len;
+        p += len;
+    }
+    if (!placed) { // no automatic entry at all: RIPPS2's goes at the end
+        if (o > 0 && blOut[o - 1] != '\n')
+            o += sprintf(blOut + o, "%s", eol);
+        memcpy(blOut + o, ours, oursLen);
+        o += oursLen;
+    }
+    blOut[o] = '\0';
+    return o;
+}
+
+// RIPPS2's own path as PS2BBL writes it (mc?:/, usb:/, ata:/, mx4sio:/, mmce?:/ or an HDD path)
+static int blRipps2Path(char *out, int size)
+{
+    char boot[256];
+    const char *rest;
+
+    if (!ripps2GetBootPath(boot, sizeof(boot)))
+        return 0;
+    if ((!strncmp(boot, "mc0:", 4) || !strncmp(boot, "mc1:", 4)) && boot[4] == '/')
+        return snprintf(out, size, "mc?:%s", boot + 4) < size;
+    if (!strncmp(boot, "mmce0:", 6) || !strncmp(boot, "mmce1:", 6))
+        return snprintf(out, size, "mmce?:%s", boot + 6) < size;
+    if (!strncmp(boot, "mass", 4) && (rest = strchr(boot, ':')) != NULL) {
+        int t = ripps2GetBootBdmType();
+        const char *dev = t == BDM_TYPE_USB ? "usb" : t == BDM_TYPE_ATA ? "ata" : t == BDM_TYPE_SDC ? "mx4sio" : "mass";
+        return snprintf(out, size, "%s:%s%s", dev, rest[1] == '/' ? "" : "/", rest + 1) < size;
+    }
+    if (!strncmp(boot, "hdd0:", 5))
+        return snprintf(out, size, "%s", boot) < size;
+    return 0;
+}
+
+int ripps2BootLockIgrPath(char *out, int size)
+{
+    char boot[256];
+    const char *rest;
+
+    out[0] = '\0';
+    if (!ripps2GetBootPath(boot, sizeof(boot)))
+        return 0;
+    if ((!strncmp(boot, "mc0:", 4) || !strncmp(boot, "mc1:", 4)) && boot[4] == '/')
+        return snprintf(out, size, "%s", boot) < size;
+    if (!strncmp(boot, "mass", 4) && (rest = strchr(boot, ':')) != NULL) // the IGR path's own form
+        return snprintf(out, size, "mass:%s%s", rest[1] == '/' ? "" : "/", rest + 1) < size;
+    return 0; // the IGR cannot reach MMCE or the HDD (see the IGR Path hint)
+}
+
+int ripps2BootLockState(void)
+{
+    int i;
+    blFound[0] = '\0';
+    for (i = 0; blConfigs[i] != NULL; i++) {
+        if (blRead(blConfigs[i]) < 0)
+            continue;
+        if (!blFound[0])
+            snprintf(blFound, sizeof(blFound), "%s", blConfigs[i]);
+        if (strstr(blText, BL_MARKER) != NULL)
+            return 1;
+    }
+    return 0;
+}
+
+void ripps2BootLockApply(int on)
+{
+    char ripps2[256], backup[128], msg[400], where[200] = "";
+    int i, changed = 0, failed = 0, len;
+
+    if (on && !blRipps2Path(ripps2, sizeof(ripps2))) {
+        guiMsgBox("BOOT LOCK needs RIPPS2 on a memory card, a USB or exFAT drive, MMCE or the HDD, where PS2BBL can start it. This copy was started from somewhere PS2BBL cannot reach.", 0, NULL);
+        return;
+    }
+    for (i = 0; blConfigs[i] != NULL; i++) {
+        if (blRead(blConfigs[i]) < 0)
+            continue;
+        snprintf(backup, sizeof(backup), "%s.RIPPS2-BACKUP", blConfigs[i]);
+        int fd = open(backup, O_RDONLY);
+        if (fd >= 0)
+            close(fd);
+        else if (strstr(blText, BL_MARKER) == NULL) // the config as it was before RIPPS2 ever touched it
+            blWrite(backup, blText, strlen(blText));
+        len = blUnlocked(blText);
+        if (on) {
+            memcpy(blText, blOut, len + 1);
+            len = blLocked(blText, ripps2);
+        }
+        if (len < 0 || blWrite(blConfigs[i], blOut, len) != 0) {
+            failed++;
+            continue;
+        }
+        changed++;
+        if (strlen(where) + strlen(blConfigs[i]) + 3 < sizeof(where))
+            snprintf(where + strlen(where), sizeof(where) - strlen(where), "%s%s", where[0] ? ", " : "", blConfigs[i]);
+    }
+
+    if (!changed && !failed)
+        snprintf(msg, sizeof(msg), "BOOT LOCK works through PS2BBL (PlayStation 2 Basic BootLoader), and RIPPS2 found no PS2BBL config on this console (mc0:/SYS-CONF/PS2BBL.INI or PS2BBL/CONFIG.INI on a drive). Install PS2BBL or PS2BBL Extended first.");
+    else if (failed && !changed)
+        snprintf(msg, sizeof(msg), "BOOT LOCK could not write the PS2BBL config. Check that the memory card or drive is not write protected, then try again.");
+    else if (on)
+        snprintf(msg, sizeof(msg), "BOOT LOCK is on. PS2BBL now starts RIPPS2 at power on (%s). Hold a PS2BBL hotkey while the console starts to reach anything else.", where);
+    else
+        snprintf(msg, sizeof(msg), "BOOT LOCK is off. PS2BBL starts what it started before (%s).", where);
+    guiMsgBox(msg, 0, NULL);
+}
