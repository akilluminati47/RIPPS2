+static int sfxHex8(const char *s, unsigned int *out)
+{
+    unsigned int v = 0;
+    int i;
+    for (i = 0; i < 8; i++) {
+        char c = s[i];
+        v <<= 4;
+        if (c >= '0' && c <= '9')
+            v |= c - '0';
+        else if (c >= 'A' && c <= 'F')
+            v |= c - 'A' + 10;
+        else if (c >= 'a' && c <= 'f')
+            v |= c - 'a' + 10;
+        else
+            return 0;
+    }
+    *out = v;
+    return 1;
+}
