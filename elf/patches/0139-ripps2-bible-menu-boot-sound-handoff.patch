+    {"LOGO_DISPLAY", N_("Splash"), 3, {"0", "2", "3"}, {N_("Off"), N_("Logo"), N_("Logo and Names")}, 1},
+    {"BIBLE_GLYPHS", N_("Button Glyphs"), 3, {"0", "1", "2"}, {N_("None"), N_("Face Buttons"), N_("All Sixteen")}, 1},
+    {"BIBLE_INFO", N_("Info Line"), 2, {"0", "1"}, {N_("Off"), N_("On")}, 0},
+    {"KEY_READ_WAIT_TIME", N_("Power-on Wait"), 6, {"0", "1000", "2000", "3000", "6000", "10000"}, {"0 ms", "1000 ms", "2000 ms", "3000 ms", "6000 ms", "10000 ms"}, -1},
+    {"VIDEO_MODE", "Video Mode", 7, {"AUTO", "NTSC", "PAL", "480P", "576P", "720P", "1080I"}, {N_("Auto"), "NTSC", "PAL", "480p", "576p", "720p", "1080i"}, 0},
+    {"BIBLE_WIDESCREEN", "Widescreen", 3, {"AUTO", "ON", "OFF"}, {N_("Auto"), N_("On"), N_("Off")}, 0},
+};
+#define BL_SETS ((int)(sizeof(blSets) / sizeof(blSets[0])))
