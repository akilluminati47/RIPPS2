+// place in the settings file BIBLE reads (mc?:/SYS-CONF/PS2BBL.INI): only that key's line changes, comments and every
+// other key stay, so the file stays one to edit by hand (EDIT BIBLE'S SETTINGS FILE opens it). The values are BIBLE's
+// (BIBLE's src/loader_config.c); a key not in the file shows BIBLE's default.
+typedef struct
+{
+    const char *key;
+    const char *label;
+    int count;
+    const char *values[7];
+    const char *shown[7];
+    int def; // BIBLE's own when the key is not in the file; -1 none
+} blSet_t;
+
+static const blSet_t blSets[] = {
