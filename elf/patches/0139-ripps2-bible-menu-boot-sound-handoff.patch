+            }
+            snprintf(items[n], sizeof(items[n]), "%s: %s", _t(s->label), shown);
+            list[n] = items[n];
+            n++;
+        }
+        snprintf(items[n], sizeof(items[n]), "%s", _t("EDIT BIBLE'S SETTINGS FILE"));
+        list[n] = items[n];
+        n++;
+
+        if ((pick = ripps2PickList(list, n)) < 0)
