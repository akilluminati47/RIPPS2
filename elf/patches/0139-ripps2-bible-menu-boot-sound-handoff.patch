+        have = blSettingsFile(boot) && blRead(blSetPath) >= 0;
+        n = 0;
+        if (older >= 0)
+            snprintf(items[n], sizeof(items[n]), _t("UPDATE BIBLE: SLOT %d HAS AN OLDER ONE"), older);
+        else
