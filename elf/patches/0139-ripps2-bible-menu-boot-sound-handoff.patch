+// The settings file BIBLE reads: the one it read at this power on (it started RIPPS2), else the one on the card the
+// console starts BIBLE from, else either card's with BIBLE on it
+static int blSettingsFile(int boot)
+{
+    int i, port;
+    if (gBibleHome[0])
+        return snprintf(blSetPath, sizeof(blSetPath), "%sPS2BBL.INI", gBibleHome) < (int)sizeof(blSetPath);
+    for (i = -1; i < 2; i++) {
+        port = i < 0 ? boot : i;
+        if (port >= 0 && blCards[port].present && blCards[port].bible) {
+            snprintf(blSetPath, sizeof(blSetPath), "mc%d:/SYS-CONF/PS2BBL.INI", port);
+            return 1;
+        }
+    }
+    blSetPath[0] = '\0';
+    return 0;
+}
+
+// A key's value in blText (trimmed), 1 when the file has it
+static int blIniGet(const char *key, char *val, int size)
+{
+    const char *p = blText, *e, *eq, *end;
+    char k[48];
+    int len, n;
+    while (*p) {
+        e = strchr(p, '\n');
+        len = e != NULL ? (int)(e - p) : (int)strlen(p);
+        blKey(p, len, k, sizeof(k));
+        if (k[0] && !strcasecmp(k, key) && (eq = memchr(p, '=', len)) != NULL) {
+            eq++;
+            end = p + len;
+            while (eq < end && (*eq == ' ' || *eq == '\t'))
+                eq++;
+            while (end > eq && (end[-1] == '\r' || end[-1] == ' ' || end[-1] == '\t'))
+                end--;
+            n = (int)(end - eq) < size - 1 ? (int)(end - eq) : size - 1;
+            memcpy(val, eq, n);
+            val[n] = '\0';
+            return 1;
+        }
+        p = e != NULL ? e + 1 : p + len;
+    }
+    val[0] = '\0';
+    return 0;
+}
+
+// Which of a setting's values the file holds: its index, or -1 for one RIPPS2 does not offer (shown as it is)
+static int blSetIndex(const blSet_t *s, const char *val)
+{
+    int j;
+    for (j = 0; j < s->count; j++)
+        if (!strcasecmp(val, s->values[j]) || (!strcmp(s->key, "KEY_READ_WAIT_TIME") && atoi(val) == atoi(s->values[j]) && val[0] >= '0' && val[0] <= '9'))
+            return j;
+    if (!strcmp(s->key, "BIBLE_BACKGROUND")) // BIBLE reads BLACK, OFF and 0 as BLANK, ON and 1 as SKY
+        return !strcasecmp(val, "BLACK") || !strcasecmp(val, "OFF") || !strcmp(val, "0") ? 2 : !strcasecmp(val, "ON") || !strcmp(val, "1") ? 1 : -1;
+    return -1;
+}
+
+// key = value in the file: that key's line replaced, or a line added at the end; 1 when it was written
+static int blIniSet(const char *path, const char *key, const char *value)
+{
+    const char *p, *e, *nl;
+    char k[48];
+    int len, o = 0, done = 0;
+    if (blRead(path) < 0)
+        return 0;
+    nl = strstr(blText, "\r\n") != NULL ? "\r\n" : "\n";
+    for (p = blText; *p;) {
+        e = strchr(p, '\n');
+        len = e != NULL ? (int)(e - p) + 1 : (int)strlen(p);
+        blKey(p, len, k, sizeof(k));
+        if (!done && k[0] && !strcasecmp(k, key) && memchr(p, '=', len) != NULL) {
+            o += snprintf(blOut + o, sizeof(blOut) - o, "%s = %s%s", key, value, e != NULL ? nl : "");
+            done = 1;
+        } else if (o + len < (int)sizeof(blOut)) {
+            memcpy(blOut + o, p, len);
+            o += len;
+        }
+        if (o >= (int)sizeof(blOut) - 64)
+            return 0;
+        p += len;
+    }
+    if (!done) {
+        if (o > 0 && blOut[o - 1] != '\n')
+            o += snprintf(blOut + o, sizeof(blOut) - o, "%s", nl);
+        o += snprintf(blOut + o, sizeof(blOut) - o, "%s = %s%s", key, value, nl);
+    }
+    if (o >= (int)sizeof(blOut))
+        return 0;
+    ripps2Diag("bible: %s: %s = %s", path, key, value);
+    return blWrite(path, blOut, o) == 0;
+}
