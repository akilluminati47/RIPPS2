diff --git a/src/ripps2.c b/src/ripps2.c
index 6c5fb09..3af2d0b 100644
--- a/src/ripps2.c
+++ b/src/ripps2.c
@@ -1,14 +1,6 @@
 /*
-  RIPPS2: launch the Memory Files ELF bundled inside RIPPS2.elf.
-
-  The ELF is compiled in (misc/ripps2_memfiles.elf via bin2c), so its image already sits in RAM
-  inside our own data. After tearing RIPPS2 down the way a disc launch does, reset the IOP so the
-  program starts on a clean IOP (as the PS2 browser leaves it), copy its PT_LOAD segments to their
-  load addresses, and jump in with ExecPS2.
-
-  The copy runs from our own code and stack, so every segment is checked up front: it must stay in
-  user RAM and clear of our image (which holds the source copy) and of the live stack. The bundled
-  Memory Files is a packed homebrew whose one segment loads high (~0x1bd5a20), well clear of both.
+  RIPPS2 launchers: DVD video (a DVD player, or ESR for an ESR-patched game) and PlayStation discs
+  from LAUNCH DISC.
 */
 
 #include <kernel.h>
@@ -29,127 +21,6 @@
 #include "include/ioman.h"
 #include "include/ripps2.h"
 
-extern unsigned char ripps2_memfiles_elf[];
-extern unsigned int size_ripps2_memfiles_elf;
-extern char _end[]; // end of our image (code, data, bss) from the ps2sdk linkfile
-
-#define R2_ELF_MAGIC   0x464c457f
-#define R2_PT_LOAD     1
-#define R2_USER_START  0x00100000
-#define R2_USER_END    0x02000000
-#define R2_STACK_GUARD 0x00010000 // keep this much below the current stack pointer free
-
-typedef struct
-{
-    u8 ident[16];
-    u16 type;
-    u16 machine;
-    u32 version;
-    u32 entry;
-    u32 phoff;
-    u32 shoff;
-    u32 flags;
-    u16 ehsize;
-    u16 phentsize;
-    u16 phnum;
-    u16 shentsize;
-    u16 shnum;
-    u16 shstrndx;
-} r2_elf_header_t;
-
-typedef struct
-{
-    u32 type;
-    u32 offset;
-    u32 vaddr;
-    u32 paddr;
-    u32 filesz;
-    u32 memsz;
-    u32 flags;
-    u32 align;
-} r2_elf_pheader_t;
-
-static const r2_elf_pheader_t *r2Segment(const u8 *img, const r2_elf_header_t *eh, u32 i)
-{
-    return (const r2_elf_pheader_t *)(img + eh->phoff + i * sizeof(r2_elf_pheader_t));
-}
-
-static int r2Overlaps(u32 a0, u32 a1, u32 b0, u32 b1)
-{
-    return a0 < b1 && b0 < a1;
-}
-
-// Everything is checked before RIPPS2 is torn down, so a bad image just returns to the menu.
-static int r2CheckElf(const u8 *img, u32 size)
-{
-    const r2_elf_header_t *eh = (const r2_elf_header_t *)img;
-    u32 sp, i;
-
-    if (size < sizeof(*eh) || *(const u32 *)eh->ident != R2_ELF_MAGIC)
-        return -1;
-    if (eh->phentsize != sizeof(r2_elf_pheader_t) || eh->phoff + (u32)eh->phnum * sizeof(r2_elf_pheader_t) > size)
-        return -2;
-
-    __asm__ __volatile__("move %0, $sp" : "=r"(sp));
-
-    for (i = 0; i < eh->phnum; i++) {
-        const r2_elf_pheader_t *ph = r2Segment(img, eh, i);
-        u32 end = ph->vaddr + ph->memsz;
-
-        if (ph->type != R2_PT_LOAD)
-            continue;
-        if (ph->filesz > ph->memsz || ph->offset + ph->filesz > size)
-            return -3;
-        if (ph->vaddr < R2_USER_START || end > R2_USER_END || end < ph->vaddr)
-            return -4;
-        if (r2Overlaps(ph->vaddr, end, R2_USER_START, (u32)_end))
-            return -5; // would overwrite our own code or the source image
-        if (r2Overlaps(ph->vaddr, end, sp - R2_STACK_GUARD, R2_USER_END))
-            return -6; // would overwrite the stack the copy loop runs on
-    }
-    return 0;
-}
-
-int ripps2LaunchMemoryFiles(void)
-{
-    const u8 *img = ripps2_memfiles_elf;
-    const r2_elf_header_t *eh = (const r2_elf_header_t *)img;
-    u32 i;
-    int rc = r2CheckElf(img, size_ripps2_memfiles_elf);
-
-    if (rc < 0) {
-        LOG("RIPPS2 Memory Files ELF rejected (%d)\n", rc);
-        return rc;
-    }
-
-    ripps2PlayLaunchSequence(); // pillars light up; the last frame holds through the handoff
-    deinit(NO_EXCEPTION, IO_MODE_SELECTED_ALL);
-
-    // Start the program on a clean IOP
-    SifInitRpc(0);
-    while (!SifIopReset("", 0))
-        ;
-    while (!SifIopSync())
-        ;
-    SifInitRpc(0);
-    SifExitRpc();
-
-    for (i = 0; i < eh->phnum; i++) {
-        const r2_elf_pheader_t *ph = r2Segment(img, eh, i);
-
-        if (ph->type != R2_PT_LOAD)
-            continue;
-        memcpy((void *)ph->vaddr, img + ph->offset, ph->filesz);
-        if (ph->memsz > ph->filesz)
-            memset((void *)(ph->vaddr + ph->filesz), 0, ph->memsz - ph->filesz);
-    }
-
-    FlushCache(0);
-    FlushCache(2);
-    ExecPS2((void *)eh->entry, NULL, 0, NULL);
-    return -7; // ExecPS2 does not return
-}
