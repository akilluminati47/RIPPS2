+'''
+
+MAPPING_WANT = [
+    '512 write=1 read=1',
+    '511 write=0 read=0',
+    '256 write=0 read=0',
+    '1 write=0 read=0',
+    '0 write=0 read=0',
+    '-5 write=0 read=0',
+    '-2 write=0 read=0',
+    '-1000 write=0 read=0',
+    'calls 8 8',
+]
