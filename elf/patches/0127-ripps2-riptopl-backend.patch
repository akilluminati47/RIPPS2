 #endif
-    g_bd->write(g_bd, lba, buffer, nsectors);
+    {
+        // build 126 (RiptOPL #1201): MX4SIO ("sdc"): when a multi-sector write stops part way, its driver retries
+        // the rest from the first sector again instead of the next one (ps2dev/ps2sdk#936), so the last sectors can
+        // be left unwritten while the call reports success. It gets one sector per call; every other driver the run
+        unsigned short int step = nsectors, done = 0;
