diff --git a/.github/scripts/test_ilink_scsi_geometry.py b/.github/scripts/test_ilink_scsi_geometry.py
new file mode 100644
index 0000000..f2ab439
--- /dev/null
+++ b/.github/scripts/test_ilink_scsi_geometry.py
@@ -0,0 +1,164 @@
+"""Compile both real SCSI implementations against simulated READ CAPACITY replies.
+
+Verify byte-bounded reads/writes for 512/2048/4096-byte blocks, exact sector
+counts, RC16 selection/fallback, and refusal of unrepresentable geometry.
+"""
+from pathlib import Path
+import argparse
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+DRIVERS = (
+    Path('modules/ilink/IEEE1394_bd/src'),
+    Path('modules/bdmassault/ilink_bd_assault/src/IEEE1394_bd/src'),
+)
+TYPES = '''#ifndef TEST_TYPES_H
+#define TEST_TYPES_H
+#include <stdint.h>
+typedef uint8_t u8; typedef uint16_t u16; typedef uint32_t u32; typedef uint64_t u64;
+#endif
+'''
+BDM = '''#ifndef TEST_BDM_H
+#define TEST_BDM_H
+#include "tamtypes.h"
+struct block_device {
+    void *priv; char *name; unsigned int devNr,parNr; unsigned char parId;
+    unsigned int sectorSize; u64 sectorOffset,sectorCount;
+    int (*read)(struct block_device *,u64,void *,u16);
+    int (*write)(struct block_device *,u64,const void *,u16);
+    void (*flush)(struct block_device *);
+    int (*stop)(struct block_device *);
+    char *path;
+};
+void bdm_connect_bd(struct block_device *);
+void bdm_disconnect_bd(struct block_device *);
+#endif
+'''
+HARNESS = r'''
+#include <stdio.h>
+#include <string.h>
+#include "bdm.h"
+#include "scsi.h"
+#include "thbase.h"
+void GetSystemTime(iop_sys_clock_t *c) { c->lo=c->hi=0; }
+void SysClock2USec(iop_sys_clock_t *c,uint32_t *s,uint32_t *u) { (void)c;*s=*u=0; }
+
+static struct block_device *connected;
+static unsigned int block_size=512,last10=999,block16=512;
+static u64 last16=0x100000002ull;
+static int fail16,calls16,rw_calls,failures,expected_write;
+static unsigned int transferred,max_bytes;
+static unsigned char data[131072];
+static u64 expected_lba;
+#define CHECK(c,msg) do { if(!(c)) { printf("FAIL %s\n",msg);failures++; } } while(0)
+int DelayThread(int us) { (void)us;return 0; }
+void bdm_connect_bd(struct block_device *bd) { connected=bd; }
+void bdm_disconnect_bd(struct block_device *bd) { (void)bd;connected=NULL; }
+static void be32(unsigned char *p,unsigned int v) { p[0]=v>>24;p[1]=v>>16;p[2]=v>>8;p[3]=v; }
+static int lun(struct scsi_interface *s) { (void)s;return 0; }
+static int command(struct scsi_interface *s,const unsigned char *cmd,unsigned int len,
+                   unsigned char *buffer,unsigned int bytes,unsigned int write) {
+    (void)s;(void)len;
+    switch(cmd[0]) {
+        case 0x25: be32(buffer,last10);be32(buffer+4,block_size);return 0;
+        case 0x9e:
+            calls16++;
+            if(fail16) return -1;
+            be32(buffer,last16>>32);be32(buffer+4,last16);be32(buffer+8,block16);return 0;
+        case 0x28: case 0x2a: case 0x88: case 0x8a: {
+            unsigned int sectors;
+            u64 lba=0;
+            int i;
+            if(cmd[0]==0x88 || cmd[0]==0x8a) {
+                for(i=2;i<10;i++) lba=(lba<<8)|cmd[i];
+                sectors=((unsigned int)cmd[10]<<24)|((unsigned int)cmd[11]<<16)|(cmd[12]<<8)|cmd[13];
+            } else {
+                for(i=2;i<6;i++) lba=(lba<<8)|cmd[i];
+                sectors=(cmd[7]<<8)|cmd[8];
+            }
+            CHECK(bytes<=65024,"each SCSI transfer fits ORB length and staging buffer");
+            CHECK(sectors>0,"chunking makes progress");
+            CHECK(bytes==sectors*connected->sectorSize,"CDB sectors match transfer bytes");
+            CHECK(lba==expected_lba,"chunks advance disk LBA");
+            CHECK(buffer==data+transferred,"chunks advance memory pointer");
+            CHECK(write==(unsigned int)expected_write,"read/write direction reaches transport");
+            expected_lba+=sectors;transferred+=bytes;rw_calls++;
+            if(bytes>max_bytes) max_bytes=bytes;
+            return 0;
+        }
+        default: memset(buffer,0,bytes);return 0;
+    }
+}
+static struct scsi_interface iface={.name="sd",.max_sectors=127,.get_max_lun=lun,.queue_cmd=command};
+static void disconnect(void) { scsi_disconnect(&iface);connected=NULL; }
+static void transfer(unsigned int size,unsigned int count,unsigned int chunks) {
+    block_size=size;last10=999;scsi_connect(&iface);
+    CHECK(connected!=NULL,"supported geometry is connected");
+    if(!connected) return;
+    CHECK(connected->sectorCount==1000,"capacity is last LBA plus one");
+    for(expected_write=0;expected_write<2;expected_write++) {
+        expected_lba=123;transferred=max_bytes=rw_calls=0;
+        int rc=expected_write ? connected->write(connected,123,data,count) : connected->read(connected,123,data,count);
+        CHECK(rc==(int)count,"full block request completes");
+        CHECK(transferred==size*count && rw_calls==(int)chunks,"byte limit selects exact chunk sizes");
+    }
+    disconnect();
+}
+int main(void) {
+    setvbuf(stdout, NULL, _IONBF, 0);
+    scsi_init();
+    transfer(512,128,2);transfer(2048,33,2);transfer(4096,32,3);transfer(65024,2,2);
+    block_size=512;last10=0;scsi_connect(&iface);
+    CHECK(connected && connected->sectorCount==1,"one-block disk has one usable sector");disconnect();
+    last10=0xffffffffu;calls16=0;scsi_connect(&iface);
+#ifdef NATIVE_DRIVER
+    CHECK(calls16==1 && connected && connected->sectorCount==last16+1,"RC10 sentinel selects exact 64-bit capacity");
+    disconnect();fail16=1;scsi_connect(&iface);
+    CHECK(connected && connected->sectorCount==0x100000000ull,"unsupported RC16 preserves RC10 addressable range");
+    disconnect();fail16=0;last16=~0ull;scsi_connect(&iface);
+    CHECK(!connected,"unrepresentable RC16 sector count is refused");disconnect();
+    last16=0x100000002ull;block16=65536;scsi_connect(&iface);
+    CHECK(!connected,"oversized RC16 block length is refused");disconnect();
+#else
+    CHECK(calls16==0 && connected && connected->sectorCount==0x100000000ull,"legacy RC10 range does not wrap to zero");
+#endif
+    disconnect();last10=999;block_size=65536;scsi_connect(&iface);
+    CHECK(!connected,"block larger than one SBP-2 buffer is refused");disconnect();
+    block_size=0;scsi_connect(&iface);
+    CHECK(!connected,"zero block length is refused");disconnect();
+    return failures ? 1 : 0;
+}
+'''
+
+
+def run(driver, native):
+    with tempfile.TemporaryDirectory() as directory:
+        folder = Path(directory)
+        for name, text in {'tamtypes.h': TYPES, 'bdm.h': BDM, 'sysclib.h': '#include <string.h>\n',
+                           'thbase.h': '#include <stdint.h>\ntypedef struct { uint32_t lo, hi; } iop_sys_clock_t;\nint DelayThread(int);\nvoid GetSystemTime(iop_sys_clock_t *);\nvoid SysClock2USec(iop_sys_clock_t *, uint32_t *, uint32_t *);\n', 'thsemap.h': ''}.items():
+            (folder / name).write_text(text, encoding='utf-8')
+        cfile = folder / 'geometry.c'
+        cfile.write_text(HARNESS, encoding='utf-8')
+        exe = folder / ('geometry.exe' if sys.platform == 'win32' else 'geometry')
+        flags = ['-DNATIVE_DRIVER'] if native else []
+        subprocess.run(['gcc', '-std=gnu2x', '-O2', '-Wall', '-Werror', '-DMINI_DRIVER', *flags,
+                        '-I', str(folder), '-I', str(driver), '-I', str(driver / 'include'),
+                        str(driver / 'scsi.c'), str(cfile), '-o', str(exe)], check=True, timeout=60)
+        result = subprocess.run([str(exe)], capture_output=True, text=True, timeout=10)
+        print(str(driver) + ':')
+        if result.returncode == 0:
+            print(result.stdout.strip() or 'PASS: geometry, capacity and byte-bounded I/O')
+        else:
+            print(result.stdout.strip() or 'FAIL: harness exited %d' % result.returncode)
+            if result.stderr: print(result.stderr.strip())
+        return result.returncode == 0
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source-root', type=Path, default=ROOT)
+    args = parser.parse_args()
+    results = [run(args.source_root / driver, native=i == 0) for i, driver in enumerate(DRIVERS)]
+    sys.exit(0 if all(results) else 1)
diff --git a/.github/scripts/test_iso9660_records.py b/.github/scripts/test_iso9660_records.py
new file mode 100644
index 0000000..1fbc568
--- /dev/null
+++ b/.github/scripts/test_iso9660_records.py
@@ -0,0 +1,220 @@
+#!/usr/bin/env python3
+"""Regression tests for the ISO 9660 directory walk in isofs (the game list) and the in-game CDVDMAN.
+
+Both copies of cdvdman_locatefile() are compiled on the host, with AddressSanitizer when it is
+available, and run on directory sectors built here: a record without a name used to stop the scan
+from advancing (an endless loop), a non-zero extended attribute byte was read as the high byte of
+the record length (a step of 256+ bytes, or backwards), and damaged records were walked past the
+sector. Ported from belomaxorka/YAOPL ff498c19, af5b52b7 and bfe726f5, plus the bounds of our own.
+"""
+import re
+import shutil
+import struct
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+ISOFS = ROOT / 'modules/isofs/isofs.c'
+SEARCHFILE = ROOT / 'modules/iopcore/cdvdman/searchfile.c'
+INTERNAL = ROOT / 'modules/iopcore/cdvdman/internal.h'
+IOOPS = ROOT / 'modules/iopcore/cdvdman/ioops.c'
+CC = shutil.which('cc') or shutil.which('gcc')
+ROOT_LBA, SUB_LBA, FILE_LBA = 20, 30, 100
+
+
+def function(text, name):
+    match = re.search(r'\n[^\n;{}]*\b' + re.escape(name) + r'\([^;{]*\)[^;{\n]*\n\{', text)
+    assert match, name
+    depth, i = 0, match.end() - 1
+    while True:
+        depth += {'{': 1, '}': -1}.get(text[i], 0)
+        i += 1
+        if depth == 0:
+            return text[match.start():i]
+
+
+def dir_struct(text):
+    match = re.search(r'struct dirTocEntry\n\{.*?\} __attribute__\(\(packed\)\);', text, re.S)
+    assert match
+    return match.group(0)
+
+
+def record(name, lba=0, size=0, flags=0, length=None, ext=0, pad=True):
+    raw = name.encode() if isinstance(name, str) else name
+    body = struct.pack('<BBIIIIxxxxxxBB6xB', 0, ext, lba, 0, size, 0, 0, flags, len(raw)) + raw
+    if pad and len(body) % 2:
+        body += b'\0'
+    body = bytes([len(body) if length is None else length]) + body[1:]
+    return body
+
+
+def sector(*records, fill=b'\0'):
+    data = b''.join(records)
+    assert len(data) <= 2048
+    return data + fill * (2048 - len(data))
+
+
+def standard(*middle):
+    return sector(record(b'\0', ROOT_LBA, 2048, 2), record(b'\1', ROOT_LBA, 2048, 2), *middle)
+
+
+COMMON = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint8_t u8;
+typedef uint32_t u32;
+#define DPRINTF(...)
+static unsigned char disc[64][2048];
+static int sceCdReadDvdDualInfo(int *on_dual, u32 *layer1_start) { *on_dual = 0; *layer1_start = 0; return 1; }
+'''
+MAIN = r'''
+int main(int argc, char **argv)
+{
+    FILE *f = fopen(argv[1], "rb");
+    if (!f || fread(disc, 1, sizeof(disc), f) != sizeof(disc))
+        return 2;
+    fclose(f);
+    char path[256];
+    strcpy(path, argv[2]);
+    struct dirTocEntry *e = cdvdman_locatefile(path, %(root)d, 2048, 0);
+    if (e)
+        printf("%%u %%u\n", (unsigned)e->fileLBA, (unsigned)e->fileSize);
+    else
+        puts("none");
+    return 0;
+}
+'''
+
+
+def isofs_source():
+    text = ISOFS.read_text()
+    return COMMON + dir_struct(text) + r'''
+static unsigned char cdvdman_buf[2048];
+static int cdEmuRead(u32 lsn, unsigned int count, void *buffer) { memcpy(buffer, disc[lsn], 2048); return 0; }
+''' + function(text, 'cdvdman_locatefile') + MAIN % {'root': ROOT_LBA}
+
+
+def ingame_source():
+    text = SEARCHFILE.read_text()
+    return COMMON + dir_struct(INTERNAL.read_text()) + r'''
+#define IOPCORE_COMPAT_EMU_DVDDL 0x10
+static struct { struct { int flags; } common; } cdvdman_settings;
+static unsigned char cdvdman_buf[2048];
+static int sceCdRead(u32 lsn, u32 count, void *buffer, void *mode) { memcpy(buffer, disc[lsn], 2048); return 1; }
+static int sceCdSync(int mode) { return 0; }
+''' + function(text, 'cdvdman_locatefile') + MAIN % {'root': ROOT_LBA}
+
+
+@unittest.skipUnless(CC, 'no host C compiler')
+class LocateFileTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp = tempfile.TemporaryDirectory()
+        cls.exes = {}
+        for name, source in (('isofs', isofs_source()), ('ingame', ingame_source())):
+            src = Path(cls.tmp.name) / (name + '.c')
+            src.write_text(source)
+            exe = Path(cls.tmp.name) / name
+            for flags in (['-fsanitize=address,undefined', '-fno-omit-frame-pointer'], []):
+                built = subprocess.run([CC, '-std=gnu99', '-g', '-O1', '-w', *flags, '-o', str(exe), str(src)],
+                                       capture_output=True, text=True)
+                if built.returncode == 0:
+                    break
+            assert built.returncode == 0, built.stderr
+            cls.exes[name] = exe
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.tmp.cleanup()
+
+    def locate(self, which, root, path, sub=None):
+        image = bytearray(64 * 2048)
+        image[ROOT_LBA * 2048:(ROOT_LBA + 1) * 2048] = root
+        if sub is not None:
+            image[SUB_LBA * 2048:(SUB_LBA + 1) * 2048] = sub
+        disc = Path(self.tmp.name) / 'disc.bin'
+        disc.write_bytes(bytes(image))
+        try:
+            run = subprocess.run([str(self.exes[which]), str(disc), path], capture_output=True, text=True, timeout=5)
+        except subprocess.TimeoutExpired:
+            self.fail(f'{which}: {path}: the directory walk did not end')
+        self.assertEqual(run.returncode, 0, f'{which}: {path}: {run.stderr[-2000:]}')
+        return run.stdout.strip()
+
+    def both(self, root, path, expect, sub=None):
+        for which in ('isofs', 'ingame'):
+            with self.subTest(which=which, path=path):
+                self.assertEqual(self.locate(which, root, path, sub), expect)
+
+    def test_plain_lookup(self):
+        self.both(standard(record('SYSTEM.CNF;1', FILE_LBA, 77)), '\\SYSTEM.CNF;1', f'{FILE_LBA} 77')
+        self.both(standard(record('SYSTEM.CNF;1', FILE_LBA, 77)), '/SYSTEM.CNF;1', f'{FILE_LBA} 77')
+        self.both(standard(record('SYSTEM.CNF;1', FILE_LBA, 77)), '\\MISSING.ELF;1', 'none')
+
+    def test_record_without_a_name_is_stepped_over(self):  # YAOPL ff498c19
+        root = standard(record(b'', length=34), record('SYSTEM.CNF;1', FILE_LBA, 77))
+        self.both(root, '\\SYSTEM.CNF;1', f'{FILE_LBA} 77')
+
+    def test_extended_attribute_byte_is_not_part_of_the_length(self):  # YAOPL af5b52b7
+        for ext in (0x01, 0x80, 0xff):
+            root = standard(record('README.TXT;1', 5, 1, ext=ext), record('SYSTEM.CNF;1', FILE_LBA, 77))
+            self.both(root, '\\SYSTEM.CNF;1', f'{FILE_LBA} 77')
+
+    def test_damaged_records_end_the_sector_inside_it(self):
+        short = standard(record('BROKEN.BIN;1', length=36), record('SYSTEM.CNF;1', FILE_LBA, 77))
+        self.both(short, '\\SYSTEM.CNF;1', 'none')  # shorter than its own name: nothing after it is trusted
+        # A record that starts in the last bytes of the sector and claims to run past it.
+        filler = [record(b'', length=36)[:34] + b'\0\0' for _ in range(55)]
+        tail = record('AAAAAAA')
+        past_end = (record(b'\0', ROOT_LBA, 2048, 2) + b''.join(filler) + tail)[:2048]
+        self.assertEqual(len(past_end), 2048)
+        self.both(past_end, '\\AAAAAAA', 'none')
+        self.both(sector(record('X' * 200, length=255)), '\\SYSTEM.CNF;1', 'none')
+
+    def test_names_longer_than_level_1(self):  # YAOPL a2ff76fc, already bounded here
+        root = standard(record('A_VERY_LONG_LEVEL2_FILENAME_HERE.TXT;1', 5, 1), record('SYSTEM.CNF;1', FILE_LBA, 77))
+        self.both(root, '\\SYSTEM.CNF;1', f'{FILE_LBA} 77')
+
+    def test_nested_directory(self):
+        root = standard(record('DATA', SUB_LBA, 2048, 2))
+        sub = standard(record(b'', length=34), record('MOVIE.PSS;1', FILE_LBA, 4096, ext=0x80))
+        self.both(root, '\\DATA\\MOVIE.PSS;1', f'{FILE_LBA} 4096', sub)
+
+    def test_isofs_compares_within_the_record(self):
+        # An odd-length name has no pad byte, so the next record's length byte follows it directly.
+        root = standard(record('SLUS_200.62;1', FILE_LBA, 9, pad=False), record('SYSTEM.CNF;1', 101, 77))
+        self.assertEqual(self.locate('isofs', root, '\\SLUS_200.62;1'), f'{FILE_LBA} 9')
+        # A name that only starts like the wanted one is not it.
+        root = standard(record('SYSTEM.CNF;12', 5, 1), record('SYSTEM.CNF;1', FILE_LBA, 77))
+        self.assertEqual(self.locate('isofs', root, '\\SYSTEM.CNF;1'), f'{FILE_LBA} 77')
+
+
+class SourceTests(unittest.TestCase):
+    def test_record_length_is_one_byte(self):
+        for text in (ISOFS.read_text(), INTERNAL.read_text()):
+            body = dir_struct(text)
+            self.assertRegex(body, r'\{\s*u8 length;[^\n]*\n\s*u8 extAttrLength;')
+            self.assertNotIn('short length', body)
+        for path in (ISOFS, SEARCHFILE):
+            self.assertNotIn('<< 16) >> 16', path.read_text())
+
+    def test_found_name_is_bounded_and_takes_either_separator(self):
+        for path in (ISOFS, SEARCHFILE):
+            body = function(path.read_text(), 'cdvdman_findfile')
+            self.assertNotIn('strcpy(pcdfile->name', body)
+            self.assertIn("if (*c == '\\\\' || *c == '/')", body)
+            self.assertIn('strncpy(pcdfile->name, base, sizeof(pcdfile->name) - 1);', body)
+            self.assertIn("pcdfile->name[sizeof(pcdfile->name) - 1] = '\\0';", body)
+
+    def test_dread_stays_in_the_sector(self):
+        body = function(IOOPS.read_text(), 'cdrom_dread')
+        self.assertLess(body.index('if (fh->position > 2048 - 34)'), body.index('&cdvdman_fs_buf[fh->position]'))
+        self.assertIn('if (tocEntryPointer != NULL) {', body)
+
+
+if __name__ == '__main__':
+    unittest.main()
