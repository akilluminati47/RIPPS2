+#define DBUF_FIFO_RESET_TX 0x00008000
+#define DBUF_FIFO_RESET_RX 0x80000000
+
+#define PACKET_TCODE (((x) >> 4) & 0xF)
+
+/* PHY configuration packet data */
+#define PHY_CONFIG_PACKET     0xE0
+#define PHY_CONFIG_GAP_CNT(x) (((x) >> 16) & 0x3F)
