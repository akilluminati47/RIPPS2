+    // The row still owns a slot of its own (its id probe, say): that answer comes first.
+    if (*cacheId >= 0 && *cacheId < cache->count && cache->content[*cacheId].UID == *UID)
+        return 0;
+    if (strlen(name) >= sizeof(cache->content[0].key))
+        return 0;
