+// A plasma tail: the orb's recent path, smoothed into a curve (Catmull-Rom through the samples), drawn
+// as two soft ribbons that fade to clear at their edges: a wide blue glow and a narrow hot core that
+// is white at the orb and cools to blue, then violet, as it thins away. A faint ripple runs down it.
+#define TAIL_SUB 3                         // curve points between two samples
+#define TAIL_PTS ((TRAIL_N - 1) * TAIL_SUB + 1)
+
+static float catmull(float p0, float p1, float p2, float p3, float u)
+{
+    float u2 = u * u, u3 = u2 * u;
+    return 0.5f * (2.0f * p1 + (p2 - p0) * u + (2.0f * p0 - 5.0f * p1 + 4.0f * p2 - p3) * u2 + (3.0f * p1 - p0 - 3.0f * p2 + p3) * u3);
