+// A soft line for the pillars and the floor: a core `core` px across with a feather of `feather` px
+// each side, fading to clear. On a CRT in 480i a one-scanline line exists in one field only and
+// flickers at 30 Hz; this one is at least two scanlines tall at any angle, so both fields carry it,
+// and the feather antialiases it at the same time. Colour as given; drawn in the current blend.
+static u64 softClear(u64 c)
+{
+    return c & ~(0xFFULL << 24);
+}
+
+static void softLine(float x1, float y1, float x2, float y2, float core, float feather, u64 c)
+{
+    float dx = x2 - x1, dy = y2 - y1, len = sqrtf(dx * dx + dy * dy);
+    if (len < 0.25f)
+        return;
+    // across the line: its true normal, but never thinner than two scanlines up and down, so a nearly
+    // flat line stays thick enough for both fields of an interlaced picture
+    float nx = -dy / len, ny = dx / len;
+    float h = core * 0.5f, ny2 = h;
+    if (fabsf(ny) > 0.7f && fabsf(ny) * h < 1.0f) // within 45 degrees of flat: a core two scanlines tall
+        ny2 = 1.0f / fabsf(ny);
+    float ax = nx * ny2, ay = ny * ny2;                 // half the core
+    float fx = nx * (ny2 + feather), fy = ny * (ny2 + feather); // to the outer edge of the feather
+    u64 clear = softClear(c);
+    rmDrawQuadGouraud(x1 + ax, y1 + ay, c, x2 + ax, y2 + ay, c, x1 - ax, y1 - ay, c, x2 - ax, y2 - ay, c);
+    rmDrawQuadGouraud(x1 + fx, y1 + fy, clear, x2 + fx, y2 + fy, clear, x1 + ax, y1 + ay, c, x2 + ax, y2 + ay, c);
+    rmDrawQuadGouraud(x1 - ax, y1 - ay, c, x2 - ax, y2 - ay, c, x1 - fx, y1 - fy, clear, x2 - fx, y2 - fy, clear);
+}
