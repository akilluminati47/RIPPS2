+// RIPPS2 build 91: the corners are turned in the 640 x 480 page's own square space, then the widescreen
+// squeeze is applied about the centre, then scaled to the display, so a round thing stays round at any angle
+void rmDrawPixmapRotated(GSTEXTURE *txt, int cx, int cy, int w, int h, float angle, u64 color)
+{
+    if (txt == NULL || txt->Mem == NULL || rmQueueFull())
+        return;
+    float c = cosf(angle), s = sinf(angle), squeeze = rmWideScale(1000) / 1000.0f;
+    float lx[4] = {-w / 2.0f, w / 2.0f, -w / 2.0f, w / 2.0f}, ly[4] = {-h / 2.0f, -h / 2.0f, h / 2.0f, h / 2.0f};
+    float px[4], py[4];
+    int k;
+    for (k = 0; k < 4; k++) {
+        px[k] = X_SCALE(cx + squeeze * (lx[k] * c - ly[k] * s));
+        py[k] = Y_SCALE(cy + (lx[k] * s + ly[k] * c));
+    }
+    if ((txt->PSM == GS_PSM_CT32) || (txt->Clut && txt->ClutPSM == GS_PSM_CT32)) {
+        gsGlobal->PrimAlphaEnable = GS_SETTING_ON;
+        gsKit_set_test(gsGlobal, GS_ATEST_ON);
+    } else {
+        gsGlobal->PrimAlphaEnable = ((color >> 24) & 0xFF) < 0x80 ? GS_SETTING_ON : GS_SETTING_OFF;
+        gsKit_set_test(gsGlobal, GS_ATEST_OFF);
+    }
+    gsKit_TexManager_bind(gsGlobal, txt);
+    if (gTiltOn)
+        rmTiltTexQuad(txt, px, py, 0.0f, 0.0f, txt->Width, txt->Height, color);
+    else
+        gsKit_prim_quad_texture(gsGlobal, txt,
+                                px[0] + fRenderXOff, py[0] + fRenderYOff, 0.0f, 0.0f,
+                                px[1] + fRenderXOff, py[1] + fRenderYOff, txt->Width, 0.0f,
+                                px[2] + fRenderXOff, py[2] + fRenderYOff, 0.0f, txt->Height,
+                                px[3] + fRenderXOff, py[3] + fRenderYOff, txt->Width, txt->Height, order, color);
+    order++;
+}
