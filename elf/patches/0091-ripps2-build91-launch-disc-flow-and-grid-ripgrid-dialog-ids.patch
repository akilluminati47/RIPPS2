+// ---- build 91: the launch disc ----
+// As a game starts, its disc comes in over the middle of the page where the launch's Please Wait would sit:
+// the game's own disc art (ICO), else RIPPS2's disc (a theme's launch_disc.png). pop: it arrives the way the
+// L3 logos do (a touch large, settling, with a glow), holds and fades. spin: it arrives the same way, then
+// turns, faster and faster up to a cap, and never fades: it is still turning when the game takes the screen.
+#define DISC_SIZE   150
+#define DISC_Y      228   // the view word's line
+#define DISC_IN_S   0.40f
+#define DISC_HOLD_S 0.90f
+#define DISC_OUT_S  0.55f
+#define DISC_REV0   0.25f // turns a second as it lands
+#define DISC_RAMP   0.90f // and faster by this, each second
+#define DISC_REVMAX 2.20f // the cap: past this a 50 Hz picture strobes the turn
+#define DISC_ICO_WAIT 500 // art worker ticks to wait for it to let go before the ICO is read
+int gRipps2LaunchDisc = 0;
+static GSTEXTURE launchIco;
+static int launchArmed = 0, launchMode = 0;
+static clock_t launchStart = 0;
+
+int ripps2LaunchDiscMode(void)
+{
+    if (gRipps2LaunchDisc == 1)
+        return 0;
+    if (gRipps2LaunchDisc >= 2 && gRipps2LaunchDisc <= 3)
+        return gRipps2LaunchDisc - 1;
+    return gTheme != NULL ? gTheme->launchDiscDef : 0;
+}
+
+static void launchIcoFree(void)
+{
+    if (launchIco.Mem != NULL) {
+        rmUnloadTexture(&launchIco);
+        texFree(&launchIco);
+    }
+    memset(&launchIco, 0, sizeof(launchIco));
+}
+
+void ripps2LaunchDiscArmGeneric(void)
+{
+    launchIcoFree();
+    launchMode = ripps2LaunchDiscMode();
+    launchArmed = launchMode != 0;
+    launchStart = 0;
+}
+
+void ripps2LaunchDiscArm(struct _item_list_t *support, const char *startup)
+{
+    char folder[8] = "ART", suffix[8] = "ICO", value[128];
+
+    ripps2LaunchDiscArmGeneric();
+    if (!launchArmed || support == NULL || support->itemGetImage == NULL || startup == NULL || startup[0] == '\0')
+        return;
+    // the art worker reads covers off the same drive: let it go first, or use RIPPS2's disc
+    if (!cacheCancelPendingImageLoadsTimed(DISC_ICO_WAIT))
+        return;
+    snprintf(value, sizeof(value), "%s", startup);
+    if (support->itemGetImage(support, folder, 1, value, suffix, &launchIco, GS_PSM_CT24) < 0 || launchIco.Mem == NULL ||
+        launchIco.Width == 0 || launchIco.Height == 0)
+        launchIcoFree();
+}
+
+void ripps2LaunchDiscBegin(void)
+{
+    if (launchArmed) {
+        launchStart = clock();
+        if (launchStart == 0)
+            launchStart = 1;
+    }
+}
+
+void ripps2LaunchDiscEnd(void)
+{
+    launchArmed = 0;
+    launchStart = 0;
+    launchIcoFree();
+}
+
+static void viewWordBand(float cx, float cy, float halfW, float halfH, float fade, int r, int g, int b, int a);
+
+int ripps2DrawLaunchDisc(void)
+{
+    if (!launchArmed)
+        return 0;
+    if (launchStart == 0)
+        ripps2LaunchDiscBegin();
+    GSTEXTURE *tex = launchIco.Mem != NULL ? &launchIco : thmGetTexture(RIPPS2_LAUNCH_DISC);
+    if (tex == NULL || tex->Width == 0 || tex->Height == 0)
+        return 0;
+
+    float t = (float)(clock() - launchStart) / (float)CLOCKS_PER_SEC, out = 0.0f, keep = 1.0f;
+    if (launchMode == 1) {
+        float outStart = DISC_IN_S + DISC_HOLD_S;
+        if (t >= outStart + DISC_OUT_S)
+            return 0;
+        out = t > outStart ? (t - outStart) / DISC_OUT_S : 0.0f;
+        keep = 1.0f - out * out;
+    }
+    float li = t < DISC_IN_S ? t / DISC_IN_S : 1.0f;
+    float s = (1.0f + 0.16f * (1.0f - easeOutBack(li))) * (1.0f + 0.10f * out);
+    float flare = sinf(3.14159265f * li);
+    int a = (int)(0x80 * fminf(1.0f, li * 1.8f) * keep);
+    int h = DISC_SIZE, w = DISC_SIZE * tex->Width / tex->Height;
+    float angle = 0.0f;
+    if (launchMode == 2) { // the turn: up from DISC_REV0 by DISC_RAMP a second, then held at DISC_REVMAX
+        float tcap = (DISC_REVMAX - DISC_REV0) / DISC_RAMP;
+        float revs = t < tcap ? DISC_REV0 * t + 0.5f * DISC_RAMP * t * t
+                              : DISC_REV0 * tcap + 0.5f * DISC_RAMP * tcap * tcap + DISC_REVMAX * (t - tcap);
+        angle = revs * 6.2831853f;
+    }
+
+    // a faint dark halo keeps it clear of whatever is behind (kept small and soft: on the launch's white
+    // flash a stronger one read as a grey square)
+    int bandA = (int)(fminf(1.0f, li * 2.0f) * keep * 0x80);
+    viewWordBand(320.0f, (float)DISC_Y, w * s / 2.0f * 0.6f, h * s / 2.0f * 0.6f, w * s * 0.55f, 0x01, 0x02, 0x0A, bandA / 4);
+    rmSetBlendAdditive(1); // the glow: a larger copy, brightest as it lands
+    rmDrawPixmapRotated(tex, 320, DISC_Y, (int)(w * s * 1.08f), (int)(h * s * 1.08f), angle,
+                        GS_SETREG_RGBAQ(0x80, 0x80, 0x80, (int)((0x10 + 0x40 * flare) * keep), 0x00));
+    rmSetBlendAdditive(0);
+    rmDrawPixmapRotated(tex, 320, DISC_Y, (int)(w * s), (int)(h * s), angle, GS_SETREG_RGBAQ(0x80, 0x80, 0x80, a, 0x00));
+    return 1;
+}
