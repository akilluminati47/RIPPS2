diff --git a/src/dia.c b/src/dia.c
index 983a7d8..e448484 100644
--- a/src/dia.c
+++ b/src/dia.c
@@ -1061,13 +1061,37 @@ void diaSetSettingsContext(int enabled)
 
 // The lowest pixel the dialog would reach (content space, from `top`) with rows `gap` apart. Walks the
 // items exactly as diaRenderUI lays them out, with diaItemHeight standing in for diaRenderItem's *h.
+// RIPPS2 build 91: a row whose controls are all hidden (BDMA Source and Mode while Apply on Launch is on,
+// HTTP's rows on an SMB page) takes no line. Its label and value go, but its spacer and the break that ends
+// it used to leave a blank line, the rows below floating under a gap. diaRowState follows a row: hidden
+// when something on it is hidden, shown when something drawn is; its break is skipped when only the first.
+static void diaRowState(struct UIItem *ui, int *rowHidden, int *rowShown)
+{
+    if (!ui->visible && ui->type >= UI_LABEL)
+        *rowHidden = 1;
+    else if (ui->type != UI_SPACER && ui->type != UI_BREAK)
+        *rowShown = 1;
+}
+
+static int diaRowCollapses(struct UIItem *ui, int rowHidden, int rowShown)
+{
+    return ui->type == UI_BREAK && rowHidden && !rowShown;
+}
+
 static int diaLayoutBottom(struct UIItem *ui, int spacingH, int gap, int top)
 {
-    int y = top, hmax = 0, bottom = top;
+    int y = top, hmax = 0, bottom = top, rowHidden = 0, rowShown = 0;
 
     for (; ui->type != UI_TERMINATOR; ui++) {
         int h;
 
+        if (diaRowCollapses(ui, rowHidden, rowShown)) {
+            rowHidden = rowShown = 0;
+            continue;
+        }
+        if (diaShouldBreakLine(ui))
