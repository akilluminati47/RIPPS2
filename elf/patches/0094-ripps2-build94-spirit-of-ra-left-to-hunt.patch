diff --git a/src/rahunt.c b/src/rahunt.c
new file mode 100644
index 0000000..1dc166d
--- /dev/null
+++ b/src/rahunt.c
@@ -0,0 +1,385 @@
+/*
+  RIPPS2 build 94: what is left to hunt in a game, and how each one is earned.
+
+  xeRAbora (the PC client) knows a game's whole set once a console has identified the game: its interface
+  page asks for it as GET /state, JSON, every achievement with its title, description, points and state.
+  When OPEN TO THE NETWORK is on in xeRAbora's settings, the console can ask the same thing over the
+  network, so CHECK GAME SUPPORT (ranet.c) does, and saves the set beside the game's list as
+  RA/<serial>.ach:
+
+    RIPPS2 ACH 1
+    <unlocked 0|1> TAB <points> TAB <title> TAB <description>      one line per achievement
+
+  Achievements > YOUR ACCOUNT reads it back (raHuntRead), and a launch hands the locked ones to the in-game
+  menu (raHuntBlob): its ACHIEVEMENTS page shows one at a time, title, points and how to earn it. They go
+  in the menu's own lines, wrapped here: ee_core's stack is the room its code leaves, so it only prints.
+
+  Plain C with no console calls, so elf/tests runs it on the PC (RAHUNT_HOST_TEST).
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <ctype.h>
+#include "include/rahunt.h"
+
+// ---- reading xeRAbora's /state ----
+
+// The code point of the UTF-8 sequence at *pp, which moves past it; a broken one is '?'
+static unsigned huntUtf8(const char **pp, const char *end)
+{
+    const unsigned char *p = (const unsigned char *)*pp;
+    unsigned u = *p++;
+    int more = u >= 0xF0 ? 3 : u >= 0xE0 ? 2 : u >= 0xC0 ? 1 : 0;
+
+    if (u >= 0x80 && more == 0)
+        u = '?'; // a stray continuation byte
+    else if (more)
+        u &= 0x3F >> more;
+    while (more-- > 0) {
+        if ((const char *)p >= end || (*p & 0xC0) != 0x80) {
+            u = '?';
+            break;
+        }
+        u = u << 6 | (*p++ & 0x3F);
+    }
+    *pp = (const char *)p;
+    return u;
+}
+
+// marks the PS2's fonts do not have, as plain ones; control characters as spaces (the .ach is TAB separated)
+static unsigned huntPlain(unsigned u)
+{
+    if (u == 0x2018 || u == 0x2019 || u == 0x2032)
+        return '\'';
+    if (u == 0x201C || u == 0x201D)
+        return '"';
+    if (u == 0x2013 || u == 0x2014 || u == 0x2212)
+        return '-';
+    if (u < 0x20 || u == 0xA0)
+        return ' ';
+    if ((u >= 0xD800 && u < 0xE000) || u > 0x10FFFF)
+        return '?';
+    return u;
+}
+
+static int huntHex(const char *p)
+{
+    int v = 0, i;
+    for (i = 0; i < 4; i++) {
+        int c = (unsigned char)p[i] | 0x20;
+        v = v * 16 + (c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : 0);
+    }
+    return v;
+}
+
+// The JSON string starting at p (on its opening quote) into out as UTF-8, escapes undone, whole characters
+// only (a long one is cut short, never mid-character). Returns the character after the closing quote.
+static const char *huntString(const char *p, const char *end, char *out, int size)
+{
+    int o = 0, full = 0;
+    if (p >= end || *p != '"')
+        return NULL;
+    for (p++; p < end && *p != '"';) {
+        unsigned u;
+        char seq[4];
+        int k;
+        if (*p == '\\' && p + 1 < end) {
+            char c = p[1];
+            p += 2;
+            if (c == 'u' && p + 4 <= end) {
+                u = huntHex(p);
+                p += 4;
+                if (u >= 0xD800 && u < 0xDC00 && p + 6 <= end && p[0] == '\\' && p[1] == 'u') { // a pair
+                    unsigned lo = huntHex(p + 2);
+                    if (lo >= 0xDC00 && lo < 0xE000) {
+                        u = 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00);
+                        p += 6;
+                    }
+                }
+            } else
+                u = (c == '"' || c == '\\' || c == '/') ? (unsigned char)c : ' ';
+        } else
+            u = huntUtf8(&p, end);
+        if (u == 0x2026) { // an ellipsis
+            seq[0] = seq[1] = seq[2] = '.';
+            k = 3;
+        } else if ((u = huntPlain(u)) < 0x80) {
+            seq[0] = (char)u;
+            k = 1;
+        } else if (u < 0x800) {
+            seq[0] = (char)(0xC0 | u >> 6);
+            seq[1] = (char)(0x80 | (u & 0x3F));
+            k = 2;
+        } else if (u < 0x10000) {
+            seq[0] = (char)(0xE0 | u >> 12);
+            seq[1] = (char)(0x80 | ((u >> 6) & 0x3F));
+            seq[2] = (char)(0x80 | (u & 0x3F));
+            k = 3;
+        } else {
+            seq[0] = (char)(0xF0 | u >> 18);
+            seq[1] = (char)(0x80 | ((u >> 12) & 0x3F));
+            seq[2] = (char)(0x80 | ((u >> 6) & 0x3F));
+            seq[3] = (char)(0x80 | (u & 0x3F));
+            k = 4;
+        }
+        if (full || o + k > size - 1) {
+            full = 1;
+            continue;
+        }
+        memcpy(out + o, seq, k);
+        o += k;
+    }
+    out[o] = '\0';
+    return p < end ? p + 1 : NULL;
+}
+
+// The end of the JSON value starting at p: a string, an object or array (strings inside it skipped whole),
+// or a number or literal up to the next delimiter
+static const char *huntSkip(const char *p, const char *end)
+{
+    char tmp[2];
+    while (p < end && *p == ' ')
+        p++;
+    if (p >= end)
+        return NULL;
+    if (*p == '"')
+        return huntString(p, end, tmp, sizeof(tmp));
+    if (*p == '{' || *p == '[') {
+        int depth = 0;
+        for (; p < end; p++) {
+            if (*p == '"') {
+                if ((p = huntString(p, end, tmp, sizeof(tmp))) == NULL)
+                    return NULL;
+                p--;
+            } else if (*p == '{' || *p == '[')
+                depth++;
+            else if ((*p == '}' || *p == ']') && --depth == 0)
+                return p + 1;
+        }
+        return NULL;
+    }
+    while (p < end && *p != ',' && *p != '}' && *p != ']')
+        p++;
+    return p;
+}
+
+static int huntSame(const char *a, const char *b) // two serials alike, separators and case aside
+{
+    while (*a || *b) {
+        while (*a && !isalnum((unsigned char)*a))
+            a++;
+        while (*b && !isalnum((unsigned char)*b))
+            b++;
+        if (toupper((unsigned char)*a) != toupper((unsigned char)*b))
+            return 0;
+        if (*a)
+            a++;
+        if (*b)
+            b++;
+    }
+    return 1;
+}
+
+int raHuntFromState(const char *json, int len, const char *serial, char *out, int outsz)
+{
+    const char *end = json + len, *p, *game;
+    int n = 0, o;
+
+    // the set the page is drawing: the top level "game" object (the one with "checked_only"), and the
+    // "achievements" array that follows it; "follow" has an achievements list of its own, before it
+    if ((game = strstr(json, "\"checked_only\"")) == NULL || game >= end)
+        return -1;
+    if (serial != NULL && serial[0]) { // its "serial" must be this game's, or the PC is busy with another
+        const char *g = game;
+        while (g > json && strncmp(g, "\"game\":{", 8) != 0)
+            g--;
+        const char *s = strstr(g, "\"serial\":");
+        char got[32];
+        if (s != NULL && s < game) {
+            if (huntString(s + 9, end, got, sizeof(got)) == NULL || (got[0] && !huntSame(got, serial)))
+                return -2;
+        }
+    }
+    if ((p = strstr(game, "\"achievements\":[")) == NULL || p >= end)
+        return -1;
+    p += 16;
+    o = snprintf(out, outsz, "RIPPS2 ACH 1\n");
+    while (p < end && *p != ']') {
+        char title[RA_HUNT_TITLE], desc[RA_HUNT_DESC], key[24];
+        int points = 0, state = 0, line;
+        while (p < end && (*p == ',' || *p == ' ' || *p == '\n' || *p == '\r'))
+            p++;
+        if (p >= end || *p != '{')
+            break;
+        title[0] = desc[0] = '\0';
+        p++;
+        while (p < end && *p != '}') { // "key":value pairs at this level
+            while (p < end && (*p == ',' || *p == ' '))
+                p++;
+            if (p >= end || *p == '}')
+                break;
+            p = huntString(p, end, key, sizeof(key));
+            if (p == NULL || p >= end || *p != ':')
+                return -1;
+            p++;
+            if (!strcmp(key, "title"))
+                p = huntString(p, end, title, sizeof(title));
+            else if (!strcmp(key, "description"))
+                p = huntString(p, end, desc, sizeof(desc));
+            else if (!strcmp(key, "points")) {
+                points = atoi(p);
+                p = huntSkip(p, end);
+            } else if (!strcmp(key, "state")) {
+                state = atoi(p);
+                p = huntSkip(p, end);
+            } else
+                p = huntSkip(p, end);
+            if (p == NULL)
+                return -1;
+        }
+        if (p < end)
+            p++; // the object's '}'
+        // rcheevos' states: 0 inactive, 1 active, 2 unlocked, 3 disabled
+        line = snprintf(out + o, outsz - o, "%d\t%d\t%s\t%s\n", state == 2 ? 1 : 0, points, title, desc);
+        if (line >= outsz - o)
+            break; // full: what fitted is kept
+        o += line;
+        n++;
+    }
+    return n;
+}
+
+// ---- reading RA/<serial>.ach ----
+
+int raHuntRead(const char *text, int len, ra_hunt_t *list, int max)
+{
+    const char *p = text, *end = text + len;
+    int n = 0;
+    if (len < 12 || strncmp(text, "RIPPS2 ACH 1", 12) != 0)
+        return -1;
+    while (p < end && *p != '\n')
+        p++;
+    while (p < end && n < max) {
+        const char *e;
+        char field[4][RA_HUNT_DESC];
+        int f = 0, k;
+        if (*p == '\n')
+            p++;
+        if (p >= end)
+            break;
+        for (e = p; e < end && *e != '\n'; e++)
+            ;
+        for (k = 0; k < 4; k++)
+            field[k][0] = '\0';
+        while (p < e && f < 4) {
+            int o = 0;
+            while (p < e && *p != '\t') {
+                if (o < RA_HUNT_DESC - 1)
+                    field[f][o++] = *p;
+                p++;
+            }
+            field[f][o] = '\0';
+            f++;
+            if (p < e)
+                p++;
+        }
+        p = e;
+        if (f < 3)
+            continue;
+        list[n].unlocked = atoi(field[0]) != 0;
+        list[n].points = atoi(field[1]);
+        snprintf(list[n].title, sizeof(list[n].title), "%s", field[2]);
+        snprintf(list[n].desc, sizeof(list[n].desc), "%s", field[3]);
+        n++;
+    }
+    return n;
+}
+
+// ---- for the in-game menu ----
+
+// UTF-8 text in the menu's characters: capitals and ASCII 32..95. Latin-1 letters lose their accents, '"'
+// (which its font lacks) becomes '\'', anything else '?'.
+static void huntMenuText(const char *s, char *out, int size)
+{
+    static const char fold[] = "AAAAAAACEEEEIIIIDNOOOOOXOUUUUYTSAAAAAAACEEEEIIIIDNOOOOO/OUUUUYTY"; // U+00C0..U+00FF
+    const char *end = s + strlen(s);
+    int o = 0;
+
+    while (s < end && o < size - 1) {
+        unsigned u = huntUtf8(&s, end);
+        int c;
+        if (u >= 0xC0 && u <= 0xFF)
+            u = (unsigned char)fold[u - 0xC0];
+        c = u < 0x80 ? toupper((int)u) : '?';
+        if (c == '"')
+            c = '\'';
+        out[o++] = (char)((c >= 32 && c <= 95) ? c : '?');
+    }
+    out[o] = '\0';
+}
+
+// s in lines of RA_HUNT_COLS broken at spaces (a word too long for one is broken where it must be), at most
+// max of them, each NUL ended into blob at *o; a last line with more to say ends "...". The lines, -1 when
+// cap ran out.
+static int huntLines(const char *text, int max, unsigned char *blob, int *o, int cap)
+{
+    char menu[RA_HUNT_DESC];
+    const char *s = menu;
+    int n = 0, len, cut, k, i, dots;
+
+    huntMenuText(text, menu, sizeof(menu));
+    for (;;) {
+        while (*s == ' ')
+            s++;
+        if (!*s || n >= max)
+            return n;
+        len = (int)strlen(s);
+        cut = len;
+        if (len > RA_HUNT_COLS) {
+            for (cut = RA_HUNT_COLS; cut > 0 && s[cut] != ' '; cut--)
+                ;
+            if (cut == 0)
+                cut = RA_HUNT_COLS;
+        }
+        k = cut;
+        while (k > 0 && s[k - 1] == ' ')
+            k--;
+        dots = n == max - 1 && cut < len;
+        if (dots && k > RA_HUNT_COLS - 3)
+            k = RA_HUNT_COLS - 3;
+        if (*o + k + 3 * dots + 1 > cap)
+            return -1;
+        for (i = 0; i < k; i++)
+            blob[(*o)++] = (unsigned char)s[i];
+        for (i = 0; i < 3 * dots; i++)
+            blob[(*o)++] = '.';
+        blob[(*o)++] = '\0';
+        n++;
+        s += cut;
+    }
+}
+
+int raHuntBlob(const ra_hunt_t *list, int n, unsigned char *blob, int cap, int *count)
+{
+    int i, o = 0;
+    *count = 0;
+    for (i = 0; i < n; i++) {
+        int start = o, nt, nd;
+        if (list[i].unlocked)
+            continue;
+        if (o + 3 > cap)
+            break;
+        o += 3;
+        if ((nt = huntLines(list[i].title, 2, blob, &o, cap)) < 0 ||
+            (nd = huntLines(list[i].desc, RA_HUNT_ROWS - 1 - nt, blob, &o, cap)) < 0) {
+            o = start; // no room for all of it: none of it
+            break;
+        }
+        blob[start] = (unsigned char)(list[i].points > 255 ? 255 : list[i].points);
+        blob[start + 1] = (unsigned char)nt;
+        blob[start + 2] = (unsigned char)nd;
+        (*count)++;
+    }
+    return o;
+}
