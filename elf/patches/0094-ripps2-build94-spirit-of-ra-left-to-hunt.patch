+/* RIPPS2 build 94: what is left to hunt, from RA/<serial>.ach beside the .inf (ranet.c saves both at a
+   CHECK GAME SUPPORT), packed as the in-game menu reads it. Static: the launch copies it into module
+   storage (system.c), which the game leaves alone. */
+static unsigned char sbRaHunt[RA_HUNT_BLOB];
+static int sbRaHuntCount, sbRaHuntBytes;
+
+const unsigned char *sbGetRaHunt(int *count, int *bytes)
+{
+    *count = sbRaHuntCount;
+    *bytes = sbRaHuntBytes;
+    return sbRaHuntCount > 0 ? sbRaHunt : NULL;
+}
+
+static void sbLoadRaHunt(const char *path, const char *file)
+{
+    char achPath[256], *text;
+    ra_hunt_t *list;
+    FILE *f;
+    int len, n;
+
+    sbRaHuntCount = sbRaHuntBytes = 0;
+    if (snprintf(achPath, sizeof(achPath), "%sRA/%s.ach", path, file) >= (int)sizeof(achPath) ||
+        (f = fopen(achPath, "rb")) == NULL)
+        return;
+    fseek(f, 0, SEEK_END);
+    len = (int)ftell(f);
+    fseek(f, 0, SEEK_SET);
+    text = len > 0 && len <= 256 * 1024 ? malloc(len + 1) : NULL;
+    list = text != NULL ? malloc(sizeof(ra_hunt_t) * RA_HUNT_MAX) : NULL;
+    if (list != NULL) {
+        len = (int)fread(text, 1, len, f);
+        text[len] = '\0';
+        if ((n = raHuntRead(text, len, list, RA_HUNT_MAX)) > 0)
+            sbRaHuntBytes = raHuntBlob(list, n, sbRaHunt, sizeof(sbRaHunt), &sbRaHuntCount);
+    }
+    free(list);
+    free(text);
+    fclose(f);
+}
