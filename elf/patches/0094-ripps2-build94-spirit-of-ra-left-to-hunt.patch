+/* RIPPS2 build 94: the game's whole set, from the PC that just answered. xeRAbora's interface page asks
+   for GET /state (port 18280, or up to four above when that was taken); with OPEN TO THE NETWORK on in its
+   settings it answers anyone on the network too. The answer is JSON with every achievement of the game
+   the check just identified: its title, how to earn it, its points and whether this account has it.
+   Plain HTTP over TCP, read the way the cover download reads (whole 64-byte blocks into an aligned
+   buffer: rule 1 and 2 above). The text into buf; its length, or -1. */
+#define RA_UI_PORT   18280
+#define RA_STATE_MAX (192 * 1024)
+static char g_tcp[960] __attribute__((aligned(64)));
+
+static int raFetchState(char *buf, int cap)
+{
+    static const char req[] = "GET /state HTTP/1.0\r\nHost: xerabora\r\nConnection: close\r\n\r\n";
+    int port;
+
+    if (g_peer == 0)
+        return -1;
+    for (port = RA_UI_PORT; port < RA_UI_PORT + 5; port++) {
+        struct sockaddr_in a;
+        int s, got = 0;
+
+        memset(&a, 0, sizeof(a));
+        a.sin_family = AF_INET;
+        a.sin_port = htons(port);
+        a.sin_addr.s_addr = g_peer;
+        if ((s = socket(AF_INET, SOCK_STREAM, 0)) < 0)
+            return -1;
+        if (connect(s, (struct sockaddr *)&a, sizeof(a)) < 0) { /* refused: the page is not open to the network */
+            disconnect(s);
+            continue;
+        }
+        send(s, (void *)req, sizeof(req) - 1, 0);
+        for (;;) {
+            int n = recv(s, g_tcp, sizeof(g_tcp), 0);
+            if (n <= 0)
+                break;
+            if (got + n > cap - 1)
+                n = cap - 1 - got;
+            memcpy(buf + got, g_tcp, n);
+            got += n;
+            if (got >= cap - 1)
+                break;
+        }
+        disconnect(s);
+        buf[got] = '\0';
+        if (got > 12 && strncmp(buf, "HTTP/1.", 7) == 0 && strstr(buf, "\"achievements\"") != NULL)
+            return got;
+    }
+    return -1;
