@@ -2185,6 +2185,19 @@ void sysLaunchLoaderElf(const char *filename, const char *mode_str, int size_cdv
         raWorkArea = (u8 *)ModuleStorage + ModuleStorageSize;
         ModuleStorageSize += (RA_EE_WORK_BYTES + 0x3F) & ~0x3F;
     }
+
+    /* RIPPS2 build 94: the in-game menu's LEFT TO HUNT list goes after it, for the whole game. Only with
+       the menu on, and only at the default address, where the game's own memory starts at 0x100000: a
+       game moved lower (mod_storage_location_list) or a storage too full for it plays without the page. */
+    const u8 *raHunt = NULL, *huntSrc;
+    int raHuntCount = 0, raHuntBytes = 0;
+    if (gRipps2IgrMenu && (huntSrc = sbGetRaHunt(&raHuntCount, &raHuntBytes)) != NULL &&
+        ModuleStorage == (void *)OPL_MOD_STORAGE && (u32)ModuleStorage + ModuleStorageSize + raHuntBytes <= 0xFF000) {
+        raHunt = (u8 *)ModuleStorage + ModuleStorageSize;
+        memcpy((void *)raHunt, huntSrc, raHuntBytes);
+        ModuleStorageSize += (raHuntBytes + 0x3F) & ~0x3F;
+    } else
+        raHuntCount = 0;
 #endif
 
