diff --git a/include/rahunt.h b/include/rahunt.h
new file mode 100644
index 0000000..b646cb7
--- /dev/null
+++ b/include/rahunt.h
@@ -0,0 +1,27 @@
+#ifndef __RAHUNT_H
+#define __RAHUNT_H
+
+// RIPPS2 build 94: a game's achievements as xeRAbora knows them (src/rahunt.c)
+
+#define RA_HUNT_TITLE 64
+#define RA_HUNT_DESC  160
+#define RA_HUNT_MAX   400       // achievements read from one RA/<serial>.ach
+#define RA_HUNT_BLOB  (8 * 1024) // the most the in-game menu is given (module storage is tight)
+
+typedef struct
+{
+    int unlocked, points;
+    char title[RA_HUNT_TITLE];
+    char desc[RA_HUNT_DESC];
+} ra_hunt_t;
+
+// xeRAbora's GET /state JSON into the RA/<serial>.ach text (its first line "RIPPS2 ACH 1"). The achievements
+// written, -1 when it carries none, -2 when the PC is on another game (serial "" skips that check).
+int raHuntFromState(const char *json, int len, const char *serial, char *out, int outsz);
+// RA/<serial>.ach's text into list; how many, or -1 when it is not one
+int raHuntRead(const char *text, int len, ra_hunt_t *list, int max);
+// The locked ones packed for the in-game menu: points (one byte), title, NUL, description, NUL, each in the
+// menu's characters (capitals, ASCII 32..95). Bytes used; *count how many fitted in cap.
+int raHuntBlob(const ra_hunt_t *list, int n, unsigned char *blob, int cap, int *count);
+
+#endif
