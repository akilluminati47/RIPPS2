+
+// build 82: the back of the case. Hold the right stick to one side for 2 s and the chosen case turns
+// over to its back cover, the way the stick leans; it stays turned on the grid when the selection moves
+// on and when it comes back, until the stick turns it home. Only once its back cover has loaded.
+#define GRID_FLIPS  64
+#define FLIP_HOLD_S 2.0f
+#define FLIP_TURN_S 0.55f
+static struct
+{
+    const void *item;
+    float pos;  // 0 front .. 1 back
+    int target; // where it is turning to
+    int side;   // the way it turns, +1 / -1
+} gridFlips[GRID_FLIPS];
+static int gridFlipNext;
+static const void *flipHoldItem;
+static int flipHoldSide, flipHoldDone;
+static clock_t flipHoldSince, flipLast;
+
+static int gridFlipFind(const void *item, int make)
+{
+    int i;
+    for (i = 0; i < GRID_FLIPS; i++)
+        if (gridFlips[i].item == item)
+            return i;
+    if (!make)
+        return -1;
+    for (i = 0; i < GRID_FLIPS; i++) // a free slot, else one that is at rest at the front
+        if (gridFlips[i].item == NULL || (gridFlips[i].target == 0 && gridFlips[i].pos <= 0.0f))
+            break;
+    if (i == GRID_FLIPS)
+        i = gridFlipNext++ % GRID_FLIPS;
+    gridFlips[i].item = item;
+    gridFlips[i].pos = 0.0f;
+    gridFlips[i].target = 0;
+    gridFlips[i].side = 1;
+    return i;
+}
+
+// a game's back cover if it is in memory (asking for it if not), else NULL
+static GSTEXTURE *gridBackTexture(const void *elem, item_list_t *src, struct submenu_list *it, int priority)
+{
+    mutable_image_t *gb = gridBackFor(elem);
+    GSTEXTURE *t = gb != NULL ? getGameImageTextureEx(gb->cache, src, &it->item, priority) : NULL;
+    return t != NULL && t->Mem != NULL ? t : NULL;
+}
+
+// the turn (radians) a case is drawn at: 0 front, +-pi its back
+static float gridFlipTurn(const void *item)
+{
+    int k = gridFlipFind(item, 0);
+    if (k < 0 || gridFlips[k].pos <= 0.0f)
+        return 0.0f;
+    float p = gridFlips[k].pos, e = p * p * (3.0f - 2.0f * p);
+    return gridFlips[k].side * 3.14159265f * e;
+}
+
+// once a frame: every case eases toward the side it is turning to; the chosen one turns over when the
+// stick has been held to one side for FLIP_HOLD_S and its back cover is there
+static void gridFlipUpdate(const void *selected, int backReady)
+{
+    clock_t now = clock();
+    float dt = flipLast != 0 ? (float)(now - flipLast) / (float)CLOCKS_PER_SEC : 0.0f;
+    int i, side = ripps2StickSide();
+    flipLast = now;
+    if (dt < 0.0f || dt > 0.25f)
+        dt = 0.016f;
+    for (i = 0; i < GRID_FLIPS; i++) {
+        if (gridFlips[i].item == NULL)
+            continue;
+        float goal = (float)gridFlips[i].target, step = dt / FLIP_TURN_S;
+        gridFlips[i].pos += gridFlips[i].pos < goal ? fminf(step, goal - gridFlips[i].pos) : -fminf(step, gridFlips[i].pos - goal);
+    }
+    if (side == 0 || selected == NULL || !backReady) {
+        flipHoldItem = NULL;
+        return;
+    }
+    if (flipHoldItem != selected || flipHoldSide != side) {
+        flipHoldItem = selected;
+        flipHoldSide = side;
+        flipHoldSince = now;
+        flipHoldDone = 0;
+        return;
+    }
+    if (!flipHoldDone && (float)(now - flipHoldSince) / (float)CLOCKS_PER_SEC >= FLIP_HOLD_S) {
+        int k = gridFlipFind(selected, 1);
+        gridFlips[k].target = !gridFlips[k].target;
+        gridFlips[k].side = -side; // the leaning side goes away first, as the tilt sends it
+        flipHoldDone = 1;          // let go and hold again to turn it back
+        sfxPlay(SFX_PAGE_IN);
+    }
+}
 
