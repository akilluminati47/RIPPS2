 }
+
+// build 82: the stick's tilt plus a turn of its own about the vertical axis (RIPgrid's case flip)
+void ripps2TiltBeginTurn(int cx, int cy, int scalePct, float turn)
+{
+    rmSetTilt(1, cx, cy, tiltYaw * scalePct / 100.0f + turn, tiltPitch * scalePct / 100.0f);
