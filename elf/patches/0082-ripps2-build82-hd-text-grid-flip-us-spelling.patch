+
+// build 82: which way the right stick is held, -1 / 0 / 1 (well past the tilt's own range)
+int ripps2StickSide(void)
+{
+    int sx, sy;
+    padGetRightStick(&sx, &sy);
+    return sx > 100 ? 1 : sx < -100 ? -1 : 0;
+}
