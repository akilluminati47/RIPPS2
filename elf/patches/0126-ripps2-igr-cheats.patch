+/*
+ * RIPPS2 build 126: the in-game menu's CHEATS page (ee_core/include/igrcheats.h), only with Settings > General >
+ * In-Game Menu > Cheats on (off by default). The cheat rules here (which codes are hooks, every hook planted, the
+ * master code) are RiptOPL's In-Game Menu's (NathanNeurotic/RiptOPL #184, Open-PS2-Loader #1155).
+ *
+ * igrCheatsPack lists the game's cheats at dst, each with its codes, hook codes left out (the engine plants the hooks
+ * once, when the game calls SetupThread, so a hook cannot be switched later), and whether it is ticked now. Every
+ * listed cheat's codes fit the engine's list together (MAX_CODES pairs): the ticked ones first, then the others in
+ * file order while the list, the page and the room hold them. set_cheats_list_live then makes gCheatList that list:
+ * every cheat's hook codes first, then each listed cheat's codes, or {0, IGR_CHEAT_OFF_VAL} pairs in their place for
+ * one that is not ticked, which the engine steps over and the menu writes back when it is turned on.
+ */
+
+// A hook code, by the engine's own rule (ee_core cheat_api.c SetupCheats): 0x90/0x91 addresses, unless the line
+// before was the first of a two-line 3- or 4-type code. prevCanHook carries that across one cheat's lines.
+static int cheatIsHook(const code_t *c, int *prevCanHook)
+{
+    int hook = ((c->addr & 0xfe000000) == 0x90000000) && *prevCanHook;
+    *prevCanHook = !((c->addr & 0xf0000000) == 0x40000000 || (c->addr & 0xf0000000) == 0x30000000);
+    return hook;
+}
+
+static int cheatRealCodes(const cheat_entry_t *e)
+{
+    int n = 0, canHook = 1;
+    for (int j = 0; j < MAX_CHEATLIST && e->codes[j].addr != 0; ++j)
+        if (!cheatIsHook(&e->codes[j], &canHook))
+            n++;
+    return n;
+}
+
+int igrCheatsPack(void *dst, unsigned int room)
+{
+    igr_cheats_t *h = (igr_cheats_t *)dst;
+    unsigned char listed[MAX_CODES];
+    unsigned int count = 0, pairs = 0;
+
+    if (gCheats == NULL || dst == NULL)
+        return 0;
+    memset(listed, 0, sizeof(listed));
+    // the ticked cheats first, then the others: a ticked one that cannot be listed means no page, and the game starts
+    // with the list it gets without it (set_cheats_list), so every ticked cheat runs as before
+    for (int pass = 0; pass < 2; ++pass)
+        for (int i = 0; i < MAX_CODES; ++i) {
+            int n = gCheats[i].codes[0].addr != 0 ? cheatRealCodes(&gCheats[i]) : 0;
+            if (n == 0 || (gCheats[i].enabled != 0) != (pass == 0))
+                continue;
+            if (count >= IGR_CHEATS_MAX || n > 255 || pairs + n > MAX_CODES || IGR_CHEATS_BYTES(count + 1, pairs + n) > room) {
+                if (pass == 0)
+                    return 0;
+                continue;
+            }
+            listed[i] = 1;
+            count++;
+            pairs += n;
+        }
+    if (count == 0)
+        return 0;
+
+    memset(dst, 0, IGR_CHEATS_BYTES(count, pairs));
+    h->magic = IGR_CHEATS_MAGIC;
+    h->count = count;
+    h->pairs = pairs;
+    igr_cheat_t *row = IGR_CHEATS_ROWS(h);
+    unsigned int *codes = IGR_CHEATS_CODES(h), r = 0, p = 0;
+    for (int i = 0; i < MAX_CODES; ++i) {
+        if (!listed[i])
+            continue;
+        int canHook = 1;
+        row[r].at = p;
+        row[r].count = cheatRealCodes(&gCheats[i]);
+        row[r].on = gCheats[i].enabled ? 1 : 0;
+        // the menu's font is upper case ASCII (anything else shows as '?'), 18 characters before ON / OFF
+        snprintf(row[r].name, IGR_CHEAT_NAME, "%.*s", IGR_CHEAT_NAME - 1, gCheats[i].name[0] ? gCheats[i].name : "CHEAT");
+        for (int j = 0; j < MAX_CHEATLIST && gCheats[i].codes[j].addr != 0; ++j)
+            if (!cheatIsHook(&gCheats[i].codes[j], &canHook)) {
+                codes[p * 2] = gCheats[i].codes[j].addr;
+                codes[p * 2 + 1] = gCheats[i].codes[j].val;
+                p++;
+            }
+        r++;
+    }
+    return (int)IGR_CHEATS_BYTES(count, pairs);
+}
+
+void set_cheats_list_live(const void *packed)
+{
+    const igr_cheats_t *h = (const igr_cheats_t *)packed;
+    const igr_cheat_t *row = IGR_CHEATS_ROWS(h);
+    const unsigned int *codes = IGR_CHEATS_CODES(h);
+    int cheatCount = 0;
+
+    memset((void *)gCheatList, 0, sizeof(gCheatList));
+    if (gCheats == NULL)
+        return;
+    // every hook, from every cheat: the engine takes MAX_HOOKS, so the ticked cheats' hooks go first, and a hook two
+    // cheats share is listed once
+    for (int pass = 0; pass < 2; ++pass)
+        for (int i = 0; i < MAX_CODES; ++i) {
+            if ((gCheats[i].enabled != 0) != (pass == 0))
+                continue;
+            int canHook = 1;
+            for (int j = 0; j < MAX_CHEATLIST && gCheats[i].codes[j].addr != 0; ++j) {
+                if (!cheatIsHook(&gCheats[i].codes[j], &canHook) || cheatCount + 2 > MAX_HOOKS * 2)
+                    continue;
+                int seen = 0;
+                for (int d = 0; d < cheatCount && !seen; d += 2)
+                    seen = gCheatList[d] == gCheats[i].codes[j].addr && gCheatList[d + 1] == gCheats[i].codes[j].val;
+                if (!seen) {
+                    gCheatList[cheatCount++] = gCheats[i].codes[j].addr;
+                    gCheatList[cheatCount++] = gCheats[i].codes[j].val;
+                }
+            }
+        }
+    // then every listed cheat's codes in the menu's order, {0, IGR_CHEAT_OFF_VAL} for one not ticked: at most MAX_CODES
+    // pairs, so with MAX_HOOKS hooks the list is exactly full, which SetupCheats reads without a terminator (it stops at
+    // MAX_CHEATLIST); a shorter list ends in the zeros of the memset above
+    for (unsigned int r = 0; r < h->count; ++r)
+        for (unsigned int k = row[r].at; k < (unsigned int)row[r].at + row[r].count && cheatCount + 2 <= MAX_CHEATLIST; ++k) {
+            gCheatList[cheatCount++] = row[r].on ? codes[k * 2] : 0;
+            gCheatList[cheatCount++] = row[r].on ? codes[k * 2 + 1] : IGR_CHEAT_OFF_VAL;
+        }
+}
