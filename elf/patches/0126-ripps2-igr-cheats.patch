new file mode 100644
index 0000000..6be47cc
--- /dev/null
+++ b/ee_core/include/igrcheats.h
@@ -0,0 +1,52 @@
+/*
+  igrcheats.h RIPPS2 build 126: the cheats the in-game menu's CHEATS page turns on and off (igrmenu.c)
+
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  The launcher (src/cheatman.c igrCheatsPack) packs the game's cheats here, not only the ones ticked, after the IOP
+  modules (below 0xD0000, kept for the whole game), and gives the engine a code list with every listed cheat in it:
+  a cheat that is OFF sits there as {0, 1} pairs, which CodeHandler steps over (address 0) and SetupCheats keeps (only
+  {0, 0} ends the list). Turning a cheat on or off is then writing its own pairs of the code list back, from the copy
+  here, or {0, 1}: no second list, no copy of the list in ee_core, nothing that moves. Every listed cheat fits the
+  engine's list together (MAX_CODES pairs), so nothing can be turned on that would not fit.
+
+  Shared by the launcher and ee_core: plain C, fixed sizes, no pointers inside. Layout, all words little endian:
+    igr_cheats_t           header
+    igr_cheat_t cheat[n]   one row of the page each
+    u32 codes[]            what the code list holds with every cheat ON: addr/val pairs, cheat after cheat, hook codes
+                           left out (the engine plants those once, so they are always in the list)
+
+  The idea and the cheat rules (which codes are hooks, the master code) are RiptOPL's In-Game Menu's
+  (NathanNeurotic/RiptOPL #184, Open-PS2-Loader #1155); this layout is RIPPS2's own, smaller in ee_core.
+*/
+
+#ifndef IGRCHEATS_H
+#define IGRCHEATS_H
+
+#define IGR_CHEATS_MAGIC 0x32484349 // "ICH2"
+#define IGR_CHEATS_MAX   64         // rows on the page
+#define IGR_CHEAT_NAME   19         // a name on its row (18 characters, before ON / OFF), NUL included
+
+typedef struct
+{
+    unsigned short at;    // its first pair in the code list and in codes[]
+    unsigned char count;  // its pairs
+    unsigned char on;     // in the list now
+    char name[IGR_CHEAT_NAME + 1]; // + 1: the row stays 24 bytes
+} igr_cheat_t;
+
+typedef struct
+{
+    unsigned int magic;
+    unsigned int count; // rows
+    unsigned int pairs; // pairs in codes[] (the code list holds as many)
+    unsigned int reserved;
+} igr_cheats_t;
+
+#define IGR_CHEATS_ROWS(h)             ((igr_cheat_t *)((unsigned char *)(h) + sizeof(igr_cheats_t)))
+#define IGR_CHEATS_CODES(h)            ((unsigned int *)(IGR_CHEATS_ROWS(h) + (h)->count))
+#define IGR_CHEATS_BYTES(count, pairs) (sizeof(igr_cheats_t) + (count) * sizeof(igr_cheat_t) + (pairs) * 8)
+#define IGR_CHEAT_OFF_VAL              1 // an OFF pair: {0, IGR_CHEAT_OFF_VAL}
+
+#endif
