+// RIPPS2 build 75: an HDD launch reads its settings from the HDD, so its whole driver stack comes up
+// first and the boot sat silent and still for seconds. The built-in boot sound starts before that
+// now, unless the memory card says the user turned it off (QUIETBOOT, kept by ripps2QuietBootMark).
+static int sfxBootBuiltinOnly = 0;
+#define QUIETBOOT_MC0 "mc0:/RIPPS2/QUIETBOOT"
+#define QUIETBOOT_MC1 "mc1:/RIPPS2/QUIETBOOT"
+
+static int quietBootMarked(void)
+{
+    int fd = open(QUIETBOOT_MC0, O_RDONLY);
+    if (fd < 0)
+        fd = open(QUIETBOOT_MC1, O_RDONLY);
+    if (fd >= 0)
+        close(fd);
+    return fd >= 0;
+}
+
+void sfxBootStartEarly(void)
+{
+    if (quietBootMarked())
+        return;
+    sfxBootBuiltinOnly = 1;
+    sfxBootStart();
+    sfxBootBuiltinOnly = 0;
+}
+
+// On the IO worker, with each settings save: the marker follows the boot sound setting
+void ripps2QuietBootMark(int bootSoundOn)
+{
+    int marked = quietBootMarked(), fd;
+    if (!bootSoundOn && !marked) {
+        mkdir("mc0:/RIPPS2", 0777);
+        if ((fd = open(QUIETBOOT_MC0, O_WRONLY | O_CREAT | O_TRUNC, 0666)) >= 0)
+            close(fd);
+    } else if (bootSoundOn && marked) {
+        remove(QUIETBOOT_MC0);
+        remove(QUIETBOOT_MC1);
+    }
+}
