+#ifdef PADEMU
+/* RIPPS2 build 129: Controllers > Set Up A USB Pad. The menu's USB pad driver takes any HID pad while this is open
+   (ripps2PadsMenuLearn) and hands its reports over as they come (ds34usb_get_raw). RIPPS2 reads the pad at rest, then
+   asks for each button and stick in turn and finds what moved: one bit (a button, b<byte>.<bit>, or !b when it drops), a
+   hat's low nibble leaving its centre (the d-pad, dpad=hat<byte>), or a byte that swings (an axis, a<byte>, a- when it
+   runs the other way; a trigger that only has an axis is a<byte>). Bytes that move at rest are left out. The result is
+   tried live, then written as PADS/VVVV_PPPP.pad (an old one is kept as .bak) and read back with the reference reader.
+   The PS2 pad drives it: SELECT skips a button, the cancel button backs out. */
+
+#define PAD_SETUP_GENERIC 4 // the menu driver's GENERIC (modules/ds34usb/iop/ds34usb.h)
+#define PAD_SETUP_SWING   0x50 // an axis moved this far from rest
+#define PAD_SETUP_HOLD    4    // frames a find must hold before it counts
+
+typedef struct
+{
+    int port, len, seq;
+    unsigned vid, pid;
+    unsigned char r[64];
+} pad_setup_raw_t;
+
+static const struct
+{
+    int axis, id;
+    const char *name;
+} padSetupSteps[] = {
+    {0, PAD_B_CROSS, N_("Cross")}, {0, PAD_B_CIRCLE, N_("Circle")}, {0, PAD_B_SQUARE, N_("Square")}, {0, PAD_B_TRIANGLE, N_("Triangle")},
+    {0, PAD_B_L1, "L1"}, {0, PAD_B_R1, "R1"}, {0, PAD_B_L2, "L2"}, {0, PAD_B_R2, "R2"}, {0, PAD_B_SELECT, "SELECT"},
+    {0, PAD_B_START, "START"}, {0, PAD_B_L3, N_("L3 (press the left stick in)")}, {0, PAD_B_R3, N_("R3 (press the right stick in)")},
+    {0, PAD_B_UP, N_("Up on the d-pad")}, {0, PAD_B_DOWN, N_("Down on the d-pad")}, {0, PAD_B_LEFT, N_("Left on the d-pad")},
+    {0, PAD_B_RIGHT, N_("Right on the d-pad")}, {1, PAD_AX_LX, N_("the left stick to the right")}, {1, PAD_AX_LY, N_("the left stick down")},
+    {1, PAD_AX_RX, N_("the right stick to the right")}, {1, PAD_AX_RY, N_("the right stick down")},
+};
+#define PAD_SETUP_STEPS ((int)(sizeof(padSetupSteps) / sizeof(padSetupSteps[0])))
+
+static int padSetupPoll(pad_setup_raw_t *p) // the port the driver holds a HID pad in, and its last report
+{
+    unsigned char b[72];
+    int port;
+
+    for (port = 0; port < 2; port++) {
+        if (!ds34usb_get_raw(port, b) || b[1] != PAD_SETUP_GENERIC || !(b[0] & DS34USB_STATE_RUNNING))
+            continue;
+        p->port = port;
+        p->vid = b[2] | b[3] << 8;
+        p->pid = b[4] | b[5] << 8;
+        p->len = b[6];
+        p->seq = b[7];
+        memcpy(p->r, b + 8, sizeof(p->r));
+        return 1;
+    }
+    return 0;
+}
+
+static void padSetupDraw(const char *title, const char *body, int skipHint)
+{
+    char wrapped[1024];
+    int lines = guiWrapText(body, screenWidth - 120, wrapped, sizeof(wrapped));
+    int hints[1] = {_STR_BACK}, icons[1] = {guiCancelIcon()}, hx, hy;
+
+    guiStartFrame();
+    if (guiDrawBGSettings() == 0)
+        guiDrawBGPlasma();
+    guiDrawStatusBackdrop();
+    fntRenderString(RIPPS2_MENU_FONT, screenWidth >> 1, 110, ALIGN_CENTER, 0, 0, title, gTheme->selTextColor);
+    guiDrawWrappedLines(wrapped, lines);
+    hx = guiAlignSubMenuHints(1, hints, icons, RIPPS2_UI_FONT, 12, 2);
+    hy = gTheme->usedHeight - 32;
+    if (skipHint) { // SELECT and what it does here, left of BACK (as guiMsgBox draws START)
+        const char *label = skipHint == 2 ? _t("Save") : _t("Skip");
+        int icon = skipHint == 2 ? guiConfirmIcon() : SELECT_ICON;
+        GSTEXTURE *st = thmGetTexture(icon);
+        int sw = st ? (st->Width * 20) / st->Height : 20;
+        hx -= rmWideScale(sw) + 2 + rmUnScaleX(fntCalcDimensions(RIPPS2_UI_FONT, label)) + 12;
+        hx = guiDrawIconAndLiteralText(icon, label, RIPPS2_UI_FONT, hx, hy, gTheme->textColor) + 12;
+    }
+    guiDrawIconAndText(icons[0], hints[0], RIPPS2_UI_FONT, hx, hy, gTheme->textColor);
+    guiEndFrame();
+}
+
+static int padSetupBits(unsigned v)
+{
+    int n = 0;
+    for (; v; v &= v - 1)
+        n++;
+    return n;
+}
+
+// What moved since rest, for the step: 1 a bit (*at, *bit, *low), 2 a hat (*at), 3 an axis (*at, *low = it fell)
+static int padSetupFind(const unsigned char *rest, const unsigned char *noise, const pad_setup_raw_t *p, int axis, int dpad,
+                        int trigger, const unsigned char *usedBits, const unsigned char *usedAxis, int *at, int *bit, int *low)
+{
+    int i, best = -1, bestSwing = 0;
+
+    for (i = 0; i < p->len; i++) { // the byte that swung furthest
+        int d = (int)p->r[i] - (int)rest[i];
+        if (d < 0)
+            d = -d;
+        if (noise[i] >= 0x20 || usedAxis[i] || usedBits[i] || d < PAD_SETUP_SWING || d <= bestSwing)
+            continue;
+        if (axis ? rest[i] < 0x40 || rest[i] > 0xC0 : rest[i] > 0x40) // a stick rests round its centre, a trigger low
+            continue;
+        best = i;
+        bestSwing = d;
+    }
+    if (best >= 0 && (axis || trigger)) { // L2/R2: an analog trigger's byte first, as its low bits flip on the way down
+        *at = best;
+        *low = p->r[best] < rest[best];
+        return 3;
+    }
+    if (!axis) {
+        if (dpad) // first: Up on a hat centred at 8 drops one bit (8 to 0), which would read as a button
+            for (i = 0; i < p->len; i++) // a hat: the low nibble leaves its centre (8-15), the high one stays
+                if (!noise[i] && !usedAxis[i] && (rest[i] & 0x0F) >= 8 && (p->r[i] & 0x0F) < 8 && (rest[i] & 0xF0) == (p->r[i] & 0xF0)) {
+                    *at = i;
+                    return 2;
+                }
+        for (i = 0; i < p->len; i++) { // one bit, in a byte that is still at rest
+            unsigned x = rest[i] ^ p->r[i];
+            if (noise[i] || usedAxis[i] || !x || padSetupBits(x) != 1 || (usedBits[i] & x))
+                continue;
+            *at = i;
+            for (*bit = 0; !(x & (1u << *bit)); (*bit)++)
+                ;
+            *low = (rest[i] >> *bit) & 1; // set at rest: pressed is 0
+            return 1;
+        }
+    }
+    if (best < 0)
+        return 0;
+    *at = best; // a button with only an axis (pressed past half)
+    *low = 0;
+    return 3;
+}
+
+static int padSetupAtRest(const unsigned char *rest, const unsigned char *noise, const unsigned char *usedAxis, const pad_setup_raw_t *p)
+{
+    int i;
+    for (i = 0; i < p->len; i++) {
+        int d = (int)p->r[i] - (int)rest[i];
+        if (d < 0)
+            d = -d;
+        if (noise[i] ? d > noise[i] + 0x30 : usedAxis[i] ? d > 0x30 : d != 0)
+            return 0;
+    }
+    return 1;
+}
+
+static void guiSetUpUsbPad(void)
+{
+    char body[512], dir[256], path[320], text[2048], err[96];
+    unsigned char rest[64], lo[64], hi[64], noise[64], usedBits[64], usedAxis[64];
+    // what was found per step: kind (0 none), byte, bit, low
+    unsigned char kind[PAD_SETUP_STEPS], at[PAD_SETUP_STEPS], bitOf[PAD_SETUP_STEPS], lowOf[PAD_SETUP_STEPS];
+    pad_setup_raw_t p;
+    pad_def_t def;
+    int step, frames, i, hat = -1, len = 0, fd, offset, maxButton = 0, ok;
+    unsigned vid = 0, pid = 0;
+
+    if (!oplGetRipps2Dir(dir, sizeof(dir) - 16)) {
+        guiMsgBox(_t("RIPPS2 cannot tell where its folder is, so it cannot look for PADS."), 0, NULL);
+        return;
+    }
+    ripps2PadsMenuLearn(1);
+    sfxPlay(SFX_MESSAGE);
+
+    // 1: the pad, plugged in now (one the driver already let go of is not offered again until it is)
+    for (frames = 0;; frames++) {
+        int seen = padSetupPoll(&p) && p.len > 0;
+        if (seen) {
+            vid = p.vid;
+            pid = p.pid;
+            break;
+        }
+        padSetupDraw(_l(_STR_RIPPS2_PAD_SETUP),
+                     _t("Plug in the USB pad you want to set up. If it is in already, take it out and plug it in again. Then press any button on it once."), 0);
+        readPads();
+        if (getKeyOn(guiCancelKey()))
+            goto out;
+    }
+
+    // 2: at rest. What a byte does with nothing held (an axis drifts, a counter counts) is measured for a second and a half
+    for (frames = 0; frames < 90; frames++) {
+        snprintf(body, sizeof(body), _t("Found %04X:%04X. Let go of everything on it, sticks too, and wait."), vid, pid);
+        padSetupDraw(_l(_STR_RIPPS2_PAD_SETUP), body, 0);
+        readPads();
+        if (getKeyOn(guiCancelKey()))
+            goto out;
+        if (!padSetupPoll(&p))
+            continue;
+        if (frames < 30 || !len) { // the first half second: the hand lets go
+            memcpy(lo, p.r, sizeof(lo));
+            memcpy(hi, p.r, sizeof(hi));
+            len = p.len;
+        }
+        for (i = 0; i < 64; i++) {
+            if (p.r[i] < lo[i])
+                lo[i] = p.r[i];
+            if (p.r[i] > hi[i])
+                hi[i] = p.r[i];
+        }
+    }
+    memcpy(rest, p.r, sizeof(rest));
+    for (i = 0; i < 64; i++)
+        noise[i] = hi[i] - lo[i];
+    memset(usedBits, 0, sizeof(usedBits));
+    memset(usedAxis, 0, sizeof(usedAxis));
+    memset(kind, 0, sizeof(kind));
+
+    // 3: each button and stick
+    for (step = 0; step < PAD_SETUP_STEPS; step++) {
+        int axis = padSetupSteps[step].axis, id = padSetupSteps[step].id, held = 0, last = -1, lastKind = 0, a = 0, b = 0, l = 0;
+        int dpad = !axis && id >= PAD_B_UP && id <= PAD_B_LEFT;
+
+        if (dpad && hat >= 0) { // the hat gave all four
+            kind[step] = 2;
+            at[step] = hat;
+            continue;
+        }
+        for (;;) {
+            int k = 0;
+            snprintf(body, sizeof(body), axis ? _t("Push %s and hold it.") : _t("Press %s on the USB pad and hold it."), _t(padSetupSteps[step].name));
+            padSetupDraw(_l(_STR_RIPPS2_PAD_SETUP), body, 1);
+            readPads();
+            if (getKeyOn(guiCancelKey()))
+                goto out;
+            if (getKeyOn(KEY_SELECT)) { // left as none
+                sfxPlay(SFX_CURSOR);
+                break;
+            }
+            if (padSetupPoll(&p) && p.vid == vid && p.pid == pid)
+                k = padSetupFind(rest, noise, &p, axis, dpad, !axis && (id == PAD_B_L2 || id == PAD_B_R2), usedBits, usedAxis, &a, &b, &l);
+            if (k && k == lastKind && a == last)
+                held++;
+            else
+                held = 0;
+            last = a;
+            lastKind = k;
+            if (k && held >= PAD_SETUP_HOLD) {
+                kind[step] = k;
+                at[step] = a;
+                bitOf[step] = b;
+                lowOf[step] = l;
+                if (k == 1)
+                    usedBits[a] |= 1u << b;
+                else {
+                    usedAxis[a] = 1;
+                    if (k == 2)
+                        hat = a;
+                }
+                sfxPlay(SFX_CONFIRM);
+                break;
+            }
+        }
+        // let go before the next (a second at most: a stick that rests a little off still moves on)
+        for (frames = 0; frames < 60; frames++) {
+            padSetupDraw(_l(_STR_RIPPS2_PAD_SETUP), _t("Got it. Let go."), 0);
+            readPads();
+            if (getKeyOn(guiCancelKey()))
+                goto out;
+            if (padSetupPoll(&p) && padSetupAtRest(rest, noise, usedAxis, &p))
+                break;
+        }
+    }
+
+    // 4: the text. Bytes count from the report's start; a report with its buttons past byte 31 is read from an offset
+    offset = 255;
+    for (step = 0; step < PAD_SETUP_STEPS; step++) {
+        if (kind[step] && at[step] < offset)
+            offset = at[step];
+        if (kind[step] == 1 && at[step] > maxButton)
+            maxButton = at[step];
+    }
+    if (offset == 255) {
+        guiMsgBox(_t("Nothing was set up, so no file was written."), 0, NULL);
+        goto out;
+    }
+    if (maxButton <= PAD_BYTE_MAX)
+        offset = 0;
+    len = snprintf(text, sizeof(text), "# Set up on the PS2 by RIPPS2 (Controllers > Set Up A USB Pad)\n[Device]\nformat=%d\nname=USB pad %04X:%04X\ndecoder=generic\n",
+                   PAD_FORMAT, vid, pid);
+    if (offset)
+        len += snprintf(text + len, sizeof(text) - len, "offset=%d\n", offset);
+    len += snprintf(text + len, sizeof(text) - len, "[Buttons]\n");
+    for (step = 0; step < PAD_SETUP_STEPS; step++) {
+        static const char *const names[PAD_B_COUNT] = {"select", "l3", "r3", "start", "up", "right", "down", "left",
+                                                       "l2", "r2", "l1", "r1", "triangle", "circle", "cross", "square"};
+        int id = padSetupSteps[step].id;
+        if (padSetupSteps[step].axis || kind[step] == 2)
+            continue;
+        if (kind[step] == 1)
+            len += snprintf(text + len, sizeof(text) - len, "%s=%sb%d.%d\n", names[id], lowOf[step] ? "!" : "", at[step] - offset, bitOf[step]);
+        else if (kind[step] == 3)
+            len += snprintf(text + len, sizeof(text) - len, "%s=a%d\n", names[id], at[step] - offset);
+        else
+            len += snprintf(text + len, sizeof(text) - len, "%s=none\n", names[id]);
+    }
+    len += snprintf(text + len, sizeof(text) - len, "[Axes]\n");
+    if (hat >= 0)
+        len += snprintf(text + len, sizeof(text) - len, "dpad=hat%d\n", hat - offset);
+    else
+        len += snprintf(text + len, sizeof(text) - len, "dpad=buttons\n");
+    for (step = 0; step < PAD_SETUP_STEPS; step++) {
+        static const char *const axes[PAD_AX_COUNT] = {"lx", "ly", "rx", "ry"};
+        if (!padSetupSteps[step].axis)
+            continue;
+        if (kind[step] == 3)
+            len += snprintf(text + len, sizeof(text) - len, "%s=a%d%s\n", axes[padSetupSteps[step].id], at[step] - offset, lowOf[step] ? "-" : "");
+        else
+            len += snprintf(text + len, sizeof(text) - len, "%s=none\n", axes[padSetupSteps[step].id]);
+    }
+    len += snprintf(text + len, sizeof(text) - len, "deadzone=12\n[Rumble]\nrumble=off\nled=off\ninit=off\n");
+    if (padDefParse(text, len, vid, pid, &def, err, sizeof(err)) != 0) { // never a file the reader would refuse
+        snprintf(body, sizeof(body), _t("This pad cannot be described in a .pad yet (%s), so no file was written."), err);
+        guiMsgBox(body, 0, NULL);
+        goto out;
+    }
+
+    // 5: tried live; the confirm button writes it
+    for (ok = 0; !ok;) {
+        unsigned short buttons = 0xFFFF;
+        unsigned char ax[PAD_AX_COUNT] = {128, 128, 128, 128};
+        static const char *const shown[PAD_B_COUNT] = {"SELECT", "L3", "R3", "START", N_("Up"), N_("Right"), N_("Down"), N_("Left"),
+                                                       "L2", "R2", "L1", "R1", N_("Triangle"), N_("Circle"), N_("Cross"), N_("Square")};
+        int n = 0;
+        if (padSetupPoll(&p) && p.vid == vid && p.pid == pid)
+            padTranslate(&def, p.r, p.len, &buttons, ax);
+        n = snprintf(body, sizeof(body), "%s\n", _t("Try it. What you hold shows here:"));
+        for (i = 0; i < PAD_B_COUNT && n < (int)sizeof(body) - 24; i++)
+            if (!(buttons & (1u << i)))
+                n += snprintf(body + n, sizeof(body) - n, "%s ", _t(shown[i]));
+        snprintf(body + n, sizeof(body) - n, "\nL %3d %3d   R %3d %3d", ax[PAD_AX_LX], ax[PAD_AX_LY], ax[PAD_AX_RX], ax[PAD_AX_RY]);
+        padSetupDraw(_l(_STR_RIPPS2_PAD_SETUP), body, 2);
+        readPads();
+        if (getKeyOn(guiCancelKey()))
+            goto out;
+        if (getKeyOn(guiConfirmKey()))
+            ok = 1;
+    }
+
+    // 6: written, an old one kept beside it as .bak
+    strcat(dir, "PADS");
+    mkdir(dir, 0777);
+    snprintf(path, sizeof(path), "%s/%04X_%04X.pad", dir, vid, pid);
+    if ((fd = open(path, O_RDONLY)) >= 0) {
+        char bak[320];
+        int k, bfd;
+        close(fd);
+        for (k = 0; k < 100; k++) { // .bak, then .b01 to .b99: no file the user had is ever removed
+            if (k == 0)
+                snprintf(bak, sizeof(bak), "%s/%04X_%04X.bak", dir, vid, pid);
+            else
+                snprintf(bak, sizeof(bak), "%s/%04X_%04X.b%02d", dir, vid, pid, k);
+            if ((bfd = open(bak, O_RDONLY)) < 0)
+                break;
+            close(bfd);
+        }
+        if (k == 100 || rename(path, bak) != 0) {
+            snprintf(body, sizeof(body), _t("%s is there already and could not be put aside, so it was left as it was."), path);
+            guiMsgBox(body, 0, NULL);
+            goto out;
+        }
+    }
+    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC)) < 0 || write(fd, text, len) != len) {
+        if (fd >= 0)
+            close(fd);
+        snprintf(body, sizeof(body), _t("%s could not be written."), path);
+        guiMsgBox(body, 0, NULL);
+        goto out;
+    }
+    close(fd);
+    ripps2PadsMenuLoad();
+    ripps2PadsMenuLearn(0); // sends the new profiles now, so the pad steers the menu as soon as the box below closes
+    snprintf(body, sizeof(body), _t("Saved as %s. The pad now steers the menu, and plays in games with the Pad Emulator on."), path);
+    guiMsgBoxSound(SFX_CONFIRM);
+    guiMsgBox(body, 0, NULL);
+    return;
+
+out:
+    ripps2PadsMenuLoad();
+    ripps2PadsMenuLearn(0);
+}
+#endif
