+/*
+  ripps2pads.c the user's .pad profiles for a launch (RIPPS2 build 129)
+
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  As a game starts (opl.c, before the drives are let go), the PADS folder beside RIPPS2 is read: up to PAD_DEFS_MAX
+  VVVV_PPPP.pad profiles, checked by the reference reader (padfile.c), and PADS/GAMES/<the game's ID>.pad, the game's
+  button map. They are packed into the block PADEMU gets after its settings (system.c places it after the modules, ee_core
+  hands it over): a profiled USB pad then plays, and the map applies, with nothing read in the game. A file that is not
+  right is left out (Controllers > My Pads says why); no file, no block, and PADEMU starts as before.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <dirent.h>
+
+#include "include/opl.h"
+#include "include/ioman.h" // LOG
+#include "include/padfile.h"
+#include "include/ripps2pads.h"
+#ifdef PADEMU
+#include <libds34usb.h>
+#endif
+
+static unsigned char padsBlock[PAD_BLOCK_SIZE];
+static int padsReady = 0;
+
+static int padsRead(const char *path, char *buf, int size)
+{
+    int fd = open(path, O_RDONLY), n;
+    if (fd < 0)
+        return -1;
+    n = read(fd, buf, size - 1);
+    close(fd);
+    if (n >= 0)
+        buf[n] = '\0';
+    return n;
+}
+
+int ripps2PadsPrepare(const char *gameId)
+{
+    char dir[256], path[320], text[4096], err[96];
+    pad_def_t defs[PAD_DEFS_MAX];
+    unsigned char map[PAD_B_COUNT];
+    int count = 0, mapped = 0, n;
+    unsigned vid, pid;
+    struct dirent *e;
+    DIR *d;
+
+    padsReady = 0;
+    memset(map, PAD_REMAP_SAME, sizeof(map));
+    if (!oplGetRipps2Dir(dir, sizeof(dir) - 16))
+        return 0;
+    strcat(dir, "PADS");
+    if ((d = opendir(dir)) == NULL)
+        return 0;
+    while ((e = readdir(d)) != NULL && count < PAD_DEFS_MAX) {
+        if (padFileId(e->d_name, &vid, &pid) != 0)
+            continue;
+        snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
+        if ((n = padsRead(path, text, sizeof(text))) < 0 || padDefParse(text, n, vid, pid, &defs[count], err, sizeof(err)) != 0) {
+            LOG("PADS: %s left out: %s\n", e->d_name, n < 0 ? "not read" : err);
+            continue;
+        }
+        count++;
+    }
+    closedir(d);
+    if (gameId != NULL && gameId[0]) {
+        snprintf(path, sizeof(path), "%s/GAMES/%s.pad", dir, gameId);
+        if ((n = padsRead(path, text, sizeof(text))) >= 0) {
+            if (padMapParse(text, n, map, err, sizeof(err)) == 0)
+                mapped = !padMapIsSame(map);
+            else
+                LOG("PADS: %s left out: %s\n", path, err);
+        }
+    }
+    if (count == 0 && !mapped)
+        return 0;
+    padBlockPack(defs, count, map, padsBlock);
+    padsReady = 1;
+    LOG("PADS: %d profile(s)%s packed for PADEMU\n", count, mapped ? " and the game's map" : "");
+    return count;
+}
+
+const unsigned char *ripps2PadsBlock(void)
+{
+    return padsReady ? padsBlock : NULL;
+}
+
+// The menu reads a profiled pad too: the same block (no game map) goes to the menu's USB pad driver, at boot (deferredInit)
+// and after Set Up A USB Pad saves. It is read on any thread and sent on the GUI thread, the one that talks to the driver
+static unsigned char menuBlock[PAD_BLOCK_SIZE];
+static volatile int menuPending = 0;
+
+void ripps2PadsMenuLoad(void)
+{
+    if (ripps2PadsPrepare(NULL) > 0)
+        memcpy(menuBlock, padsBlock, sizeof(menuBlock));
+    else
+        memset(menuBlock, 0, sizeof(menuBlock)); // no profile: a block the driver refuses, so it reads none
+    menuPending = 1;
+}
+
+void ripps2PadsMenuTick(void)
+{
+#ifdef PADEMU
+    if (menuPending) {
+        menuPending = 0;
+        ds34usb_set_profiles(menuBlock, PAD_BLOCK_SIZE, 0);
+    }
+#endif
+}
+
+void ripps2PadsMenuLearn(int on)
+{
+#ifdef PADEMU
+    static const unsigned char none[PAD_BLOCK_SIZE];
+    // open: no profile, so a pad being set up again steers nothing while it is learnt, and both ports, so it is taken
+    // beside a DualShock in the first; closed: the profiles again and the menu's one port (system.c)
+    ds34usb_set_profiles(on ? none : menuBlock, PAD_BLOCK_SIZE, on);
+    ds34usb_reinit_ports(on ? 3 : 1);
+    menuPending = 0;
+#else
+    (void)on;
+#endif
+}
