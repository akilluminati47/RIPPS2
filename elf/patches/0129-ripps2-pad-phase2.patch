+unsigned short padApplyMap(unsigned short buttons, const unsigned char map[PAD_B_COUNT])
+{
+    unsigned pressed = (unsigned short)~buttons, out = 0;
+    int i;
+
+    for (i = 0; i < PAD_B_COUNT; i++) {
+        if (!(pressed & (1u << i)))
+            continue;
+        if (map[i] == PAD_REMAP_SAME)
+            out |= 1u << i;
