diff --git a/src/ripps2hdd.c b/src/ripps2hdd.c
new file mode 100644
index 0000000..9fc42c2
--- /dev/null
+++ b/src/ripps2hdd.c
@@ -0,0 +1,202 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 HDD manager (Memory Files settings): the internal APA hard disk's partitions in the RIPPS2
+  glass, the way wLaunchELF's HDD manager lists them (ps2homebrew/wLaunchELF, AFL-2.0, was the
+  reference): each partition's name, kind and size, and the disk's total and free space. A user
+  partition can be removed, after two confirmations; the system partitions (__ names) never can.
+  Creating and formatting partitions are left to the dedicated tools for now: RiptOPL's HDD driver
+  refuses partition creates on purpose.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define NEWLIB_PORT_AWARE
+#include <fileXio_rpc.h> // fileXioDopen/Dread/Devctl/Remove on hdd0: (partition level, below newlib)
+#include <hdd-ioctl.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/dia.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/pad.h"
+#include "include/sound.h"
+#include "include/hdd.h"
+#include "include/ripps2.h"
+
+#define HM_MAX   128
+#define HM_ROWS  14
+#define HM_ROW_H 22
+#define HM_Y     84
+#define HM_X     30
+#define HM_RIGHT 610
+
+#define HM_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define HM_DIM  GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+#define HM_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define HM_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+
+typedef struct
+{
+    char name[33];
+    unsigned int type;
+    u32 sectors;
+} hm_part_t;
+
+static hm_part_t hmParts[HM_MAX];
+static int hmCount = 0;
+
+static const char *hmTypeName(unsigned int type)
+{
+    switch (type) {
+        case APA_TYPE_PFS: return "PFS";
+        case APA_TYPE_HDL: return "HDL GAME";
+        case APA_TYPE_CFS: return "CFS";
+        case APA_TYPE_EXT2: return "EXT2";
+        case APA_TYPE_EXT2SWAP: return "EXT2 SWAP";
+        case APA_TYPE_REISER: return "REISER";
+        case APA_TYPE_MBR: return "MBR";
+        default: return "OTHER";
+    }
+}
+
+static void hmMb(u32 sectors, char *out, int size)
+{
+    u32 mb = sectors / 2048;
+    if (mb >= 1024)
+        snprintf(out, size, "%u.%u GB", mb / 1024, (mb % 1024) * 10 / 1024);
+    else
+        snprintf(out, size, "%u MB", mb);
+}
+
+static int hmScan(void)
+{
+    iox_dirent_t de;
+    int fd = fileXioDopen("hdd0:");
+    hmCount = 0;
+    if (fd < 0)
+        return fd;
+    while (hmCount < HM_MAX && fileXioDread(fd, &de) > 0) {
+        if (de.stat.mode == APA_TYPE_FREE)
+            continue;
+        hm_part_t *p = &hmParts[hmCount++];
+        snprintf(p->name, sizeof(p->name), "%s", de.name);
+        p->type = de.stat.mode;
+        p->sectors = de.stat.size;
+    }
+    fileXioDclose(fd);
+    return 0;
+}
+
+static void hmHint(int icon, const char *text, int *x, int y)
+{
+    GSTEXTURE *t = thmGetTexture(icon);
+    if (t != NULL) {
+        rmDrawPixmap(t, *x, y - 10, ALIGN_NONE, 20, 20, SCALING_RATIO, HM_LIT, 0);
+        *x += 24;
+    }
+    fntRenderString(gTheme->fonts[4], *x, y, ALIGN_VCENTER, 0, 0, text, HM_SOFT);
+    *x += fntCalcDimensions(gTheme->fonts[4], text) + 18;
+}
+
+void ripps2HddManager(void)
+{
+    int status = hddCheck(), cursor = 0, top = 0, i;
+    char line[96], total[24], freeTxt[24], toast[64] = "";
+
+    if (status < 0) {
+        guiMsgBox("No internal hard disk is ready. Start the drives first (START DRIVES), or check the HDD is connected.", 0, NULL);
+        return;
+    }
+    if (status == 1) {
+        guiMsgBox("The internal hard disk is not APA formatted. Format it with a dedicated HDD tool first.", 0, NULL);
+        return;
+    }
+    hmScan();
+
+    while (1) {
+        readPads();
+        if (cursor >= hmCount)
+            cursor = hmCount - 1;
+        if (cursor < 0)
+            cursor = 0;
+        if (cursor < top)
+            top = cursor;
+        if (cursor >= top + HM_ROWS)
+            top = cursor - HM_ROWS + 1;
+
+        u32 totalS = (u32)fileXioDevctl("hdd0:", HDIOC_TOTALSECTOR, NULL, 0, NULL, 0);
+        u32 freeS = (u32)fileXioDevctl("hdd0:", HDIOC_FREESECTOR, NULL, 0, NULL, 0);
+        hmMb(totalS, total, sizeof(total));
+        hmMb(freeS, freeTxt, sizeof(freeTxt));
+
+        rmStartFrame();
+        guiDrawBGPlasma();
+        fntRenderString(gTheme->fonts[4], HM_X, 30, ALIGN_VCENTER, 0, 0, "HDD MANAGER", HM_LIT);
+        snprintf(line, sizeof(line), "%d PARTITIONS   %s FREE OF %s", hmCount, freeTxt, total);
+        fntRenderString(gTheme->fonts[4], HM_RIGHT - fntCalcDimensions(gTheme->fonts[4], line), 30, ALIGN_VCENTER, 0, 0, line, HM_SOFT);
+        rmDrawLine(HM_X, 46, HM_RIGHT, 46, HM_PRIM(0x4A, 0x72, 0xDC, 0x60));
+        // the disk as a bar: used against free
+        if (totalS > 0) {
+            int w = HM_RIGHT - HM_X, used = (int)((float)w * (float)(totalS - freeS) / (float)totalS);
+            rmDrawRect(HM_X, 56, w, 8, HM_PRIM(0x03, 0x08, 0x22, 0x80));
+            rmDrawRect(HM_X, 56, used, 8, HM_PRIM(0x4A, 0x8C, 0xF0, 0x80));
+        }
+        for (i = 0; i < HM_ROWS && top + i < hmCount; i++) {
+            hm_part_t *p = &hmParts[top + i];
+            int y = HM_Y + i * HM_ROW_H, cur = top + i == cursor, sys = p->name[0] == '_' && p->name[1] == '_';
+            if (cur) {
+                rmDrawRect(HM_X - 6, y - 1, HM_RIGHT - HM_X + 12, HM_ROW_H - 2, HM_PRIM(0x1E, 0x3C, 0x96, 0x58));
+                rmDrawRect(HM_X - 6, y - 1, 3, HM_ROW_H - 2, HM_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+            }
+            fntRenderString(gTheme->fonts[8], HM_X + 6, y + 9, ALIGN_VCENTER, 330, 0, p->name, cur ? HM_LIT : (sys ? HM_DIM : HM_SOFT));
+            fntRenderString(gTheme->fonts[5], 390, y + 9, ALIGN_VCENTER, 0, 0, sys ? "SYSTEM" : hmTypeName(p->type), HM_DIM);
+            hmMb(p->sectors, line, sizeof(line));
+            fntRenderString(gTheme->fonts[5], HM_RIGHT - fntCalcDimensions(gTheme->fonts[5], line), y + 9, ALIGN_VCENTER, 0, 0, line, HM_DIM);
+        }
+        if (toast[0])
+            fntRenderString(gTheme->fonts[5], HM_RIGHT - fntCalcDimensions(gTheme->fonts[5], toast), 432, ALIGN_VCENTER, 0, 0, toast, HM_SOFT);
+        int hx = 44;
+        hmHint(TRIANGLE_ICON, "REMOVE", &hx, 448);
+        hmHint(SELECT_ICON, "REFRESH", &hx, 448);
+        hmHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, "BACK", &hx, 448);
+        rmEndFrame();
+
+        if (getKey(KEY_UP) && cursor > 0) {
+            cursor--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && cursor < hmCount - 1) {
+            cursor++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(KEY_SELECT)) {
+            sfxPlay(SFX_CONFIRM);
+            hmScan();
+            toast[0] = '\0';
+        } else if (getKeyOn(KEY_TRIANGLE) && hmCount > 0) {
+            hm_part_t *p = &hmParts[cursor];
+            if (p->name[0] == '_' && p->name[1] == '_') {
+                sfxPlay(SFX_CANCEL);
+                snprintf(toast, sizeof(toast), "SYSTEM PARTITIONS STAY");
+            } else {
+                char ask[96], path[48];
+                snprintf(ask, sizeof(ask), "Remove partition %s and everything on it?", p->name);
+                if (guiMsgBox(ask, 1, NULL) && guiMsgBox("This cannot be undone. Remove it?", 1, NULL)) {
+                    snprintf(path, sizeof(path), "hdd0:%s", p->name);
+                    int r = fileXioRemove(path);
+                    snprintf(toast, sizeof(toast), r >= 0 ? "REMOVED %s" : "COULD NOT REMOVE %s", p->name);
+                    hmScan();
+                }
+            }
+        } else if (getKeyOn(gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE)) {
+            sfxPlay(SFX_CANCEL);
+            break;
+        }
+    }
+    readPads();
+}
diff --git a/src/ripps2kbd.c b/src/ripps2kbd.c
new file mode 100644
index 0000000..a79db20
--- /dev/null
+++ b/src/ripps2kbd.c
@@ -0,0 +1,90 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 USB keyboard: ps2sdk's ps2kbd driver (on the usbd RiptOPL loads at boot), started the first
+  time something asks for text. ripps2KbdPoll hands back one key at a time without waiting, so the
+  on-screen keyboard can take typing from a USB keyboard and pad presses in the same frame loop.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <libkbd.h>
+
+#include "include/opl.h"
+#include "include/system.h"
+#include "include/extern_irx.h"
+#include "include/ripps2.h"
+
+static int kbdState = 0; // 0 not tried, 1 running, -1 unavailable
+
+static int kbdStart(void)
+{
+    if (kbdState != 0)
+        return kbdState > 0;
+    kbdState = -1;
+    if (sysLoadModuleBuffer(&ps2kbd_irx, size_ps2kbd_irx, 0, NULL) < 0) {
+        LOG("RIPPS2 KBD: ps2kbd did not load\n");
+        return 0;
+    }
+    if (PS2KbdInit() == 0) {
+        LOG("RIPPS2 KBD: PS2KbdInit failed\n");
+        return 0;
+    }
+    PS2KbdSetReadmode(PS2KBD_READMODE_NORMAL);
+    PS2KbdSetBlockingMode(PS2KBD_NONBLOCKING);
+    PS2KbdFlushBuffer();
+    kbdState = 1;
+    return 1;
+}
+
+// One key, or 0 when nothing is waiting: a printable character, or one of the RIPPS2_KEY_* codes
+int ripps2KbdPoll(void)
+{
+    char c = 0;
+
+    if (!kbdStart())
+        return 0;
+    if (PS2KbdRead(&c) <= 0)
+        return 0;
+    if (c == PS2KBD_ESCAPE_KEY) { // a special key: the next byte says which
+        char code = 0;
+        if (PS2KbdRead(&code) <= 0)
+            return RIPPS2_KEY_ESC;
+        switch ((unsigned char)code) {
+            case 0x29: // right (ps2kbd's default special map)
+            case 0x4F:
+                return RIPPS2_KEY_RIGHT;
+            case 0x2A: // left
+            case 0x50:
+                return RIPPS2_KEY_LEFT;
+            case 0x2B: // down
+            case 0x51:
+                return RIPPS2_KEY_DOWN;
+            case 0x2C: // up
+            case 0x52:
+                return RIPPS2_KEY_UP;
+            case 0x26: // delete
+            case 0x4C:
+                return RIPPS2_KEY_DELETE;
+            case 0x24: // home
+            case 0x4A:
+                return RIPPS2_KEY_HOME;
+            case 0x27: // end
+            case 0x4D:
+                return RIPPS2_KEY_END;
+            default:
+                return 0;
+        }
+    }
+    if (c == 0x07 || c == 0x08 || c == 0x7F)
+        return RIPPS2_KEY_BACKSPACE;
+    if (c == '\n' || c == '\r')
+        return RIPPS2_KEY_ENTER;
+    if (c == '\t')
+        return ' ';
+    if ((unsigned char)c >= 0x20 && (unsigned char)c < 0x7F)
+        return (unsigned char)c;
+    return 0;
+}
