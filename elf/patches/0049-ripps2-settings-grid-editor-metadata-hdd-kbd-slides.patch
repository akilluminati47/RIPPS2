diff --git a/src/themes.c b/src/themes.c
index df60a9f..9f3b84e 100644
--- a/src/themes.c
+++ b/src/themes.c
@@ -1158,6 +1158,108 @@ static void drawRAMark(struct submenu_list *item, struct theme_element *elem,
 }
 #endif /* RETROACHIEVEMENTS */
 
+// RIPPS2: the info page slideshow. GameImage elements with <name>_slide=N (1..4) in one family take
+// turns: each shows for SLIDE_HOLD_S, then crossfades into the next one that has art. A slide whose
+// file is missing is skipped, never shown as a blank; with no art at all nothing draws, and the glass
+// panel over them carries the page alone. The theme lists slides in ascending order, so in a
+// crossfade the earlier one is painted opaque and the later one fades in over it (or out of it).
+#define SLIDE_HOLD_S 5.0f
+#define SLIDE_FADE_S 1.0f
+#define SLIDE_MAX    4
+
+static struct
+{
+    int frame;                     // guiFrameId of the last update
+    void *item;                    // the game the show belongs to
+    struct theme_elems *family;    // the page it is on
+    GSTEXTURE *tex[SLIDE_MAX + 1]; // each slide's art this frame, by slide number (NULL = none yet)
+    int cur;                       // the slide on show (0 = none)
+    clock_t start;                 // when it began showing
+} slideShow;
+
+static int slideNext(int cur)
+{
+    int i, s;
+    for (i = 1; i <= SLIDE_MAX; i++) {
+        s = (cur - 1 + i) % SLIDE_MAX + 1;
+        if (slideShow.tex[s] != NULL)
+            return s;
+    }
+    return cur;
+}
+
