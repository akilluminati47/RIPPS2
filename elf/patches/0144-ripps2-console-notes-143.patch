+#ifdef PADEMU
+// build 144: this game's button map (PADS/GAMES/<its ID>.pad, which ripps2PadsPrepare hands to PADEMU), as rows: what each button
+// does in this game. The file is written once when the page closes, and taken away when every button does what it says.
+#define GUI_MAP_NONE (PAD_REF_NONE - 1)
+static const char *const guiMapKeys[PAD_B_COUNT] = {"select", "l3", "r3", "start", "up", "right", "down", "left",
+                                                    "l2", "r2", "l1", "r1", "triangle", "circle", "cross", "square"};
+static const char *const guiMapShown[PAD_B_COUNT] = {"SELECT", "L3", "R3", "START", N_("Up"), N_("Right"), N_("Down"), N_("Left"),
+                                                     "L2", "R2", "L1", "R1", N_("Triangle"), N_("Circle"), N_("Cross"), N_("Square")};
+static const unsigned char guiMapOrder[PAD_B_COUNT] = {PAD_B_CROSS, PAD_B_CIRCLE, PAD_B_SQUARE, PAD_B_TRIANGLE, PAD_B_L1, PAD_B_R1, PAD_B_L2, PAD_B_R2,
+                                                       PAD_B_L3, PAD_B_R3, PAD_B_START, PAD_B_SELECT, PAD_B_UP, PAD_B_DOWN, PAD_B_LEFT, PAD_B_RIGHT};
+
+static int guiMapPath(const char *gameId, char *path, int size)
+{
+    char dir[256];
+    if (gameId == NULL || !gameId[0] || !oplGetRipps2Dir(dir, sizeof(dir) - 16))
+        return 0;
+    return snprintf(path, size, "%sPADS/GAMES/%s.pad", dir, gameId) < size;
+}
+
+// 1 when the game has a map of its own; *moved how many buttons it changes
+static int guiMapRead(const char *gameId, unsigned char *map, int *moved)
+{
+    char path[320], text[2048], err[96];
+    int fd, n, i;
+
+    memset(map, PAD_REMAP_SAME, PAD_B_COUNT);
+    *moved = 0;
+    if (!guiMapPath(gameId, path, sizeof(path)) || (fd = open(path, O_RDONLY)) < 0)
+        return 0;
+    n = read(fd, text, sizeof(text) - 1);
+    close(fd);
+    if (n < 0 || padMapParse(text, n, map, err, sizeof(err)) != 0) {
+        memset(map, PAD_REMAP_SAME, PAD_B_COUNT);
+        return 0;
+    }
+    for (i = 0; i < PAD_B_COUNT; i++)
+        *moved += map[i] != PAD_REMAP_SAME;
+    return *moved > 0;
+}
+
+static void guiMapWrite(const char *gameId, const unsigned char *map)
+{
+    char dir[256], path[320], text[1024], msg[420];
+    int fd, i, len, moved = 0;
+
+    if (!guiMapPath(gameId, path, sizeof(path)) || !oplGetRipps2Dir(dir, sizeof(dir) - 16))
+        return;
+    for (i = 0; i < PAD_B_COUNT; i++)
+        moved += map[i] != PAD_REMAP_SAME;
+    if (!moved) {
+        remove(path);
+        return;
+    }
+    len = snprintf(text, sizeof(text), "# This game's button map, set on the PS2 by RIPPS2 (the game's Controller Settings)\n[Mapping]\nformat=%d\n", PAD_FORMAT);
+    for (i = 0; i < PAD_B_COUNT; i++)
+        if (map[i] != PAD_REMAP_SAME)
+            len += snprintf(text + len, sizeof(text) - len, "%s=%s\n", guiMapKeys[i], map[i] == GUI_MAP_NONE ? "none" : guiMapKeys[map[i]]);
+    strcat(dir, "PADS");
+    mkdir(dir, 0777);
+    strcat(dir, "/GAMES");
+    mkdir(dir, 0777);
+    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC)) < 0 || write(fd, text, len) != len) {
+        if (fd >= 0)
+            close(fd);
+        snprintf(msg, sizeof(msg), _t("%s could not be written."), path);
+        guiMsgBox(msg, 0, NULL);
+        return;
+    }
+    close(fd);
+    snprintf(msg, sizeof(msg), _t("Saved as %s. It works through the Pad Emulator, so turn that on for this game."), path);
+    guiMsgBoxSound(SFX_SAVE);
+    guiMsgBox(msg, 0, NULL);
+}
+
+static void guiGameButtonMap(const char *gameId)
+{
+    static ripps2_page_row_t rows[PAD_B_COUNT];
+    unsigned char map[PAD_B_COUNT], was[PAD_B_COUNT];
+    int moved, cursor = 0, i, pick, action;
+
+    guiMapRead(gameId, map, &moved);
+    memcpy(was, map, sizeof(was));
+    while (1) {
+        for (i = 0; i < PAD_B_COUNT; i++) {
+            int b = guiMapOrder[i];
+            rows[i].label = _t(guiMapShown[b]);
+            rows[i].value = map[b] == PAD_REMAP_SAME ? _t("Itself") : map[b] == GUI_MAP_NONE ? _t("Nothing") : _t(guiMapShown[map[b]]);
+            rows[i].tip = _t("What this button does in this game, on a USB pad through the Pad Emulator. Square puts it back. The file is written when this page closes.");
+            rows[i].confirm = _t("NEXT VALUE");
+            rows[i].steps = 1;
+            rows[i].clears = 1;
+            rows[i].sky = NULL;
+        }
+        if ((pick = ripps2Page(_t("Button Map"), rows, PAD_B_COUNT, &cursor, &action)) < 0)
+            break;
+        {
+            int b = guiMapOrder[pick], v;
+            if (action == RIPPS2_PAGE_CLEAR) {
+                map[b] = PAD_REMAP_SAME;
+                continue;
+            }
+            // the sixteen buttons, then nothing
+            v = map[b] == PAD_REMAP_SAME ? b : map[b] == GUI_MAP_NONE ? PAD_B_COUNT : map[b];
+            v = (v + action + PAD_B_COUNT + 1) % (PAD_B_COUNT + 1);
