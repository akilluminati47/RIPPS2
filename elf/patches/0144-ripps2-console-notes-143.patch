+  the theme custom color too so they both get upgraded, use roboto and very nice ui/ux)". A field for saturation and
+  brightness, a bar for hue, the colour as it will be with its value in hex and numbers, and the Color Themes one press
+  away. One colour (the theme's, any colour row in a dialog), or the three of BIBLE's sky with the sky drawn as BIBLE draws
+  it. It does not include ripps2tint.h: what is shown is the colour itself, not turned by the Color Theme.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/pad.h"
+#include "include/sound.h"
+#include "include/ripps2.h"
+#include "include/ripps2tr.h" // _t, N_
+
+#define CP_FX      28
+#define CP_FY      60
+#define CP_FW      216
+#define CP_FH      216
+#define CP_HX      (CP_FX + CP_FW + 10)
+#define CP_HW      22
+#define CP_CELLS   12
+#define CP_PX      296
+#define CP_PW      316
+#define CP_PREVIEW 104
+#define CP_PARTS   3
+#define CP_LIT     GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define CP_SOFT    GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define CP_DIM     GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+
+typedef struct
+{
+    float h, s, v; // 0 to 1
+} cp_hsv_t;
+
+static u64 cpPrim(int r, int g, int b)
+{
+    return GS_SETREG_RGBAQ(r, g, b, 0x80, 0x00);
+}
+
+static float cpClamp(float x)
+{
+    return x < 0.0f ? 0.0f : x > 1.0f ? 1.0f : x;
+}
+
+static int cpByte(float x)
+{
+    int b = (int)(x * 255.0f + 0.5f);
+    return b < 0 ? 0 : b > 255 ? 255 : b;
+}
+
+// The pure colour of a hue, each part 0 to 1
+static void cpHue(float h, float *r, float *g, float *b)
+{
+    float x;
+    int seg;
+
+    while (h >= 1.0f)
+        h -= 1.0f;
+    while (h < 0.0f)
+        h += 1.0f;
+    x = h * 6.0f;
+    seg = (int)x;
+    x -= (float)seg;
+    switch (seg) {
+        case 0:
+            *r = 1.0f, *g = x, *b = 0.0f;
+            break;
+        case 1:
+            *r = 1.0f - x, *g = 1.0f, *b = 0.0f;
+            break;
+        case 2:
+            *r = 0.0f, *g = 1.0f, *b = x;
+            break;
+        case 3:
+            *r = 0.0f, *g = 1.0f - x, *b = 1.0f;
+            break;
+        case 4:
+            *r = x, *g = 0.0f, *b = 1.0f;
+            break;
+        default:
+            *r = 1.0f, *g = 0.0f, *b = 1.0f - x;
+            break;
+    }
+}
+
+static void cpToRgb(const cp_hsv_t *c, unsigned char *rgb)
+{
+    float r, g, b;
+    cpHue(c->h, &r, &g, &b);
+    rgb[0] = cpByte(c->v * (1.0f - c->s + c->s * r));
+    rgb[1] = cpByte(c->v * (1.0f - c->s + c->s * g));
+    rgb[2] = cpByte(c->v * (1.0f - c->s + c->s * b));
+}
+
+// A grey has no hue of its own: the one it had stays (keep)
+static void cpFromRgb(const unsigned char *rgb, cp_hsv_t *c, float keep)
+{
+    float r = rgb[0] / 255.0f, g = rgb[1] / 255.0f, b = rgb[2] / 255.0f;
+    float hi = r > g ? (r > b ? r : b) : (g > b ? g : b), lo = r < g ? (r < b ? r : b) : (g < b ? g : b), d = hi - lo, h = keep;
+
+    if (d > 0.0f) {
+        if (hi == r)
+            h = (g - b) / d;
+        else if (hi == g)
+            h = 2.0f + (b - r) / d;
+        else
+            h = 4.0f + (r - g) / d;
+        h /= 6.0f;
+        if (h < 0.0f)
+            h += 1.0f;
+    }
+    c->h = h;
+    c->s = hi > 0.0f ? d / hi : 0.0f;
+    c->v = hi;
+}
+
+static void cpBox(int x, int y, int w, int h, u64 col)
+{
+    rmDrawLine(x, y, x + w, y, col);
+    rmDrawLine(x, y + h, x + w, y + h, col);
+    rmDrawLine(x, y, x, y + h, col);
+    rmDrawLine(x + w, y, x + w, y + h, col);
+}
+
+static void cpDrawField(const cp_hsv_t *c)
+{
+    static u64 corner[CP_CELLS + 1][CP_CELLS + 1];
+    float r, g, b;
+    int i, j, mx, my;
+
+    cpHue(c->h, &r, &g, &b);
+    for (j = 0; j <= CP_CELLS; j++) {
+        float v = 1.0f - (float)j / CP_CELLS;
+        for (i = 0; i <= CP_CELLS; i++) {
+            float s = (float)i / CP_CELLS;
+            corner[j][i] = cpPrim(cpByte(v * (1.0f - s + s * r)), cpByte(v * (1.0f - s + s * g)), cpByte(v * (1.0f - s + s * b)));
+        }
+    }
+    for (j = 0; j < CP_CELLS; j++) {
+        int y0 = CP_FY + CP_FH * j / CP_CELLS, y1 = CP_FY + CP_FH * (j + 1) / CP_CELLS;
+        for (i = 0; i < CP_CELLS; i++) {
+            int x0 = CP_FX + CP_FW * i / CP_CELLS, x1 = CP_FX + CP_FW * (i + 1) / CP_CELLS;
+            rmDrawQuadGouraud(x0, y0, corner[j][i], x1, y0, corner[j][i + 1], x0, y1, corner[j + 1][i], x1, y1, corner[j + 1][i + 1]);
+        }
+    }
+    cpBox(CP_FX - 1, CP_FY - 1, CP_FW + 1, CP_FH + 1, cpPrim(0x4A, 0x72, 0xDC));
+
+    // the marker: a ring that shows on any colour
+    mx = CP_FX + (int)(c->s * CP_FW);
+    my = CP_FY + (int)((1.0f - c->v) * CP_FH);
+    cpBox(mx - 5, my - 5, 10, 10, cpPrim(0x00, 0x00, 0x00));
+    cpBox(mx - 4, my - 4, 8, 8, cpPrim(0xFF, 0xFF, 0xFF));
+}
+
+static void cpDrawHueBar(float hue)
+{
+    int i, y;
+    for (i = 0; i < 6; i++) {
+        float r0, g0, b0, r1, g1, b1;
+        int y0 = CP_FY + CP_FH * i / 6, y1 = CP_FY + CP_FH * (i + 1) / 6;
+        u64 top, low;
+        cpHue((float)i / 6.0f, &r0, &g0, &b0);
+        cpHue((float)(i + 1) / 6.0f, &r1, &g1, &b1);
+        top = cpPrim(cpByte(r0), cpByte(g0), cpByte(b0));
+        low = cpPrim(cpByte(r1), cpByte(g1), cpByte(b1));
+        rmDrawQuadGouraud(CP_HX, y0, top, CP_HX + CP_HW, y0, top, CP_HX, y1, low, CP_HX + CP_HW, y1, low);
+    }
+    cpBox(CP_HX - 1, CP_FY - 1, CP_HW + 1, CP_FH + 1, cpPrim(0x4A, 0x72, 0xDC));
+    y = CP_FY + (int)(hue * CP_FH);
+    rmDrawRect(CP_HX - 3, y - 2, CP_HW + 6, 5, cpPrim(0x00, 0x00, 0x00));
+    rmDrawRect(CP_HX - 2, y - 1, CP_HW + 4, 3, cpPrim(0xFF, 0xFF, 0xFF));
+}
+
+static void cpHint(int icon, const char *text, int *x, int y)
+{
+    GSTEXTURE *t = thmGetTexture(icon);
+    if (t != NULL) {
+        rmDrawPixmap(t, *x, y - 10, ALIGN_NONE, 20, 20, SCALING_RATIO, CP_LIT, 0);
+        *x += 24;
+    }
+    fntRenderString(RIPPS2_MSG_FONT, *x, y, ALIGN_VCENTER, 0, 0, text, CP_LIT);
+    *x += rmUnScaleX(fntCalcDimensions(RIPPS2_MSG_FONT, text)) + 18;
+}
+
+static int cpHintW(const char *text)
+{
+    return 24 + rmUnScaleX(fntCalcDimensions(RIPPS2_MSG_FONT, text)) + 18;
+}
+
+// A Color Theme's colours: its sky, or for one colour the sky's horizon, which is the colour the theme is known by
+static int cpThemeColors(int p, unsigned char out[3][3])
+{
+    char text[32];
+    unsigned int c[3];
+    int i;
+
+    ripps2ThemeSky(p, text, sizeof(text));
+    if (sscanf(text, "%6x,%6x,%6x", &c[0], &c[1], &c[2]) != 3)
+        return 0;
+    for (i = 0; i < 3; i++) {
+        out[i][0] = (c[i] >> 16) & 0xFF;
+        out[i][1] = (c[i] >> 8) & 0xFF;
+        out[i][2] = c[i] & 0xFF;
+    }
+    return 1;
+}
+
+int ripps2ColorPick(const char *title, unsigned char (*rgb)[3], int count, const char *const *partNames)
+{
+    static unsigned char before[CP_PARTS][3], now[CP_PARTS][3];
+    cp_hsv_t hsv[CP_PARTS];
+    char line[64];
+    int part = 0, theme = -1, i, heldFrames = 0, result = -1;
+    int backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+    int okIcon = gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, backIcon = gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON;
+
+    if (count < 1)
+        return 0;
+    if (count > CP_PARTS)
+        count = CP_PARTS;
+    for (i = 0; i < count; i++) {
+        memcpy(before[i], rgb[i], 3);
+        memcpy(now[i], rgb[i], 3);
+        cpFromRgb(rgb[i], &hsv[i], 0.0f);
+    }
+
+    while (result < 0) {
+        cp_hsv_t *c = &hsv[part];
+        const char *themeName = theme >= 0 ? _t(ripps2PaletteName(theme)) : NULL;
+        int hintY = gTheme->usedHeight - 32, tipY = hintY - 22, hw, hx, sx, sy;
+
+        readPads();
+        rmStartFrame();
+        guiDrawBGPlasma();
+        rmDrawRect(0, 0, 640, 480, GS_SETREG_RGBAQ(0x00, 0x02, 0x0A, 0x58, 0x00)); // the colours are what is looked at
+        fntRenderStringFit(RIPPS2_NOTE_FONT, 20, 30, ALIGN_VCENTER, 600, title, CP_LIT, 1);
+        rmDrawLine(20, 46, 620, 46, cpPrim(0x4A, 0x72, 0xDC));
+
+        cpDrawField(c);
+        cpDrawHueBar(c->h);
+
+        // the colour as it will be
+        if (count == 3) { // BIBLE's sky: top to horizon, horizon to floor
+            int top = CP_FY, hz = CP_FY + CP_PREVIEW * 290 / 480, low = CP_FY + CP_PREVIEW;
+            u64 c0 = cpPrim(now[0][0], now[0][1], now[0][2]), c1 = cpPrim(now[1][0], now[1][1], now[1][2]), c2 = cpPrim(now[2][0], now[2][1], now[2][2]);
+            rmDrawQuadGouraud(CP_PX, top, c0, CP_PX + CP_PW, top, c0, CP_PX, hz, c1, CP_PX + CP_PW, hz, c1);
+            rmDrawQuadGouraud(CP_PX, hz, c1, CP_PX + CP_PW, hz, c1, CP_PX, low, c2, CP_PX + CP_PW, low, c2);
+        } else { // what it was, and what it is now
+            int half = CP_PW / 2;
+            rmDrawRect(CP_PX, CP_FY, half, CP_PREVIEW, cpPrim(before[0][0], before[0][1], before[0][2]));
+            rmDrawRect(CP_PX + half, CP_FY, CP_PW - half, CP_PREVIEW, cpPrim(now[0][0], now[0][1], now[0][2]));
+            fntRenderString(RIPPS2_MSG_FONT, CP_PX + half / 2, CP_FY + CP_PREVIEW + 12, ALIGN_CENTER, 0, 0, _t("Before"), CP_DIM);
+            fntRenderString(RIPPS2_MSG_FONT, CP_PX + half + half / 2, CP_FY + CP_PREVIEW + 12, ALIGN_CENTER, 0, 0, _t("Now"), CP_SOFT);
+        }
+        cpBox(CP_PX - 1, CP_FY - 1, CP_PW + 1, CP_PREVIEW + 1, cpPrim(0x4A, 0x72, 0xDC));
+
+        // the parts of the sky, the chosen one lit
+        sy = CP_FY + CP_PREVIEW + 12;
+        if (count > 1) {
+            int w = CP_PW / count;
+            for (i = 0; i < count; i++) {
+                sx = CP_PX + i * w;
+                if (i == part)
+                    rmDrawRect(sx, sy - 10, w - 4, 20, cpPrim(0x1E, 0x3C, 0x96));
+                rmDrawRect(sx + 4, sy - 7, 14, 14, cpPrim(now[i][0], now[i][1], now[i][2]));
+                cpBox(sx + 4, sy - 7, 14, 14, cpPrim(0x6A, 0x9A, 0xFF));
+                fntRenderStringFit(RIPPS2_MSG_FONT, sx + 24, sy, ALIGN_VCENTER, w - 32, partNames != NULL ? _t(partNames[i]) : "", i == part ? CP_LIT : CP_SOFT, 0);
+            }
+        }
+
+        // the value
+        snprintf(line, sizeof(line), "#%02X%02X%02X", now[part][0], now[part][1], now[part][2]);
+        fntRenderString(RIPPS2_NOTE_FONT, CP_PX, sy + 28, ALIGN_VCENTER, 0, 0, line, CP_LIT);
+        snprintf(line, sizeof(line), "R %d   G %d   B %d", now[part][0], now[part][1], now[part][2]);
+        fntRenderString(RIPPS2_MSG_FONT, CP_PX, sy + 50, ALIGN_VCENTER, 0, 0, line, CP_SOFT);
+        snprintf(line, sizeof(line), "H %d   S %d   V %d", (int)(c->h * 360.0f + 0.5f), (int)(c->s * 100.0f + 0.5f), (int)(c->v * 100.0f + 0.5f));
+        fntRenderString(RIPPS2_MSG_FONT, CP_PX, sy + 70, ALIGN_VCENTER, 0, 0, line, CP_SOFT);
+
+        // the Color Themes, one press away
+        sy += 96;
+        fntRenderStringFit(RIPPS2_MSG_FONT, CP_PX, sy, ALIGN_VCENTER, CP_PW, themeName != NULL ? themeName : _t("Color Themes"), themeName != NULL ? CP_LIT : CP_DIM, 0);
+        sy += 12;
+        for (i = 0; i < RIPPS2_PALETTE_COUNT; i++) {
+            unsigned char t[3][3];
+            int w = CP_PW / RIPPS2_PALETTE_COUNT;
+            sx = CP_PX + i * w;
+            if (!cpThemeColors(i, t))
+                continue;
+            rmDrawRect(sx + 1, sy, w - 3, 14, cpPrim(t[1][0], t[1][1], t[1][2]));
+            if (i == theme)
+                cpBox(sx, sy - 1, w - 1, 16, cpPrim(0xFF, 0xFF, 0xFF));
+        }
+
+        rmDrawLine(20, tipY - 12, 620, tipY - 12, cpPrim(0x4A, 0x72, 0xDC));
+        fntRenderStringFit(RIPPS2_MSG_FONT, 320, tipY, ALIGN_CENTER, 600, _t("D-pad or left stick: saturation and brightness. L1, R1 or right stick: hue."), CP_SOFT, 0);
+
+        hw = cpHintW(_t("Color Theme")) + cpHintW(_t("OK")) + cpHintW(_t("Cancel")) + (count > 1 ? cpHintW(_t("Next Part")) : 0);
+        hx = (640 - hw) / 2;
+        if (count > 1)
+            cpHint(SQUARE_ICON, _t("Next Part"), &hx, hintY + 10);
+        cpHint(TRIANGLE_ICON, _t("Color Theme"), &hx, hintY + 10);
+        cpHint(okIcon, _t("OK"), &hx, hintY + 10);
+        cpHint(backIcon, _t("Cancel"), &hx, hintY + 10);
+        rmEndFrame();
+
+        if (getKeyOn(gSelectButton)) {
+            sfxPlay(SFX_CONFIRM);
+            result = 1;
+            continue;
+        }
+        if (getKeyOn(backKey)) {
+            sfxPlay(SFX_CANCEL);
+            result = 0;
+            continue;
+        }
+        if (count > 1 && getKeyOn(KEY_SQUARE)) {
+            part = (part + 1) % count;
+            sfxPlay(SFX_CURSOR);
+            continue;
+        }
+        if (getKeyOn(KEY_TRIANGLE)) { // the next Color Theme: its colours, ready to change
+            unsigned char t[3][3];
+            theme = (theme + 1) % RIPPS2_PALETTE_COUNT;
+            if (cpThemeColors(theme, t)) {
