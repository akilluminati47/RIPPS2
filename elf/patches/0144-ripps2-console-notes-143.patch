+            continue;
+        }
+
+        // held longer, it moves faster
+        {
+            float ds = 0.0f, dv = 0.0f, dh = 0.0f, step;
+            int lx, ly, rx, ry, any;
+
+            any = getKeyPressed(KEY_LEFT) || getKeyPressed(KEY_RIGHT) || getKeyPressed(KEY_UP) || getKeyPressed(KEY_DOWN) || getKeyPressed(KEY_L1) || getKeyPressed(KEY_R1);
+            heldFrames = any ? heldFrames + 1 : 0;
+            step = heldFrames > 45 ? 0.016f : heldFrames > 15 ? 0.008f : 1.0f / 255.0f;
+            if (getKeyPressed(KEY_LEFT))
+                ds -= step;
+            if (getKeyPressed(KEY_RIGHT))
+                ds += step;
+            if (getKeyPressed(KEY_UP))
+                dv += step;
+            if (getKeyPressed(KEY_DOWN))
+                dv -= step;
+            if (getKeyPressed(KEY_L1))
+                dh -= step;
+            if (getKeyPressed(KEY_R1))
+                dh += step;
+            padGetLeftStick(&lx, &ly);
+            padGetRightStick(&rx, &ry);
+            if (lx > 24 || lx < -24)
+                ds += (float)lx / 127.0f * 0.012f;
+            if (ly > 24 || ly < -24)
+                dv -= (float)ly / 127.0f * 0.012f;
+            if (ry > 24 || ry < -24)
+                dh += (float)ry / 127.0f * 0.006f;
+            if (ds != 0.0f || dv != 0.0f || dh != 0.0f) {
+                c->s = cpClamp(c->s + ds);
+                c->v = cpClamp(c->v + dv);
+                c->h += dh;
+                if (c->h > 1.0f)
+                    c->h -= 1.0f; // round the bar
+                if (c->h < 0.0f)
+                    c->h += 1.0f;
+                cpToRgb(c, now[part]);
+                theme = -1;
+                if (heldFrames == 1)
+                    sfxPlay(SFX_CURSOR);
+            }
+        }
+    }
+
+    if (result)
+        for (i = 0; i < count; i++)
+            memcpy(rgb[i], now[i], 3);
+    readPads();
+    return result;
+}
