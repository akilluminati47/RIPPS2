+// Manage's Other Regions: the bound file copied to every region's names, or those copies taken away. A file is bound to the card, not to a
+// folder, so no second bind. A folder holding anything of anyone else's is left alone
+static void blRegionsSet(int port, int add)
+{
+    char bound[64], other[32], path[80], msg[300];
+    int f, kb = 0, done = 0, failed = 0;
+
+    snprintf(bound, sizeof(bound), "mc%d:/%s/%s", port, blSysFolder, blSysFile);
+    if (add) {
+        int fd = open(bound, O_RDONLY), size = 0;
+        if (fd >= 0) {
+            size = lseek(fd, 0, SEEK_END);
+            close(fd);
+        }
+        if (size <= 0) {
+            guiMsgBoxSound(SFX_ERROR);
+            snprintf(msg, sizeof(msg), _t("%s is not there, so there is nothing to copy. Set up BIBLE on this card first."), bound);
+            guiMsgBox(msg, 0, NULL);
+            return;
+        }
+        for (f = 0; blSysFolders[f] != NULL; f++) {
+            const char *const *n = blRegionFiles(blSysFolders[f]);
+            if (strcmp(blSysFolders[f], blSysFolder))
+                for (; *n != NULL; n++)
+                    kb += size / 1024 + 2;
+        }
+        kb += 3 * ((size_bible_icn + 1023) / 1024 + 2);
+        blCardInfo(port, &f);
+        if (f < kb) {
+            guiMsgBoxSound(SFX_ERROR);
+            snprintf(msg, sizeof(msg), _t("The memory card in slot %d has %d KB free, and BIBLE for the other regions needs %d KB. Free some space, then try again."), port, f, kb);
+            guiMsgBox(msg, 0, NULL);
+            return;
+        }
+    }
+    guiRenderTextScreen(_t("RIPPS2: Setting up BIBLE (its copies for other regions)"));
+    for (f = 0; blSysFolders[f] != NULL; f++) {
+        if (!strcmp(blSysFolders[f], blSysFolder))
+            continue;
+        snprintf(other, sizeof(other), "mc%d:/%s", port, blSysFolders[f]);
+        if (add) {
+            const char *const *n = blRegionFiles(blSysFolders[f]);
+            int ok = 1;
+            if (blDirExists(other) && !blFolderIsBibleCopy(other, NULL)) {
+                ripps2Diag("bible: %s holds someone else's files: left alone", other);
+                continue;
+            }
+            mkdir(other, 0777);
+            for (; *n != NULL && ok; n++) {
+                snprintf(path, sizeof(path), "%s/%s", other, *n);
+                ok = blCardCopy(bound, path);
+            }
+            if (ok)
+                ok = blWriteIcons(other, "BIBLE ", blRegionName(blSysFolders[f]));
+            done += ok;
+            failed += !ok;
+        } else if (blDirExists(other) && blFolderIsBibleCopy(other, NULL)) {
+            blFolderEmpty(other, NULL);
+            done++;
+        }
+    }
+    guiMsgBoxSound(failed ? SFX_ERROR : SFX_SAVE);
+    if (failed)
+        snprintf(msg, sizeof(msg), _t("BIBLE was copied for %d other regions, and %d would not take it. DIAG.TXT beside RIPPS2 has what the card said."), done, failed);
+    else if (add)
+        snprintf(msg, sizeof(msg), _t("This card now starts BIBLE on consoles of every region. Each has its own folder in the browser, holding only its boot file. The settings and boot sound stay in one."));
+    else
+        snprintf(msg, sizeof(msg), _t("BIBLE's copies for the other regions are gone. This card starts it on consoles of this region."));
+    guiMsgBox(msg, 0, NULL);
+}
