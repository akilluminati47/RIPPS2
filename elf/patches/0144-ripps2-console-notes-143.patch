+// The folder holding this card's one settings file, this console's first; this console's when there is none yet. 1 when it was there
+static int blHomeOf(int port, char *home, int size)
+{
+    char path[64];
+    int f;
+
+    for (f = -1; blSysFolders[f < 0 ? 0 : f] != NULL; f++) {
+        const char *folder = f < 0 ? blSysFolder : blSysFolders[f];
+        snprintf(path, sizeof(path), "mc%d:/%s/PS2BBL.INI", port, folder);
+        if (blFileExists(path)) {
+            snprintf(home, size, "mc%d:/%s", port, folder);
+            return 1;
+        }
+    }
+    snprintf(home, size, "mc%d:/%s", port, blSysFolder);
+    return 0;
+}
+
+// BIBLE's settings and boot sound in one folder, every region's copy current and named, the old places gone when nothing else is
+// in them. 1 unless the settings could not be written; conf: where they are
+static int blOneFolder(int port, const char *alt, const char *backupKelf, char *conf, int confSize)
+{
+    static const char *const sysConfNames[] = {"PS2BBL.INI", "PS2BBL.INI.RIPPS2-BACKUP", "boot.adp", "icon.sys", "PS2BBL.icn", "bible.icn", NULL};
+    static const char *const oldConfNames[] = {"CONFIG.INI", "CONFIG.INI.RIPPS2-BACKUP", "icon.sys", "PS2BBL.icn", "bible.icn", NULL};
+    char home[32], own[32], bound[64], from[64], to[80], sysConf[24], oldConf[24];
+    int len, f;
+
+    blHomeOf(port, home, sizeof(home));
+    snprintf(own, sizeof(own), "mc%d:/%s", port, blSysFolder);
+    snprintf(bound, sizeof(bound), "%s/%s", own, blSysFile);
+    snprintf(conf, confSize, "%s/PS2BBL.INI", home);
+    snprintf(sysConf, sizeof(sysConf), "mc%d:/SYS-CONF", port);
+    snprintf(oldConf, sizeof(oldConf), "mc%d:/PS2BBL", port);
+
+    if (blRead(conf) < 0) {
+        snprintf(from, sizeof(from), "%s/PS2BBL.INI", sysConf);
+        if (blRead(from) >= 0)
+            len = strlen(blText); // the settings the card has stay the settings it has
+        else
+            len = blBibleConfig(alt, backupKelf);
+        if (len < 0 || blWrite(conf, blText, len) != 0)
+            return 0;
+    }
+    snprintf(from, sizeof(from), "%s/PS2BBL.INI.RIPPS2-BACKUP", sysConf);
+    snprintf(to, sizeof(to), "%s/PS2BBL.INI.RIPPS2-BACKUP", home);
+    if (blFileExists(from) && !blFileExists(to))
+        blCardCopy(from, to);
+    snprintf(from, sizeof(from), "%s/boot.adp", sysConf);
+    snprintf(to, sizeof(to), "%s/boot.adp", home);
+    if (blFileExists(from) && !blFileExists(to))
+        blCardCopy(from, to);
+
+    if (blFolderOnlyHas(sysConf, sysConfNames))
+        blFolderRemove(sysConf, sysConfNames);
+    if (blFolderOnlyHas(oldConf, oldConfNames))
+        blFolderRemove(oldConf, oldConfNames);
+
+    // the user, 11/05: "we need regional support, can't we make it neater?". The browser shows every folder (it ignores the hidden
+    // attribute, the lab tried it), so a region's copy stays as a folder: only the boot file and BIBLE's icon, its title naming the region
+    guiRenderTextScreen(_t("RIPPS2: Setting up BIBLE (its copies for other regions)"));
+    if (blFolderIsBibleCopy(own, blSysFile))
+        blFolderRefresh(bound, own, blSysFile);
+    for (f = 0; blSysFolders[f] != NULL; f++) {
+        char other[32];
+        if (!strcmp(blSysFolders[f], blSysFolder))
+            continue;
+        snprintf(other, sizeof(other), "mc%d:/%s", port, blSysFolders[f]);
+        if (blDirExists(other) && blFolderIsBibleCopy(other, NULL)) {
+            blFolderRefresh(bound, other, NULL);
+            blWriteIcons(other, "BIBLE ", blRegionName(blSysFolders[f]));
+        }
+    }
+    if (gBibleHome[0] && gBibleHome[2] - '0' == port) // this boot's BIBLE read the old place: Manage and the sounds follow it
+        snprintf(gBibleHome, sizeof(gBibleHome), "%s/", home);
+    return 1;
+}
+
+// How many other regions this card has BIBLE for
+static int blRegionCount(int port)
+{
+    char other[32];
+    int f, n = 0;
+
+    for (f = 0; blSysFolders[f] != NULL; f++) {
+        if (!strcmp(blSysFolders[f], blSysFolder))
+            continue;
+        snprintf(other, sizeof(other), "mc%d:/%s", port, blSysFolders[f]);
+        n += blDirExists(other) && blFolderIsBibleCopy(other, NULL);
+    }
+    return n;
+}
