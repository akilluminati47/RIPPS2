+
+    if (d == NULL)
+        return;
+    while (n < 12 && (e = readdir(d)) != NULL) {
+        if (strstr(e->d_name, ".elf") == NULL || (keep != NULL && !strcasecmp(e->d_name, keep)))
+            continue;
+        snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
+        if (blBibleBuildOf(path, &older) != NULL)
+            snprintf(names[n++], sizeof(names[0]), "%.35s", e->d_name);
+    }
+    closedir(d);
+    for (i = 0; i < n; i++) {
+        snprintf(path, sizeof(path), "%s/%s", dir, names[i]);
+        if (!blCardCopy(bound, path))
+            ripps2Diag("bible: %s was not refreshed", path);
+    }
+    snprintf(path, sizeof(path), "%s/PS2BBL.icn", dir);
+    remove(path);
+}
