+#ifdef RIPPS2_BIBLE_ONE_FOLDER
+/* build 144 (the user, 11/05, after the first console run: "the only folder with the new icon is BIBLE BOOT LOADER ... next test id
+   like to have only this folder for all the memory card files from bible it makes on mc"): BIBLE's settings, their backup and the
+   boot sound go in its system folder, and what it left elsewhere goes when nothing else is there. Someone else's file keeps its
+   folder as it was. */
+static int blIsOneOf(const char *name, const char *const *names)
+{
+    for (; *names != NULL; names++)
+        if (!strcasecmp(name, *names))
+            return 1;
+    return 0;
+}
+
+// 1 when a folder holds only these names
+static int blFolderOnlyHas(const char *dir, const char *const *names)
+{
+    DIR *d = opendir(dir);
+    struct dirent *e;
+    int only = 1;
+
+    if (d == NULL)
+        return 0;
+    while (only && (e = readdir(d)) != NULL)
+        if (strcmp(e->d_name, ".") && strcmp(e->d_name, "..") && !blIsOneOf(e->d_name, names))
+            only = 0;
+    closedir(d);
+    return only;
+}
+
+// The named files, then the folder (rmdir leaves a folder that still holds anything)
+static void blFolderRemove(const char *dir, const char *const *names)
+{
+    char path[96];
+    for (; *names != NULL; names++) {
+        snprintf(path, sizeof(path), "%s/%s", dir, *names);
+        remove(path);
+    }
+    if (rmdir(dir) != 0)
+        ripps2Diag("bible: %s stayed", dir);
+    else
+        ripps2Diag("bible: %s tidied away", dir);
+}
+
+// The whole file to another place on a card. 1 when it is there
+static int blCardCopy(const char *from, const char *to)
+{
+    char *buf;
+    int fd, size, ok = 0;
+
+    if ((fd = open(from, O_RDONLY)) < 0)
+        return 0;
+    size = lseek(fd, 0, SEEK_END);
+    lseek(fd, 0, SEEK_SET);
+    if (size > 0 && (buf = malloc(size)) != NULL) {
+        ok = read(fd, buf, size) == size;
+        close(fd);
+        fd = -1;
+        if (ok)
+            ok = blWrite(to, buf, size) == 0;
+        free(buf);
+    }
+    if (fd >= 0)
+        close(fd);
+    return ok;
+}
+
+// A system folder that holds BIBLE and nothing of anyone else's: its BIBLEs, its icons, the 7 KB kernel loaders an SD2PSX boot card has
+static int blFolderIsBibleCopy(const char *dir, const char *keep)
+{
+    static const char *const icons[] = {"icon.sys", "PS2BBL.icn", "bible.icn", "PS2BBL.INI", "PS2BBL.INI.RIPPS2-BACKUP", "boot.adp", NULL};
+    DIR *d = opendir(dir);
+    struct dirent *e;
+    char path[96];
+    int ours = 1, bibles = 0, older, fd;
+
+    if (d == NULL)
+        return 0;
+    while (ours && (e = readdir(d)) != NULL) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..") || blIsOneOf(e->d_name, icons) || (keep != NULL && !strcasecmp(e->d_name, keep)))
+            continue;
+        snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
+        if (blBibleBuildOf(path, &older) != NULL) {
+            bibles++;
+            continue;
+        }
+        ours = 0;
+        if ((fd = open(path, O_RDONLY)) >= 0) { // a kernel loader beside it
+            ours = lseek(fd, 0, SEEK_END) <= 8192 && strstr(e->d_name, ".elf") != NULL;
+            close(fd);
+        }
+    }
+    closedir(d);
+    return ours && (bibles > 0 || keep != NULL);
+}
+
+// Every file in the folder but keep, the folder itself when it has no keep
+static void blFolderEmpty(const char *dir, const char *keep)
+{
+    char names[24][36];
+    char path[96];
+    DIR *d = opendir(dir);
+    struct dirent *e;
+    int n = 0, i;
+
+    if (d == NULL)
+        return;
+    while (n < 24 && (e = readdir(d)) != NULL)
+        if (strcmp(e->d_name, ".") && strcmp(e->d_name, "..") && (keep == NULL || !blIsOneOf(e->d_name, (const char *const[]){keep, "icon.sys", "bible.icn", "PS2BBL.INI", "PS2BBL.INI.RIPPS2-BACKUP", "boot.adp", NULL})))
+            snprintf(names[n++], sizeof(names[0]), "%.35s", e->d_name);
+    closedir(d);
+    for (i = 0; i < n; i++) {
+        snprintf(path, sizeof(path), "%s/%s", dir, names[i]);
+        remove(path);
+    }
+    if (keep == NULL) {
+        if (rmdir(dir) != 0)
+            ripps2Diag("bible: %s stayed", dir);
+        else
+            ripps2Diag("bible: %s tidied away", dir);
