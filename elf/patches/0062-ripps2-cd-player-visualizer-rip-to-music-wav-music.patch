diff --git a/src/ripps2cd.c b/src/ripps2cd.c
new file mode 100644
index 0000000..80c17e6
--- /dev/null
+++ b/src/ripps2cd.c
@@ -0,0 +1,624 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 CD player: LAUNCH DISC with an audio CD in the drive, START LASER. The disc plays through
+  the music stream (sound.c bgmStartPcm) while the towers settle and light up to it, from a glass
+  panel inlaid on the page, the category bar still on top. A track copies into MUSIC/ beside RIPPS2
+  as a .wav, named on the keyboard, and Audio settings > Music then offers it for the menu music.
+
+    Cross       play / pause            Up / Down    pick a track
+    Square      stop                    Left / Right the track before / after
+    L1 / R1     back / on 10 seconds    Triangle     copy the picked track to MUSIC
+    Circle      close the player (the menu music comes back)
+
+  The stream reads CDDA sectors (2352 bytes, 16-bit stereo at 44.1 kHz) straight off the disc, 16 at
+  a time, on the music's own IO thread; the panel shows what is heard, from what the stream has
+  handed to audsrv, not what has been read ahead. A disc's tracks play on into each other, as a CD
+  player's do, up to the lead-out or the first data track.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <math.h>
+#include <kernel.h>
+#include <libcdvd.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/pad.h"
+#include "include/sound.h"
+#include "include/ripps2.h"
+#include "include/ioman.h" // LOG
+
+#define CD_TRACKS_MAX 99
+#define CD_SECTOR     2352
+#define CD_READ       16  // sectors a read: 0.21 s of sound
+#define CD_PREGAP     150 // the 2 s every MSF in the TOC counts from
+#define CD_SKIP       750 // 10 s of sectors
+#define CD_ROWS       4
+#define CD_ROW_H      19
+
+#define CD_X 60 // the panel: low on the page, so the towers above it have the screen
+#define CD_Y 316
+#define CD_W 520
+#define CD_H 118
+
+#define CD_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define CD_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define CD_DIM  GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+#define CD_BLUE GS_SETREG_RGBA(0x5C, 0x98, 0xFF, 0x80)
+#define CD_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+
+enum { CD_STOPPED = 0, CD_PLAYING, CD_PAUSED };
+
+static int cdOpen = 0, cdCount = 0, cdSel = 1, cdTop = 1, cdState = CD_STOPPED;
+static u32 cdStart[CD_TRACKS_MAX + 2];        // each track's first sector; [cdCount + 1] is the lead-out
+static unsigned char cdAudio[CD_TRACKS_MAX + 2]; // an audio track (not data)
+static u32 cdFrom = 0, cdHeld = 0;            // where the stream began; where a pause holds
+static clock_t cdTrayAt = 0;
+static char cdNote[96];
+static clock_t cdNoteAt = 0;
+
+// the stream, read on the music's IO thread
+static volatile u32 cdLsn = 0, cdEnd = 0;
+static u8 cdBuf[CD_READ * CD_SECTOR] __attribute__((aligned(64)));
+static int cdBufPos = 0, cdBufLen = 0;
+
+static void cdSay(const char *text)
+{
+    snprintf(cdNote, sizeof(cdNote), "%s", text);
+    cdNoteAt = clock();
+}
+
+static int cdBcd(u8 b)
+{
+    return (b >> 4) * 10 + (b & 0x0F);
+}
+
+static u32 cdMsf(const u8 *m)
+{
+    int s = (cdBcd(m[0]) * 60 + cdBcd(m[1])) * 75 + cdBcd(m[2]) - CD_PREGAP;
+    return s < 0 ? 0 : (u32)s;
+}
+
+// The TOC: 10-byte entries, each naming its point (a track number in BCD, or A0 / A1 / A2 for the
+// first track, the last and the lead-out) and where it starts (PMIN PSEC PFRAME). Scanning every
+// entry for its point reads the drive's raw TOC and the emulators' layouts alike.
+static int cdReadToc(void)
+{
+    static u8 toc[1024] __attribute__((aligned(64)));
+    unsigned char seen[CD_TRACKS_MAX + 2];
+    u32 leadOut = 0;
+    int o, t, last = 0;
+
+    cdCount = 0;
+    memset(seen, 0, sizeof(seen));
+    memset(cdAudio, 0, sizeof(cdAudio));
+    sceCdMmode(SCECdMmodeCd);
+    sceCdDiskReady(0);
+    memset(toc, 0, sizeof(toc));
+    if (!sceCdGetToc(toc))
+        memset(toc, 0, sizeof(toc));
+#ifdef RIPPS2_CD_TEST
+    if (toc[2] != 0xA0) { // a test build: PCSX2 builds no CD TOC for an image it cannot type, so the test
+        static const u32 testStarts[4] = {0, 2250, 3750, 4875}; // CD's own layout (scratchpad testcd)
+        for (t = 1; t <= 3; t++) {
+            cdStart[t] = testStarts[t - 1];
+            cdAudio[t] = 1;
+        }
+        cdStart[4] = testStarts[3];
+        cdCount = 3;
+        return 1;
+    }
+#endif
+    for (o = 0; o + 10 <= (int)sizeof(toc); o += 10) {
+        const u8 *e = toc + o;
+        u8 point = e[2];
+        if (point == 0xA2)
+            leadOut = cdMsf(e + 7);
+        else if (point != 0 && (point >> 4) <= 9 && (point & 0x0F) <= 9) {
+            t = cdBcd(point);
+            if (t >= 1 && t <= CD_TRACKS_MAX && !seen[t]) {
+                seen[t] = 1;
+                cdStart[t] = cdMsf(e + 7);
+                cdAudio[t] = !(e[0] & 0x40); // the control bits mark a data track
+#ifdef RIPPS2_CD_TEST
+                cdAudio[t] = 1; // a test build: PCSX2 calls every image track data
+#endif
+                if (t > last)
+                    last = t;
+            }
+        }
+    }
+    for (t = 1; t <= last; t++)
+        if (!seen[t])
+            return 0;
+    if (last == 0 || leadOut <= cdStart[last])
+        return 0;
+    cdStart[last + 1] = leadOut;
+    cdCount = last;
+    return 1;
+}
+
+static int cdTrackAt(u32 lsn)
+{
+    int t;
+    for (t = cdCount; t > 1 && cdStart[t] > lsn; t--)
+        ;
+    return t;
+}
+
+// Where play from lsn runs out: the lead-out, or the first data track after it
+static u32 cdAudioEnd(u32 lsn)
+{
+    int t;
+    for (t = cdTrackAt(lsn) + 1; t <= cdCount; t++)
+        if (!cdAudio[t])
+            return cdStart[t];
+    return cdStart[cdCount + 1];
+}
+
+#ifdef RIPPS2_CD_TEST
+// PCSX2 hands back silence for a disc image's CDDA reads, so a test build plays the test CD's own sound
+// in its place (scratchpad testcd: a kick and bass, then hi-hats, then a swelling chord), letting the
+// stream, the panel and the towers be seen and heard in the emulator
+static void cdTestSound(u32 lsn, u32 n)
+{
+    static unsigned int noise = 7;
+    short *s = (short *)cdBuf;
+    int track = cdTrackAt(lsn);
+    u32 i, frames = n * (CD_SECTOR / 4), first = (lsn - cdStart[track]) * (CD_SECTOR / 4);
+
+    for (i = 0; i < frames; i++) {
+        float t = (float)(first + i) / 44100.0f, x;
+        if (track == 1) {
+            float b = fmodf(t, 0.5f);
+            x = 0.8f * sinf(6.2832f * (50.0f + 120.0f * expf(-b * 30.0f)) * b) * expf(-b * 9.0f) + 0.35f * sinf(6.2832f * 55.0f * t);
+        } else if (track == 2) {
+            noise = noise * 1664525u + 1013904223u;
+            x = 0.35f * ((float)(noise >> 9) / 4194304.0f - 1.0f) * expf(-fmodf(t + 0.25f, 0.5f) * 40.0f);
+        } else
+            x = 0.15f * (sinf(6.2832f * 261.6f * t) + sinf(6.2832f * 329.6f * t) + sinf(6.2832f * 392.0f * t) + sinf(6.2832f * 523.3f * t)) *
+                (0.5f + 0.5f * sinf(6.2832f * 0.25f * t));
+        s[2 * i] = s[2 * i + 1] = (short)(x * 30000.0f);
+    }
+}
+#endif
+
+static int cdStreamRead(char *buf, int size)
+{
+    sceCdRMode m;
+    int done = 0;
+
+    m.trycount = 3;
+    m.spindlctrl = SCECdSpinNom;
+    m.datapattern = SCECdSecS2352;
+    m.pad = 0;
+    while (done < size) {
+        if (cdBufPos >= cdBufLen) {
+            u32 n;
+            if (cdLsn >= cdEnd)
+                return done; // the disc's audio is over: 0 ends the stream
+            n = cdEnd - cdLsn;
+            if (n > CD_READ)
+                n = CD_READ;
+            if (!sceCdReadCDDA(cdLsn, n, cdBuf, &m)) { // libcdvd writes the cache back over cdBuf itself
+                LOG("RIPPS2 CD: read of %u sectors at %u refused\n", (unsigned)n, (unsigned)cdLsn);
+                return done > 0 ? done : -1;
+            }
+            sceCdSync(0);
+            // the drive's error code can outlast the read that set it, so a reported error keeps the
+            // data (the drive's retries already had their go at a scratch) and only goes in the log
+            int err = sceCdGetError();
+            if (err != SCECdErNO || cdLsn == cdFrom)
+                LOG("RIPPS2 CD: %u sectors at %u, error %d, first samples %d %d\n", (unsigned)n, (unsigned)cdLsn, err,
+                    ((short *)cdBuf)[0], ((short *)cdBuf)[1000]);
+#ifdef RIPPS2_CD_TEST
+            if (((short *)cdBuf)[1000] == 0 && ((short *)cdBuf)[3001] == 0)
+                cdTestSound(cdLsn, n);
+#endif
+            cdLsn += n;
+            cdBufPos = 0;
+            cdBufLen = n * CD_SECTOR;
+        }
+        int k = size - done;
+        if (k > cdBufLen - cdBufPos)
+            k = cdBufLen - cdBufPos;
+        memcpy(buf + done, cdBuf + cdBufPos, k);
+        done += k;
+        cdBufPos += k;
+    }
+    return done;
+}
+
+// The sector being heard
+static u32 cdNow(void)
+{
+    if (cdState == CD_PLAYING)
+        return cdFrom + bgmPlayedBytes() / CD_SECTOR;
+    if (cdState == CD_PAUSED)
+        return cdHeld;
+    return cdStart[cdSel];
+}
+
+static void cdPlayFrom(u32 lsn)
+{
+    int t = cdTrackAt(lsn);
+    if (!cdAudio[t]) {
+        cdSay("THAT TRACK IS DATA, NOT SOUND");
+        return;
+    }
+    cdFrom = cdLsn = lsn;
+    cdEnd = cdAudioEnd(lsn);
+    cdBufPos = cdBufLen = 0;
+    if (bgmStartPcm(&cdStreamRead, 44100, 2) == 0) {
+        cdState = CD_PLAYING;
+        cdSel = t;
+        ripps2PillarMusic(1);
+    } else {
+        cdState = CD_STOPPED;
+        cdSay("THE DISC COULD NOT BE READ");
+    }
+}
+
+static void cdHalt(int state)
+{
+    cdHeld = cdNow();
+    bgmStopPcm();
+    cdState = state;
+    if (state == CD_STOPPED) {
+        sceCdStop();
+        sceCdSync(0);
+    } else
+        sceCdPause();
+    ripps2PillarMusic(0);
+}
+
+int ripps2CdIsOpen(void)
+{
+    return cdOpen;
+}
+
+void ripps2CdStart(void)
+{
+    int t;
+    if (isBgmPlaying())
+        bgmStop(); // the menu music makes way; it comes back when the player closes
+    if (!cdReadToc()) {
+        if (gEnableBGM)
+            bgmStart();
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("This audio CD's table of contents could not be read. Clean the disc, close the tray again and try once more.", 0, NULL);
+        return;
+    }
+    cdOpen = 1;
+    cdState = CD_STOPPED;
+    cdTrayAt = clock();
+    cdNote[0] = '\0';
+    for (t = 1; t <= cdCount && !cdAudio[t]; t++)
+        ;
+    cdSel = cdTop = t <= cdCount ? t : 1;
+    cdPlayFrom(cdStart[cdSel]); // START LASER plays: the disc starts from its first song
+}
+
+static void cdClose(void)
+{
+    if (cdState != CD_STOPPED)
+        cdHalt(CD_STOPPED);
+    bgmStopPcm();
+    ripps2PillarMusic(0);
+    cdOpen = 0;
+    if (gEnableBGM && !isBgmPlaying())
+        bgmStart(); // the menu music again
+}
+
+// ---- copy a track to MUSIC/ as a .wav ----
+
+static void cdPut32(u8 *p, u32 v)
+{
+    p[0] = v;
+    p[1] = v >> 8;
+    p[2] = v >> 16;
+    p[3] = v >> 24;
+}
+
+static void cdWavHeader(u8 *h, u32 bytes)
+{
+    memcpy(h, "RIFF", 4);
+    cdPut32(h + 4, 36 + bytes);
+    memcpy(h + 8, "WAVEfmt ", 8);
+    cdPut32(h + 16, 16);
+    h[20] = 1; h[21] = 0;                   // PCM
+    h[22] = 2; h[23] = 0;                   // stereo
+    cdPut32(h + 24, 44100);
+    cdPut32(h + 28, 44100 * 4);
+    h[32] = 4; h[33] = 0;                   // bytes a frame
+    h[34] = 16; h[35] = 0;                  // bits
+    memcpy(h + 36, "data", 4);
+    cdPut32(h + 40, bytes);
+}
