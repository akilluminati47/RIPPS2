+static void cdCopyFrame(const char *what, float p)
+{
+    char buf[32];
+    int cancel = gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON;
+    rmStartFrame();
+    ripps2DrawBackground();
