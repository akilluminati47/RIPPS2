+// RIPPS2: a raw PCM source in place of Ogg Vorbis (the CD player, MUSIC .wav tracks). One call hands
+// the stream 16-bit samples; 0 ends it (what is queued plays out, then the music stops), < 0 is an
+// error. bgmPcmExternal is the CD player's, set through bgmStartPcm; a .wav track's is the file reader.
+static int (*bgmPcmRead)(char *buf, int size) = NULL;
+static int (*bgmPcmExternal)(char *buf, int size) = NULL;
+static int bgmPcmRate = 44100, bgmPcmChannels = 2;
+static volatile int bgmPcmEnded = 0;
+static volatile unsigned int bgmPlayed = 0; // bytes handed to audsrv since the stream started
+static volatile float bgmLevels[3];         // low, mid, high of the chunk handed over last (the towers)
+static float bgmLp1 = 0.0f, bgmLp2 = 0.0f;
+
+// Three bands of what audsrv is being handed (so they keep time with what is heard, not with the
+// read-ahead): one-pole low passes near 150 Hz and 2 kHz split each sample into low, mid and high
+static void bgmMeasure(const short *s, int bytes)
+{
+    int i, frames = bytes / (2 * bgmPcmChannels);
+    float lo = 0.0f, mid = 0.0f, hi = 0.0f;
+    if (frames <= 0 || bgmPcmRate <= 0)
+        return;
+    float k1 = 6.2832f * 150.0f / (float)bgmPcmRate, k2 = 6.2832f * 2000.0f / (float)bgmPcmRate;
+    for (i = 0; i < frames; i++) {
+        float x = bgmPcmChannels == 2 ? (s[2 * i] + s[2 * i + 1]) * (0.5f / 32768.0f) : s[i] * (1.0f / 32768.0f);
+        bgmLp1 += k1 * (x - bgmLp1);
+        bgmLp2 += k2 * (x - bgmLp2);
+        float l = bgmLp1, m = bgmLp2 - bgmLp1, h = x - bgmLp2;
+        lo += l * l;
+        mid += m * m;
+        hi += h * h;
+    }
+    bgmLevels[0] = sqrtf(lo / frames);
+    bgmLevels[1] = sqrtf(mid / frames);
+    bgmLevels[2] = sqrtf(hi / frames);
+}
+
+void bgmGetLevels(float *out3)
+{
+    out3[0] = bgmLevels[0];
+    out3[1] = bgmLevels[1];
+    out3[2] = bgmLevels[2];
+}
