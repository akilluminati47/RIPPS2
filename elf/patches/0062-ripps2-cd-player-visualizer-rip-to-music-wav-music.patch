+// A MUSIC .wav track (16-bit PCM, mono or stereo): read straight off the file, round and round
+static FILE *wavFile = NULL;
+static long wavData = 0, wavSize = 0, wavPos = 0;
+
+static int wavRead(char *buf, int size)
+{
+    int frame = 2 * bgmPcmChannels, n;
+    if (wavSize - wavPos < frame) { // the end: from the top again
+        if (fseek(wavFile, wavData, SEEK_SET) != 0)
+            return -1;
+        wavPos = 0;
+    }
+    if (size > wavSize - wavPos)
+        size = (int)(wavSize - wavPos);
+    size -= size % frame;
+    n = (int)fread(buf, 1, size, wavFile);
+    n -= n % frame;
+    if (n <= 0)
+        return -1;
+    wavPos += n;
+    return n;
+}
+
+static void wavClose(void)
+{
+    if (wavFile != NULL)
+        fclose(wavFile);
+    wavFile = NULL;
+}
+
+static int wavOpen(const char *path)
+{
+    unsigned char h[12], ck[8], fmt[16];
+    int haveFmt = 0;
+
+    wavClose();
+    if ((wavFile = fopen(path, "rb")) == NULL)
+        return 0;
+    if (fread(h, 1, 12, wavFile) != 12 || memcmp(h, "RIFF", 4) || memcmp(h + 8, "WAVE", 4))
+        goto bad;
+    while (fread(ck, 1, 8, wavFile) == 8) {
+        long len = ck[4] | (ck[5] << 8) | (ck[6] << 16) | ((long)ck[7] << 24);
+        if (!memcmp(ck, "fmt ", 4) && len >= 16) {
+            if (fread(fmt, 1, 16, wavFile) != 16)
+                goto bad;
+            int tag = fmt[0] | (fmt[1] << 8), bits = fmt[14] | (fmt[15] << 8);
+            bgmPcmChannels = fmt[2] | (fmt[3] << 8);
+            bgmPcmRate = fmt[4] | (fmt[5] << 8) | (fmt[6] << 16) | (fmt[7] << 24);
+            if (tag != 1 || bits != 16 || bgmPcmChannels < 1 || bgmPcmChannels > 2)
+                goto bad;
+            haveFmt = 1;
+            if (len > 16 && fseek(wavFile, len - 16 + (len & 1), SEEK_CUR) != 0)
+                goto bad;
+        } else if (!memcmp(ck, "data", 4) && haveFmt) {
+            wavData = ftell(wavFile);
+            wavSize = len;
+            wavPos = 0;
+            bgmPcmRead = wavRead;
+            return 1;
+        } else if (fseek(wavFile, len + (len & 1), SEEK_CUR) != 0)
+            goto bad;
+    }
+bad:
+    LOG("BGM: not a 16-bit PCM .wav: %s\n", path);
+    wavClose();
+    return 0;
+}
