+    rmDrawRect(170, CD_Y + 60, 300, 6, CD_PRIM(0x03, 0x08, 0x22, 0x80));
+    rmDrawRect(170, CD_Y + 60, (int)(300 * (p > 1.0f ? 1.0f : p)), 6, CD_PRIM(0x4A, 0x8C, 0xF0, 0x80));
+    snprintf(buf, sizeof(buf), "%d%%", (int)(p * 100.0f));
+    fntRenderString(gTheme->fonts[5], 320, CD_Y + 84, ALIGN_CENTER, 0, 0, buf, CD_SOFT);
+    GSTEXTURE *t = thmGetTexture(cancel);
+    if (t != NULL)
+        rmDrawPixmap(t, 274, 438, ALIGN_NONE, 20, 20, SCALING_RATIO, CD_LIT, 0);
+    fntRenderString(gTheme->fonts[4], 298, 448, ALIGN_VCENTER, 0, 0, "CANCEL", CD_SOFT);
+    rmEndFrame();
+}
+
+static void cdCopy(int track)
+{
+    char dir[256], name[48], path[320], what[80];
+    u8 head[44];
+    sceCdRMode m;
+    FILE *f;
+    u32 lsn, end, bytes = 0;
+    int cancelKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE, ok = 1;
+
+    if (!cdAudio[track]) {
+        cdSay("THAT TRACK IS DATA, NOT SOUND");
+        return;
+    }
+    if (!oplGetRipps2Dir(dir, sizeof(dir) - 8)) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("RIPPS2 cannot tell which drive it was started from, so it does not know where MUSIC is.", 0, NULL);
+        return;
+    }
+    if (!strncmp(dir, "mc", 2)) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("MUSIC sits beside RIPPS2, here on a memory card, and a CD track takes about 10 MB a minute. Start RIPPS2 from a USB drive or the HDD to copy tracks.", 0, NULL);
+        return;
+    }
+    snprintf(name, sizeof(name), "CD Track %02d", track);
+    if (!guiShowKeyboard(name, sizeof(name)) || name[0] == '\0')
+        return;
+    if (cdState != CD_STOPPED)
+        cdHalt(CD_STOPPED);
+
+    strcat(dir, "MUSIC");
+    mkdir(dir, 0777);
+    snprintf(path, sizeof(path), "%s/%s.wav", dir, name);
+    if ((f = fopen(path, "wb")) == NULL) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("The copy could not be started: MUSIC could not be written. Check the drive is not full or write protected.", 0, NULL);
+        return;
+    }
+    cdWavHeader(head, 0);
+    fwrite(head, 1, sizeof(head), f);
+
+    m.trycount = 5;
+    m.spindlctrl = SCECdSpinNom;
+    m.datapattern = SCECdSecS2352;
+    m.pad = 0;
+    snprintf(what, sizeof(what), "COPYING TRACK %02d TO MUSIC", track);
+    sceCdMmode(SCECdMmodeCd);
+    sceCdDiskReady(0);
+    end = cdStart[track + 1];
+    for (lsn = cdStart[track]; lsn < end && ok;) {
+        u32 n = end - lsn > CD_READ ? CD_READ : end - lsn;
+        if (!sceCdReadCDDA(lsn, n, cdBuf, &m)) {
+            ok = 0;
+            break;
+        }
+        sceCdSync(0);
+        if (fwrite(cdBuf, 1, n * CD_SECTOR, f) != n * CD_SECTOR) {
+            ok = 0;
+            break;
+        }
+        bytes += n * CD_SECTOR;
+        lsn += n;
+        cdCopyFrame(what, (float)(lsn - cdStart[track]) / (float)(end - cdStart[track]));
+        readPads();
+        if (getKeyOn(cancelKey))
+            ok = -1;
+    }
+    if (ok == 1) {
+        cdWavHeader(head, bytes);
+        if (fseek(f, 0, SEEK_SET) != 0 || fwrite(head, 1, sizeof(head), f) != sizeof(head))
+            ok = 0;
+    }
+    fclose(f);
+    sceCdStop();
+    sceCdSync(0);
+    if (ok != 1) {
+        remove(path);
+        if (ok == 0) {
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox("The copy stopped: the disc could not be read or the drive could not take more. Nothing was kept.", 0, NULL);
+        } else
+            cdSay("COPY CANCELLED");
+        return;
+    }
+    snprintf(what, sizeof(what), "Copied to MUSIC as %s.wav. Pick it in Settings > Audio Settings > Music.", name);
+    guiMsgBoxSound(SFX_SAVE);
+    guiMsgBox(what, 0, NULL);
+}
