+void ripps2CdRender(void)
+{
+    char buf[64], len[16];
+    int i, rowFont = gTheme->fonts[8], uiFont = gTheme->fonts[4], small = gTheme->fonts[5];
+    u32 now;
+
+    // the stream ran out at the end of the disc
+    if (cdState == CD_PLAYING && !isBgmPlaying()) {
+        bgmStopPcm();
+        cdState = CD_STOPPED;
+        ripps2PillarMusic(0);
+        for (cdSel = 1; cdSel < cdCount && !cdAudio[cdSel]; cdSel++)
+            ;
+    }
+    // the tray: an open tray closes the player (the disc watcher reads what goes in next)
+    if ((float)(clock() - cdTrayAt) / CLOCKS_PER_SEC > 0.5f) {
+        int st = sceCdStatus();
+        cdTrayAt = clock();
+        if (st >= 0 && (st & 0x01)) {
+            cdClose();
+            return;
+        }
+    }
+
+    now = cdNow();
+    int playing = cdTrackAt(now);
+    static int lastPlaying = 0;
+    if (cdState == CD_PLAYING && playing != lastPlaying)
+        cdSel = playing; // the pick follows the music on to each new track
+    lastPlaying = cdState == CD_PLAYING ? playing : 0;
+
+    ripps2DrawPanelGlass(CD_X, CD_Y, CD_W, CD_H, 0);
+    fntRenderString(uiFont, CD_X + 18, CD_Y + 18, ALIGN_VCENTER, 0, 0, "AUDIO CD", CD_LIT);
+    snprintf(buf, sizeof(buf), "%d TRACKS", cdCount);
+    fntRenderString(small, CD_X + 18 + fntCalcDimensions(uiFont, "AUDIO CD") + 12, CD_Y + 18, ALIGN_VCENTER, 0, 0, buf, CD_DIM);
+    rmDrawLine(CD_X + 14, CD_Y + 32, CD_X + CD_W - 14, CD_Y + 32, CD_PRIM(0x4A, 0x72, 0xDC, 0x60));
+
+    // the tracks, a page of them round the pick
+    if (cdSel < cdTop)
+        cdTop = cdSel;
+    if (cdSel >= cdTop + CD_ROWS)
+        cdTop = cdSel - CD_ROWS + 1;
+    for (i = 0; i < CD_ROWS && cdTop + i <= cdCount; i++) {
+        int t = cdTop + i, y = CD_Y + 48 + i * CD_ROW_H;
+        if (t == cdSel)
+            rmDrawRect(CD_X + 12, y - 9, 236, 18, CD_PRIM(0x2A, 0x4C, 0xA0, 0x40));
+        cdTime(cdStart[t + 1] - cdStart[t], len, sizeof(len));
+        snprintf(buf, sizeof(buf), "%02d", t);
+        u64 col = (cdState != CD_STOPPED && t == playing) ? CD_BLUE : (t == cdSel ? CD_LIT : CD_SOFT);
+        fntRenderString(rowFont, CD_X + 22, y, ALIGN_VCENTER, 0, 0, buf, col);
+        fntRenderString(rowFont, CD_X + 58, y, ALIGN_VCENTER, 0, 0, cdAudio[t] ? "TRACK" : "DATA", cdAudio[t] ? col : CD_DIM);
+        fntRenderString(rowFont, CD_X + 240 - fntCalcDimensions(rowFont, len), y, ALIGN_VCENTER, 0, 0, len, col);
+    }
+
+    // what is playing
+    int rx = CD_X + 276, track = cdState == CD_STOPPED ? cdSel : playing;
+    u32 at = now > cdStart[track] ? now - cdStart[track] : 0, length = cdStart[track + 1] - cdStart[track];
+    snprintf(buf, sizeof(buf), "TRACK %02d", track);
+    fntRenderString(gTheme->fonts[11], rx, CD_Y + 52, ALIGN_VCENTER, 0, 0, buf, CD_LIT);
+    cdTime(at, buf, sizeof(buf));
+    cdTime(length, len, sizeof(len));
+    strcat(buf, " / ");
+    strcat(buf, len);
+    fntRenderString(uiFont, rx, CD_Y + 76, ALIGN_VCENTER, 0, 0, buf, CD_SOFT);
+    rmDrawRect(rx, CD_Y + 90, 216, 4, CD_PRIM(0x03, 0x08, 0x22, 0x80));
+    if (length > 0)
+        rmDrawRect(rx, CD_Y + 90, (int)(216.0f * (at > length ? 1.0f : (float)at / (float)length)), 4, CD_PRIM(0x4A, 0x8C, 0xF0, 0x80));
+    const char *state = cdState == CD_PLAYING ? "PLAYING" : cdState == CD_PAUSED ? "PAUSED" : "STOPPED";
+    if (cdNoteAt != 0 && (float)(clock() - cdNoteAt) / CLOCKS_PER_SEC < 3.0f)
+        state = cdNote;
+    fntRenderString(small, rx, CD_Y + 106, ALIGN_VCENTER, 0, 0, state, cdState == CD_PLAYING ? CD_BLUE : CD_SOFT);
+
+    cdHints();
+}
+
+void ripps2CdInput(void)
+{
+    int confirm = gSelectButton == KEY_CIRCLE ? KEY_CIRCLE : KEY_CROSS, back = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+    u32 now = cdNow();
+    int t = cdTrackAt(now);
+
+    if (getKeyOn(back)) {
+        sfxPlay(SFX_CANCEL);
+        cdClose();
+    } else if (getKeyOn(confirm) || getKeyOn(KEY_START)) {
+        // the track playing pauses; a paused one goes on; any other picked track plays from its start
+        sfxPlay(SFX_CONFIRM);
+        if (cdState == CD_PLAYING && cdSel == t)
+            cdHalt(CD_PAUSED);
+        else if (cdState == CD_PAUSED && cdTrackAt(cdHeld) == cdSel)
+            cdPlayFrom(cdHeld);
+        else
+            cdPlayFrom(cdStart[cdSel]);
+    } else if (getKeyOn(KEY_SQUARE)) {
+        sfxPlay(SFX_CANCEL);
+        if (cdState != CD_STOPPED)
+            cdHalt(CD_STOPPED);
+    } else if (getKey(KEY_UP)) { // pick only: Cross plays the pick
+        if (cdSel > 1) {
+            sfxPlay(SFX_CURSOR);
+            cdSel--;
+        }
+    } else if (getKey(KEY_DOWN)) {
+        if (cdSel < cdCount) {
+            sfxPlay(SFX_CURSOR);
+            cdSel++;
+        }
+    } else if (getKeyOn(KEY_LEFT)) {
+        // back to the start of this track, or to the one before when it has only just begun
+        int to = (cdState != CD_STOPPED && now - cdStart[t] > 3 * 75) ? t : (t > 1 ? t - 1 : 1);
+        sfxPlay(SFX_CURSOR);
+        cdSel = to;
+        if (cdState != CD_STOPPED)
+            cdPlayFrom(cdStart[to]);
+    } else if (getKeyOn(KEY_RIGHT)) {
+        if (t < cdCount) {
+            sfxPlay(SFX_CURSOR);
+            cdSel = t + 1;
+            if (cdState != CD_STOPPED)
+                cdPlayFrom(cdStart[cdSel]);
+        }
+    } else if (getKeyOn(KEY_L1) || getKeyOn(KEY_R1)) {
+        if (cdState == CD_PLAYING) {
+            u32 to = getKeyOn(KEY_R1) ? now + CD_SKIP : (now > cdStart[t] + CD_SKIP ? now - CD_SKIP : cdStart[t]);
+            if (to < cdStart[cdCount + 1] - CD_READ)
+                cdPlayFrom(to);
+        }
+    } else if (getKeyOn(KEY_TRIANGLE)) {
+        sfxPlay(SFX_CONFIRM);
+        cdCopy(cdSel);
+    }
+}
