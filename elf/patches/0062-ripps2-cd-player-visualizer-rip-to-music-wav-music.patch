+// a loud one; it rises fast and falls slowly, and the loudest moments send up the launch's beams.
+static int musicOn = 0;
+static float musicMix = 0.0f, musicLast = -1.0f;
+static float musicLevel[3], musicPeak[3] = {0.02f, 0.02f, 0.02f};
+
+void ripps2PillarMusic(int on)
+{
+    musicOn = on;
+}
+
+static void musicUpdate(float t)
+{
+    float dt = musicLast < 0.0f ? 0.016f : fminf(0.1f, fmaxf(0.0f, t - musicLast)), lv[3];
+    int b;
+
+    musicLast = t;
+    musicMix = clamp01(musicMix + (musicOn ? dt : -dt) / 1.2f);
+    if (musicMix <= 0.0f) {
+        musicLevel[0] = musicLevel[1] = musicLevel[2] = 0.0f;
+        return;
+    }
+    bgmGetLevels(lv);
+    for (b = 0; b < 3; b++) {
+        musicPeak[b] = fmaxf(fmaxf(lv[b], 0.004f), musicPeak[b] * expf(-dt / 4.0f));
+        float target = clamp01(lv[b] / musicPeak[b]);
+        target *= target;
+        float k = 1.0f - expf(-dt / (target > musicLevel[b] ? 0.03f : 0.22f));
+        musicLevel[b] += (target - musicLevel[b]) * k;
+    }
+}
