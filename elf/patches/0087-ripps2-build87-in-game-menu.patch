@@ -0,0 +1,720 @@
+/*
+  igrmenu.c RIPPS2's in-game menu (build 87)
+
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  L1+L2+R1+R2+SELECT+START used to leave the game at once. With In-Game Menu on (Settings > General)
+  it pauses the game under a plain panel: RESUME, ACHIEVEMENTS (SpiritofRA: what the console knows
+  about this game's achievements) and EXIT GAME (the Exit To path, so RIPPS2 itself, the boot lock's
+  loader or the browser, as before). No animation: the panel is drawn when it opens and when the
+  choice moves, and nothing in between.
+
+  The method is ORBIT's in-game menu for its Neutrino fork (danielnuld/ps2-launcher,
+  third_party/neutrino-igr/menu.c and igr.c, AFL-3.0), brought over to OPL's core. The game's GS
+  drawing state is write-only, so it is never touched: the panel is rendered here in the shown
+  frame's own pixel format and uploaded into that frame with image transfers through VIF1 DIRECT
+  (PATH2), after a FLUSHA, leaving the game's PATH3 mask alone. The pixels under it are not saved;
+  the game's next frames draw over them. Which frame is shown comes from GSM, which records the
+  game's PMODE, SMODE2, DISPFB and DISPLAY writes (gsm_engine.S; capture only when GSM itself is off).
+
+  IGR_MENU_HOST_TEST builds only the renderer, for elf/tests (a picture of the panel on the PC).
+*/
+
+#ifndef IGR_MENU_HOST_TEST
+#include "ee_core.h"
+#include "coreconfig.h"
+#include "padhook.h"
+#ifdef RETROACHIEVEMENTS
+#include "ra.h"
+#include "ra_overlay.h"
+#endif
+#endif
+#include "igrmenu.h"
+
+// ---- the panel, in its own units (one font pixel at scale 1): 160 x 106, or 320 x 212 at scale 2
+#define PW         160
+#define PH         106
+#define ROW_TITLE  4
+#define ROW_SEP1   14
+#define ROW_ITEM0  18
+#define ITEM_STEP  10
+#define ROW_SEP2   49
+#define ROW_INFO0  53
+#define INFO_STEP  10
+#define ROW_HINT   95
+#define TEXT_X     8
+#define ITEM_X     20
+#define TEXT_CHARS 24 // (PW - 2 * TEXT_X) / 6
+
+enum { C_PANEL, C_BORDER, C_SEP, C_BAR, C_TITLE, C_DIM, C_ITEM, C_SEL, C_TEXT, C_GOLD, C_WARN, C_CROSS, C_CIRCLE, C_COUNT };
+static const u8 igrmRgb[C_COUNT][3] = {
+    {12, 16, 36},    // panel: RIPPS2's night navy
+    {72, 96, 168},   // border
+    {36, 46, 88},    // separators
+    {30, 44, 100},   // the selected row's bar
+    {232, 236, 250}, // title
+    {112, 122, 152}, // quiet text
+    {150, 160, 190}, // items
+    {255, 255, 255}, // the selected item
+    {196, 204, 226}, // page text
+    {255, 204, 96},  // SpiritofRA
+    {255, 150, 120}, // what EXIT GAME costs
+    {124, 178, 240}, // the pad's cross
+    {240, 110, 110}, // the pad's circle
+};
+
+// 5x7 glyphs in 6x8 cells, bit 4 = the left column: ASCII 32..95, then the pad's cross and circle
+// and the selection pointer (codes 1, 2, 3). Lower case draws as upper case, anything else as '?'
+#define G_CROSS   64
+#define G_CIRCLE  65
+#define G_POINTER 66
+static const u8 igrmFont[67][7] = {
