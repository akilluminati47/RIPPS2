+/* RIPPS2 build 87: the game's RA progress as the last check left it (RA/<serial>.inf beside the list,
+   ranet.c: title, total, unlocked, unsupported, one a line), for the in-game menu's Achievements page */
+static int sbRaInfoKnown, sbRaInfoTotal, sbRaInfoUnlocked;
+
+int sbGetRaInfo(int *total, int *unlocked)
+{
+    *total = sbRaInfoKnown ? sbRaInfoTotal : 0;
+    *unlocked = sbRaInfoKnown ? sbRaInfoUnlocked : -1;
+    return sbRaInfoKnown;
+}
+
+static void sbLoadRaInfo(const char *path, const char *file)
+{
+    char infPath[256], line[128];
+    FILE *f;
+
+    sbRaInfoKnown = 0;
+    if (snprintf(infPath, sizeof(infPath), "%sRA/%s.inf", path, file) >= (int)sizeof(infPath) ||
+        (f = fopen(infPath, "rb")) == NULL)
+        return;
+    if (fgets(line, sizeof(line), f) != NULL && fgets(line, sizeof(line), f) != NULL) {
+        sbRaInfoTotal = atoi(line);
+        sbRaInfoUnlocked = fgets(line, sizeof(line), f) != NULL ? atoi(line) : -1;
+        sbRaInfoKnown = 1;
+    }
+    fclose(f);
+}
