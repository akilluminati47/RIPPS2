diff --git a/ee_core/src/gsm_api.c b/ee_core/src/gsm_api.c
index 16b474f..58342c5 100644
--- a/ee_core/src/gsm_api.c
+++ b/ee_core/src/gsm_api.c
@@ -211,6 +211,44 @@ void DisableGSM(void)
     Remove_GSHandler();
 }
 
+/*
+  RIPPS2 build 87: capture only, for the in-game menu (igrmenu.c). It must know which frame the game
+  shows, and the GS registers that say so are write-only: GSHandler records the game's PMODE, SMODE2,
+  DISPFB and DISPLAY writes in GSMSourceGSRegs and lets every write through unchanged (GSMCaptureOnly in
+  gsm_engine.S). No SetGsCrt hook and no forced mode; writes only, so reads such as CSR polling stay
+  untrapped. Armed by ee_core's init when In-Game Menu is on and GSM itself is not.
+*/
+extern unsigned char GSMCaptureOnly;
+extern void Enable_GSCapture(void);
+static int GSMCaptureArmed;
+
+void EnableGSMCapture(void)
+{
+    GSMCaptureOnly = 1;
+
+    DI();
+    ee_kmode_enter();
+    KSEG_backup[0] = *(volatile u32 *)0x80000100;
+    KSEG_backup[1] = *(volatile u32 *)0x80000104;
+    *(volatile u32 *)0x80000100 = MAKE_J((int)GSHandler);
+    *(volatile u32 *)0x80000104 = NOP;
+    ee_kmode_exit();
+    Enable_GSCapture();
+    EI();
+
+    FlushCache(0);
+    FlushCache(2);
+    GSMCaptureArmed = 1;
+}
+
+void DisableGSMCapture(void)
+{
+    if (!GSMCaptureArmed)
+        return;
+    Remove_GSHandler();
+    GSMCaptureArmed = 0;
+}
+
 /*--------------------------------------------*/
 /* Set up the DVE for 576P mode               */
 /*--------------------------------------------*/
diff --git a/ee_core/src/gsm_engine.S b/ee_core/src/gsm_engine.S
index 6cd80e0..34ecf08 100644
--- a/ee_core/src/gsm_engine.S
+++ b/ee_core/src/gsm_engine.S
@@ -68,6 +68,9 @@ GSMFlags: .space 19
 
 GSMAdapts:          .space 18
 
+.globl GSMCaptureOnly                               # RIPPS2 build 87: 1 = record the shown frame, change nothing
+GSMCaptureOnly:     .byte 0
+
 .p2align 4                                          # align 16 bytes (IMPORTANT!!!)
 
 ###############################
@@ -478,6 +481,34 @@ have_some_write:                                    # Opcode is a write, so we m
     nop
     ld      $a1, 0($a1)                             # a1 = value in rt
 
+# RIPPS2 build 87: capture only, for the in-game menu (igrmenu.c). Remember what the game shows and let
+# every write through unchanged; nothing below runs (no forced mode, no adaptation)
+    la      $v1, GSMCaptureOnly
+    lbu     $v1, 0($v1)
+    beqz    $v1, gsm_full_write
+    nop
+    addi    $v1, $v0, -GS_PMODE
+    beql    $v1, $zero, not_wanted_reg
+    sd      $a1, Source_PMODE($s0)
+    addi    $v1, $v0, -GS_SMODE2
+    beql    $v1, $zero, not_wanted_reg
+    sd      $a1, Source_SMODE2($s0)
+    addi    $v1, $v0, -GS_DISPFB1
+    beql    $v1, $zero, not_wanted_reg
+    sd      $a1, Source_DISPFB1($s0)
+    addi    $v1, $v0, -GS_DISPFB2
+    beql    $v1, $zero, not_wanted_reg
+    sd      $a1, Source_DISPFB2($s0)
+    addi    $v1, $v0, -GS_DISPLAY1
+    beql    $v1, $zero, not_wanted_reg
+    sd      $a1, Source_DISPLAY1($s0)
+    addi    $v1, $v0, -GS_DISPLAY2
+    beql    $v1, $zero, not_wanted_reg
+    sd      $a1, Source_DISPLAY2($s0)
+    b       not_wanted_reg
+    nop
+
+gsm_full_write:
     addi    $v1, $v0, -GS_PMODE
     beqz    $v1, have_PMODE_write                   # in case of  dest == GS_reg_PMODE
     addi    $v1, $v0, -GS_SMODE1
@@ -1240,6 +1271,27 @@ Enable_GSBreakpoint:
     nop
 .end Enable_GSBreakpoint
 
+# RIPPS2 build 87: the in-game menu's capture-only trap. Writes only (DWE, DUE, DKE): the game's CSR
+# polling and every other read run untrapped. Must be executed with interrupts disabled.
+.globl Enable_GSCapture
+.ent Enable_GSCapture
+Enable_GSCapture:
+    li      $a0, TRAP_BASE
+    li      $a1, TRAP_MASK
+    sync.l
+    li      $a2, 0x8000
+    mtbpc   $a2                                     # All breakpoints off (BED = 1)
+    sync.p
+    mtdab   $a0
+    mtdabm  $a1
+    sync.p
+    li      $a2, 0x20280000                         # Data write breakpoint on (DWE, DUE, DKE = 1)
+    mtbpc   $a2
+    sync.p
+    jr      $ra
+    nop
+.end Enable_GSCapture
+
 # Must be executed with interrupts disabled.
 .globl Disable_GSBreakpoint
 .ent Disable_GSBreakpoint
diff --git a/ee_core/src/igrmenu.c b/ee_core/src/igrmenu.c
