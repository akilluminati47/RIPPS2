+// What happened, top right: "PASTED 3", "MOVED 2, 1 SKIPPED", "DELETED 1, 1 FAILED"
+static void fbReport(const char *verb, int done)
+{
+    char text[48];
+    int ok = done - fbFailed - fbSkipped;
+    int n = snprintf(text, sizeof(text), "%s %d", verb, ok < 0 ? 0 : ok);
+    if (fbSkipped > 0)
+        n += snprintf(text + n, sizeof(text) - n, ", %d SKIPPED", fbSkipped);
+    if (fbFailed > 0)
+        snprintf(text + n, sizeof(text) - n, ", %d FAILED", fbFailed);
+    fbSetToast(text);
+}
