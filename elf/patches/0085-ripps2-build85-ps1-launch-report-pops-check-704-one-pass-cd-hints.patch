+// RIPPS2 build 85: POPSTARTER starts a PS1 game with Sony's emulator, POPS.ELF and POPS_IOX.PAK, from the
+// game's own POPS folder, and when they are not there it says nothing: a black screen, then the console's
+// browser. Ask first, while a dialog can still be drawn. START launches anyway (a set-up RIPPS2 cannot
+// see is still the user's), anything else goes back. Returns 1 to go on.
+int vcdConfirmPopsFiles(const char *devPrefix)
+{
+    static const char *const files[] = {"POPS.ELF", "POPS_IOX.PAK"};
+    char missing[64] = "", path[256], msg[320];
+    int i, n = 0;
+
+    if (devPrefix == NULL || devPrefix[0] == '\0')
+        return 1;
+    for (i = 0; i < 2; i++) {
+        snprintf(path, sizeof(path), "%s%s%c%s", devPrefix, POPS_FOLDER, vcdSep(devPrefix), files[i]);
+        int fd = open(path, O_RDONLY);
+        if (fd >= 0) {
+            close(fd);
+            continue;
+        }
+        snprintf(missing + strlen(missing), sizeof(missing) - strlen(missing), "%s%s", n ? " and " : "", files[i]);
+        n++;
+    }
+    if (n == 0)
+        return 1;
+    snprintf(msg, sizeof(msg), "%s %s missing from %s%s. POPSTARTER needs POPS.ELF and POPS_IOX.PAK, the PS1 emulator from "
+                               "your own console, beside the games to start one.",
+             missing, n == 1 ? "is" : "are", devPrefix, POPS_FOLDER);
+    guiMsgBoxStartOption("LAUNCH ANYWAY");
+    return guiMsgBox(msg, 0, NULL) == 2;
+}
+
 void vcdDescribePopstarterLookup(const char *devPrefix, char *out, int outSize)
 {
     if (out == NULL || outSize <= 0)
