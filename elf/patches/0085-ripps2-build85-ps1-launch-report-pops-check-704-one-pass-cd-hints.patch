+
+/*
+  RIPPS2 build 85: the launch report. A PS1 game that will not start on a console says nothing about why,
+  and PCSX2 starts them fine, so the only witness is the console itself. Just before the handoff RIPPS2
+  writes what it is about to do to mc0:/RIPPS2/LAUNCH.TXT, where a tester can open it in Memory Files'
+  text editor (or a photo of it can be posted). Overwritten by each launch; best effort throughout.
+*/
+#define LR_CRC_MAX (512 * 1024)
+static unsigned char lrBuf[8192];
+
+// the file's size (-1: missing) and the CRC32 of up to its first 512 KB
+static int lrFile(const char *path, unsigned int *crc, int *partial)
+{
+    int fd = open(path, O_RDONLY), size, n, done = 0;
+    unsigned int c = crc32(0L, Z_NULL, 0);
+
+    if (fd < 0)
+        return -1;
+    size = (int)lseek(fd, 0, SEEK_END);
+    lseek(fd, 0, SEEK_SET);
+    if (crc != NULL) {
+        while (done < LR_CRC_MAX && (n = read(fd, lrBuf, sizeof(lrBuf))) > 0) {
+            c = crc32(c, lrBuf, n);
+            done += n;
+        }
+        *crc = c;
+        *partial = size > LR_CRC_MAX;
+    }
+    close(fd);
+    return size;
+}
+
+void ripps2LaunchReport(const char *what, const char *elf, int argc, char **argv)
+{
+    static char rep[3072];
+    char dir[256], path[320];
+    unsigned int crc = 0;
+    int len = 0, i, partial = 0, size, cut;
+    const char *slash, *bslash, *colon;
+    FILE *f;
+
+#define LR_ADD(...)                                                     \
+    do {                                                                \
+        if (len < (int)sizeof(rep))                                     \
+            len += snprintf(rep + len, sizeof(rep) - len, __VA_ARGS__); \
+    } while (0)
+
+    if (elf == NULL || what == NULL)
+        return;
+    LR_ADD("RIPPS2 build %d launch report: %s\r\n\r\n", RIPPS2_BUILD, what);
+    size = lrFile(elf, &crc, &partial);
+    if (size < 0)
+        LR_ADD("elf        %s\r\n           CANNOT BE OPENED\r\n", elf);
+    else
+        LR_ADD("elf        %s\r\n           %d bytes, crc32 %08x%s%s\r\n", elf, size, crc, partial ? " of the first 512 KB" : "",
+               (size == 167700 && crc == 0x59ebabb9u) ? " (the POPSTARTER RIPPS2 carries)" : (size == 1611956 ? " (the size of the Ember RIPPS2 carries)" : ""));
+    for (i = 0; argv != NULL && i < argc; i++)
+        LR_ADD("argv[%d]    %s\r\n", i, argv[i] != NULL ? argv[i] : "(null)");
+
+    // the folder the ELF sits in, with its separator
+    slash = strrchr(elf, '/');
+    bslash = strrchr(elf, '\\');
+    colon = strrchr(elf, ':');
+    cut = (int)((slash > bslash ? (slash > colon ? slash : colon) : (bslash > colon ? bslash : colon)) - elf) + 1;
+    if (cut <= 0 || cut >= (int)sizeof(dir))
+        cut = 0;
+    snprintf(dir, sizeof(dir), "%.*s", cut, elf);
+
+    LR_ADD("\r\nbeside it (%s)\r\n", dir);
+    if (!strcmp(what, "POPSTARTER")) {
+        static const char *const pops[] = {"POPS.ELF", "POPS_IOX.PAK"};
+        for (i = 0; i < 2; i++) {
+            snprintf(path, sizeof(path), "%s%s", dir, pops[i]);
+            size = lrFile(path, NULL, NULL);
+            if (size < 0)
+                LR_ADD("  %-13s MISSING\r\n", pops[i]);
+            else
+                LR_ADD("  %-13s %d bytes\r\n", pops[i], size);
+        }
+        for (i = 0; i < 2; i++) { // POPSTARTER reloads its block driver from here after its IOP reset
+            char mcDir[24];
+            DIR *d;
+            struct dirent *de;
+            int listed = 0;
+            snprintf(mcDir, sizeof(mcDir), "mc%d:/POPSTARTER", i);
+            d = opendir(mcDir);
+            if (d == NULL) {
+                LR_ADD("%s  (none)\r\n", mcDir);
+                continue;
+            }
+            LR_ADD("%s\r\n", mcDir);
+            while ((de = readdir(d)) != NULL && listed < 12) {
+                if (de->d_name[0] == '.')
+                    continue;
+                snprintf(path, sizeof(path), "%s/%s", mcDir, de->d_name);
+                LR_ADD("  %-24s %d\r\n", de->d_name, lrFile(path, NULL, NULL));
+                listed++;
+            }
+            closedir(d);
+            if (!listed)
+                LR_ADD("  (empty)\r\n");
+        }
+        LR_ADD("popstarter_path  %s\r\n", gPopstarterPath[0] ? gPopstarterPath : "(not set)");
+    } else {
+        static const char *const ember[] = {"bios.bin", "settings.txt"};
+        for (i = 0; i < 2; i++) {
+            snprintf(path, sizeof(path), "%s%s", dir, ember[i]);
+            size = lrFile(path, NULL, NULL);
+            if (size < 0)
+                LR_ADD("  %-13s missing\r\n", ember[i]);
+            else
+                LR_ADD("  %-13s %d bytes\r\n", ember[i], size);
+        }
+    }
+    LR_ADD("\r\nvideo mode %d", gVMode);
+#ifdef RETROACHIEVEMENTS
+    LR_ADD(", telemetry %s", gRATelemetry ? "ON (network stack in the launch)" : "off");
+#endif
+    LR_ADD("\r\n");
+#undef LR_ADD
+
+    mkdir("mc0:/RIPPS2", 0777);
+    f = fopen("mc0:/RIPPS2/LAUNCH.TXT", "wb");
+    if (f == NULL)
+        return;
+    fwrite(rep, 1, len < (int)sizeof(rep) ? len : (int)sizeof(rep) - 1, f);
+    fclose(f);
+}
