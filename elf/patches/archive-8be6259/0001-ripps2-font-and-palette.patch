 	Galician German Greek Hungarian Indonesian Italian Japanese Korean Laotian Persian Polish Portuguese \
@@ -1102,6 +1102,10 @@ $(EE_ASM_DIR)conf_theme_OPL.c: misc/conf_theme_OPL.cfg | $(EE_ASM_DIR)
 $(EE_ASM_DIR)theme_coverflow.c: misc/theme_coverflow.cfg | $(EE_ASM_DIR)
 	$(BIN2C) $< $@ $(*F)_cfg
 
+# RIPPS2: theme font compiled in (misc/ripps2_font.ttf is copied in by RIPPS2's build.sh)
+$(EE_ASM_DIR)ripps2_font.c: misc/ripps2_font.ttf | $(EE_ASM_DIR)
+	$(BIN2C) $< $@ $(*F)_raw
+
 $(EE_ASM_DIR)boot.c: audio/boot.adp | $(EE_ASM_DIR)
 	$(BIN2C) $< $@ $(*F)_adp
 
