@@ -0,0 +1,8 @@
+#ifndef __RIPPS2_H
+#define __RIPPS2_H
+
+// Launches the Memory Files ELF bundled inside RIPPS2.elf. Never returns on success;
+// returns < 0 (before touching anything) when the bundled image fails validation.
+int ripps2LaunchMemoryFiles(void);
+
+#endif
