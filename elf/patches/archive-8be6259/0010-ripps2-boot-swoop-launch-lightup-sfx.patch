+// ---- boot and launch hooks ----
+
+void ripps2DrawBootFrame(void)
+{
+    bootFreeze = 1;
+    ripps2DrawPillars();
+    bootFreeze = 0;
+}
+
+int ripps2IntroUiReady(void)
+{
+    return sceneTime() >= INTRO_UI_S;
+}
+
+void ripps2PlayLaunchSequence(void)
+{
+    // Pillars only: no menu, no HUD. Runs its own frames on the GUI thread, outside any frame.
+    launchT0 = sceneTime();
+    launchHeld = 0;
+    for (;;) {
+        float L = sceneTime() - launchT0;
+        guiStartFrame();
+        ripps2DrawPillars();
+        guiEndFrame();
+        if (L >= LAUNCH_S)
+            break;
+    }
+    // once more, so both framebuffers hold the final lit frame through the teardown and handoff
+    guiStartFrame();
+    ripps2DrawPillars();
+    guiEndFrame();
+    launchHeld = 1;
+}
+
+int ripps2LaunchScreenHeld(void)
+{
+    return launchHeld;
+}
+
+void ripps2LaunchAborted(void)
+{
+    // the launch returned (it failed): back to the idle field under the menu
+    launchT0 = -1.0f;
+    launchHeld = 0;
+}
