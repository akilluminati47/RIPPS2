+// RIPPS2: every sound interrupts the one before it, cursor ticks included. audsrv cannot stop an
+// adpcm voice, so the previous sound's channel is muted instead, and a channel gets its volume back
+// right before it plays again. The coalescing above still drops a double-raise of the SAME sound.
+static int sfxLastChannel = -1;
+
+static void sfxInterruptPrevious(int channel)
+{
+    if (sfxLastChannel >= 0 && sfxLastChannel != channel)
+        audsrv_adpcm_set_volume_and_pan(sfxLastChannel, 0, 0);
+    audsrv_adpcm_set_volume_and_pan(channel, channel == 0 ? gBootSndVolume : gSFXVolume, 0);
+    sfxLastChannel = channel;
+}
