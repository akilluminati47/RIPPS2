+// Is something there? Opened, not stat()ed: on a memory card stat() reports success for a path that
+// does not exist (RiptOPL checks card files by opening them for the same reason)
+static int fbExists(const char *path)
+{
+    int fd = open(path, O_RDONLY);
+    DIR *d;
+    if (fd >= 0) {
+        close(fd);
+        return 1;
+    }
+    d = opendir(path);
+    if (d != NULL) {
+        closedir(d);
+        return 1;
+    }
+    return 0;
+}
