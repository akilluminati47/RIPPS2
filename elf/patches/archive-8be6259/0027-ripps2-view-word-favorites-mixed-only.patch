+// ---- The view word ----
+// L3 names the list it switched to, large over the page, the way the PS2 boot names itself: the
+// letters rise in one after another, each flaring as it lands, hold, then drift apart and fade.
+// The page stays live underneath (it used to be a black splash that held the pad for 2 s).
+#define WORD_STEP_S 0.07f // between letters
+#define WORD_IN_S   0.40f // one letter's rise
+#define WORD_HOLD_S 0.55f
+#define WORD_OUT_S  0.55f
+#define WORD_Y      240
+#define WORD_TRACK  8.0f // px between letters
+#define WORD_FONT   (gTheme->fonts[14])
+#define WORD_RGBA(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+static char viewWord[12], viewCaption[24];
+static clock_t viewWordStart = 0;
+
+static u64 withAlpha(u64 c, int a)
+{
+    return (c & ~(0xFFULL << 24)) | ((u64)(a < 0 ? 0 : a > 0x80 ? 0x80 : a) << 24);
+}
+
+void ripps2ShowViewWord(const char *word, const char *caption)
+{
+    snprintf(viewWord, sizeof(viewWord), "%s", word);
+    snprintf(viewCaption, sizeof(viewCaption), "%s", caption != NULL ? caption : "");
+    viewWordStart = clock();
+    if (viewWordStart == 0)
+        viewWordStart = 1;
+}
+
+// A soft band of light behind the word: three columns by two rows, clear at every outer edge
+static void viewWordBand(float cx, float cy, float halfW, float halfH, int a)
+{
+    u64 lit = WORD_RGBA(0x40, 0x70, 0xD0, a), clear = WORD_RGBA(0x40, 0x70, 0xD0, 0);
+    float x0 = cx - halfW - 60.0f, x1 = cx - halfW, x2 = cx + halfW, x3 = cx + halfW + 60.0f;
+    float y0 = cy - halfH, y1 = cy, y2 = cy + halfH;
+    rmDrawQuadGouraud(x0, y0, clear, x1, y0, clear, x0, y1, clear, x1, y1, lit);
+    rmDrawQuadGouraud(x1, y0, clear, x2, y0, clear, x1, y1, lit, x2, y1, lit);
+    rmDrawQuadGouraud(x2, y0, clear, x3, y0, clear, x2, y1, lit, x3, y1, clear);
+    rmDrawQuadGouraud(x0, y1, clear, x1, y1, lit, x0, y2, clear, x1, y2, clear);
+    rmDrawQuadGouraud(x1, y1, lit, x2, y1, lit, x1, y2, clear, x2, y2, clear);
+    rmDrawQuadGouraud(x2, y1, lit, x3, y1, clear, x2, y2, clear, x3, y2, clear);
+}
+
+void ripps2DrawViewWord(void)
+{
+    int i, n = (int)strlen(viewWord), total = 0, w[sizeof(viewWord)];
+    char ch[2] = {0, 0};
+
+    if (viewWordStart == 0 || n == 0)
+        return;
+    float t = (float)(clock() - viewWordStart) / (float)CLOCKS_PER_SEC;
+    float inEnd = WORD_STEP_S * (n - 1) + WORD_IN_S, outStart = inEnd + WORD_HOLD_S;
+    if (t >= outStart + WORD_OUT_S) {
+        viewWordStart = 0;
+        return;
+    }
+    float out = t > outStart ? (t - outStart) / WORD_OUT_S : 0.0f;
+    float keep = 1.0f - out * out;                  // fades out ever faster
+    float track = WORD_TRACK + 18.0f * out * out;   // the letters drift apart as they go
+    float lead = t < inEnd ? t / inEnd : 1.0f;
+
+    for (i = 0; i < n; i++) {
+        ch[0] = viewWord[i];
+        w[i] = fntCalcDimensions(WORD_FONT, ch);
+        total += w[i];
+    }
+    float span = total + track * (n - 1), x = 320.0f - span / 2.0f;
+
+    rmSetBlendAdditive(1);
+    viewWordBand(320.0f, (float)WORD_Y, span / 2.0f, 46.0f, (int)(0x30 * fminf(1.0f, lead * 2.0f) * keep));
+    rmSetBlendAdditive(0);
+
+    for (i = 0; i < n; i++) {
+        float li = (t - WORD_STEP_S * i) / WORD_IN_S;
+        if (li > 0.0f) {
+            if (li > 1.0f)
+                li = 1.0f;
+            float rise = (1.0f - easeOutBack(li)) * 16.0f;      // up from below, a touch past, settle
+            float flare = sinf(3.14159265f * li);               // brightest mid-landing
+            int a = (int)(0x80 * fminf(1.0f, li * 1.8f) * keep);
+            int lx = (int)x, ly = (int)(WORD_Y + rise);
+            ch[0] = viewWord[i];
+            if (ch[0] != ' ') {
+                u64 glow = WORD_RGBA(0x50, 0x78, 0xC0, (int)((0x18 + 0x40 * flare) * keep));
+                rmSetBlendAdditive(1);
+                fntRenderString(WORD_FONT, lx - 2, ly, ALIGN_VCENTER, 0, 0, ch, glow);
+                fntRenderString(WORD_FONT, lx + 2, ly, ALIGN_VCENTER, 0, 0, ch, glow);
+                fntRenderString(WORD_FONT, lx, ly - 2, ALIGN_VCENTER, 0, 0, ch, glow);
+                fntRenderString(WORD_FONT, lx, ly + 2, ALIGN_VCENTER, 0, 0, ch, glow);
+                rmSetBlendAdditive(0);
+                fntRenderString(WORD_FONT, lx, ly, ALIGN_VCENTER, 0, 0, ch, withAlpha(COLOR_LIT, a));
+            }
+        }
+        x += w[i] + track;
+    }
+
+    if (viewCaption[0] != '\0') {
+        float ci = (t - inEnd * 0.6f) / 0.3f;
+        if (ci > 0.0f)
+            fntRenderString(RIPPS2_UI_FONT, 320, WORD_Y + 44, ALIGN_CENTER, 0, 0, viewCaption,
+                            withAlpha(COLOR_SOFT, (int)(0x80 * fminf(1.0f, ci) * keep)));
+    }
+}
