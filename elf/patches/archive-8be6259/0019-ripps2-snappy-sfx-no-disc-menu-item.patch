diff --git a/src/sound.c b/src/sound.c
index 76a6986..a3e33ec 100644
--- a/src/sound.c
+++ b/src/sound.c
@@ -105,16 +105,22 @@ static int sfxIsUiOneShot(int id)
     return (id == SFX_CONFIRM) || (id == SFX_CANCEL) || (id == SFX_MESSAGE) || (id == SFX_TRANSITION);
 }
 
-// RIPPS2: every sound interrupts the one before it, cursor ticks included. audsrv cannot stop an
-// adpcm voice, so the previous sound's channel is muted instead, and a channel gets its volume back
-// right before it plays again. The coalescing above still drops a double-raise of the SAME sound.
+// RIPPS2: every sound cuts the one before it off and starts fresh -- the same sound again too, so a
+// category switch or an info page toggle always answers with a new transition, never a tail.
+// audsrv cannot stop an adpcm voice, and replaying a voice that is still sounding does not restart
+// it, so one-shots rotate through a pool of their own channels (like the cursor ticks do): each play
+// takes the next channel and mutes the one before, and a channel gets its volume back right before
+// it plays again. The coalescing above still drops a double-raise of the same sound in one frame.
+#define ONESHOT_SFX_CHANNEL_BASE  (CURSOR_SFX_CHANNEL_BASE + CURSOR_SFX_CHANNEL_COUNT)
+#define ONESHOT_SFX_CHANNEL_COUNT 8 // channels 14..21 of audsrv's 24
+static int oneShotChannelIndex = 0;
 static int sfxLastChannel = -1;
 
-static void sfxInterruptPrevious(int channel)
+static void sfxInterruptPrevious(int channel, int volume)
 {
     if (sfxLastChannel >= 0 && sfxLastChannel != channel)
         audsrv_adpcm_set_volume_and_pan(sfxLastChannel, 0, 0);
-    audsrv_adpcm_set_volume_and_pan(channel, channel == 0 ? gBootSndVolume : gSFXVolume, 0);
+    audsrv_adpcm_set_volume_and_pan(channel, volume, 0);
     sfxLastChannel = channel;
 }
 
@@ -422,7 +428,7 @@ void sfxPlay(int id)
             channel = sfxGetCursorChannel(chosenSlot);
 
             // Replaying a rotation channel replaces its old sample in one SIF RPC.
-            sfxInterruptPrevious(channel);
+            sfxInterruptPrevious(channel, gSFXVolume);
             audsrv_ch_play_adpcm(channel, &sfx[id]);
         } else {
             if (sfxIsUiOneShot(id)) { // see SFX_ONESHOT_COALESCE_MS
@@ -435,8 +441,10 @@ void sfxPlay(int id)
                 lastOneShotTicks = sfxStartTicks;
                 lastOneShotId = id;
             }
-            sfxInterruptPrevious(id);
-            audsrv_ch_play_adpcm(id, &sfx[id]);
+            channel = ONESHOT_SFX_CHANNEL_BASE + oneShotChannelIndex;
+            oneShotChannelIndex = (oneShotChannelIndex + 1) % ONESHOT_SFX_CHANNEL_COUNT;
+            sfxInterruptPrevious(channel, id == SFX_BOOT ? gBootSndVolume : gSFXVolume);
+            audsrv_ch_play_adpcm(channel, &sfx[id]);
         }
 
         unsigned int costMs = (unsigned int)((cpu_ticks() - sfxStartTicks) / SFX_CLOCKS_PER_MS);
