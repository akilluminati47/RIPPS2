diff --git a/src/menusys.c b/src/menusys.c
index 6932b01..be46c07 100644
--- a/src/menusys.c
+++ b/src/menusys.c
@@ -1257,8 +1257,8 @@ static void menuFirstPage()
     }
 }
 
-// RIPPS2: R2 jumps to a random game (never the one already selected, never a folder row), placed a
-// third of the way down the page
+// RIPPS2: L2 + R2 jump to a random game (never the one already selected, never a folder row), placed
+// a third of the way down the page
 static void menuRandomItem(void)
 {
     submenu_list_t *it, *cur = selected_item->item->current;
@@ -1837,6 +1837,24 @@ void menuHandleInputMain()
     item_list_t *support = selected_item != NULL && selected_item->item != NULL ? selected_item->item->userdata : NULL;
     int viewPending = support != NULL && libViewPending(support->mode);
 
+    // RIPPS2: L2 + R2 together pick a random game, once per press (holding them never repeats it).
+    // Alone, L2 goes to the top of the list and R2 to the end, when released, so a chord can never
+    // set off either of them on the way in.
+    static int shoulderChord = 0; // this L2/R2 hold became a chord
+    int l2 = getKeyPressed(KEY_L2), r2 = getKeyPressed(KEY_R2);
+    if (l2 && r2) {
+        if (!shoulderChord && !viewPending)
+            menuRandomItem();
+        shoulderChord = 1;
+    } else {
+        if (getKeyOff(KEY_L2) && !shoulderChord)
+            menuFirstPage();
+        if (getKeyOff(KEY_R2) && !shoulderChord)
+            menuLastPage();
+        if (!l2 && !r2)
+            shoulderChord = 0;
+    }
+
     if (getKeyOn(KEY_LEFT)) {
         ripps2StepCategory(-1); // RIPPS2: Left/Right switch categories (Launch Disc / Memory Files)
     } else if (getKeyOn(KEY_RIGHT)) {
@@ -1868,11 +1886,6 @@ void menuHandleInputMain()
         menuNavigateLeft(); // RIPPS2: L1/R1 switch drives, like the orb formations
     } else if (getKeyOn(KEY_R1)) {
         menuNavigateRight();
-    } else if (getKeyOn(KEY_L2)) { // home
-        menuFirstPage();
-    } else if (getKeyOn(KEY_R2)) { // RIPPS2: a random game (was: end of the list)
-        if (!viewPending)
-            menuRandomItem();
     } else if (getKeyOn(KEY_R3)) { // toggle favourite
         if (!viewPending && selected_item->item->fav)
             selected_item->item->fav(selected_item->item);
