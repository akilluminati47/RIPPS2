-                            cx + fRenderXOff, cy + fRenderYOff, u0, v1,
-                            dx + fRenderXOff, dy + fRenderYOff, u1, v1, order, color);
+    float px[4] = {x0, x1, x0, x1}, py[4] = {y0, y0, y1, y1};
