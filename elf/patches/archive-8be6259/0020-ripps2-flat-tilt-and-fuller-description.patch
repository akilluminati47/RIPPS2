-// A textured axis-aligned rect (x0,y0)-(x1,y1) through the tilt, as a quad
+// A textured quad through the tilt; px/py are its corners TL, TR, BL, BR before the tilt. The GS
+// maps a texture affinely across each of a quad's two triangles, so one big perspective quad shears
+// its art along the diagonal. Big quads are cut into cells of about 40 px, each projected on its own,
+// which keeps the art flat; small ones (text glyphs) stay a single quad.
+#define TILT_CELL_PX 40.0f
+static void rmTiltTexQuad(GSTEXTURE *txt, const float *px, const float *py, float u0, float v0, float u1, float v1, u64 color)
+{
+    float w = fmaxf(fabsf(px[1] - px[0]), fabsf(px[3] - px[2])), h = fmaxf(fabsf(py[2] - py[0]), fabsf(py[3] - py[1]));
+    int nx = (int)(w / TILT_CELL_PX) + 1, ny = (int)(h / TILT_CELL_PX) + 1, i, j, k;
+    if (nx > 8)
+        nx = 8;
+    if (ny > 8)
+        ny = 8;
+    for (j = 0; j < ny; j++) {
+        for (i = 0; i < nx; i++) {
+            float s[4] = {(float)i / nx, (float)(i + 1) / nx, (float)i / nx, (float)(i + 1) / nx};
+            float t[4] = {(float)j / ny, (float)j / ny, (float)(j + 1) / ny, (float)(j + 1) / ny};
+            float cx[4], cy[4];
+            for (k = 0; k < 4; k++) { // bilinear point in the quad, then through the tilt
+                float topX = px[0] + (px[1] - px[0]) * s[k], topY = py[0] + (py[1] - py[0]) * s[k];
+                float botX = px[2] + (px[3] - px[2]) * s[k], botY = py[2] + (py[3] - py[2]) * s[k];
+                cx[k] = topX + (botX - topX) * t[k];
+                cy[k] = topY + (botY - topY) * t[k];
+                rmTiltPoint(&cx[k], &cy[k]);
+            }
+            gsKit_prim_quad_texture(gsGlobal, txt,
+                                    cx[0] + fRenderXOff, cy[0] + fRenderYOff, u0 + (u1 - u0) * s[0], v0 + (v1 - v0) * t[0],
+                                    cx[1] + fRenderXOff, cy[1] + fRenderYOff, u0 + (u1 - u0) * s[1], v0 + (v1 - v0) * t[1],
+                                    cx[2] + fRenderXOff, cy[2] + fRenderYOff, u0 + (u1 - u0) * s[2], v0 + (v1 - v0) * t[2],
+                                    cx[3] + fRenderXOff, cy[3] + fRenderYOff, u0 + (u1 - u0) * s[3], v0 + (v1 - v0) * t[3], order, color);
+        }
+    }
+}
