+static int gTiltOn = 0;
+static float gTiltCx, gTiltCy, gTiltCosY, gTiltSinY, gTiltCosP, gTiltSinP, gTiltD;
+
+void rmSetTilt(int on, int cx, int cy, float yaw, float pitch)
+{
+    gTiltOn = on;
+    if (!on)
+        return;
+    gTiltCx = X_SCALE(cx);
+    gTiltCy = Y_SCALE(cy);
+    gTiltCosY = cosf(yaw);
+    gTiltSinY = sinf(yaw);
+    gTiltCosP = cosf(pitch);
+    gTiltSinP = sinf(pitch);
+    gTiltD = X_SCALE(900); // viewing distance: a gentle perspective
+}
