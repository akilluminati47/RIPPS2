+static void rmTiltPoint(float *x, float *y)
+{
+    float px = *x - gTiltCx, py = *y - gTiltCy;
+    float x1 = px * gTiltCosY, z1 = -px * gTiltSinY;     // yaw
+    float y2 = py * gTiltCosP - z1 * gTiltSinP;           // pitch
+    float z2 = py * gTiltSinP + z1 * gTiltCosP;
+    float k = gTiltD / (gTiltD + z2);
+    *x = gTiltCx + x1 * k;
+    *y = gTiltCy + y2 * k;
+}
