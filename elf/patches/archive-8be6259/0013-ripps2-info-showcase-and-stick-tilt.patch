+
+// ---- INFO page: right-stick view tilt ----
+// The stick tips the art panel (with everything on it) and the disc-and-cover showcase a few degrees
+// in any direction, each about its own centre; the view eases after the stick and starts level each
+// time the page opens. Pushing a side sends that side away.
+#define TILT_YAW_MAX   0.16f // ~9 degrees
+#define TILT_PITCH_MAX 0.12f // ~7 degrees
+
+static float tiltYaw = 0.0f, tiltPitch = 0.0f;
+static clock_t tiltLast = 0;
+
+void ripps2UpdateTilt(void)
+{
+    int sx, sy;
+    clock_t now = clock();
+    float dt = tiltLast != 0 ? (float)(now - tiltLast) / (float)CLOCKS_PER_SEC : 1.0f;
+    tiltLast = now;
+    if (dt > 0.25f) { // the page just opened
+        tiltYaw = 0.0f;
+        tiltPitch = 0.0f;
+        dt = 0.016f;
+    }
+    padGetRightStick(&sx, &sy);
+    float k = fminf(1.0f, dt * 8.0f);
+    tiltYaw += (-(sx / 128.0f) * TILT_YAW_MAX - tiltYaw) * k;
+    tiltPitch += ((sy / 128.0f) * TILT_PITCH_MAX - tiltPitch) * k;
+}
+
+void ripps2TiltBegin(int cx, int cy)
+{
+    if (fabsf(tiltYaw) > 0.0005f || fabsf(tiltPitch) > 0.0005f)
+        rmSetTilt(1, cx, cy, tiltYaw, tiltPitch);
+}
+
+void ripps2TiltEnd(void)
+{
+    rmSetTilt(0, 0, 0, 0.0f, 0.0f);
+}
