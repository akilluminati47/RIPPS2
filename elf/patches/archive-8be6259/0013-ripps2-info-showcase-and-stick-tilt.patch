+// RIPPS2: the right stick, for views that tilt with it. -128..127 per axis from the first pad in
+// analog mode; 0 when there is none or the stick rests inside a small deadzone.
+void padGetRightStick(int *x, int *y)
+{
+    int i;
+    *x = 0;
+    *y = 0;
+    for (i = 0; i < pad_count && i < MAX_PADS; i++) {
+        struct pad_data_t *pad = &pad_data[i];
+        if (pad->state != PAD_STATE_STABLE || (pad->buttons.mode >> 4) != 0x07)
+            continue;
+        int h = (int)pad->buttons.rjoy_h - 128, v = (int)pad->buttons.rjoy_v - 128;
+        if (h * h + v * v > 24 * 24) {
+            *x = h;
+            *y = v;
+        }
+        return;
+    }
+}
