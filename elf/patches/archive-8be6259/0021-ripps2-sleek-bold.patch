+# RIPPS2: its bold weight (misc/ripps2_sleekbold.ttf), for text beside big button glyphs
+$(EE_ASM_DIR)ripps2_sleekbold.c: misc/ripps2_sleekbold.ttf | $(EE_ASM_DIR)
+	$(BIN2C) $< $@ $(*F)_raw
+
 # RIPPS2: the Memory Files ELF compiled in (misc/ripps2_memfiles.elf, copied in by build.sh)
 $(EE_ASM_DIR)ripps2_memfiles.c: misc/ripps2_memfiles.elf | $(EE_ASM_DIR)
 	$(BIN2C) $< $@ $(*F)_elf
