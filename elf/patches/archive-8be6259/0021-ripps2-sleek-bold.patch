 	Galician German Greek Hungarian Indonesian Italian Japanese Korean Laotian Persian Polish Portuguese \
@@ -1113,6 +1113,10 @@ $(EE_ASM_DIR)ripps2_font.c: misc/ripps2_font.ttf | $(EE_ASM_DIR)
 $(EE_ASM_DIR)ripps2_sleek.c: misc/ripps2_sleek.ttf | $(EE_ASM_DIR)
