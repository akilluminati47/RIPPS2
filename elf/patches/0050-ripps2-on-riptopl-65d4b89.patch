+static int fbDrawGrid(void)
+{
+    float t = (float)(clock() - fbGridAt) / CLOCKS_PER_SEC, k;
+    int i, uiFont = gTheme->fonts[4];
+
+    if (fbGridClosing) {
+        k = 1.0f - t / FB_GRID_OUT;
+        if (k <= 0.0f) {
+            fbGridOpen = fbGridClosing = 0; // the tree, smoothly back
+            return 0;
+        }
+    } else
+        k = t / FB_GRID_IN > 1.0f ? 1.0f : t / FB_GRID_IN;
+
+    rmDrawRect(14, 10, 612, 460, FB_PRIM(0x03, 0x08, 0x22, (int)(0x68 * k)));
+    fntRenderString(uiFont, FB_X, 30, ALIGN_VCENTER, 0, 0, "MEMORY FILES SETTINGS", GS_SETREG_RGBA(0x80, 0x80, 0x80, (int)(0x80 * k)));
+    int x0 = 320 - (3 * FB_TILE_W + 2 * FB_TILE_GAP) / 2;
+    for (i = 0; i < FB_TILE_COUNT; i++) {
+        float ki = fbGridClosing ? k : (k * 1.4f - i * 0.08f);
+        if (ki <= 0.0f)
+            continue;
+        if (ki > 1.0f)
+            ki = 1.0f;
+        float s = 0.9f + 0.1f * ki;
+        int sel = i == fbGridSel, a = (int)(0x80 * ki);
+        float cx = x0 + (i % 3) * (FB_TILE_W + FB_TILE_GAP) + FB_TILE_W / 2.0f, cy = FB_GRID_Y + (i / 3) * (FB_TILE_H + FB_TILE_GAP) + FB_TILE_H / 2.0f;
+        float hw = FB_TILE_W * s / 2, hh = FB_TILE_H * s / 2;
+        int l = (int)(cx - hw), r = (int)(cx + hw), tp = (int)(cy - hh), b = (int)(cy + hh);
+        u64 edge = sel ? FB_PRIM(0x9C, 0xB8, 0xFF, a) : FB_PRIM(0x4A, 0x72, 0xDC, a);
+        rmDrawRect(l, tp, r - l, b - tp, sel ? FB_PRIM(0x1E, 0x3C, 0x96, (int)(0x60 * ki)) : FB_PRIM(0x04, 0x0C, 0x2E, (int)(0x50 * ki)));
+        rmDrawLine(l, tp, r, tp, edge);
+        rmDrawLine(r, tp, r, b, edge);
+        rmDrawLine(r, b, l, b, edge);
+        rmDrawLine(l, b, l, tp, edge);
+        fbTileIcon(i, cx, cy - hh * 0.22f, 52 * s, a);
+        u64 tc = sel ? GS_SETREG_RGBA(0x80, 0x80, 0x80, a) : GS_SETREG_RGBA(0x67, 0x6C, 0x7A, a);
+        fntRenderString(uiFont, (int)cx, (int)(cy + hh * 0.48f), ALIGN_CENTER, 0, 0, fbTileLine1[i], tc);
+        fntRenderString(uiFont, (int)cx, (int)(cy + hh * 0.48f) + 17, ALIGN_CENTER, 0, 0, fbTileLine2[i], tc);
+    }
+    int hx = 44, hy = 448;
+    fbHint(gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, "SELECT", &hx, hy);
+    fbHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, "BACK", &hx, hy);
+    return 1;
+}
+
+void ripps2HandleInputFiles(void)
+{
+    int openKey = gSelectButton == KEY_CIRCLE ? KEY_CIRCLE : KEY_CROSS;
+    int backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+
+    if (fbBusy)
+        return;
+
+    if (fbGridOpen) { // the settings grid has the pad
+        fbHandleGrid();
+        return;
+    }
+    if (getKeyOn(KEY_START) && !fbMenuOpen) {
+        sfxPlay(SFX_CONFIRM);
+        fbGridShow(1);
+        return;
+    }
+
+    if (fbMenuOpen) {
+        if (getKeyOn(KEY_UP) && fbMenuSel > 0) {
+            fbMenuSel--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(KEY_DOWN) && fbMenuSel < fbMenuCount - 1) {
+            fbMenuSel++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(openKey)) {
+            fbAction(fbMenuItems[fbMenuSel]);
+        } else if (getKeyOn(backKey) || getKeyOn(KEY_TRIANGLE)) {
+            fbMenuOpen = 0;
+            sfxPlay(SFX_CANCEL);
+        }
+        return;
+    }
+
+    if (getKeyOn(KEY_UP)) {
+        if (fbCursor > 0) {
+            fbCursor--;
+            sfxPlay(SFX_CURSOR);
+        }
+    } else if (getKeyOn(KEY_DOWN)) {
+        if (fbCursor < fbCount - 1) {
+            fbCursor++;
+            sfxPlay(SFX_CURSOR);
+        }
+    } else if (getKeyOn(KEY_L1)) {
+        fbCursor -= FB_ROWS;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKeyOn(KEY_R1)) {
+        fbCursor += FB_ROWS;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKeyOn(openKey)) {
+        fbOpen();
+    } else if (getKeyOn(backKey)) {
+        fbUp();
+    } else if (getKeyOn(KEY_SQUARE)) {
+        if (fbPath[0] && fbCount > 0) {
+            fbList[fbCursor].marked ^= 1;
+            if (fbCursor < fbCount - 1)
+                fbCursor++;
+            sfxPlay(SFX_CURSOR);
+        }
+    } else if (getKeyOn(KEY_SELECT)) { // read the folder (or the drives) again
+        sfxPlay(SFX_CONFIRM);
+        if (fbCount > 0 && fbCursor < fbCount)
+            snprintf(fbKeepName, sizeof(fbKeepName), "%s", fbList[fbCursor].name);
+        fbDevForce = 1;
+        fbRun(FB_OP_SCAN, "READING");
+    } else if (getKeyOn(KEY_TRIANGLE)) {
+        fbMenuBuild();
+        if (fbMenuCount > 0) {
+            fbMenuOpen = 1;
+            sfxPlay(SFX_CONFIRM);
+        }
+    }
+    fbFixScroll();
+}
+
+// ---- drawing ----
+
+static void fbGlyph(int kind, int x, int y, u64 col)
+{
+    u64 c = col;
+    switch (kind) {
+        case FB_KIND_DIR:
+            rmDrawRect(x, y + 3, 7, 3, c);
+            rmDrawRect(x, y + 5, 16, 10, c);
+            break;
+        case FB_KIND_SAVE: // a little memory card
+            rmDrawRect(x + 1, y + 1, 12, 15, c);
+            rmDrawRect(x + 3, y + 3, 8, 5, FB_PRIM(0x03, 0x08, 0x22, 0x80));
+            break;
+        case FB_KIND_ELF: // a play mark
+            rmDrawLine(x + 2, y + 2, x + 13, y + 8, c);
+            rmDrawLine(x + 13, y + 8, x + 2, y + 14, c);
+            rmDrawLine(x + 2, y + 14, x + 2, y + 2, c);
+            break;
+        case FB_KIND_DEVICE:
+        case FB_KIND_START:
+            rmDrawRect(x, y + 4, 16, 9, c);
+            rmDrawRect(x + 2, y + 6, 4, 2, FB_PRIM(0x03, 0x08, 0x22, 0x80));
+            break;
+        default: // a page with a folded corner
+            rmDrawLine(x + 2, y + 1, x + 10, y + 1, c);
+            rmDrawLine(x + 10, y + 1, x + 14, y + 5, c);
+            rmDrawLine(x + 14, y + 5, x + 14, y + 16, c);
+            rmDrawLine(x + 14, y + 16, x + 2, y + 16, c);
+            rmDrawLine(x + 2, y + 16, x + 2, y + 1, c);
+            break;
+    }
+}
+
+static void fbSizeText(u32 size, char *out, int n)
+{
+    if (size >= 1024 * 1024)
+        snprintf(out, n, "%u.%u MB", size >> 20, ((size & 0xFFFFF) * 10) >> 20);
+    else if (size >= 1024)
+        snprintf(out, n, "%u KB", (size + 1023) >> 10);
+    else
+        snprintf(out, n, "%u B", size);
+}
+
+static void fbHint(int icon, const char *text, int *x, int y)
+{
+    GSTEXTURE *t = thmGetTexture(icon);
+    if (t != NULL) {
+        rmDrawPixmap(t, *x, y - 10, ALIGN_NONE, 20, 20, SCALING_RATIO, FB_LIT, 0);
+        *x += 24;
+    }
+    fntRenderString(gTheme->fonts[4], *x, y, ALIGN_VCENTER, 0, 0, text, FB_SOFT);
+    *x += fntCalcDimensions(gTheme->fonts[4], text) + 18;
+}
+
+// A row of hints that always fits the panel: the gaps close up before the last one runs off the edge
+#define FB_HINT_RIGHT 612
+static void fbHintRow(const int *icons, const char *const *texts, int n, int x, int y)
+{
+    int i, w = 0, gap = 18;
+    for (i = 0; i < n; i++)
+        w += 24 + fntCalcDimensions(gTheme->fonts[4], texts[i]);
+    if (n > 1 && x + w + gap * (n - 1) > FB_HINT_RIGHT)
+        gap = (FB_HINT_RIGHT - x - w) / (n - 1);
+    if (gap < 6)
+        gap = 6;
+    for (i = 0; i < n; i++) {
+        GSTEXTURE *t = thmGetTexture(icons[i]);
+        if (t != NULL)
+            rmDrawPixmap(t, x, y - 10, ALIGN_NONE, 20, 20, SCALING_RATIO, FB_LIT, 0);
+        x += 24;
+        fntRenderString(gTheme->fonts[4], x, y, ALIGN_VCENTER, 0, 0, texts[i], FB_SOFT);
+        x += fntCalcDimensions(gTheme->fonts[4], texts[i]) + gap;
+    }
+}
+
+void ripps2RenderFiles(void)
+{
+    int i, rowFont = gTheme->fonts[8], smallFont = gTheme->fonts[5], uiFont = gTheme->fonts[4];
+    char buf[96];
+
+    ripps2DrawBackground();
+    ripps2DrawPagePanel();
+
+    if (!fbBusy && fbRescanAt != 0 && clock() >= fbRescanAt && fbPath[0] == '\0') {
+        fbRescanAt = 0; // drives started from here have had time to attach
+        fbStarted = 0;
+        fbDevForce = 1;
+        fbRun(FB_OP_SCAN, "READING");
+    }
+    if (!fbBusy)
+        fbRestoreCursor();
+
+    // the path, and the clipboard / what just happened
+    fntRenderString(uiFont, FB_X, 30, ALIGN_VCENTER, 0, 0, fbPath[0] ? fbPath : "MEMORY FILES", FB_LIT);
+    if (fbToastAt != 0 && (float)(clock() - fbToastAt) / CLOCKS_PER_SEC < 2.5f)
+        snprintf(buf, sizeof(buf), "%s", fbToast);
+    else if (fbClipCount > 0)
+        snprintf(buf, sizeof(buf), "%d %s %s", fbClipCount, fbFiles(fbClipCount), fbClipCut ? "CUT" : "COPIED");
+    else
+        buf[0] = '\0';
+    if (buf[0])
+        fntRenderString(uiFont, FB_RIGHT - fntCalcDimensions(uiFont, buf), 30, ALIGN_VCENTER, 0, 0, buf, FB_SOFT);
+    if (fbToastDetail[0] && fbToastAt != 0 && (float)(clock() - fbToastAt) / CLOCKS_PER_SEC < 6.0f) // what failed
+        fntRenderString(smallFont, FB_RIGHT - fntCalcDimensions(smallFont, fbToastDetail), 432, ALIGN_VCENTER, 0, 0, fbToastDetail, FB_SOFT);
+    rmDrawLine(FB_X, 46, FB_RIGHT, 46, FB_PRIM(0x4A, 0x72, 0xDC, 0x60));
+
+    if (fbBusy) {
+        // reading, or a paste / delete with its progress
+        fntRenderString(uiFont, 320, 210, ALIGN_CENTER, 0, 0, fbOpLabel, FB_LIT);
+        if (fbOp != FB_OP_SCAN && fbTotalItems > 0) {
+            float p = fbTotalBytes > 0 ? (float)fbDoneBytes / (float)fbTotalBytes : (float)fbDoneItems / (float)fbTotalItems;
+            if (p > 1.0f)
+                p = 1.0f;
+            rmDrawRect(170, 236, 300, 6, FB_PRIM(0x03, 0x08, 0x22, 0x80));
+            rmDrawRect(170, 236, (int)(300 * p), 6, FB_PRIM(0x4A, 0x8C, 0xF0, 0x80));
+            snprintf(buf, sizeof(buf), "%d / %d", fbDoneItems, fbTotalItems);
+            fntRenderString(smallFont, 320, 258, ALIGN_CENTER, 0, 0, buf, FB_SOFT);
+        }
+        return;
+    }
+
+    if (fbCount == 0)
+        fntRenderString(uiFont, 320, 200, ALIGN_CENTER, 0, 0, fbPath[0] ? "EMPTY" : "NO DRIVES", FB_DIM);
+
+    for (i = 0; i < FB_ROWS && fbTop + i < fbCount; i++) {
+        fb_entry_t *e = &fbList[fbTop + i];
+        int y = FB_LIST_Y + i * FB_ROW_H, cur = (fbTop + i) == fbCursor;
+        u64 col = cur ? FB_LIT : FB_DIM;
+        if (cur) {
+            rmDrawRect(FB_X - 6, y - 1, FB_RIGHT - FB_X + 12, FB_ROW_H - 2, FB_PRIM(0x1E, 0x3C, 0x96, 0x58));
+            rmDrawRect(FB_X - 6, y - 1, 3, FB_ROW_H - 2, FB_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+        }
+        if (e->marked)
+            rmDrawRect(FB_X, y + 6, 6, 6, FB_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+        fbGlyph(e->kind, FB_X + 12, y + 1, cur ? FB_PRIM(0x9C, 0xB8, 0xFF, 0x80) : FB_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        int tx = FB_X + 36;
+        if (e->kind == FB_KIND_DEVICE || e->kind == FB_KIND_START) {
+            // a drive: its label, its path on the right; the start row: START DRIVES, what it starts
+            const char *main = e->kind == FB_KIND_DEVICE ? e->title : e->name, *side = e->kind == FB_KIND_DEVICE ? e->name : e->title;
+            fntRenderString(rowFont, tx, y + 9, ALIGN_VCENTER, 0, 0, main, col);
+            fntRenderString(smallFont, FB_RIGHT - fntCalcDimensions(smallFont, side), y + 9, ALIGN_VCENTER, 0, 0, side, FB_DIM);
+        } else if (e->kind == FB_KIND_SAVE) {
+            fntRenderString(rowFont, tx, y + 9, ALIGN_VCENTER, 0, 0, e->title, col);
+            fntRenderString(smallFont, FB_RIGHT - fntCalcDimensions(smallFont, e->name), y + 9, ALIGN_VCENTER, 0, 0, e->name, FB_DIM);
+        } else {
+            fntRenderString(rowFont, tx, y + 9, ALIGN_VCENTER, 0, 0, e->name, col);
+            if (e->kind != FB_KIND_DIR) {
+                fbSizeText(e->size, buf, sizeof(buf));
+                fntRenderString(smallFont, FB_RIGHT - fntCalcDimensions(smallFont, buf), y + 9, ALIGN_VCENTER, 0, 0, buf, FB_DIM);
+            }
+        }
+    }
+    if (fbCount > FB_ROWS) { // where you are in a long folder
+        int h = FB_ROWS * FB_ROW_H, bar = h * FB_ROWS / fbCount;
+        rmDrawRect(FB_RIGHT + 4, FB_LIST_Y + h * fbTop / fbCount, 2, bar < 8 ? 8 : bar, FB_PRIM(0x6A, 0x9A, 0xFF, 0x60));
+    }
+
+    // the actions menu
+    if (fbMenuOpen) {
+        int w = 200, h = fbMenuCount * 24 + 20, x = 420, y = 120;
+        rmDrawRect(x, y, w, h, FB_PRIM(0x03, 0x08, 0x22, 0x70));
+        rmDrawLine(x, y, x + w, y, FB_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        rmDrawLine(x, y + h, x + w, y + h, FB_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        rmDrawLine(x, y, x, y + h, FB_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        rmDrawLine(x + w, y, x + w, y + h, FB_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        for (i = 0; i < fbMenuCount; i++) {
+            int ry = y + 10 + i * 24;
+            if (i == fbMenuSel)
+                rmDrawRect(x + 4, ry, w - 8, 22, FB_PRIM(0x1E, 0x3C, 0x96, 0x60));
+            fntRenderString(uiFont, x + 16, ry + 11, ALIGN_VCENTER, 0, 0, fbActName[fbMenuItems[i]], i == fbMenuSel ? FB_LIT : FB_SOFT);
+        }
+    }
+
+    if (fbGridOpen && fbDrawGrid())
+        return; // the grid draws its own hints
+    // the hints
+    int hx = 34, hy = 448;
+    int selIcon = gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, backIcon = gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON;
+    if (fbMenuOpen) {
+        fbHint(selIcon, "SELECT", &hx, hy);
+        fbHint(backIcon, "CLOSE", &hx, hy);
+    } else {
+        fb_entry_t *e = fbCount > 0 ? &fbList[fbCursor] : NULL;
+        int icons[6], n = 0;
+        const char *texts[6];
+        icons[n] = selIcon;
+        texts[n++] = e != NULL && e->kind == FB_KIND_ELF ? "RUN" : "OPEN";
+        icons[n] = backIcon;
+        texts[n++] = fbPath[0] ? "BACK" : "EXIT";
+        if (fbPath[0]) {
+            icons[n] = SQUARE_ICON;
+            texts[n++] = "MARK";
+            icons[n] = TRIANGLE_ICON;
+            texts[n++] = "ACTIONS";
+        }
+        icons[n] = SELECT_ICON;
+        texts[n++] = "REFRESH";
+        icons[n] = START_ICON;
+        texts[n++] = "SETTINGS";
+        fbHintRow(icons, texts, n, hx, hy);
+    }
+}
