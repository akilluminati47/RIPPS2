+static void fbOpen(void)
+{
+    if (fbCount == 0)
+        return;
+    fb_entry_t *e = &fbList[fbCursor];
+    char path[256];
+
+    switch (e->kind) {
+        case FB_KIND_START:
+            sfxPlay(SFX_CONFIRM);
+            ripps2StartSources();
+            fbStarted = 1;
+            fbDevForce = 1;
+            fbRescanAt = clock() + 3 * CLOCKS_PER_SEC; // the drives attach in the background
+            fbRun(FB_OP_SCAN, "STARTING DRIVES");
+            break;
+        case FB_KIND_DEVICE:
+            sfxPlay(SFX_CONFIRM);
+            fbOpenPath(e->name, NULL);
+            break;
+        case FB_KIND_DIR:
+        case FB_KIND_SAVE:
+            sfxPlay(SFX_CONFIRM);
+            snprintf(path, sizeof(path), "%s%s/", fbPath, e->name);
+            fbOpenPath(path, NULL);
+            break;
+        case FB_KIND_ELF:
+            sfxPlay(SFX_CONFIRM);
+            fbRunElf(e);
+            break;
+        default:
+            if (fbIsText(e->name)) {
+                sfxPlay(SFX_CONFIRM);
+                fbEdit(e->name);
+            }
+            break;
+    }
