+static void fbHandleGrid(void)
+{
+    int openKey = gSelectButton == KEY_CIRCLE ? KEY_CIRCLE : KEY_CROSS;
+    int backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+    int col = fbGridSel % 3, row = fbGridSel / 3;
+
+    if (fbGridClosing)
+        return;
+    if (getKeyOn(KEY_LEFT) && col > 0) {
+        fbGridSel--;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKeyOn(KEY_RIGHT) && col < 2) {
+        fbGridSel++;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKeyOn(KEY_UP) && row > 0) {
+        fbGridSel -= 3;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKeyOn(KEY_DOWN) && row < 1) {
+        fbGridSel += 3;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKeyOn(openKey)) {
+        fbTile(fbGridSel);
+    } else if (getKeyOn(backKey) || getKeyOn(KEY_START)) {
+        sfxPlay(SFX_CANCEL);
+        fbGridShow(0);
+    }
+}
