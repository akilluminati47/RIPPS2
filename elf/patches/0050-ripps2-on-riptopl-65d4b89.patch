+// RIPPS2: the info page slideshow. GameImage elements with <name>_slide=N (1..4) in one family take
+// turns: each shows for SLIDE_HOLD_S, then crossfades into the next one that has art. A slide whose
+// file is missing is skipped, never shown as a blank; with no art at all nothing draws, and the glass
+// panel over them carries the page alone. The theme lists slides in ascending order, so in a
+// crossfade the earlier one is painted opaque and the later one fades in over it (or out of it).
+#define SLIDE_HOLD_S 5.0f
+#define SLIDE_FADE_S 1.0f
+#define SLIDE_MAX    4
+
+static struct
+{
+    int frame;                     // guiFrameId of the last update
+    void *item;                    // the game the show belongs to
+    struct theme_elems *family;    // the page it is on
+    GSTEXTURE *tex[SLIDE_MAX + 1]; // each slide's art this frame, by slide number (NULL = none yet)
+    int cur;                       // the slide on show (0 = none)
+    clock_t start;                 // when it began showing
+} slideShow;
+
+static int slideNext(int cur)
+{
+    int i, s;
+    for (i = 1; i <= SLIDE_MAX; i++) {
+        s = (cur - 1 + i) % SLIDE_MAX + 1;
+        if (slideShow.tex[s] != NULL)
+            return s;
+    }
+    return cur;
+}
+
+static float slideElapsed(void)
+{
+    return (float)(clock() - slideShow.start) / (float)CLOCKS_PER_SEC;
+}
+
+static void slideUpdate(struct menu_list *menu, struct submenu_list *item, struct theme_element *drawElem)
+{
+    theme_element_t *e;
+    int have = 0, s;
+
+    if (slideShow.frame == guiFrameId && slideShow.item == item && slideShow.family == drawElem->family)
+        return;
+    // another game, another page, or the page opened again: the show starts over at the first slide
+    if (slideShow.item != item || slideShow.family != drawElem->family || guiFrameId - slideShow.frame > 2) {
+        slideShow.cur = 0;
+        slideShow.start = clock();
+    }
+    slideShow.frame = guiFrameId;
+    slideShow.item = item;
+    slideShow.family = drawElem->family;
+    memset(slideShow.tex, 0, sizeof(slideShow.tex));
+
+    for (e = drawElem->family->first; e != NULL; e = e->next) {
+        if (e->slide < 1 || e->extended == NULL)
+            continue;
+        mutable_image_t *img = (mutable_image_t *)e->extended;
+        // the slide on show (or the first, before one is) asks first; the rest queue behind it
+        GSTEXTURE *t = getGameImageTextureEx(img->cache, menu->item->userdata, &item->item, slideShow.cur == 0 || e->slide == slideShow.cur);
+        if (t != NULL && t->Mem != NULL) {
+            slideShow.tex[e->slide] = t;
+            have++;
+        }
+    }
+    if (!have) {
+        slideShow.cur = 0;
+        slideShow.start = clock();
+        return;
+    }
+    if (slideShow.cur == 0 || slideShow.tex[slideShow.cur] == NULL) {
+        for (s = 1; s <= SLIDE_MAX && slideShow.tex[s] == NULL; s++)
+            ;
+        slideShow.cur = s;
+        slideShow.start = clock();
+    } else if (slideElapsed() >= SLIDE_HOLD_S + SLIDE_FADE_S) {
+        slideShow.cur = slideNext(slideShow.cur);
+        slideShow.start = clock();
+    }
+}
+
+// How much of slide s shows this frame, 0..1
+static float slideWeight(int s)
+{
+    int cur = slideShow.cur, next = slideNext(cur);
+    float f, t = slideElapsed();
+
+    if (cur == 0 || slideShow.tex[s] == NULL)
+        return 0.0f;
+    if (t < SLIDE_HOLD_S || next == cur)
+        return s == cur ? 1.0f : 0.0f;
+    f = (t - SLIDE_HOLD_S) / SLIDE_FADE_S;
+    if (f > 1.0f)
+        f = 1.0f;
+    f = f * f * (3.0f - 2.0f * f);
+    if (s == (cur < next ? cur : next))
+        return 1.0f; // painted first: the other one fades over it
+    if (s == cur)
+        return 1.0f - f;
+    if (s == next)
+        return f;
+    return 0.0f;
+}
