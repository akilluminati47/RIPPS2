+#ifndef __MIXSUPPORT_H
+#define __MIXSUPPORT_H
+
+#include "include/iosupport.h"
+
+// RIPPS2 All Games (MIX_MODE): every game on every started game source in one list. See mixsupport.c.
+
+item_list_t *mixGetObject(int initOnly);
+
+// A game source's list changed: rebuild All Games (one queued pass however many sources change)
+void mixRequestUpdate(void);
+
+// The source of one All Games row: its device mode, the id in that device's PS2 or PS1 list (found
+// again by name if the device has rescanned since), and its FAV_KIND_*. -1 when id is invalid.
+int mixGetItemSourceMode(int id);
+int mixGetItemSourceId(int id);
+int mixGetItemKind(int id);
+
+// The selected row's source flags (Options menu, DMA rows), like favGetFlags
+unsigned char mixGetFlags(item_list_t *itemList);
+
+// Source device mode of the row whose art-cache value matches, or -1. GUI thread, like favGetArtMode.
+int mixGetArtMode(const char *value);
+
+// Favourite stars on All Games rows, kept by the Favourites rebuild (favsupport.c)
+void mixClearStars(void);
+void mixMarkStar(int mode, int id, int kind, const char *text);
+
+#endif
