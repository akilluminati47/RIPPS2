+static void fbCircle(float cx, float cy, float r, float from, float to, u64 c)
+{
+    int k, seg = 20;
+    float px = cx + cosf(from) * r, py = cy + sinf(from) * r;
+    for (k = 1; k <= seg; k++) {
+        float a = from + (to - from) * k / seg, nx = cx + cosf(a) * r, ny = cy + sinf(a) * r;
+        rmDrawLine((int)px, (int)py, (int)nx, (int)ny, c);
+        px = nx;
+        py = ny;
+    }
+}
