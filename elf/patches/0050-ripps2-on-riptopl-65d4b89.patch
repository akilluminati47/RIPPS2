diff --git a/include/ripps2.h b/include/ripps2.h
new file mode 100644
index 0000000..a1032a2
--- /dev/null
+++ b/include/ripps2.h
@@ -0,0 +1,90 @@
+#ifndef __RIPPS2_H
+#define __RIPPS2_H
+
+// Launches the Memory Files ELF bundled inside RIPPS2.elf. Never returns on success;
+// returns < 0 (before touching anything) when the bundled image fails validation.
+
+// Boots a DVD player for the DVD video in the drive: the user's RGB-patched player from a memory
+// card when installed, else the console's own. Never returns on success; < 0 if there is none.
+int ripps2LaunchDvdPlayer(void);
+
+// Boots the PlayStation disc in the drive through the console's own PS1 driver (rom0:PS1DRV), the way
+// the browser does. Never returns on success; < 0 when the disc has nothing to boot.
+int ripps2LaunchPs1Disc(void);
+
+// ---- Front end shell (ripps2ui.c): LAUNCH DISC | STORAGE | MEMORY FILES ----
+enum {
+    RIPPS2_CAT_LAUNCH = 0,
+    RIPPS2_CAT_STORAGE,
+    RIPPS2_CAT_MEMORY,
+    RIPPS2_CAT_COUNT
+};
+
+extern int gRipps2Category;  // current category; boots on Storage
+extern int gRipps2Formation; // Memory Files orb formation, switched with L1/R1; saved in the settings
+void ripps2SaveSettingsInBackground(void); // opl.c: a quiet settings save on the io worker
+
+// Random Game (Interface settings): L2 + R2 together jump to a random game; Boot also opens each
+// game list on a random game at startup, ahead of the last played one
+enum { RIPPS2_RANDOM_OFF = 0, RIPPS2_RANDOM_ON, RIPPS2_RANDOM_BOOT };
+extern int gRipps2Random;
+
+void ripps2SetCategory(int cat);    // switch screens and fly the PS2 mark
+void ripps2StepCategory(int dir);   // -1 / +1, clamped at the ends
+void ripps2RenderCategoryBar(void); // the three labels plus the mark
+void ripps2UiEnter(void);           // the menu's first frame: the bar fades in, the mark pops in
+void ripps2ShowViewWord(const char *word, int logo, const char *caption); // L3: name the new list, large (a word, or a texture id)
+void ripps2DrawViewWord(void);      // drawn over the Storage page while it plays
+
+void ripps2HandleInputLaunch(void);
+void ripps2RenderLaunch(void);
+void ripps2HandleInputMemory(void);
+void ripps2RenderMemory(void);
+
+// ---- INFO page right-stick tilt (theme keys <name>_tilt / _tilt_x / _tilt_y) ----
+void ripps2UpdateTilt(void);            // once per info frame: ease the view after the right stick
+void ripps2TiltBegin(int cx, int cy, int scalePct); // tilt what is drawn next about (cx, cy), theme coords
+void ripps2TiltEnd(void);
+
+// ---- Storage art panel glass (theme element Ripps2PanelGlass) ----
+void ripps2DrawPanelGlass(int x, int y, int w, int h, int hasItem);
+void ripps2DrawPagePanel(void); // menus / settings / dialogs: one clear-glass panel behind the page
+void ripps2DrawHintBox(int x, int y, int w, int h); // the settings help text's box, in the same glass
+void ripps2DrawPanelVeil(int x, int y, int w, int h, float amount); // deep glass over a panel, 0..1
+// A screen switch between two panels: the pillars, and one glass panel p (0..1) of the way from a to b
+void ripps2DrawPanelMorph(int ax, int ay, int aw, int ah, int bx, int by, int bw, int bh, float p);
+
+// ---- Native backgrounds (ripps2bg.c), drawn in place of the plasma ----
+void ripps2DrawBackground(void); // orbs on Memory Files, pillars everywhere else
+void ripps2DrawPillars(void);
+void ripps2DrawOrbs(void);
+int ripps2LaunchDvdVideo(void); // ripps2.c: a DVD video disc: ESR for an ESR-patched game, else a DVD player
+
+// The Memory Files browser (ripps2files.c)
+void ripps2FilesEnter(void); // from the Memory Files page: open it where it was left
+void ripps2RenderFiles(void);
+void ripps2HandleInputFiles(void);
+void ripps2StartSources(void); // opl.c: start every game source that waits for a start
+
+// USB keyboard (ripps2kbd.c): one key at a time, 0 when none
+enum { RIPPS2_KEY_ENTER = 0x100, RIPPS2_KEY_ESC, RIPPS2_KEY_BACKSPACE, RIPPS2_KEY_DELETE, RIPPS2_KEY_LEFT, RIPPS2_KEY_RIGHT,
+       RIPPS2_KEY_UP, RIPPS2_KEY_DOWN, RIPPS2_KEY_HOME, RIPPS2_KEY_END };
+int ripps2KbdPoll(void);
+
+// The editor (ripps2edit.c): a text file, or a game's metadata as a form
+#include "include/config.h"
+int ripps2EditFile(const char *path);                              // 1 when it saved
+int ripps2EditMetadata(config_set_t *config, const char *gameName); // 1 when SAVE was chosen (values set, not written)
+
+void ripps2HddManager(void); // ripps2hdd.c
+int ripps2PickList(const char *const *items, int count); // ripps2edit.c: a small glass list; -1 = none
+void ripps2SetOrbInput(int showPaths, int boost); // Memory Files: L2 shows the paths, R2 builds the orbs to 2x
+
+// ---- Boot swoop and launch light-up (ripps2bg.c) ----
+void ripps2DrawBootFrame(void);     // the swoop's first frame, for boot screens before the intro
+int ripps2IntroUiReady(void);       // the boot swoop has run long enough to bring the menu in
+void ripps2PlayLaunchSequence(void); // pillars only, light-up and flash; the last frame holds
+int ripps2LaunchScreenHeld(void);    // that frame is up: the teardown must not draw over it
+void ripps2LaunchAborted(void);      // the launch failed and returned to the menu
+
+#endif
