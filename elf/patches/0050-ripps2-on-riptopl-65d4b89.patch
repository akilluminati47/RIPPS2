+// A tile's icon, drawn at (cx, cy) about s px across
+static void fbTileIcon(int t, float cx, float cy, float s, int a)
+{
+    u64 c = FB_PRIM(0x9C, 0xB8, 0xFF, a), dim = FB_PRIM(0x4A, 0x72, 0xDC, a);
+    float h = s / 2;
+    GSTEXTURE *tex;
+    int i;
+    switch (t) {
+        case FB_TILE_BROWSER: // wLaunchELF's own folder, large
+            tex = thmGetTexture(RIPPS2_WLE_FOLDER);
+            if (tex != NULL)
+                rmDrawPixmap(tex, (int)(cx - h), (int)(cy - h), ALIGN_NONE, (int)s, (int)s, SCALING_RATIO, GS_SETREG_RGBA(0x80, 0x80, 0x80, a), 0);
+            break;
+        case FB_TILE_EDITOR: // a page of lines
+            rmDrawLine((int)(cx - h * 0.6f), (int)(cy - h), (int)(cx + h * 0.3f), (int)(cy - h), c);
+            rmDrawLine((int)(cx + h * 0.3f), (int)(cy - h), (int)(cx + h * 0.6f), (int)(cy - h * 0.7f), c);
+            rmDrawLine((int)(cx + h * 0.6f), (int)(cy - h * 0.7f), (int)(cx + h * 0.6f), (int)(cy + h), c);
+            rmDrawLine((int)(cx + h * 0.6f), (int)(cy + h), (int)(cx - h * 0.6f), (int)(cy + h), c);
+            rmDrawLine((int)(cx - h * 0.6f), (int)(cy + h), (int)(cx - h * 0.6f), (int)(cy - h), c);
+            for (i = 0; i < 4; i++)
+                rmDrawLine((int)(cx - h * 0.35f), (int)(cy - h * 0.4f + i * h * 0.4f), (int)(cx + h * (i == 3 ? 0.05f : 0.35f)), (int)(cy - h * 0.4f + i * h * 0.4f), dim);
+            break;
+        case FB_TILE_HDD: // a drive: body, a platter, a light
+            rmDrawRect((int)(cx - h), (int)(cy - h * 0.55f), (int)s, (int)(s * 0.55f), FB_PRIM(0x1E, 0x3C, 0x96, a / 2));
+            rmDrawLine((int)(cx - h), (int)(cy - h * 0.55f), (int)(cx + h), (int)(cy - h * 0.55f), c);
+            rmDrawLine((int)(cx + h), (int)(cy - h * 0.55f), (int)(cx + h), (int)(cy + h * 0.55f), c);
+            rmDrawLine((int)(cx + h), (int)(cy + h * 0.55f), (int)(cx - h), (int)(cy + h * 0.55f), c);
+            rmDrawLine((int)(cx - h), (int)(cy + h * 0.55f), (int)(cx - h), (int)(cy - h * 0.55f), c);
+            fbCircle(cx - h * 0.25f, cy, h * 0.35f, 0, 6.2832f, dim);
+            rmDrawRect((int)(cx + h * 0.55f), (int)(cy + h * 0.25f), 4, 3, FB_PRIM(0x6A, 0xF0, 0x9A, a));
+            break;
+        case FB_TILE_EXPLOIT: // a memory card with wLaunchELF's warning mark
+            rmDrawLine((int)(cx - h * 0.55f), (int)(cy - h), (int)(cx + h * 0.55f), (int)(cy - h), c);
+            rmDrawLine((int)(cx + h * 0.55f), (int)(cy - h), (int)(cx + h * 0.55f), (int)(cy + h), c);
+            rmDrawLine((int)(cx + h * 0.55f), (int)(cy + h), (int)(cx - h * 0.55f), (int)(cy + h), c);
+            rmDrawLine((int)(cx - h * 0.55f), (int)(cy + h), (int)(cx - h * 0.55f), (int)(cy - h), c);
+            rmDrawRect((int)(cx - h * 0.35f), (int)(cy - h * 0.75f), (int)(h * 0.7f), (int)(h * 0.5f), FB_PRIM(0x1E, 0x3C, 0x96, a / 2));
+            tex = thmGetTexture(RIPPS2_WLE_WARNING);
+            if (tex != NULL)
+                rmDrawPixmap(tex, (int)(cx + h * 0.15f), (int)(cy + h * 0.1f), ALIGN_NONE, (int)(h * 0.9f), (int)(h * 0.9f), SCALING_RATIO, GS_SETREG_RGBA(0x80, 0x80, 0x80, a), 0);
+            break;
+        case FB_TILE_POWER: // the power mark
+            fbCircle(cx, cy + h * 0.1f, h * 0.75f, -1.05f, 4.19f, c);
+            rmDrawLine((int)cx, (int)(cy - h), (int)cx, (int)(cy + h * 0.15f), c);
+            break;
+        default: // EXIT: a doorway and an arrow out of it, toward the orbs
+            rmDrawLine((int)(cx - h * 0.1f), (int)(cy - h), (int)(cx + h * 0.7f), (int)(cy - h), dim);
+            rmDrawLine((int)(cx + h * 0.7f), (int)(cy - h), (int)(cx + h * 0.7f), (int)(cy + h), dim);
+            rmDrawLine((int)(cx + h * 0.7f), (int)(cy + h), (int)(cx - h * 0.1f), (int)(cy + h), dim);
+            rmDrawLine((int)(cx + h * 0.4f), (int)cy, (int)(cx - h * 0.8f), (int)cy, c);
+            rmDrawLine((int)(cx - h * 0.8f), (int)cy, (int)(cx - h * 0.45f), (int)(cy - h * 0.35f), c);
+            rmDrawLine((int)(cx - h * 0.8f), (int)cy, (int)(cx - h * 0.45f), (int)(cy + h * 0.35f), c);
+            break;
+    }
+}
