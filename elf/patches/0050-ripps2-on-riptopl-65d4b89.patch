+// An installer the user keeps for their memory cards (FreeMcBoot, OpenTuna, wLaunchELF R3Z...)
+static int fbFindInstallers(char found[][96], int max)
+{
+    static const char *const folders[] = {"mc0:/APPS/", "mc1:/APPS/", "mc0:/BOOT/", "mc1:/BOOT/", "mass0:/", "mass0:/APPS/", NULL};
+    static const char *const keys[] = {"fmcb", "install", "tuna", "r3z", "booter", NULL};
+    int i, n = 0;
+    for (i = 0; folders[i] != NULL && n < max; i++) {
+        DIR *d = opendir(folders[i]);
+        struct dirent *de;
+        if (d == NULL)
+            continue;
+        while (n < max && (de = readdir(d)) != NULL) {
+            char low[FB_NAME];
+            int k, j;
+            if (!fbHasSuffix(de->d_name, ".elf"))
+                continue;
+            for (j = 0; de->d_name[j] && j < FB_NAME - 1; j++)
+                low[j] = (de->d_name[j] >= 'A' && de->d_name[j] <= 'Z') ? de->d_name[j] + 32 : de->d_name[j];
+            low[j] = '\0';
+            for (k = 0; keys[k] != NULL; k++)
+                if (strstr(low, keys[k]) != NULL) {
+                    snprintf(found[n++], 96, "%s%s", folders[i], de->d_name);
+                    break;
+                }
+        }
+        closedir(d);
+    }
+    return n;
+}
+
+static void fbRunInstaller(void)
+{
+    static char found[6][96];
+    const char *items[6];
+    int n = fbFindInstallers(found, 6), pick = 0, i;
+    if (n == 0) {
+        guiMsgBox("No installer found. Put your memory card exploit installer ELF (FreeMcBoot, OpenTuna, wLaunchELF R3Z...) in APPS on a memory card or USB drive, then choose this again.", 0, NULL);
+        return;
+    }
+    if (n > 1) {
+        for (i = 0; i < n; i++)
+            items[i] = found[i];
+        pick = ripps2PickList(items, n);
+        if (pick < 0)
+            return;
+    }
+    char ask[160];
+    snprintf(ask, sizeof(ask), "Run %s?", found[pick]);
+    if (!guiMsgBox(ask, 1, NULL))
+        return;
+    char *argv[1] = {found[pick]};
+    ripps2PlayLaunchSequence();
+    deinit(UNMOUNT_EXCEPTION, IO_MODE_SELECTED_ALL_SPARE);
+    sysLoadELFApp(found[pick], NULL, 1, argv, 1, 0);
+    ripps2LaunchAborted();
+}
