+void ripps2LaunchAborted(void)
+{
+    // the launch returned (it failed): back to the idle field under the menu
+    launchT0 = -1.0f;
+    launchHeld = 0;
+}
+
+// ---------------------------------------------------------------- orbs
+
+#define MAX_ORBS 28
+#define LORENZ_N 24
+
+typedef struct
+{
+    const char *name;
+    int n;
+    float tilt, spin;
+} formation_t;
+
+// Same order as the Memory Files names in ripps2ui.c
+static const formation_t formations[] = {
+    {"Browser Orbit", 7, 0.12f, 0.0f}, {"Borromean Rings", 24, 0.35f, 0.14f}, {"Torus Orbit", 28, 0.75f, 0.0f},
+    {"Icosahedron", 12, 0.0f, 0.0f}, {"Double Helix", 20, 0.3f, 0.0f}, {"Strange Attractor", LORENZ_N, 0.0f, 0.08f},
+    {"Trefoil Knot", 24, 0.0f, 0.12f}, {"Mobius Strip", 27, 0.6f, 0.1f}, {"Klein Bottle", 28, 0.15f, 0.0f},
+    {"Golden Spiral", 21, 1.15f, 0.0f}, {"Lissajous", 28, 0.0f, 0.1f}, {"Seven-Point Star", 21, 0.0f, 0.0f}};
+#define FORMATIONS ((int)(sizeof(formations) / sizeof(formations[0])))
+
+static v3 lorenz[LORENZ_N];
+static int lorenzReady = 0;
+static const int STAR[7] = {0, 3, 6, 2, 5, 1, 4};
+
+static void lorenzStep(float dt)
+{
+    int i, k;
+    if (!lorenzReady) {
+        for (i = 0; i < LORENZ_N; i++) {
+            lorenz[i].x = 0.1f + (i % 6) * 0.35f;
+            lorenz[i].y = 0.2f * i - 2.0f;
+            lorenz[i].z = 16.0f + (i % 5) * 1.8f;
+        }
+        lorenzReady = 1;
+    }
+    float h = fminf(dt, 0.05f) * 0.35f / 4.0f;
+    for (i = 0; i < LORENZ_N; i++) {
+        v3 *p = &lorenz[i];
+        for (k = 0; k < 4; k++) {
+            float dx = 10.0f * (p->y - p->x), dy = p->x * (28.0f - p->z) - p->y, dz = p->x * p->y - (8.0f / 3.0f) * p->z;
+            p->x += dx * h;
+            p->y += dy * h;
+            p->z += dz * h;
+        }
+    }
+}
+
+static v3 V(float x, float y, float z)
+{
+    v3 r = {x, y, z};
+    return r;
+}
+
+static v3 menuOrbit(int k, float a, float t)
+{
+    float r = (2.5f + (k % 4) * 0.55f) * (1.0f + 0.06f * sinf(t * 0.4f + k));
+    float incl = 0.3f + fmodf(k * 0.61f, 1.0f);
+    float node = (k / 7.0f) * TAU + t * 0.05f;
+    float x0 = cosf(a) * r, z0 = sinf(a) * r;
+    float y1 = -z0 * sinf(incl), z1 = z0 * cosf(incl);
+    return V(x0 * cosf(node) + z1 * sinf(node), y1, -x0 * sinf(node) + z1 * cosf(node));
+}
+
+static v3 klein(float u, float v)
+{
+    float cu = cosf(u), su = sinf(u), cv = cosf(v), sv = sinf(v);
+    float c2 = cu * cu, c4 = c2 * c2, c6 = c4 * c2;
+    float x = -2.0f / 15.0f * cu * (3 * cv - 30 * su + 90 * c4 * su - 60 * c6 * su + 5 * cu * cv * su);
+    float y = -1.0f / 15.0f * su * (3 * cv - 3 * c2 * cv - 48 * c4 * cv + 48 * c6 * cv - 60 * su + 5 * cu * cv * su - 5 * c2 * cu * cv * su - 80 * c4 * cu * cv * su + 80 * c6 * cu * cv * su);
+    float z = 2.0f / 15.0f * (3 + 5 * cu * su) * sv;
+    return V((x - 0.15f) * 1.55f, (y - 2.1f) * 1.55f, z * 1.55f);
+}
+
+// Position of orb i of n in formation f at time t (formation frame, before tilt/spin)
+static v3 formationAt(int f, int i, int n, float t)
+{
+    float s, a, b;
+    switch (f) {
+        case 0: // Browser Orbit
+            return menuOrbit(i, t * (0.3f + fmodf(i * 0.37f, 1.0f) * 0.35f) + i * 2.1f, t);
+        case 1: { // Borromean Rings
+            int per = n / 3, ring = i / per, idx = i % per;
+            s = ((float)idx / per) * TAU + t * (0.4f + ring * 0.07f) + ring * 1.1f;
+            a = 3.2f * cosf(s);
+            b = 1.6f * sinf(s);
+            return ring == 0 ? V(a, b, 0) : ring == 1 ? V(0, a, b) : V(b, 0, a);
+        }
+        case 2: { // Torus Orbit
+            float u = ((float)i / n) * TAU + t * 0.3f, v = ((float)i / n) * TAU * 4.0f + t * 1.1f;
+            return V((3.3f + 1.25f * cosf(v)) * cosf(u), 1.25f * sinf(v), (3.3f + 1.25f * cosf(v)) * sinf(u));
+        }
+        case 3: { // Icosahedron: 12 vertices, tumbling
+            static const float ico[12][3] = {{0, -1, -PHI}, {0, -1, PHI}, {0, 1, -PHI}, {0, 1, PHI}, {-1, -PHI, 0}, {-1, PHI, 0},
+                                             {1, -PHI, 0}, {1, PHI, 0}, {-PHI, 0, -1}, {-PHI, 0, 1}, {PHI, 0, -1}, {PHI, 0, 1}};
+            float sc = 3.4f / sqrtf(1.0f + PHI * PHI);
+            v3 p = V(ico[i][0] * sc, ico[i][1] * sc, ico[i][2] * sc);
+            float ax = t * 0.31f, ay = t * 0.23f;
+            v3 q = V(p.x, p.y * cosf(ax) - p.z * sinf(ax), p.y * sinf(ax) + p.z * cosf(ax));
+            return V(q.x * cosf(ay) + q.z * sinf(ay), q.y, -q.x * sinf(ay) + q.z * cosf(ay));
+        }
+        case 4: { // Double Helix
+            float k = (float)(i / 2) / (n / 2 - 1);
+            s = k * TAU * 1.4f + t * 0.8f + (i % 2) * PI;
+            return V((k - 0.5f) * 8.5f, cosf(s) * 1.7f, sinf(s) * 1.7f);
+        }
+        case 5: // Strange Attractor (live Lorenz system)
+            return V(lorenz[i].x * 0.17f, (lorenz[i].z - 25.0f) * 0.17f, lorenz[i].y * 0.17f);
+        case 6: // Trefoil Knot
+            s = ((float)i / n) * TAU + t * 0.2f;
+            return V((sinf(s) + 2 * sinf(2 * s)) * 1.45f, (cosf(s) - 2 * cosf(2 * s)) * 1.45f, -sinf(3 * s) * 1.45f);
+        case 7: { // Mobius Strip: three lanes across the width
+            int per = n / 3;
+            float v = ((i % 3) - 1) * 1.15f;
+            s = ((float)(i / 3) / per) * TAU + t * 0.28f;
+            float R = 3.6f + v * cosf(s / 2);
+            return V(R * cosf(s), v * sinf(s / 2), R * sinf(s));
+        }
+        case 8: { // Klein Bottle: 7 x 4 grid sliding through the neck
+            int per = n / 4;
+            float uu = ((float)(i / 4) / per) * PI + t * 0.12f;
+            int wraps = (int)floorf(uu / PI);
+            float v = ((float)(i % 4) / 4.0f) * TAU + t * 0.5f;
+            if (wraps & 1)
+                v = PI - v;
+            return klein(uu - wraps * PI, v);
+        }
+        case 9: { // Golden Spiral
+            float k = (float)i / (n - 1);
+            a = k * 3.0f * PI;
+            float r = 0.24f * expf((logf(PHI) / (PI / 2)) * a) * (1.0f + 0.06f * sinf(t * 1.1f));
+            float rot = a + t * 0.25f;
+            return V(cosf(rot) * r, (k - 0.5f) * 1.2f, sinf(rot) * r);
+        }
+        case 10: // Lissajous
+            s = ((float)i / n) * TAU + t * 0.25f;
+            return V(4.2f * sinf(3 * s + PI / 2), 2.6f * sinf(2 * s), 2.4f * sinf(5 * s));
+        default: { // Seven-Point Star {7/3}
+            float p = fmodf((float)i / n + t * 0.03f, 1.0f) * 7.0f;
+            int seg = (int)p;
+            float f2 = p - seg, r = 4.0f * (1.0f + 0.1f * sinf(t * 1.2f));
+            float a0 = (STAR[seg % 7] / 7.0f) * TAU + t * 0.12f - PI / 2, a1 = (STAR[(seg + 1) % 7] / 7.0f) * TAU + t * 0.12f - PI / 2;
+            return V((cosf(a0) + (cosf(a1) - cosf(a0)) * f2) * r, (sinf(a0) + (sinf(a1) - sinf(a0)) * f2) * r, 0);
+        }
+    }
+}
+
+// Formation frame to world: tilt toward the camera, then spin
+static v3 toWorld(int f, v3 p, float t)
+{
+    float tl = formations[f].tilt, sp = formations[f].spin * t;
+    if (tl != 0.0f)
+        p = V(p.x, p.y * cosf(tl) - p.z * sinf(tl), p.y * sinf(tl) + p.z * cosf(tl));
+    if (sp != 0.0f)
+        p = V(p.x * cosf(sp) + p.z * sinf(sp), p.y, -p.x * sinf(sp) + p.z * cosf(sp));
+    return p;
+}
+
+// Additive glow: a fan bright in the centre, clear at the rim
+static void glow(float x, float y, float r, int cr, int cg, int cb, int ca)
+{
+    int k;
+    const int seg = 10;
+    u64 centre = RGBA(cr, cg, cb, ca), rimC = RGBA(cr, cg, cb, 0);
+    float px = x + r, py = y;
+    for (k = 1; k <= seg; k++) {
+        float ang = TAU * k / seg;
+        float nx = x + cosf(ang) * r, ny = y + sinf(ang) * r * 0.9f;
+        rmDrawTriGouraud(x, y, centre, px, py, rimC, nx, ny, rimC);
+        px = nx;
+        py = ny;
+    }
+}
+
+// ---- Guide lines: each formation's outline, as in the web theme ----
+// Drawn on (with a bright flash) when the Memory Files tab opens and each time a formation snaps
+// into place, held a moment, then faded back to just the orbs. Hidden while a formation morphs.
+
+#define GUIDE_REVEAL_S 0.7f
+#define GUIDE_HOLD_S   1.9f
+#define GUIDE_FADE_S   1.2f
+#define LPATH_N        320
+
+static v3 lorenzPath[LPATH_N];
+static int lorenzPathCount = 0;
+static int icoEdges[30][2];
+static int icoEdgeCount = 0;
+
+static void guidesInit(void)
+{
+    int i, j, k;
+    // the attractor's long-run path (the web theme's LORENZ_PATH, thinned for the EE)
+    v3 p = {0.1f, 0.0f, 0.0f};
+    for (k = 0; k < 9000 && lorenzPathCount < LPATH_N; k++) {
+        const float h = 0.004f;
+        float dx = 10.0f * (p.y - p.x), dy = p.x * (28.0f - p.z) - p.y, dz = p.x * p.y - (8.0f / 3.0f) * p.z;
+        p.x += dx * h;
+        p.y += dy * h;
+        p.z += dz * h;
+        if (k > 600 && k % 27 == 0)
+            lorenzPath[lorenzPathCount++] = V(p.x * 0.17f, (p.z - 25.0f) * 0.17f, p.y * 0.17f);
+    }
+    // the icosahedron's 30 edges: vertex pairs at distance 2 on the (0, +-1, +-PHI) layout
+    static const float ico[12][3] = {{0, -1, -PHI}, {0, -1, PHI}, {0, 1, -PHI}, {0, 1, PHI}, {-1, -PHI, 0}, {-1, PHI, 0},
+                                     {1, -PHI, 0}, {1, PHI, 0}, {-PHI, 0, -1}, {-PHI, 0, 1}, {PHI, 0, -1}, {PHI, 0, 1}};
+    for (i = 0; i < 12; i++)
+        for (j = i + 1; j < 12; j++) {
+            float dx = ico[i][0] - ico[j][0], dy = ico[i][1] - ico[j][1], dz = ico[i][2] - ico[j][2];
+            if (fabsf(dx * dx + dy * dy + dz * dz - 4.0f) < 1e-3f && icoEdgeCount < 30) {
+                icoEdges[icoEdgeCount][0] = i;
+                icoEdges[icoEdgeCount][1] = j;
+                icoEdgeCount++;
+            }
+        }
+}
+
+static v3 borromeanPt(int ring, float s)
+{
+    float a = 3.2f * cosf(s), b = 1.6f * sinf(s);
+    return ring == 0 ? V(a, b, 0) : ring == 1 ? V(0, a, b) : V(b, 0, a);
+}
+
+static v3 helixPt(float k, int strand, float t)
+{
+    float s = k * TAU * 1.4f + t * 0.8f + strand * PI;
+    return V((k - 0.5f) * 8.5f, cosf(s) * 1.7f, sinf(s) * 1.7f);
+}
+
+static v3 mobiusPt(float s, float v)
+{
+    float R = 3.6f + v * cosf(s / 2);
+    return V(R * cosf(s), v * sinf(s / 2), R * sinf(s));
+}
+
+// A point on curve k of formation f at parameter u in [0, 1] (formation frame)
+static v3 guidePt(int f, int k, float u, float t)
+{
+    switch (f) {
+        case 0: // Browser Orbit: each orb's own tilted orbit
+            return menuOrbit(k, u * TAU, t);
+        case 1:
+            return borromeanPt(k, u * TAU);
+        case 2:
+            if (k == 0) { // the knot the orbs ride
+                float uu = u * TAU + t * 0.3f, v = u * TAU * 4.0f + t * 1.1f;
+                return V((3.3f + 1.25f * cosf(v)) * cosf(uu), 1.25f * sinf(v), (3.3f + 1.25f * cosf(v)) * sinf(uu));
+            } else { // the donut's rims: inner, outer, top, bottom
+                static const float rad[4] = {2.05f, 4.55f, 3.3f, 3.3f}, y[4] = {0.0f, 0.0f, 1.25f, -1.25f};
+                return V(cosf(u * TAU) * rad[k - 1], y[k - 1], sinf(u * TAU) * rad[k - 1]);
+            }
+        case 4:
+            return helixPt(u, k, t);
+        case 5: {
+            int idx = (int)(u * (lorenzPathCount - 1) + 0.5f);
+            return lorenzPath[idx];
+        }
+        case 6: {
+            float s = u * TAU + t * 0.2f;
+            return V((sinf(s) + 2 * sinf(2 * s)) * 1.45f, (cosf(s) - 2 * cosf(2 * s)) * 1.45f, -sinf(3 * s) * 1.45f);
+        }
+        case 7: // Mobius: the single edge, twice round
+            return mobiusPt(u * 2.0f * TAU, 1.15f);
+        case 8: // Klein: rings along the bottle, then the two profile lines
+            if (k < 10)
+                return klein(((k + 0.5f) / 10.0f) * PI, u * TAU);
+            return klein(u * PI, k == 10 ? 0.0f : PI);
+        case 9: {
+            float a = u * 3.0f * PI;
+            float r = 0.24f * expf((logf(PHI) / (PI / 2)) * a) * (1.0f + 0.06f * sinf(t * 1.1f));
+            float rot = a + t * 0.25f;
+            return V(cosf(rot) * r, (u - 0.5f) * 1.2f, sinf(rot) * r);
+        }
+        default: { // 10 Lissajous
+            float s = u * TAU + t * 0.25f;
+            return V(4.2f * sinf(3 * s + PI / 2), 2.6f * sinf(2 * s), 2.4f * sinf(5 * s));
+        }
+    }
+}
+
+// ---- the right stick spins the formation: speed ramps up while held and slides to a stop ----
+#define SPIN_MAX_SPEED 2.4f // rad/s at full tilt
+#define SPIN_RAMP      3.2f // how fast the spin catches the stick (1/s)
+#define SPIN_SLIDE     1.5f // how fast a released spin slows (1/s)
+#define SPIN_PITCH_MAX 1.1f // keep the formation from tipping over
+
+static float spinYaw = 0.0f, spinPitch = 0.0f, spinYawVel = 0.0f, spinPitchVel = 0.0f;
+
+static void spinUpdate(float dt)
+{
+    int sx, sy;
+    padGetRightStick(&sx, &sy);
+    if (sx != 0 || sy != 0) {
+        float k = fminf(1.0f, dt * SPIN_RAMP);
+        spinYawVel += ((sx / 128.0f) * SPIN_MAX_SPEED - spinYawVel) * k;
+        spinPitchVel += ((sy / 128.0f) * SPIN_MAX_SPEED * 0.6f - spinPitchVel) * k;
+    } else {
+        float k = expf(-dt * SPIN_SLIDE);
+        spinYawVel *= k;
+        spinPitchVel *= k;
+    }
+    spinYaw = fmodf(spinYaw + spinYawVel * dt, TAU);
+    spinPitch += spinPitchVel * dt;
+    if (spinPitch > SPIN_PITCH_MAX || spinPitch < -SPIN_PITCH_MAX) {
+        spinPitch = spinPitch > 0.0f ? SPIN_PITCH_MAX : -SPIN_PITCH_MAX;
+        spinPitchVel = 0.0f;
+    }
+}
+
+static v3 spin(v3 p)
+{
+    float cy = cosf(spinYaw), sy = sinf(spinYaw), cp = cosf(spinPitch), sp = sinf(spinPitch);
+    v3 q = V(p.x * cy + p.z * sy, p.y, -p.x * sy + p.z * cy);
+    return V(q.x, q.y * cp - q.z * sp, q.y * sp + q.z * cp);
+}
+
+static void guideLine(int f, v3 a, v3 b, float t, u64 col)
+{
+    p2 pa = project(spin(toWorld(f, a, t))), pb = project(spin(toWorld(f, b, t)));
+    if (pa.ok && pb.ok)
+        rmDrawLine((int)pa.x, (int)pa.y, (int)pb.x, (int)pb.y, col);
+}
+
+// A sampled curve, drawn on up to `reveal` of its length
+static void guideCurve(int f, int k, int samples, int closed, float t, float reveal, u64 col)
+{
+    int segs = closed ? samples : samples - 1, s;
+    int shown = (int)(segs * reveal + 0.5f);
+    float den = (float)(closed ? samples : samples - 1);
+    v3 prev = guidePt(f, k, 0.0f, t);
+    for (s = 1; s <= shown; s++) {
+        v3 cur = guidePt(f, k, (float)s / den, t);
+        guideLine(f, prev, cur, t, col);
+        prev = cur;
+    }
+}
+
+static void drawGuides(int f, float t, float reveal, u64 col)
+{
+    int k, n;
+    switch (f) {
+        case 0:
+            for (k = 0; k < 7; k++)
+                guideCurve(f, k, 48, 1, t, reveal, col);
+            break;
+        case 1:
+            for (k = 0; k < 3; k++)
+                guideCurve(f, k, 64, 1, t, reveal, col);
+            break;
+        case 2:
+            guideCurve(f, 0, 120, 1, t, reveal, col);
+            for (k = 1; k <= 4; k++)
+                guideCurve(f, k, 48, 1, t, reveal, col);
+            break;
+        case 3: // icosahedron edges between the live (tumbling) vertices
+            n = (int)(icoEdgeCount * reveal + 0.5f);
+            for (k = 0; k < n; k++)
+                guideLine(f, formationAt(3, icoEdges[k][0], 12, t), formationAt(3, icoEdges[k][1], 12, t), t, col);
+            break;
+        case 4:
+            guideCurve(f, 0, 64, 0, t, reveal, col);
+            guideCurve(f, 1, 64, 0, t, reveal, col);
+            n = (int)(10 * reveal + 0.5f);
+            for (k = 0; k < n; k++)
+                guideLine(f, helixPt(k / 9.0f, 0, t), helixPt(k / 9.0f, 1, t), t, col);
+            break;
+        case 5:
+            guideCurve(f, 0, lorenzPathCount, 0, t, reveal, col);
+            break;
+        case 7:
+            guideCurve(f, 0, 160, 1, t, reveal, col);
+            n = (int)(14 * reveal + 0.5f);
+            for (k = 0; k < n; k++)
+                guideLine(f, mobiusPt((k / 14.0f) * TAU, -1.15f), mobiusPt((k / 14.0f) * TAU, 1.15f), t, col);
+            break;
+        case 8:
+            for (k = 0; k < 10; k++)
+                guideCurve(f, k, 28, 1, t, reveal, col);
+            guideCurve(f, 10, 64, 0, t, reveal, col);
+            guideCurve(f, 11, 64, 0, t, reveal, col);
+            break;
+        case 9:
+            guideCurve(f, 0, 120, 0, t, reveal, col);
+            break;
+        case 11: { // the {7/3} star the orbs glide along
+            float r = 4.0f * (1.0f + 0.1f * sinf(t * 1.2f));
+            n = (int)(7 * reveal + 0.5f);
+            for (k = 0; k < n; k++) {
+                float a0 = (STAR[k] / 7.0f) * TAU + t * 0.12f - PI / 2, a1 = (STAR[(k + 1) % 7] / 7.0f) * TAU + t * 0.12f - PI / 2;
+                guideLine(f, V(cosf(a0) * r, sinf(a0) * r, 0), V(cosf(a1) * r, sinf(a1) * r, 0), t, col);
+            }
+            break;
+        }
+        default: // 6 Trefoil, 10 Lissajous
+            guideCurve(f, 0, f == 6 ? 120 : 180, 1, t, reveal, col);
+            break;
+    }
+}
+
+// ---- Tails: a short comet ribbon behind each orb, from its recent positions ----
+#define TRAIL_N  12    // samples kept per orb
+#define TRAIL_HZ 30.0f // sampled at a fixed rate, so tails look the same at 50 or 60 fps
+// RIPPS2: how far R2 has the orbs boosted, 0..1. The tails answer it: they reach further back (a
+// longer sample step), widen a little and glow brighter, so the speed reads in the comets.
+static float trailBoost = 0.0f;
+#define TRAIL_BOOST_REACH 0.5f  // +50% history at full boost (on top of twice the speed)
+#define TRAIL_BOOST_GLOW  0.7f  // +70% brightness
+#define TRAIL_BOOST_WIDTH 0.3f  // +30% width
+
+static v3 trail[MAX_ORBS][TRAIL_N];
+static int trailHead = 0, trailValid = 0;
+static float trailLastSample = -1.0f;
+
+static void drawTail(int i, p2 head, float r, float vis)
+{
+    int k;
+    p2 prev = head;
+    float width = r * 0.45f * (1.0f + TRAIL_BOOST_WIDTH * trailBoost), glowUp = 1.0f + TRAIL_BOOST_GLOW * trailBoost;
+    float prevW = width;
+    for (k = 0; k < TRAIL_N; k++) {
+        p2 p = project(trail[i][(trailHead - k + TRAIL_N) % TRAIL_N]);
+        if (!p.ok || !prev.ok)
+            break;
+        float dx = p.x - prev.x, dy = p.y - prev.y, len = sqrtf(dx * dx + dy * dy);
+        float fall = 1.0f - (float)(k + 1) / TRAIL_N;
+        float w = width * fall;
+        if (len > 0.5f) { // a still orb has no tail
+            float nx = -dy / len, ny = dx / len;
+            int a0 = (int)(0x30 * glowUp * powf(fall + 1.0f / TRAIL_N, 1.8f) * vis), a1 = (int)(0x30 * glowUp * powf(fall, 1.8f) * vis);
+            u64 c0 = RGBA(0x6F, 0x9C, 0xFF, a0), c1 = RGBA(0x6F, 0x9C, 0xFF, a1);
+            rmDrawQuadGouraud(prev.x + nx * prevW, prev.y + ny * prevW, c0, prev.x - nx * prevW, prev.y - ny * prevW, c0,
+                              p.x + nx * w, p.y + ny * w, c1, p.x - nx * w, p.y - ny * w, c1);
+        }
+        prev = p;
+        prevW = w;
+    }
+}
+
+static int shownFormation = -1, prevFormation = 0;
+static float morphStart = -10.0f, lastT = 0.0f;
+static float guideStart = -1.0f;
+static int morphing = 0;
+
+// Memory Files on the triggers: R2 held builds the orbs up, gently at first and then taking off,
+// to twice their speed after a few seconds; let go and they glide back down. They run on their own
+// clock, so nothing jumps, and a formation change mid-boost carries the speed into the next shape.
+// L2 held brings their paths up and lets them fade when released.
+#define ORB_BOOST_MAX     2.0f // 200%
+#define ORB_BUILD_S       4.0f // held this long to reach it
+#define ORB_GLIDE_S       2.5f // let go: this long to glide back to normal
+#define PATHS_IN_S        0.2f
+#define PATHS_OUT_S       0.4f
+static float orbClock = 0.0f, orbSpeed = 1.0f, orbBuild = 0.0f, pathsLevel = 0.0f;
+static int orbBoostHeld = 0, orbPathsHeld = 0;
+
+void ripps2SetOrbInput(int showPaths, int boost)
+{
+    orbPathsHeld = showPaths;
+    orbBoostHeld = boost;
+}
+
+void ripps2DrawOrbs(void)
+{
+    int i, k;
+    float t = nowSeconds();
+    float dt = lastT > 0.0f ? t - lastT : 1.0f;
+    lastT = t;
+
+    if (lorenzPathCount == 0)
+        guidesInit();
+    if (!skyReady)
+        skyInit();
+
+    float step = fminf(dt, 0.1f);
+    if (orbBoostHeld)
+        orbBuild = fminf(1.0f, orbBuild + step / ORB_BUILD_S);
+    else
+        orbBuild = fmaxf(0.0f, orbBuild - step / ORB_GLIDE_S);
+    float build = orbBuild * orbBuild * (3.0f - 2.0f * orbBuild); // eases in and settles at either end
+    orbSpeed = 1.0f + (ORB_BOOST_MAX - 1.0f) * build;
+    orbClock += step * orbSpeed;
+    trailBoost = build;
+    float ot = orbClock; // where the orbs are along their paths
+    pathsLevel = orbPathsHeld ? fminf(1.0f, pathsLevel + step / PATHS_IN_S) : fmaxf(0.0f, pathsLevel - step / PATHS_OUT_S);
+
+    lorenzStep(fminf(dt, 0.05f) * orbSpeed);
+    spinUpdate(fminf(dt, 0.1f));
+
+    int f = gRipps2Formation % FORMATIONS;
+    if (shownFormation < 0)
+        shownFormation = prevFormation = f;
+    if (dt > 0.25f) { // the tab was just opened: fresh tails, and show the outline
+        trailValid = 0;
+        guideStart = t;
+    }
+    if (f != shownFormation) { // morph from wherever the orbs are
+        prevFormation = shownFormation;
+        shownFormation = f;
+        morphStart = t;
+        morphing = 1;
+    }
+    float m = fminf(1.0f, (t - morphStart) / 2.0f);
+    float e = m < 0.5f ? 4 * m * m * m : 1 - powf(-2 * m + 2, 3) / 2;
+    if (morphing && m >= 1.0f) { // snapped into the new formation: show its outline
+        morphing = 0;
+        guideStart = t;
+    }
+
+    drawSky(RGBA(0x01, 0x02, 0x0A, 0x80), RGBA(0x08, 0x16, 0x46, 0x80), RGBA(0x01, 0x02, 0x08, 0x80));
+
+    float sway = sinf(t * 0.07f) * 0.3f;
+    v3 eye = {sinf(sway) * 15.0f, 1.5f + sinf(t * 0.13f) * 0.8f, cosf(sway) * 15.0f};
+    v3 target = {0.0f, -0.7f, 0.0f};
+    camLook(eye, target, 42.0f);
+
+    // the Storage sky's stars and drifting motes, behind the formation
+    drawStars(t, sway, 0.0f);
+    drawMotes(t, 0);
+    drawMotes(t, 1);
+
+    rmSetBlendAdditive(1);
+    glow(320, 230, 260, 0x12, 0x35, 0x7F, 0x30); // soft haze behind the formation
+
+    // outline: draw on, flash, hold, fade (never mid-morph)
+    rmSetLineAA(1);
+    if (!morphing) {
+        int a = 0;
+        float reveal = 1.0f;
+        if (guideStart >= 0.0f) {
+            float age = t - guideStart;
+            float level = age < GUIDE_HOLD_S ? 1.0f : fmaxf(0.0f, 1.0f - (age - GUIDE_HOLD_S) / GUIDE_FADE_S);
+            if (level <= 0.0f)
+                guideStart = -1.0f;
+            else {
+                float flash = expf(-age * 3.0f);
+                a = (int)((0x22 + 0x44 * flash) * level);
+                reveal = clamp01(age / GUIDE_REVEAL_S);
+            }
+        }
+        int held = (int)(0x40 * pathsLevel); // L2: the whole path, steady
+        if (held > a) {
+            a = held;
+            reveal = 1.0f;
+        }
+        if (a > 0)
+            drawGuides(f, ot, reveal, RGBA(0x51, 0x8E, 0xEB, a));
+    }
+    rmSetLineAA(0);
+
+    int n = formations[f].n, pn = formations[prevFormation].n;
+    int count = (e < 1.0f && pn > n) ? pn : n;
+    if (count > MAX_ORBS)
+        count = MAX_ORBS;
+    float sizeCur = fmaxf(0.55f, sqrtf(7.0f / n)), sizePrev = fmaxf(0.55f, sqrtf(7.0f / pn));
+    float size = sizePrev + (sizeCur - sizePrev) * e;
+
+    v3 pos[MAX_ORBS];
+    float vis[MAX_ORBS];
+    for (i = 0; i < count; i++) {
+        v3 a = toWorld(f, formationAt(f, i % n, n, ot), ot);
+        vis[i] = i < n ? 1.0f : 0.0f;
+        if (e < 1.0f) { // split off / merge back, arcing outward mid-flight
+            v3 b = toWorld(prevFormation, formationAt(prevFormation, i % pn, pn, ot), ot);
+            float arc = 1.0f + sinf(e * PI) * 0.3f;
+            a = V((b.x + (a.x - b.x) * e) * arc, (b.y + (a.y - b.y) * e) * arc, (b.z + (a.z - b.z) * e) * arc);
+            vis[i] = (i < pn ? 1.0f : 0.0f) + (vis[i] - (i < pn ? 1.0f : 0.0f)) * e;
+        }
+        pos[i] = spin(a);
+    }
+
+    // tails first, so the orbs sit on their heads
+    if (!trailValid || t - trailLastSample >= (1.0f + TRAIL_BOOST_REACH * trailBoost) / TRAIL_HZ) {
+        if (!trailValid) {
+            for (i = 0; i < MAX_ORBS; i++)
+                for (k = 0; k < TRAIL_N; k++)
+                    trail[i][k] = i < count ? pos[i] : V(0, 0, 0);
+            trailValid = 1;
+        } else {
+            trailHead = (trailHead + 1) % TRAIL_N;
+            for (i = 0; i < count; i++)
+                trail[i][trailHead] = pos[i];
+        }
+        trailLastSample = t;
+    }
+
+    for (i = 0; i < count; i++) {
+        if (vis[i] <= 0.01f)
+            continue;
+        p2 p = project(pos[i]);
+        if (!p.ok)
+            continue;
+        float depthDim = fminf(1.0f, fmaxf(0.45f, 1.0f - (p.z - 12.0f) / 9.0f)) * vis[i];
+        float r = 14.0f * 15.0f / p.z * size;
+        drawTail(i, p, r, depthDim);
+        glow(p.x, p.y, r, 0x64, 0x96, 0xFF, (int)(0x40 * depthDim));
+        glow(p.x, p.y, r * 0.3f, 0xEB, 0xF2, 0xFF, (int)(0x80 * depthDim));
+    }
+    rmSetBlendAdditive(0);
+}
+
+// ---------------------------------------------------------------- entry + perf HUD
+
+#if RIPPS2_PERF_HUD
+static float bgMsAvg = 0.0f;
+static int fpsFrames = 0, fpsShown = 0;
+static float fpsWindow = 0.0f;
+#endif
+
+// The top and bottom of the screen darken like the mockups, so the category bar and the hints read
+// cleanly over whatever moves behind them
+static void drawVignette(void)
+{
+    u64 dark = RGBA(0x00, 0x02, 0x0A, 0x68), clear = RGBA(0x00, 0x02, 0x0A, 0x00);
+    rmDrawQuadGouraud(0, 0, dark, 640, 0, dark, 0, 96, clear, 640, 96, clear);
+    rmDrawQuadGouraud(0, 372, clear, 640, 372, clear, 0, 480, dark, 640, 480, dark);
+}
+
+void ripps2DrawBackground(void)
+{
+#if RIPPS2_PERF_HUD
+    unsigned int t0 = cpuTicks();
+#endif
+    if (gRipps2Category == RIPPS2_CAT_MEMORY)
+        ripps2DrawOrbs();
+    else
+        ripps2DrawPillars();
+    drawVignette();
+
+#if RIPPS2_PERF_HUD
+    float ms = (float)(cpuTicks() - t0) / 294912.0f;
+    bgMsAvg = bgMsAvg * 0.9f + ms * 0.1f;
+    float t = nowSeconds();
+    fpsFrames++;
+    if (t - fpsWindow >= 1.0f) {
+        fpsShown = (int)(fpsFrames / (t - fpsWindow) + 0.5f);
+        fpsFrames = 0;
+        fpsWindow = t;
+    }
+    char hud[32];
+    int tenths = (int)(bgMsAvg * 10.0f + 0.5f); // integer formatting: no float printf needed
+    snprintf(hud, sizeof(hud), "BG %d.%dMS %dFPS", tenths / 10, tenths % 10, fpsShown);
+    int w = fntCalcDimensions(gTheme->fonts[3], hud);
+    fntRenderString(gTheme->fonts[3], 628 - w, 472, ALIGN_VCENTER, 0, 0, hud, GS_SETREG_RGBA(0x3D, 0x46, 0x5D, 0x80));
+#endif
+}
diff --git a/src/ripps2edit.c b/src/ripps2edit.c
new file mode 100644
index 0000000..ae30a45
--- /dev/null
+++ b/src/ripps2edit.c
@@ -0,0 +1,541 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 editor: one glass page, two uses.
+
+  - The Memory Files TEXT EDITOR: a text file (CFG, TXT, CNF, INI...) line by line. Cross edits the
+    line on the keyboard; Triangle has insert, delete, save and close.
+  - Storage's SET METADATA: a game's details as a form (title, description, genre, developer,
+    publisher, release, and the badge values). What the game's own CFG says is shown bright; what
+    the metadata database fills in is shown dim. Cross edits a text field on the keyboard, Left /
+    Right step a badge field through its values, Square clears a field back to the database's.
+    Saving writes the game's CFG/<GAMEID>.cfg, so the user's words win from then on.
+
+  Both type on the same keyboard (diaShowKeyb), which also takes a USB keyboard.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/dia.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/pad.h"
+#include "include/sound.h"
+#include "include/config.h"
+#include "include/ripps2.h"
+
+#define ED_MAX_LINES 1000
+#define ED_LINE      256
+#define ED_FILE_MAX  (64 * 1024)
+#define ED_ROWS      16
+#define ED_ROW_H     22
+#define ED_LIST_Y    60
+#define ED_X         30
+#define ED_RIGHT     610
+
+#define ED_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define ED_DIM  GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+#define ED_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define ED_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+
+// ---- shared drawing ----
+
+static void edHint(int icon, const char *text, int *x, int y)
+{
+    GSTEXTURE *t = thmGetTexture(icon);
+    if (t != NULL) {
+        rmDrawPixmap(t, *x, y - 10, ALIGN_NONE, 20, 20, SCALING_RATIO, ED_LIT, 0);
+        *x += 24;
+    }
+    fntRenderString(gTheme->fonts[4], *x, y, ALIGN_VCENTER, 0, 0, text, ED_SOFT);
+    *x += fntCalcDimensions(gTheme->fonts[4], text) + 18;
+}
+
+static void edHighlight(int y)
+{
+    rmDrawRect(ED_X - 6, y - 1, ED_RIGHT - ED_X + 12, ED_ROW_H - 2, ED_PRIM(0x1E, 0x3C, 0x96, 0x58));
+    rmDrawRect(ED_X - 6, y - 1, 3, ED_ROW_H - 2, ED_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+}
+
+static void edFrameStart(const char *title, const char *right)
+{
+    guiDrawBGPlasma(); // the moving background and the glass page panel
+    fntRenderString(gTheme->fonts[4], ED_X, 30, ALIGN_VCENTER, 0, 0, title, ED_LIT);
+    if (right != NULL && right[0])
+        fntRenderString(gTheme->fonts[4], ED_RIGHT - fntCalcDimensions(gTheme->fonts[4], right), 30, ALIGN_VCENTER, 0, 0, right, ED_SOFT);
+    rmDrawLine(ED_X, 46, ED_RIGHT, 46, ED_PRIM(0x4A, 0x72, 0xDC, 0x60));
+}
+
+// The page a menu opens over (the editor, SET METADATA); NULL = the bare background
+static void (*edBehind)(void) = NULL;
+
+static int edMenu(const char *const *items, int count)
+{
+    // a small glass list over the page, which stays in view behind it, dimmed; returns the choice or -1
+    int sel = 0, i;
+    while (1) {
+        readPads();
+        rmStartFrame();
+        if (edBehind != NULL) {
+            edBehind();
+            rmDrawRect(0, 0, 640, 480, ED_PRIM(0x00, 0x02, 0x0A, 0x50));
+        } else
+            guiDrawBGPlasma();
+        int w = 220, h = count * 24 + 20, x = 400, y = 120;
+        rmDrawRect(x, y, w, h, ED_PRIM(0x03, 0x08, 0x22, 0x70));
+        rmDrawLine(x, y, x + w, y, ED_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        rmDrawLine(x, y + h, x + w, y + h, ED_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        rmDrawLine(x, y, x, y + h, ED_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        rmDrawLine(x + w, y, x + w, y + h, ED_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        for (i = 0; i < count; i++) {
+            int ry = y + 10 + i * 24;
+            if (i == sel)
+                rmDrawRect(x + 4, ry, w - 8, 22, ED_PRIM(0x1E, 0x3C, 0x96, 0x60));
+            fntRenderString(gTheme->fonts[4], x + 16, ry + 11, ALIGN_VCENTER, 0, 0, items[i], i == sel ? ED_LIT : ED_SOFT);
+        }
+        rmEndFrame();
+        if (getKey(KEY_UP) && sel > 0) {
+            sel--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && sel < count - 1) {
+            sel++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(gSelectButton)) {
+            sfxPlay(SFX_CONFIRM);
+            return sel;
+        } else if (getKeyOn(gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE) || getKeyOn(KEY_TRIANGLE)) {
+            sfxPlay(SFX_CANCEL);
+            return -1;
+        }
+    }
+}
+
+// A list to pick from (installers and the like): the choice, or -1
+int ripps2PickList(const char *const *items, int count)
+{
+    return edMenu(items, count);
+}
+
+// ---- the text editor ----
+
+static char *edLines[ED_MAX_LINES];
+static int edCount = 0;
+
+static void edFree(void)
+{
+    int i;
+    for (i = 0; i < edCount; i++)
+        free(edLines[i]);
+    edCount = 0;
+}
+
+static int edInsert(int at, const char *text)
+{
+    if (edCount >= ED_MAX_LINES)
+        return 0;
+    char *line = malloc(ED_LINE);
+    if (line == NULL)
+        return 0;
+    snprintf(line, ED_LINE, "%s", text);
+    memmove(&edLines[at + 1], &edLines[at], (edCount - at) * sizeof(char *));
+    edLines[at] = line;
+    edCount++;
+    return 1;
+}
+
+static void edDelete(int at)
+{
+    if (at < 0 || at >= edCount)
+        return;
+    free(edLines[at]);
+    memmove(&edLines[at], &edLines[at + 1], (edCount - at - 1) * sizeof(char *));
+    edCount--;
+}
+
+// 1 = loaded (a missing file is an empty one), 0 = too big or unreadable
+static int edLoad(const char *path, int *crlf)
+{
+    int fd = open(path, O_RDONLY), n;
+    char *buf, *p, *e;
+
+    edFree();
+    *crlf = 0;
+    if (fd < 0)
+        return edInsert(0, "");
+    n = lseek(fd, 0, SEEK_END);
+    lseek(fd, 0, SEEK_SET);
+    if (n < 0 || n > ED_FILE_MAX) {
+        close(fd);
+        return 0;
+    }
+    buf = malloc(n + 1);
+    if (buf == NULL) {
+        close(fd);
+        return 0;
+    }
+    n = read(fd, buf, n);
+    close(fd);
+    if (n < 0) {
+        free(buf);
+        return 0;
+    }
+    buf[n] = '\0';
+    for (p = buf; *p && edCount < ED_MAX_LINES; p = e) {
+        e = strchr(p, '\n');
+        if (e != NULL)
+            *e++ = '\0';
+        else
+            e = p + strlen(p);
+        int l = strlen(p);
+        if (l > 0 && p[l - 1] == '\r') {
+            p[l - 1] = '\0';
+            *crlf = 1;
+        }
+        edInsert(edCount, p);
+    }
+    free(buf);
+    if (edCount == 0)
+        edInsert(0, "");
+    return 1;
+}
+
+static int edSave(const char *path, int crlf)
+{
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666), i, ok = 1;
+    if (fd < 0)
+        return 0;
+    for (i = 0; i < edCount && ok; i++) {
+        int l = strlen(edLines[i]);
+        if (write(fd, edLines[i], l) != l)
+            ok = 0;
+        else if (i < edCount - 1 || l > 0) {
+            if (write(fd, crlf ? "\r\n" : "\n", crlf ? 2 : 1) != (crlf ? 2 : 1))
+                ok = 0;
+        }
+    }
+    close(fd);
+    return ok;
+}
+
+static struct
+{
+    const char *path;
+    int cursor, top, modified;
+    const char *status;
+} edView;
+
+static void edDrawFile(void)
+{
+    char line[ED_LINE];
+    int i;
+
+    snprintf(line, sizeof(line), "%s%s", edView.modified ? "* " : "", edView.path);
+    edFrameStart(line, edView.status[0] ? edView.status : "TEXT EDITOR");
+    for (i = 0; i < ED_ROWS && edView.top + i < edCount; i++) {
+        int y = ED_LIST_Y + i * ED_ROW_H, cur = edView.top + i == edView.cursor;
+        char num[8];
+        if (cur)
+            edHighlight(y);
+        snprintf(num, sizeof(num), "%d", edView.top + i + 1);
+        fntRenderString(gTheme->fonts[5], ED_X + 30 - fntCalcDimensions(gTheme->fonts[5], num), y + 9, ALIGN_VCENTER, 0, 0, num, ED_DIM);
+        fntRenderString(gTheme->fonts[8], ED_X + 42, y + 9, ALIGN_VCENTER, ED_RIGHT - ED_X - 46, 0, edLines[edView.top + i], cur ? ED_LIT : ED_SOFT);
+    }
+    int hx = 44;
+    edHint(gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, "EDIT LINE", &hx, 448);
+    edHint(TRIANGLE_ICON, "ACTIONS", &hx, 448);
+    edHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, "CLOSE", &hx, 448);
+}
+
+int ripps2EditFile(const char *path)
+{
+    static const char *const actions[] = {"INSERT LINE", "DELETE LINE", "SAVE", "SAVE AND CLOSE", "CLOSE"};
+    int cursor = 0, top = 0, modified = 0, crlf = 0, saved = 0;
+    char line[ED_LINE], status[48] = "";
+    const char *name = strrchr(path, '/');
+    name = name ? name + 1 : path;
+
+    if (!edLoad(path, &crlf)) {
+        guiMsgBox("This file is too big to edit here (64 KB at most).", 0, NULL);
+        return 0;
+    }
+    while (1) {
+        readPads();
+        if (cursor >= edCount)
+            cursor = edCount - 1;
+        if (cursor < 0)
+            cursor = 0;
+        if (cursor < top)
+            top = cursor;
+        if (cursor >= top + ED_ROWS)
+            top = cursor - ED_ROWS + 1;
+
+        edView.path = path;
+        edView.cursor = cursor;
+        edView.top = top;
+        edView.modified = modified;
+        edView.status = status;
+        rmStartFrame();
+        edDrawFile();
+        rmEndFrame();
+
+        if (getKey(KEY_UP) && cursor > 0) {
+            cursor--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && cursor < edCount - 1) {
+            cursor++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_L1)) {
+            cursor -= ED_ROWS;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_R1)) {
+            cursor += ED_ROWS;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(gSelectButton)) {
+            sfxPlay(SFX_CONFIRM);
+            snprintf(line, sizeof(line), "%s", edLines[cursor]);
+            if (diaShowKeyb(line, sizeof(line), 0, name) && strcmp(line, edLines[cursor]) != 0) {
+                snprintf(edLines[cursor], ED_LINE, "%s", line);
+                modified = 1;
+            }
+        } else if (getKeyOn(KEY_TRIANGLE)) {
+            sfxPlay(SFX_CONFIRM);
+            edBehind = edDrawFile;
+            int a = edMenu(actions, 5);
+            edBehind = NULL;
+            if (a == 0) {
+                if (edInsert(cursor + 1, "")) {
+                    cursor++;
+                    modified = 1;
+                }
+            } else if (a == 1) {
+                edDelete(cursor);
+                if (edCount == 0)
+                    edInsert(0, "");
+                modified = 1;
+            } else if (a == 2 || a == 3) {
+                if (edSave(path, crlf)) {
+                    modified = 0;
+                    saved = 1;
+                    snprintf(status, sizeof(status), "SAVED");
+                    if (a == 3)
+                        break;
+                } else
+                    snprintf(status, sizeof(status), "COULD NOT SAVE");
+            } else if (a == 4) {
+                if (!modified || guiMsgBox("Close without saving the changes?", 1, NULL))
+                    break;
+            }
+        } else if (getKeyOn(gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE)) {
+            sfxPlay(SFX_CANCEL);
+            if (!modified || guiMsgBox("Close without saving the changes?", 1, NULL))
+                break;
+        }
+    }
+    edFree();
+    readPads();
+    return saved;
+}
+
+// ---- SET METADATA ----
+
+typedef struct
+{
+    const char *key, *label;
+    const char *const *choices; // NULL = free text on the keyboard
+} ed_field_t;
+
+static const char *const vmodeChoices[] = {"vmode/ntsc", "vmode/pal", "vmode/multi", NULL};
+static const char *const aspectChoices[] = {"aspect/s", "aspect/w", "aspect/w1", "aspect/w2", NULL};
+static const char *const scanChoices[] = {"scan/480i", "scan/480p", "scan/576i", "scan/576p", "scan/720p", "scan/1080i", "scan/240p", NULL};
+static const char *const playersChoices[] = {"players/1", "players/2", "players/3", "players/4", "players/8", NULL};
+static const char *const ratingChoices[] = {"rating/0", "rating/1", "rating/2", "rating/3", "rating/4", "rating/5", NULL};
+
+static const ed_field_t mdFields[] = {
+    {"Title", "TITLE", NULL},
+    {"Description", "DESCRIPTION", NULL},
+    {"Genre", "GENRE", NULL},
+    {"Developer", "DEVELOPER", NULL},
+    {"Publisher", "PUBLISHER", NULL},
+    {"Release", "RELEASE", NULL},
+    {"Players", "PLAYERS", playersChoices},
+    {"Vmode", "VIDEO", vmodeChoices},
+    {"Aspect", "ASPECT", aspectChoices},
+    {"Scan", "SCAN", scanChoices},
+    {"Rating", "RATING", ratingChoices},
+};
+#define MD_COUNT ((int)(sizeof(mdFields) / sizeof(mdFields[0])))
+
+// A badge value shown plainly: "vmode/ntsc" -> "NTSC"
+static void mdPretty(const char *v, char *out, int size)
+{
+    const char *s = strchr(v, '/');
+    int i;
+    snprintf(out, size, "%s", s ? s + 1 : v);
+    for (i = 0; out[i]; i++)
+        if (out[i] >= 'a' && out[i] <= 'z')
+            out[i] -= 32;
+}
+
+static struct
+{
+    char (*user)[CONFIG_KEY_VALUE_LEN];
+    char (*db)[CONFIG_KEY_VALUE_LEN];
+    const char *title;
+    int cursor, top, modified;
+} mdView;
+
+static void mdDraw(void)
+{
+    char shown[CONFIG_KEY_VALUE_LEN];
+    int i;
+
+    edFrameStart(mdView.title, mdView.modified ? "NOT SAVED" : "");
+    for (i = 0; i < ED_ROWS && mdView.top + i < MD_COUNT; i++) {
+        int f = mdView.top + i, y = ED_LIST_Y + i * 34, cur = f == mdView.cursor;
+        const char *v = mdView.user[f][0] ? mdView.user[f] : mdView.db[f];
+        if (cur) {
+            rmDrawRect(ED_X - 6, y - 1, ED_RIGHT - ED_X + 12, 32, ED_PRIM(0x1E, 0x3C, 0x96, 0x58));
+            rmDrawRect(ED_X - 6, y - 1, 3, 32, ED_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+        }
+        fntRenderString(gTheme->fonts[4], ED_X + 4, y + 8, ALIGN_VCENTER, 0, 0, mdFields[f].label, cur ? ED_LIT : ED_SOFT);
+        if (mdFields[f].choices && v[0])
+            mdPretty(v, shown, sizeof(shown));
+        else
+            snprintf(shown, sizeof(shown), "%s", v[0] ? v : "-");
+        // bright: the user's own value; dim: what the metadata database says
+        fntRenderString(gTheme->fonts[10], ED_X + 4, y + 22, ALIGN_VCENTER, ED_RIGHT - ED_X - 120, 0, shown, mdView.user[f][0] ? ED_LIT : ED_DIM);
+        if (!mdView.user[f][0] && mdView.db[f][0])
+            fntRenderString(gTheme->fonts[5], ED_RIGHT - fntCalcDimensions(gTheme->fonts[5], "DATABASE"), y + 8, ALIGN_VCENTER, 0, 0, "DATABASE", ED_DIM);
+        else if (mdView.user[f][0])
+            fntRenderString(gTheme->fonts[5], ED_RIGHT - fntCalcDimensions(gTheme->fonts[5], "YOURS"), y + 8, ALIGN_VCENTER, 0, 0, "YOURS", ED_SOFT);
+    }
+    int hx = 44;
+    edHint(gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, mdFields[mdView.cursor].choices ? "NEXT VALUE" : "EDIT", &hx, 448);
+    edHint(SQUARE_ICON, "CLEAR", &hx, 448);
+    edHint(TRIANGLE_ICON, "ACTIONS", &hx, 448);
+    edHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, "CLOSE", &hx, 448);
+}
+
+int ripps2EditMetadata(config_set_t *config, const char *gameName)
+{
+    static const char *const actions[] = {"SAVE", "CLEAR THIS FIELD", "CLOSE"};
+    char user[MD_COUNT][CONFIG_KEY_VALUE_LEN]; // the user's own values ("" = none, the database shows)
+    char db[MD_COUNT][CONFIG_KEY_VALUE_LEN];
+    int cursor = 0, top = 0, modified = 0, i;
+    char title[128];
+
+    if (config == NULL)
+        return 0;
+    for (i = 0; i < MD_COUNT; i++) {
+        const char *v = NULL;
+        char rk[CONFIG_KEY_NAME_LEN];
+        user[i][0] = db[i][0] = '\0';
+        if (configGetStr(config, mdFields[i].key, &v) && v != NULL)
+            snprintf(user[i], sizeof(user[i]), "%s", v);
+        snprintf(rk, sizeof(rk), "#%s", mdFields[i].key);
+        v = NULL;
+        if (configGetStr(config, rk, &v) && v != NULL)
+            snprintf(db[i], sizeof(db[i]), "%s", v);
+    }
+    snprintf(title, sizeof(title), "SET METADATA: %s", gameName ? gameName : "");
+
+    while (1) {
+        readPads();
+        if (cursor < top)
+            top = cursor;
+        if (cursor >= top + ED_ROWS)
+            top = cursor - ED_ROWS + 1;
+
+        mdView.user = user;
+        mdView.db = db;
+        mdView.title = title;
+        mdView.cursor = cursor;
+        mdView.top = top;
+        mdView.modified = modified;
+        rmStartFrame();
+        mdDraw();
+        rmEndFrame();
+
+        const ed_field_t *fd = &mdFields[cursor];
+        int step = 0;
+        if (getKey(KEY_UP) && cursor > 0) {
+            cursor--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && cursor < MD_COUNT - 1) {
+            cursor++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_LEFT) && fd->choices) {
+            step = -1;
+        } else if (getKey(KEY_RIGHT) && fd->choices) {
+            step = 1;
+        } else if (getKeyOn(gSelectButton)) {
+            if (fd->choices)
+                step = 1;
+            else {
+                sfxPlay(SFX_CONFIRM);
+                char text[CONFIG_KEY_VALUE_LEN];
+                snprintf(text, sizeof(text), "%s", user[cursor][0] ? user[cursor] : db[cursor]);
+                if (diaShowKeyb(text, sizeof(text), 0, fd->label) && strcmp(text, user[cursor][0] ? user[cursor] : db[cursor]) != 0) {
+                    snprintf(user[cursor], sizeof(user[cursor]), "%s", text);
+                    modified = 1;
+                }
+            }
+        } else if (getKeyOn(KEY_SQUARE)) {
+            if (user[cursor][0]) {
+                user[cursor][0] = '\0';
+                modified = 1;
+                sfxPlay(SFX_CANCEL);
+            }
+        } else if (getKeyOn(KEY_TRIANGLE)) {
+            sfxPlay(SFX_CONFIRM);
+            edBehind = mdDraw;
+            int a = edMenu(actions, 3);
+            edBehind = NULL;
+            if (a == 0) {
+                for (i = 0; i < MD_COUNT; i++) {
+                    if (user[i][0])
+                        configSetStr(config, mdFields[i].key, user[i]);
+                    else
+                        configRemoveKey(config, mdFields[i].key);
+                }
+                readPads();
+                return 1; // the caller writes the CFG
+            } else if (a == 1) {
+                user[cursor][0] = '\0';
+                modified = 1;
+            } else if (a == 2) {
+                if (!modified || guiMsgBox("Close without saving the changes?", 1, NULL))
+                    break;
+            }
+        } else if (getKeyOn(gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE)) {
+            sfxPlay(SFX_CANCEL);
+            if (!modified || guiMsgBox("Close without saving the changes?", 1, NULL))
+                break;
+        }
+        if (step != 0) { // a badge field steps through its values (and back to none)
+            int n = 0, at = -1;
+            const char *curv = user[cursor][0] ? user[cursor] : db[cursor];
+            while (fd->choices[n] != NULL) {
+                if (!strcmp(fd->choices[n], curv))
+                    at = n;
+                n++;
+            }
+            at = at < 0 ? (step > 0 ? 0 : n - 1) : (at + step + n) % n;
+            snprintf(user[cursor], sizeof(user[cursor]), "%s", fd->choices[at]);
+            modified = 1;
+            sfxPlay(SFX_CURSOR);
+        }
+    }
+    readPads();
+    return 0;
+}
diff --git a/src/ripps2files.c b/src/ripps2files.c
new file mode 100644
index 0000000..e8022a7
--- /dev/null
+++ b/src/ripps2files.c
@@ -0,0 +1,1510 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 Memory Files browser: a file manager drawn in the RIPPS2 glass over the orbs, on RiptOPL's
+  own file I/O (open / read / opendir through the drivers RiptOPL already runs), so nothing else has
+  to boot. It works the way the classic PS2 file managers do (wLaunchELF and its forks were the
+  behaviour reference; none of their code is used): a list of drives, a folder tree, marks, copy /
+  cut / paste, delete, rename, new folder, and running an ELF.
+
+  - Memory card saves show the title from their icon.sys next to the folder name.
+  - Pasting a save folder (one with an icon.sys) onto a memory card always lands it in the card's
+    root, where the console looks for saves, wherever on the card you are.
+  - The clipboard count and what happened last (COPIED, CUT, PASTED, DELETED) sit top right.
+
+  Reading folders and copying run on the IO worker; the screen keeps animating and shows progress.
+  The list is only read by the GUI while the worker is idle (fbBusy), so it needs no lock.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <math.h>
+#include <malloc.h>
+#include <kernel.h>
+#include <errno.h>
+#include <delaythread.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/pad.h"
+#include "include/system.h"
+#include "include/ioman.h"
+#include "include/iosupport.h"
+#include "include/sound.h"
+#include "include/ripps2.h"
+#include "include/bdmsupport.h"  // bdmSlotEverConnected: only probe slots that have held a drive
+#include "include/mmcesupport.h"
+#include "include/hddsupport.h"
+
+#define FB_MAX      400 // entries in one folder
+#define FB_NAME     128
+#define FB_TITLE    48
+#define FB_ROWS     15
+#define FB_ROW_H    22
+#define FB_LIST_Y   58
+#define FB_X        30
+#define FB_RIGHT    610
+#define FB_CLIP_MAX 64
+#define FB_BUF_SIZE (128 * 1024)
+
+#define FB_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define FB_DIM  GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+#define FB_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define FB_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+
+enum { FB_KIND_DEVICE = 0, FB_KIND_START, FB_KIND_DIR, FB_KIND_SAVE, FB_KIND_FILE, FB_KIND_ELF };
+
+typedef struct
+{
+    char name[FB_NAME];
+    char title[FB_TITLE]; // a device's label, or a save's icon.sys title
+    u32 size;
+    unsigned char kind, marked;
+} fb_entry_t;
+
+static fb_entry_t fbList[FB_MAX];
+static int fbCount = 0, fbCursor = 0, fbTop = 0;
+static char fbPath[256] = ""; // "" = the drive list; otherwise a folder, ending in '/'
+static char fbKeepName[FB_NAME]; // after a rescan, put the cursor back on this entry
+static volatile int fbBusy = 0;
+static int fbStarted = 0;          // the drives were started from here: look again in a moment
+static clock_t fbRescanAt = 0;
+
+// what happened last, shown top right for a moment
+static char fbToast[48];
+static clock_t fbToastAt = 0;
+
+// the clipboard: names in one folder
+static char fbClipDir[256];
+static char fbClip[FB_CLIP_MAX][FB_NAME];
+static unsigned char fbClipIsDir[FB_CLIP_MAX];
+static int fbClipCount = 0, fbClipCut = 0;
+
+// a paste or delete in progress
+static volatile u32 fbDoneBytes = 0, fbTotalBytes = 0;
+static volatile int fbDoneItems = 0, fbTotalItems = 0, fbFailed = 0, fbSkipped = 0, fbKept = 0;
+static const char *fbOpLabel = "";
+static char fbFailWhat[40]; // the first thing that failed in this operation, e.g. "REMOVE icon.sys"
+
+static void fbNoteFail(const char *verb, const char *path)
+{
+    int err = errno;
+    if (fbFailWhat[0])
+        return;
+    const char *name = strrchr(path, '/');
+    if (name == NULL)
+        name = strrchr(path, ':');
+    snprintf(fbFailWhat, sizeof(fbFailWhat), "%s %s E%d", verb, name && name[1] ? name + 1 : path, err);
+}
+static int fbOp = 0; // what the worker runs next
+enum { FB_OP_SCAN = 0, FB_OP_PASTE, FB_OP_DELETE };
+static char fbDeleteNames[FB_CLIP_MAX][FB_NAME];
+static unsigned char fbDeleteIsDir[FB_CLIP_MAX];
+static int fbDeleteCount = 0;
+
+// the actions menu (Triangle)
+enum { FB_ACT_COPY = 0, FB_ACT_CUT, FB_ACT_PASTE, FB_ACT_DELETE, FB_ACT_RENAME, FB_ACT_NEWDIR, FB_ACT_MARKALL, FB_ACT_COUNT };
+static const char *fbActName[FB_ACT_COUNT] = {"COPY", "CUT", "PASTE", "DELETE", "RENAME", "NEW FOLDER", "MARK ALL"};
+static int fbMenuOpen = 0, fbMenuSel = 0, fbMenuItems[FB_ACT_COUNT], fbMenuCount = 0;
+
+static const char *fbDevices[] = {"mc0:/", "mc1:/", "mass0:/", "mass1:/", "mass2:/", "mass3:/", "mass4:/", "mass5:/", "mass6:/",
+                                  "mass7:/", "mmce0:/", "mmce1:/", "pfs0:/", NULL};
+
+static char fbToastDetail[40];
+
+static void fbSetToast(const char *text)
+{
+    snprintf(fbToast, sizeof(fbToast), "%s", text);
+    fbToastDetail[0] = '\0';
+    fbToastAt = clock();
+}
+
+static int fbIsMc(const char *path)
+{
+    return path[0] == 'm' && path[1] == 'c' && (path[2] == '0' || path[2] == '1') && path[3] == ':';
+}
+
+static void fbJoin(char *out, int size, const char *dir, const char *name)
+{
+    snprintf(out, size, "%s%s", dir, name);
+}
+
+static const char *fbDeviceLabel(const char *dev, char *buf, int size)
+{
+    if (!strncmp(dev, "mc", 2))
+        snprintf(buf, size, "MEMORY CARD %c", dev[2] == '0' ? '1' : '2');
+    else if (!strncmp(dev, "mass", 4))
+        snprintf(buf, size, "USB / BDM DRIVE %c", dev[4]);
+    else if (!strncmp(dev, "mmce", 4))
+        snprintf(buf, size, "MMCE %c", dev[4] == '0' ? '1' : '2');
+    else
+        snprintf(buf, size, "HDD (OPL HOME)");
+    return buf;
+}
+
+// ---- reading ----
+
+// Shift-JIS from an icon.sys title to plain ASCII: full-width letters, digits and common punctuation
+// map across, everything else (kana, kanji) is dropped
+static void fbSjisToAscii(const unsigned char *s, int len, int lineBreak, char *out, int size)
+{
+    int i = 0, o = 0;
+    while (i < len && s[i] && o < size - 1) {
+        if (i == lineBreak && o > 0 && out[o - 1] != ' ')
+            out[o++] = ' ';
+        unsigned int c = s[i];
+        if (c < 0x80) {
+            out[o++] = (char)c;
+            i++;
+            continue;
+        }
+        if (i + 1 >= len)
+            break;
+        unsigned int w = (c << 8) | s[i + 1];
+        char a = 0;
+        i += 2;
+        if (w >= 0x824F && w <= 0x8258)
+            a = (char)('0' + (w - 0x824F));
+        else if (w >= 0x8260 && w <= 0x8279)
+            a = (char)('A' + (w - 0x8260));
+        else if (w >= 0x8281 && w <= 0x829A)
+            a = (char)('a' + (w - 0x8281));
+        else
+            switch (w) {
+                case 0x8140: a = ' '; break;
+                case 0x8143: a = ','; break;
+                case 0x8144: a = '.'; break;
+                case 0x8146: a = ':'; break;
+                case 0x8147: a = ';'; break;
+                case 0x8148: a = '?'; break;
+                case 0x8149: a = '!'; break;
+                case 0x8151: a = '_'; break;
+                case 0x815B:
+                case 0x815C:
+                case 0x817C: a = '-'; break;
+                case 0x815E: a = '/'; break;
+                case 0x8160: a = '~'; break;
+                case 0x8166: a = '\''; break;
+                case 0x8168: a = '"'; break;
+                case 0x8169: a = '('; break;
+                case 0x816A: a = ')'; break;
+                case 0x817B: a = '+'; break;
+                case 0x8181: a = '='; break;
+                case 0x8190: a = '$'; break;
+                case 0x8193: a = '%'; break;
+                case 0x8194: a = '#'; break;
+                case 0x8195: a = '&'; break;
+                default: break;
+            }
+        if (a)
+            out[o++] = a;
+    }
+    while (o > 0 && out[o - 1] == ' ')
+        o--;
+    out[o] = '\0';
+}
+
+// A memory card save's title, from its icon.sys; 0 when it has none
+static int fbReadSaveTitle(const char *dir, char *out, int size)
+{
+    char path[320];
+    unsigned char sys[0xC0 + 68];
+    int fd, n;
+
+    snprintf(path, sizeof(path), "%sicon.sys", dir);
+    fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return 0;
+    n = read(fd, sys, sizeof(sys));
+    close(fd);
+    if (n < (int)sizeof(sys) || memcmp(sys, "PS2D", 4) != 0)
+        return 0;
+    fbSjisToAscii(sys + 0xC0, 68, sys[6] | (sys[7] << 8), out, size);
+    return out[0] != '\0';
+}
+
+// A folder? stat decides: d_type is not dependable on every driver here (MMCE clones mislabel
+// entries, see cuesupport.c); it is only the answer when stat cannot say
+static int fbIsDirEntry(const char *dir, struct dirent *e)
+{
+    char path[320];
+    struct stat st;
+    fbJoin(path, sizeof(path), dir, e->d_name);
+    if (stat(path, &st) == 0)
+        return S_ISDIR(st.st_mode) ? 1 : 0;
+#ifdef DT_DIR
+    return e->d_type == DT_DIR;
+#else
+    return 0;
+#endif
+}
+
+static int fbHasSuffix(const char *name, const char *suffix)
+{
+    int n = strlen(name), s = strlen(suffix);
+    return n >= s && !strcasecmp(name + n - s, suffix);
+}
+
+static int fbCompare(const void *a, const void *b)
+{
+    const fb_entry_t *x = (const fb_entry_t *)a, *y = (const fb_entry_t *)b;
+    int xd = x->kind == FB_KIND_DIR || x->kind == FB_KIND_SAVE, yd = y->kind == FB_KIND_DIR || y->kind == FB_KIND_SAVE;
+    if (xd != yd)
+        return xd ? -1 : 1;
+    return strcasecmp(x->name, y->name);
+}
+
+// The drive list is kept between visits: probing cards and slots that are not there takes seconds, and
+// coming back up to the list should be instant. It is probed again on entering the browser, after
+// START DRIVES, and on Select.
+static fb_entry_t fbDevCache[16];
+static int fbDevCacheCount = 0, fbDevForce = 1;
+static clock_t fbDevCacheAt = 0;
+
+static void fbScanDevices(void)
+{
+    int i, n = 0, haveMass = 0;
+    char label[FB_TITLE];
+
+    if (!fbDevForce && fbDevCacheAt != 0) {
+        memcpy(fbList, fbDevCache, fbDevCacheCount * sizeof(fb_entry_t));
+        fbCount = fbDevCacheCount;
+        return;
+    }
+    fbDevForce = 0;
+
+    for (i = 0; fbDevices[i] != NULL && n < FB_MAX; i++) {
+        const char *dev = fbDevices[i];
+        if (!strncmp(dev, "mass", 4) && !bdmSlotEverConnected(BDM_MODE + (dev[4] - '0')))
+            continue;
+        if (!strncmp(dev, "mmce", 4) && mmceGetObject(1) == NULL)
+            continue;
+        if (!strncmp(dev, "pfs", 3) && hddGetObject(1) == NULL)
+            continue;
+        DIR *d = opendir(dev);
+        if (d == NULL)
+            continue;
+        closedir(d);
+        fb_entry_t *e = &fbList[n++];
+        memset(e, 0, sizeof(*e));
+        snprintf(e->name, sizeof(e->name), "%s", fbDevices[i]);
+        snprintf(e->title, sizeof(e->title), "%s", fbDeviceLabel(fbDevices[i], label, sizeof(label)));
+        e->kind = FB_KIND_DEVICE;
+        if (!strncmp(fbDevices[i], "mass", 4))
+            haveMass = 1;
+    }
+    if (!haveMass && n < FB_MAX) { // USB and HDD start on request: offer it here
+        fb_entry_t *e = &fbList[n++];
+        memset(e, 0, sizeof(*e));
+        snprintf(e->name, sizeof(e->name), "START DRIVES");
+        snprintf(e->title, sizeof(e->title), "%s", fbStarted ? "STARTING..." : "USB, HDD, MMCE");
+        e->kind = FB_KIND_START;
+    }
+    fbCount = n;
+    if (n > (int)(sizeof(fbDevCache) / sizeof(fbDevCache[0])))
+        n = sizeof(fbDevCache) / sizeof(fbDevCache[0]);
+    memcpy(fbDevCache, fbList, n * sizeof(fb_entry_t));
+    fbDevCacheCount = n;
+    fbDevCacheAt = clock();
+}
+
+static void fbScanDir(void)
+{
+    DIR *d = opendir(fbPath);
+    struct dirent *de;
+    int n = 0, i, mcRoot;
+    char child[320];
+
+    if (d == NULL) {
+        fbCount = 0;
+        return;
+    }
+    while (n < FB_MAX && (de = readdir(d)) != NULL) {
+        if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, ".."))
+            continue;
+        fb_entry_t *e = &fbList[n++];
+        memset(e, 0, sizeof(*e));
+        snprintf(e->name, sizeof(e->name), "%s", de->d_name);
+        e->kind = fbIsDirEntry(fbPath, de) ? FB_KIND_DIR : FB_KIND_FILE;
+    }
+    closedir(d);
+
+    mcRoot = fbIsMc(fbPath) && strchr(fbPath + 5, '/') == NULL; // "mc0:/" itself
+    for (i = 0; i < n; i++) {
+        fb_entry_t *e = &fbList[i];
+        if (e->kind == FB_KIND_DIR) {
+            if (mcRoot) {
+                snprintf(child, sizeof(child), "%s%s/", fbPath, e->name);
+                if (fbReadSaveTitle(child, e->title, sizeof(e->title)))
+                    e->kind = FB_KIND_SAVE;
+            }
+        } else {
+            struct stat st;
+            fbJoin(child, sizeof(child), fbPath, e->name);
+            if (stat(child, &st) == 0)
+                e->size = (u32)st.st_size;
+            if (fbHasSuffix(e->name, ".elf"))
+                e->kind = FB_KIND_ELF;
+        }
+    }
+    qsort(fbList, n, sizeof(fb_entry_t), &fbCompare);
+    fbCount = n;
+}
+
+// ---- copying and deleting (all on the IO worker) ----
+
+static u8 *fbBuf = NULL;
+
+// A folder's entries, read whole before anything recurses (memory cards allow few open handles)
+typedef struct
+{
+    char name[FB_NAME];
+    unsigned char isDir;
+    u32 size;
+} fb_child_t;
+
+static fb_child_t *fbListChildren(const char *dir, int *count)
+{
+    DIR *d = opendir(dir);
+    struct dirent *de;
+    fb_child_t *list = NULL;
+    int n = 0, cap = 0;
+    char child[320];
+
+    *count = 0;
+    if (d == NULL)
+        return NULL;
+    while ((de = readdir(d)) != NULL) {
+        if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, ".."))
+            continue;
+        if (n == cap) {
+            cap = cap ? cap * 2 : 32;
+            fb_child_t *grown = realloc(list, cap * sizeof(fb_child_t));
+            if (grown == NULL)
+                break;
+            list = grown;
+        }
+        snprintf(list[n].name, FB_NAME, "%s", de->d_name);
+        list[n].isDir = (unsigned char)fbIsDirEntry(dir, de);
+        list[n].size = 0;
+        n++;
+    }
+    closedir(d);
+    for (int i = 0; i < n; i++) {
+        struct stat st;
+        if (!list[i].isDir) {
+            snprintf(child, sizeof(child), "%s%s", dir, list[i].name);
+            if (stat(child, &st) == 0)
+                list[i].size = (u32)st.st_size;
+        }
+    }
+    *count = n;
+    return list;
+}
+
+static u32 fbTreeSize(const char *path, int isDir, int depth)
+{
+    struct stat st;
+    if (!isDir)
+        return stat(path, &st) == 0 ? (u32)st.st_size : 0;
+    if (depth > 16)
+        return 0;
+    char dir[320], child[320];
+    int n, i;
+    u32 total = 0;
+    snprintf(dir, sizeof(dir), "%s/", path);
+    fb_child_t *kids = fbListChildren(dir, &n);
+    for (i = 0; i < n; i++) {
+        snprintf(child, sizeof(child), "%s%s", dir, kids[i].name);
+        total += kids[i].isDir ? fbTreeSize(child, 1, depth + 1) : kids[i].size;
+    }
+    free(kids);
+    return total;
+}
+
+static int fbCopyFile(const char *src, const char *dst)
+{
+    int in = open(src, O_RDONLY), out, r, ok = 1;
+    if (in < 0) {
+        fbNoteFail("READ", src);
+        return 0;
+    }
+    // a paste only ever makes new files (an existing target is skipped), so no O_TRUNC; and on a memory
+    // card the path goes in RiptOPL's own card form, "mc1:SAVE/FILE" (no slash after the colon)
+    char cardPath[320];
+    const char *target = dst;
+    if (fbIsMc(dst) && dst[4] == '/') {
+        snprintf(cardPath, sizeof(cardPath), "%.4s%s", dst, dst + 5);
+        target = cardPath;
+    }
+    // a memory card answers "changed card" (ENXIO, mcman's sceMcResChangedCard) to the first access
+    // after it is detected; asking again is how every PS2 program deals with it
+    int tries = 0;
+    do {
+        errno = 0;
+        out = open(target, O_WRONLY | O_CREAT, 0666);
+        if (out >= 0 || !fbIsMc(dst))
+            break;
+        DelayThread(50 * 1000);
+    } while (++tries < 4);
+    if (out < 0) {
+        errno = -out > 0 && errno == 0 ? -out : errno;
+        fbNoteFail("CREATE", dst);
+        close(in);
+        return 0;
+    }
+    while ((r = read(in, fbBuf, FB_BUF_SIZE)) > 0) {
+        int w = write(out, fbBuf, r);
+        if (w != r) {
+            if (errno == 0)
+                errno = w < 0 ? -w : 999;
+            fbNoteFail("WRITE", dst);
+            ok = 0;
+            break;
+        }
+        fbDoneBytes += r;
+    }
+    if (r < 0) {
+        fbNoteFail("READ", src);
+        ok = 0;
+    }
+    close(out);
+    close(in);
+    if (!ok)
+        remove(dst);
+    return ok;
+}
+
+static int fbCopyTree(const char *src, const char *dst, int isDir, int depth)
+{
+    if (!isDir)
+        return fbCopyFile(src, dst);
+    if (depth > 16)
+        return 0;
+    if (fbIsMc(dst) && dst[4] == '/') { // RiptOPL's own card form, "mc1:SAVE"
+        char cardPath[320];
+        int tries;
+        snprintf(cardPath, sizeof(cardPath), "%.4s%s", dst, dst + 5);
+        for (tries = 0; tries < 4 && mkdir(cardPath, 0777) < 0 && errno == ENXIO; tries++)
+            DelayThread(50 * 1000); // "changed card": ask again (an existing folder merges)
+    } else
+        mkdir(dst, 0777);
+    char sdir[320], ddir[320], s[320], d[320];
+    int n, i, ok = 1;
+    snprintf(sdir, sizeof(sdir), "%s/", src);
+    snprintf(ddir, sizeof(ddir), "%s/", dst);
+    fb_child_t *kids = fbListChildren(sdir, &n);
+    for (i = 0; i < n; i++) {
+        snprintf(s, sizeof(s), "%s%s", sdir, kids[i].name);
+        snprintf(d, sizeof(d), "%s%s", ddir, kids[i].name);
+        if (!fbCopyTree(s, d, kids[i].isDir, depth + 1))
+            ok = 0;
+    }
+    free(kids);
+    return ok;
+}
+
+// A removal, retried briefly: a memory card can refuse one straight after the same files were read
+static int fbRemoveRetry(const char *path, int isDir)
+{
+    int tries;
+    for (tries = 0; tries < 4; tries++) {
+        if ((isDir ? rmdir(path) : remove(path)) == 0)
+            return 1;
+        DelayThread(100 * 1000);
+    }
+    fbNoteFail(isDir ? "REMOVE FOLDER" : "REMOVE FILE", path);
+    return 0;
+}
+
+static int fbDeleteTree(const char *path, int isDir, int depth)
+{
+    if (!isDir)
+        return fbRemoveRetry(path, 0);
+    if (depth > 16)
+        return 0;
+    char dir[320], child[320];
+    int n, i, ok = 1;
+    snprintf(dir, sizeof(dir), "%s/", path);
+    fb_child_t *kids = fbListChildren(dir, &n);
+    for (i = 0; i < n; i++) {
+        snprintf(child, sizeof(child), "%s%s", dir, kids[i].name);
+        if (!fbDeleteTree(child, kids[i].isDir, depth + 1))
+            ok = 0;
+    }
+    free(kids);
+    return ok && fbRemoveRetry(path, 1);
+}
+
+// Is something there? Opened, not stat()ed: on a memory card stat() reports success for a path that
+// does not exist (RiptOPL checks card files by opening them for the same reason)
+static int fbExists(const char *path)
+{
+    int fd = open(path, O_RDONLY);
+    DIR *d;
+    if (fd >= 0) {
+        close(fd);
+        return 1;
+    }
+    d = opendir(path);
+    if (d != NULL) {
+        closedir(d);
+        return 1;
+    }
+    return 0;
+}
+
+static int fbFolderHasIconSys(const char *folder)
+{
+    char path[320];
+    int fd;
+    snprintf(path, sizeof(path), "%s/icon.sys", folder);
+    fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return 0;
+    close(fd);
+    return 1;
+}
+
+// The card root ("mc0:/") of a memory card path
+static void fbMcRoot(const char *path, char *out, int size)
+{
+    snprintf(out, size, "%.4s/", path);
+}
+
+static void fbPasteWork(void)
+{
+    char src[320], dst[320], destDir[256];
+    int i;
+
+    fbBuf = memalign(64, FB_BUF_SIZE);
+    if (fbBuf == NULL) {
+        fbFailed = fbClipCount;
+        return;
+    }
+    fbTotalBytes = 0;
+    for (i = 0; i < fbClipCount; i++) {
+        snprintf(src, sizeof(src), "%s%s", fbClipDir, fbClip[i]);
+        fbTotalBytes += fbTreeSize(src, fbClipIsDir[i], 0);
+    }
+    for (i = 0; i < fbClipCount; i++) {
+        snprintf(src, sizeof(src), "%s%s", fbClipDir, fbClip[i]);
+        snprintf(destDir, sizeof(destDir), "%s", fbPath);
+        // a save folder pasted anywhere on a memory card goes to the card's root, where saves live
+        if (fbIsMc(fbPath) && fbClipIsDir[i] && fbFolderHasIconSys(src))
+            fbMcRoot(fbPath, destDir, sizeof(destDir));
+        snprintf(dst, sizeof(dst), "%s%s", destDir, fbClip[i]);
+        if (!strcmp(src, dst) || fbExists(dst)) {
+            fbSkipped++; // never over the top of something
+        } else if (fbCopyTree(src, dst, fbClipIsDir[i], 0)) {
+            if (fbClipCut && !fbDeleteTree(src, fbClipIsDir[i], 0))
+                fbKept++; // copied; the original is still there
+        } else
+            fbFailed++;
+        fbDoneItems++;
+    }
+    free(fbBuf);
+    fbBuf = NULL;
+}
+
+static void fbDeleteWork(void)
+{
+    char path[320];
+    int i;
+    for (i = 0; i < fbDeleteCount; i++) {
+        snprintf(path, sizeof(path), "%s%s", fbPath, fbDeleteNames[i]);
+        if (!fbDeleteTree(path, fbDeleteIsDir[i], 0))
+            fbFailed++;
+        fbDoneItems++;
+    }
+}
+
+// What happened, top right: "PASTED 3", "MOVED 2, 1 SKIPPED", "DELETED 1, 1 FAILED"
+// "3 FILES PASTED", "1 FILE MOVED" (folders count as one each, as on the clipboard)
+static const char *fbFiles(int n)
+{
+    return n == 1 ? "FILE" : "FILES";
+}
+
+static void fbReport(const char *verb, int done)
+{
+    char text[48];
+    int ok = done - fbFailed - fbSkipped - fbKept;
+    if (ok < 0)
+        ok = 0;
+    int n = snprintf(text, sizeof(text), "%d %s %s", ok, fbFiles(ok), verb);
+    if (fbSkipped > 0)
+        n += snprintf(text + n, sizeof(text) - n, ", %d SKIPPED", fbSkipped);
+    if (fbKept > 0)
+        n += snprintf(text + n, sizeof(text) - n, ", %d COPIED ONLY", fbKept);
+    if (fbFailed > 0)
+        snprintf(text + n, sizeof(text) - n, ", %d FAILED", fbFailed);
+    fbSetToast(text);
+    if (fbFailWhat[0]) // the first failure, named under it for longer
+        snprintf(fbToastDetail, sizeof(fbToastDetail), "%s", fbFailWhat);
+    else
+        fbToastDetail[0] = '\0';
+}
+
+static void fbWorker(void)
+{
+    if (fbOp == FB_OP_PASTE) {
+        fbPasteWork();
+        fbReport(fbClipCut ? "MOVED" : "PASTED", fbDoneItems);
+        if (fbClipCut) // a cut moves once; a copy can be pasted again
+            fbClipCount = 0;
+    } else if (fbOp == FB_OP_DELETE) {
+        fbDeleteWork();
+        fbReport("DELETED", fbDoneItems);
+    }
+    if (fbPath[0])
+        fbScanDir();
+    else
+        fbScanDevices();
+    fbBusy = 0;
+}
+
+static void fbRun(int op, const char *label)
+{
+    if (fbBusy)
+        return;
+    fbOp = op;
+    fbOpLabel = label;
+    fbDoneItems = fbFailed = fbSkipped = fbKept = 0;
+    fbFailWhat[0] = '\0';
+    fbDoneBytes = 0;
+    fbBusy = 1;
+    if (ioPutRequest(IO_CUSTOM_SIMPLEACTION, &fbWorker) != IO_OK)
+        fbBusy = 0;
+}
