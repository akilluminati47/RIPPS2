+// RIPPS2 art panel glass (ripps2ui.c draws it). Geometry comes from the element's x/y/width/height.
+static void ripps2PanelRect(struct theme_element *elem, int *x, int *y)
+{
+    *x = elem->posX;
+    *y = elem->posY;
+    if (elem->aligned) {
+        *x -= elem->width >> 1;
+        *y -= elem->height >> 1;
+    }
+}
+
+static void drawRipps2PanelGlass(struct menu_list *menu, struct submenu_list *item, config_set_t *config, struct theme_element *elem)
+{
+    int x, y;
+    ripps2PanelRect(elem, &x, &y);
+    ripps2DrawPanelGlass(x, y, elem->width, elem->height, item != NULL);
+}
+
+// RIPPS2: the on-screen rect of the main or info page's glass panel (the art viewport), for the
+// screen switches that morph one page's panel into the next. 0 when the page has none.
+int thmGetPanelRect(int infoPage, int *x, int *y, int *w, int *h)
+{
+    theme_element_t *elem;
+
+    if (gTheme == NULL)
+        return 0;
+    for (elem = infoPage ? gTheme->infoElems.first : gTheme->mainElems.first; elem != NULL; elem = elem->next) {
+        if (elem->type == ELEM_TYPE_RIPPS2_PANEL_GLASS) {
+            ripps2PanelRect(elem, x, y);
+            *w = elem->width;
+            *h = elem->height;
+            return 1;
+        }
+    }
+    return 0;
+}
