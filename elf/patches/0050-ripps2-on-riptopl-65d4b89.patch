+static int fbSelection(char names[][FB_NAME], unsigned char *isDir, int max)
+{
+    int i, n = 0;
+    for (i = 0; i < fbCount && n < max; i++)
+        if (fbList[i].marked) {
+            snprintf(names[n], FB_NAME, "%s", fbList[i].name);
+            isDir[n++] = fbList[i].kind == FB_KIND_DIR || fbList[i].kind == FB_KIND_SAVE;
+        }
+    if (n == 0 && fbCount > 0) {
+        snprintf(names[0], FB_NAME, "%s", fbList[fbCursor].name);
+        isDir[0] = fbList[fbCursor].kind == FB_KIND_DIR || fbList[fbCursor].kind == FB_KIND_SAVE;
+        n = 1;
+    }
+    return n;
+}
