+// RIPPS2: L2 + R2 jump to a random game (never the one already selected, never a folder row), placed
+// a third of the way down the page
+static void menuRandomItem(int quiet)
+{
+    submenu_list_t *it, *cur = selected_item->item->current;
+    int count = 0, games = 0, pick;
+    static int seeded = 0;
+
+    if (cur == NULL)
+        return;
+    for (it = selected_item->item->submenu; it; it = it->next, count++)
+        if (!it->item.isFolder)
+            games++;
+    if (games < 2)
+        return;
+    if (!seeded) {
+        srand((unsigned int)clock());
+        seeded = 1;
+    }
+    do {
+        pick = rand() % count;
+        for (it = selected_item->item->submenu; pick-- > 0; it = it->next)
+            ;
+    } while (it == cur || it->item.isFolder);
+
+    selected_item->item->current = it;
+    int itms = ((items_list_t *)gTheme->itemsList->extended)->displayedItems;
+    submenu_list_t *ps = it, *end = it;
+    int back = itms / 3, rows;
+    while (back-- > 0 && ps->prev)
+        ps = ps->prev;
+    for (rows = 1, end = ps; end->next && rows < itms; end = end->next)
+        rows++;
+    while (rows < itms && ps->prev) { // near the end: keep a full page
+        ps = ps->prev;
+        rows++;
+    }
+    selected_item->item->pagestart = ps;
+    if (!quiet)
+        sfxPlay(SFX_TRANSITION);
+}
