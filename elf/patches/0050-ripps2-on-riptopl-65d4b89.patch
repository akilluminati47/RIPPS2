+static void fbTile(int t)
+{
+    char name[FB_NAME];
+    switch (t) {
+        case FB_TILE_BROWSER:
+            sfxPlay(SFX_CANCEL);
+            fbGridShow(0);
+            break;
+        case FB_TILE_EDITOR:
+            sfxPlay(SFX_CONFIRM);
+            if (fbPath[0] && fbCount > 0 && fbIsText(fbList[fbCursor].name)) {
+                fbGridOpen = 0;
+                fbEdit(fbList[fbCursor].name);
+            } else if (fbPath[0]) { // a new file in this folder
+                snprintf(name, sizeof(name), "NEW.TXT");
+                if (guiShowKeyboard(name, sizeof(name)) && name[0]) {
+                    fbGridOpen = 0;
+                    fbEdit(name);
+                }
+            } else
+                guiMsgBox("Open a folder first, then pick a text file to edit, or make a new one there.", 0, NULL);
+            break;
+        case FB_TILE_HDD:
+            sfxPlay(SFX_CONFIRM);
