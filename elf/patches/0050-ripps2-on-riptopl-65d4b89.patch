+    deinit(UNMOUNT_EXCEPTION, IO_MODE_SELECTED_ALL_SPARE); // keep the drive the ELF is on
+    sysLoadELFApp(elfPath, NULL, 1, argv, 1, 0);
+    ripps2LaunchAborted();
+}
