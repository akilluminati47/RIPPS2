+
+#define HM_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define HM_DIM  GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+#define HM_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define HM_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+
+typedef struct
+{
+    char name[33];
+    unsigned int type;
+    u32 sectors;
+} hm_part_t;
+
+static hm_part_t hmParts[HM_MAX];
+static int hmCount = 0;
+
+static const char *hmTypeName(unsigned int type)
+{
+    switch (type) {
+        case APA_TYPE_PFS: return "PFS";
+        case APA_TYPE_HDL: return "HDL GAME";
+        case APA_TYPE_CFS: return "CFS";
+        case APA_TYPE_EXT2: return "EXT2";
+        case APA_TYPE_EXT2SWAP: return "EXT2 SWAP";
+        case APA_TYPE_REISER: return "REISER";
+        case APA_TYPE_MBR: return "MBR";
+        default: return "OTHER";
+    }
+}
+
+static void hmMb(u32 sectors, char *out, int size)
+{
+    u32 mb = sectors / 2048;
+    if (mb >= 1024)
+        snprintf(out, size, "%u.%u GB", mb / 1024, (mb % 1024) * 10 / 1024);
+    else
+        snprintf(out, size, "%u MB", mb);
+}
+
+static int hmScan(void)
+{
+    iox_dirent_t de;
+    int fd = fileXioDopen("hdd0:");
+    hmCount = 0;
+    if (fd < 0)
+        return fd;
+    while (hmCount < HM_MAX && fileXioDread(fd, &de) > 0) {
+        if (de.stat.mode == APA_TYPE_FREE)
+            continue;
+        hm_part_t *p = &hmParts[hmCount++];
+        snprintf(p->name, sizeof(p->name), "%s", de.name);
+        p->type = de.stat.mode;
+        p->sectors = de.stat.size;
+    }
+    fileXioDclose(fd);
+    return 0;
+}
+
+static void hmHint(int icon, const char *text, int *x, int y)
+{
+    GSTEXTURE *t = thmGetTexture(icon);
+    if (t != NULL) {
+        rmDrawPixmap(t, *x, y - 10, ALIGN_NONE, 20, 20, SCALING_RATIO, HM_LIT, 0);
+        *x += 24;
+    }
+    fntRenderString(gTheme->fonts[4], *x, y, ALIGN_VCENTER, 0, 0, text, HM_SOFT);
+    *x += fntCalcDimensions(gTheme->fonts[4], text) + 18;
+}
+
+void ripps2HddManager(void)
+{
+    int status = hddCheck(), cursor = 0, top = 0, i;
+    char line[96], total[24], freeTxt[24], toast[64] = "";
+
+    if (status < 0) {
+        guiMsgBox("No internal hard disk is ready. Start the drives first (START DRIVES), or check the HDD is connected.", 0, NULL);
+        return;
+    }
+    if (status == 1) {
+        guiMsgBox("The internal hard disk is not APA formatted. Format it with a dedicated HDD tool first.", 0, NULL);
+        return;
+    }
+    hmScan();
+
+    while (1) {
+        readPads();
+        if (cursor >= hmCount)
+            cursor = hmCount - 1;
+        if (cursor < 0)
+            cursor = 0;
+        if (cursor < top)
+            top = cursor;
+        if (cursor >= top + HM_ROWS)
+            top = cursor - HM_ROWS + 1;
+
+        u32 totalS = (u32)fileXioDevctl("hdd0:", HDIOC_TOTALSECTOR, NULL, 0, NULL, 0);
+        u32 freeS = (u32)fileXioDevctl("hdd0:", HDIOC_FREESECTOR, NULL, 0, NULL, 0);
+        hmMb(totalS, total, sizeof(total));
+        hmMb(freeS, freeTxt, sizeof(freeTxt));
+
+        rmStartFrame();
+        guiDrawBGPlasma();
+        fntRenderString(gTheme->fonts[4], HM_X, 30, ALIGN_VCENTER, 0, 0, "HDD MANAGER", HM_LIT);
+        snprintf(line, sizeof(line), "%d PARTITIONS   %s FREE OF %s", hmCount, freeTxt, total);
+        fntRenderString(gTheme->fonts[4], HM_RIGHT - fntCalcDimensions(gTheme->fonts[4], line), 30, ALIGN_VCENTER, 0, 0, line, HM_SOFT);
+        rmDrawLine(HM_X, 46, HM_RIGHT, 46, HM_PRIM(0x4A, 0x72, 0xDC, 0x60));
+        // the disk as a bar: used against free
+        if (totalS > 0) {
+            int w = HM_RIGHT - HM_X, used = (int)((float)w * (float)(totalS - freeS) / (float)totalS);
+            rmDrawRect(HM_X, 56, w, 8, HM_PRIM(0x03, 0x08, 0x22, 0x80));
+            rmDrawRect(HM_X, 56, used, 8, HM_PRIM(0x4A, 0x8C, 0xF0, 0x80));
+        }
+        for (i = 0; i < HM_ROWS && top + i < hmCount; i++) {
+            hm_part_t *p = &hmParts[top + i];
+            int y = HM_Y + i * HM_ROW_H, cur = top + i == cursor, sys = p->name[0] == '_' && p->name[1] == '_';
+            if (cur) {
+                rmDrawRect(HM_X - 6, y - 1, HM_RIGHT - HM_X + 12, HM_ROW_H - 2, HM_PRIM(0x1E, 0x3C, 0x96, 0x58));
+                rmDrawRect(HM_X - 6, y - 1, 3, HM_ROW_H - 2, HM_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+            }
+            fntRenderString(gTheme->fonts[8], HM_X + 6, y + 9, ALIGN_VCENTER, 330, 0, p->name, cur ? HM_LIT : (sys ? HM_DIM : HM_SOFT));
+            fntRenderString(gTheme->fonts[5], 390, y + 9, ALIGN_VCENTER, 0, 0, sys ? "SYSTEM" : hmTypeName(p->type), HM_DIM);
+            hmMb(p->sectors, line, sizeof(line));
+            fntRenderString(gTheme->fonts[5], HM_RIGHT - fntCalcDimensions(gTheme->fonts[5], line), y + 9, ALIGN_VCENTER, 0, 0, line, HM_DIM);
+        }
+        if (toast[0])
+            fntRenderString(gTheme->fonts[5], HM_RIGHT - fntCalcDimensions(gTheme->fonts[5], toast), 432, ALIGN_VCENTER, 0, 0, toast, HM_SOFT);
+        int hx = 44;
+        hmHint(TRIANGLE_ICON, "REMOVE", &hx, 448);
+        hmHint(SELECT_ICON, "REFRESH", &hx, 448);
+        hmHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, "BACK", &hx, 448);
+        rmEndFrame();
+
+        if (getKey(KEY_UP) && cursor > 0) {
+            cursor--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && cursor < hmCount - 1) {
+            cursor++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(KEY_SELECT)) {
+            sfxPlay(SFX_CONFIRM);
+            hmScan();
+            toast[0] = '\0';
+        } else if (getKeyOn(KEY_TRIANGLE) && hmCount > 0) {
+            hm_part_t *p = &hmParts[cursor];
+            if (p->name[0] == '_' && p->name[1] == '_') {
+                sfxPlay(SFX_CANCEL);
+                snprintf(toast, sizeof(toast), "SYSTEM PARTITIONS STAY");
+            } else {
+                char ask[96], path[48];
+                snprintf(ask, sizeof(ask), "Remove partition %s and everything on it?", p->name);
+                if (guiMsgBox(ask, 1, NULL) && guiMsgBox("This cannot be undone. Remove it?", 1, NULL)) {
+                    snprintf(path, sizeof(path), "hdd0:%s", p->name);
+                    int r = fileXioRemove(path);
+                    snprintf(toast, sizeof(toast), r >= 0 ? "REMOVED %s" : "COULD NOT REMOVE %s", p->name);
+                    hmScan();
+                }
+            }
+        } else if (getKeyOn(gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE)) {
+            sfxPlay(SFX_CANCEL);
+            break;
+        }
+    }
+    readPads();
+}
diff --git a/src/ripps2kbd.c b/src/ripps2kbd.c
new file mode 100644
index 0000000..6598348
--- /dev/null
+++ b/src/ripps2kbd.c
@@ -0,0 +1,91 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 USB keyboard: ps2sdk's ps2kbd driver (on the usbd RiptOPL loads at boot), started the first
+  time something asks for text. ripps2KbdPoll hands back one key at a time without waiting, so the
+  on-screen keyboard can take typing from a USB keyboard and pad presses in the same frame loop.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <libkbd.h>
+
+#include "include/opl.h"
+#include "include/ioman.h"
+#include "include/system.h"
+#include "include/extern_irx.h"
+#include "include/ripps2.h"
+
+static int kbdState = 0; // 0 not tried, 1 running, -1 unavailable
+
+static int kbdStart(void)
+{
+    if (kbdState != 0)
+        return kbdState > 0;
+    kbdState = -1;
+    if (sysLoadModuleBuffer(&ps2kbd_irx, size_ps2kbd_irx, 0, NULL) < 0) {
+        LOG("RIPPS2 KBD: ps2kbd did not load\n");
+        return 0;
+    }
+    if (PS2KbdInit() == 0) {
+        LOG("RIPPS2 KBD: PS2KbdInit failed\n");
+        return 0;
+    }
+    PS2KbdSetReadmode(PS2KBD_READMODE_NORMAL);
+    PS2KbdSetBlockingMode(PS2KBD_NONBLOCKING);
+    PS2KbdFlushBuffer();
+    kbdState = 1;
+    return 1;
+}
+
+// One key, or 0 when nothing is waiting: a printable character, or one of the RIPPS2_KEY_* codes
+int ripps2KbdPoll(void)
+{
+    char c = 0;
+
+    if (!kbdStart())
+        return 0;
+    if (PS2KbdRead(&c) <= 0)
+        return 0;
+    if (c == PS2KBD_ESCAPE_KEY) { // a special key: the next byte says which
+        char code = 0;
+        if (PS2KbdRead(&code) <= 0)
+            return RIPPS2_KEY_ESC;
+        switch ((unsigned char)code) {
+            case 0x29: // right (ps2kbd's default special map)
+            case 0x4F:
+                return RIPPS2_KEY_RIGHT;
+            case 0x2A: // left
+            case 0x50:
+                return RIPPS2_KEY_LEFT;
+            case 0x2B: // down
+            case 0x51:
+                return RIPPS2_KEY_DOWN;
+            case 0x2C: // up
+            case 0x52:
+                return RIPPS2_KEY_UP;
+            case 0x26: // delete
+            case 0x4C:
+                return RIPPS2_KEY_DELETE;
+            case 0x24: // home
+            case 0x4A:
+                return RIPPS2_KEY_HOME;
+            case 0x27: // end
+            case 0x4D:
+                return RIPPS2_KEY_END;
+            default:
+                return 0;
+        }
+    }
+    if (c == 0x07 || c == 0x08 || c == 0x7F)
+        return RIPPS2_KEY_BACKSPACE;
+    if (c == '\n' || c == '\r')
+        return RIPPS2_KEY_ENTER;
+    if (c == '\t')
+        return ' ';
+    if ((unsigned char)c >= 0x20 && (unsigned char)c < 0x7F)
+        return (unsigned char)c;
+    return 0;
+}
diff --git a/src/ripps2ui.c b/src/ripps2ui.c
new file mode 100644
index 0000000..100dcf0
--- /dev/null
+++ b/src/ripps2ui.c
@@ -0,0 +1,532 @@
+/*
+  RIPPS2 front end shell: LAUNCH DISC | STORAGE | MEMORY FILES.
+
+  Storage is RiptOPL's own games list and info page; the other two categories are screens of
+  their own. The category bar is drawn on all of them, with the PS2 mark flying to the chosen
+  category: a swoop to a neighbour, a deeper dive with a coin flip when going end to end.
+  Left/Right switch categories everywhere; L1/R1 stay local to the page (drives on Storage,
+  formations on Memory Files). Start runs the page's action.
+
+  Coordinates are theme space (640 wide, gTheme->usedHeight tall), like the theme's elements.
+*/
+
+#include <time.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/pad.h"
+#include "include/system.h"
+#include "include/lang.h"
+#include "include/ripps2.h"
+#include "include/sound.h"
+
+int gRipps2Category = RIPPS2_CAT_STORAGE;
+
+static const char *categoryLabel[RIPPS2_CAT_COUNT] = {"LAUNCH DISC", "STORAGE", "MEMORY FILES"};
+static const int categoryX[RIPPS2_CAT_COUNT] = {128, 320, 512};
+
+#define BAR_Y        30
+#define MARK_Y       50
+#define MARK_W       76
+#define MARK_H       13
+// Text and textures are modulated by the GS (0x80 = full), and the font atlas is white, so
+// a text colour shows at twice its value: #7A8CBA on screen is 0x3D,0x46,0x5D here.
+#define COLOR_LIT    GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80) // #FFFFFF
+#define COLOR_DIM    GS_SETREG_RGBA(0x37, 0x3B, 0x4A, 0x80) // #6E7694, a greyer blue
+#define COLOR_SOFT   GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80) // #CED9F5
+#define COLOR_TEX    GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+
+// Memory Files orb formations (the orbs themselves arrive with the native renderer)
+static const char *formationName[] = {
+    "BROWSER ORBIT", "BORROMEAN RINGS", "TORUS ORBIT", "ICOSAHEDRON", "DOUBLE HELIX", "STRANGE ATTRACTOR",
+    "TREFOIL KNOT", "MOBIUS STRIP", "KLEIN BOTTLE", "GOLDEN SPIRAL", "LISSAJOUS", "SEVEN-POINT STAR"};
+#define FORMATION_COUNT ((int)(sizeof(formationName) / sizeof(formationName[0])))
+int gRipps2Formation = 0;
+int gRipps2Random = RIPPS2_RANDOM_ON;
+static int formationDirty = 0; // changed since the last save
+
+// ---- The flying PS2 mark ----
+static int flyFrom = RIPPS2_CAT_STORAGE;
+static int flyTo = RIPPS2_CAT_STORAGE;
+static clock_t flyStart = 0;
+static float flyDuration = 0.0f; // seconds; 0 = resting
+
+static float easeInOutCubic(float x)
+{
+    if (x < 0.5f)
+        return 4.0f * x * x * x;
+    float k = -2.0f * x + 2.0f;
+    return 1.0f - k * k * k / 2.0f;
+}
+
+// The menu's entrance after the boot swoop: labels fade in, the mark pops in under its category
+static clock_t enterStart = 0;
+#define ENTER_S 0.6f
+
+void ripps2UiEnter(void)
+{
+    enterStart = clock();
+}
+
+static float easeOutBack(float x)
+{
+    const float c1 = 1.70158f, c3 = c1 + 1.0f;
+    float k = x - 1.0f;
+    return 1.0f + c3 * k * k * k + c1 * k * k;
+}
+
+void ripps2RenderCategoryBar(void)
+{
+    int i;
+    int font = gTheme->fonts[2];
+
+    float enter = 1.0f;
+    if (enterStart != 0) {
+        enter = (float)(clock() - enterStart) / (float)CLOCKS_PER_SEC / ENTER_S;
+        if (enter >= 1.0f) {
+            enter = 1.0f;
+            enterStart = 0;
+        } else if (enter < 0.0f)
+            enter = 0.0f;
+    }
+    int alpha = (int)(0x80 * fminf(1.0f, enter * 1.6f));
+    u64 lit = (COLOR_LIT & ~(0xFFULL << 24)) | ((u64)alpha << 24);
+    u64 dim = (COLOR_DIM & ~(0xFFULL << 24)) | ((u64)alpha << 24);
+
+    // the current category bright at full size (font2), the other two greyer and a size down (font7)
+    for (i = 0; i < RIPPS2_CAT_COUNT; i++)
+        fntRenderString(i == gRipps2Category ? font : gTheme->fonts[7], categoryX[i], BAR_Y, ALIGN_CENTER, 0, 0, categoryLabel[i], i == gRipps2Category ? lit : dim);
+
+    GSTEXTURE *mark = thmGetTexture(RIPPS2_MARK);
+    if (mark == NULL)
+        return;
+
+    float x = (float)categoryX[flyTo], y = (float)MARK_Y + (1.0f - enter) * 10.0f, w = (float)MARK_W * fmaxf(0.0f, easeOutBack(enter));
+    if (flyDuration > 0.0f) {
+        float t = (float)(clock() - flyStart) / (float)CLOCKS_PER_SEC / flyDuration;
+        if (t >= 1.0f) {
+            flyDuration = 0.0f;
+        } else {
+            int hops = flyTo > flyFrom ? flyTo - flyFrom : flyFrom - flyTo;
+            float e = easeInOutCubic(t < 0.0f ? 0.0f : t);
+            x = categoryX[flyFrom] + (categoryX[flyTo] - categoryX[flyFrom]) * e;
+            y += sinf(3.14159265f * e) * (6.0f + 6.0f * hops);     // swoop under the labels
+            if (hops >= 2)
+                w *= fmaxf(0.08f, fabsf(cosf(3.14159265f * e))); // coin flip end to end
+            else
+                w *= 1.0f + 0.25f * sinf(3.14159265f * t);      // stretch while flying
+        }
+    }
+    rmDrawPixmap(mark, (int)x, (int)y, ALIGN_CENTER, (int)w, MARK_H, SCALING_RATIO, COLOR_TEX, 0);
+}
+
+// ---- The view word ----
+// L3 names the list it switched to, large over the page, the way the PS2 boot names itself. PS1 and
+// PS2 show their logos, settling from a touch large with a glow; ALL is a word whose letters rise in
+// one after another, each flaring as it lands. GAMES (or FAVORITES) fades in under it, it holds, then
+// fades as the logo swells or the letters drift apart. A soft dark band keeps it clear of the page
+// text, and the page stays live underneath (this used to be a black splash that held the pad 2 s).
+#define WORD_STEP_S 0.07f // between letters
+#define WORD_IN_S   0.40f // one letter's rise, or the logo's arrival
+#define WORD_HOLD_S 0.65f
+#define WORD_OUT_S  0.55f
+#define WORD_Y      228
+#define WORD_TRACK  10.0f // px between letters
+#define WORD_FONT   (gTheme->fonts[14])
+#define WORD_RGBA(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+#define LOGO_TALL_H 96  // the PS1 logo's height on screen
+#define LOGO_WIDE_W 300 // the PS2 mark's width on screen
+static char viewWord[12], viewCaption[24];
+static int viewLogo = -1;
+static clock_t viewWordStart = 0;
+
+static u64 withAlpha(u64 c, int a)
+{
+    return (c & ~(0xFFULL << 24)) | ((u64)(a < 0 ? 0 : a > 0x80 ? 0x80 : a) << 24);
+}
+
+void ripps2ShowViewWord(const char *word, int logo, const char *caption)
+{
+    snprintf(viewWord, sizeof(viewWord), "%s", word != NULL ? word : "");
+    snprintf(viewCaption, sizeof(viewCaption), "%s", caption != NULL ? caption : "");
+    viewLogo = logo;
+    viewWordStart = clock();
+    if (viewWordStart == 0)
+        viewWordStart = 1;
+}
+
+// A soft panel of colour: solid over halfW x halfH around (cx, cy), fading to clear over `fade` px
+// on every side (a 3 x 3 grid of gradient quads)
+static int bandLit(int k, int l)
+{
+    return (k == 1 || k == 2) && (l == 1 || l == 2);
+}
+
+static void viewWordBand(float cx, float cy, float halfW, float halfH, float fade, int r, int g, int b, int a)
+{
+    u64 lit = WORD_RGBA(r, g, b, a), clear = WORD_RGBA(r, g, b, 0);
+    float xs[4] = {cx - halfW - fade, cx - halfW, cx + halfW, cx + halfW + fade};
+    float ys[4] = {cy - halfH - fade, cy - halfH, cy + halfH, cy + halfH + fade};
+    int i, j;
+    for (j = 0; j < 3; j++)
+        for (i = 0; i < 3; i++)
+            rmDrawQuadGouraud(xs[i], ys[j], bandLit(i, j) ? lit : clear, xs[i + 1], ys[j], bandLit(i + 1, j) ? lit : clear,
+                              xs[i], ys[j + 1], bandLit(i, j + 1) ? lit : clear, xs[i + 1], ys[j + 1], bandLit(i + 1, j + 1) ? lit : clear);
+}
+
+void ripps2DrawViewWord(void)
+{
+    int i, n, total = 0, w[sizeof(viewWord)], logoW = 0, logoH = 0;
+    char ch[2] = {0, 0};
+
+    if (viewWordStart == 0)
+        return;
+    GSTEXTURE *logo = viewLogo >= 0 ? thmGetTexture(viewLogo) : NULL;
+    if (logo != NULL && (logo->Width == 0 || logo->Height == 0))
+        logo = NULL;
+    n = logo != NULL ? 0 : (int)strlen(viewWord);
+    if (logo == NULL && n == 0) {
+        viewWordStart = 0;
+        return;
+    }
+
+    float t = (float)(clock() - viewWordStart) / (float)CLOCKS_PER_SEC;
+    float inEnd = logo != NULL ? WORD_IN_S : WORD_STEP_S * (n - 1) + WORD_IN_S, outStart = inEnd + WORD_HOLD_S;
+    if (t >= outStart + WORD_OUT_S) {
+        viewWordStart = 0;
+        return;
+    }
+    float out = t > outStart ? (t - outStart) / WORD_OUT_S : 0.0f;
+    float keep = 1.0f - out * out;                // fades out ever faster
+    float lead = t < inEnd ? t / inEnd : 1.0f;
+    float halfW, halfH, captionY, track = WORD_TRACK + 18.0f * out * out, span = 0.0f;
+
+    if (logo != NULL) { // a tall logo by its height, a wide one by its width
+        if (logo->Height * 3 > logo->Width) {
+            logoH = LOGO_TALL_H;
+            logoW = logo->Width * LOGO_TALL_H / logo->Height;
+        } else {
+            logoW = LOGO_WIDE_W;
+            logoH = logo->Height * LOGO_WIDE_W / logo->Width;
+        }
+        halfW = logoW / 2.0f;
+        halfH = logoH / 2.0f;
+        captionY = WORD_Y + logoH / 2.0f + 22.0f;
+    } else {
+        for (i = 0; i < n; i++) {
+            ch[0] = viewWord[i];
+            w[i] = fntCalcDimensions(WORD_FONT, ch);
+            total += w[i];
+        }
+        span = total + track * (n - 1);
+        halfW = span / 2.0f;
+        halfH = 30.0f;
+        captionY = WORD_Y + 50.0f;
+    }
+
+    // the backdrop: dark under it all (word and caption), a little light behind the mark
+    int bandA = (int)(fminf(1.0f, lead * 2.0f) * keep * 0x80);
+    float top = WORD_Y - halfH, bottom = captionY + 12.0f;
+    viewWordBand(320.0f, (top + bottom) / 2.0f, halfW + 36.0f, (bottom - top) / 2.0f + 14.0f, 56.0f, 0x01, 0x02, 0x0A, bandA * 3 / 4);
+    rmSetBlendAdditive(1);
+    viewWordBand(320.0f, (float)WORD_Y, halfW * 0.8f, halfH * 0.6f, 40.0f, 0x30, 0x58, 0xB0, bandA / 5);
+    rmSetBlendAdditive(0);
+
+    if (logo != NULL) {
+        float li = t < WORD_IN_S ? t / WORD_IN_S : 1.0f;
+        float s = (1.0f + 0.16f * (1.0f - easeOutBack(li))) * (1.0f + 0.10f * out); // settles, then swells as it goes
+        float flare = sinf(3.14159265f * li);
+        int a = (int)(0x80 * fminf(1.0f, li * 1.8f) * keep);
+        int gw = (int)(logoW * s * 1.05f), gh = (int)(logoH * s * 1.05f) + 4;
+        rmSetBlendAdditive(1); // the glow: a larger copy, brightest mid-landing
+        rmDrawPixmap(logo, 320, WORD_Y, ALIGN_CENTER, gw, gh, SCALING_RATIO, WORD_RGBA(0x80, 0x80, 0x80, (int)((0x14 + 0x40 * flare) * keep)), 0);
+        rmSetBlendAdditive(0);
+        rmDrawPixmap(logo, 320, WORD_Y, ALIGN_CENTER, (int)(logoW * s), (int)(logoH * s), SCALING_RATIO, WORD_RGBA(0x80, 0x80, 0x80, a), 0);
+    } else {
+        float x = 320.0f - span / 2.0f;
+        for (i = 0; i < n; i++) {
+            float li = (t - WORD_STEP_S * i) / WORD_IN_S;
+            if (li > 0.0f) {
+                if (li > 1.0f)
+                    li = 1.0f;
+                float rise = (1.0f - easeOutBack(li)) * 16.0f;  // up from below, a touch past, settle
+                float flare = sinf(3.14159265f * li);           // brightest mid-landing
+                int a = (int)(0x80 * fminf(1.0f, li * 1.8f) * keep);
+                int lx = (int)x, ly = (int)(WORD_Y + rise);
+                ch[0] = viewWord[i];
+                if (ch[0] != ' ') {
+                    u64 glow = WORD_RGBA(0x50, 0x78, 0xC0, (int)((0x18 + 0x40 * flare) * keep));
+                    rmSetBlendAdditive(1);
+                    fntRenderString(WORD_FONT, lx - 2, ly, ALIGN_VCENTER, 0, 0, ch, glow);
+                    fntRenderString(WORD_FONT, lx + 2, ly, ALIGN_VCENTER, 0, 0, ch, glow);
+                    fntRenderString(WORD_FONT, lx, ly - 2, ALIGN_VCENTER, 0, 0, ch, glow);
+                    fntRenderString(WORD_FONT, lx, ly + 2, ALIGN_VCENTER, 0, 0, ch, glow);
+                    rmSetBlendAdditive(0);
+                    fntRenderString(WORD_FONT, lx, ly, ALIGN_VCENTER, 0, 0, ch, withAlpha(COLOR_LIT, a));
+                }
+            }
+            x += w[i] + track;
+        }
+    }
+
+    if (viewCaption[0]) { // GAMES under it, in after the mark lands
+        float ci = (t - inEnd * 0.6f) / 0.3f;
+        if (ci > 0.0f)
+            fntRenderString(gTheme->fonts[6], 320, (int)captionY, ALIGN_CENTER, 0, 0, viewCaption,
+                            withAlpha(COLOR_SOFT, (int)(0x80 * fminf(1.0f, ci) * keep)));
+    }
+}
+
+void ripps2SetCategory(int cat)
+{
+    if (cat < 0 || cat >= RIPPS2_CAT_COUNT || cat == gRipps2Category)
+        return;
+    if (gRipps2Category == RIPPS2_CAT_MEMORY && formationDirty) { // remember the formation left on
+        ripps2SaveSettingsInBackground();
+        formationDirty = 0;
+    }
+
+    int hops = cat > gRipps2Category ? cat - gRipps2Category : gRipps2Category - cat;
+    flyFrom = gRipps2Category;
+    flyTo = cat;
+    flyStart = clock();
+    flyDuration = 0.52f + 0.23f * hops;
+    gRipps2Category = cat;
+
+    // no fade: the mark's flight across the bar is the transition
+    if (cat == RIPPS2_CAT_STORAGE)
+        guiSwitchScreenInstant(GUI_SCREEN_MAIN);
+    else if (cat == RIPPS2_CAT_LAUNCH)
+        guiSwitchScreenInstant(GUI_SCREEN_RIPPS2_LAUNCH);
+    else
+        guiSwitchScreenInstant(GUI_SCREEN_RIPPS2_MEMORY);
+}
+
+void ripps2StepCategory(int dir)
+{
+    ripps2SetCategory(gRipps2Category + (dir < 0 ? -1 : 1));
+}
+
+// Button glyphs draw at the hint bar's height (20), keeping each image's own aspect
+#define GLYPH_H 20
+static int glyphWidth(GSTEXTURE *t)
+{
+    return t ? (t->Width * GLYPH_H) / t->Height : 0;
+}
+
+// Text that goes with a button glyph uses RIPPS2 Sleek at the prompt size (theme font6)
+#define PROMPT_FONT (gTheme->fonts[6])
+
+// A START button glyph followed by the action name, centred as one unit
+static void renderStartPrompt(const char *action, int y)
+{
+    GSTEXTURE *start = thmGetTexture(START_ICON);
+    int textW = fntCalcDimensions(PROMPT_FONT, action);
+    int iconW = glyphWidth(start), iconH = start ? GLYPH_H : 0;
+    int gap = start ? 10 : 0;
+    int x0 = 320 - (iconW + gap + textW) / 2;
+
+    if (start)
+        rmDrawPixmap(start, x0 + iconW / 2, y, ALIGN_CENTER, iconW, iconH, SCALING_RATIO, COLOR_TEX, 0);
+    fntRenderString(PROMPT_FONT, x0 + iconW + gap, y, ALIGN_VCENTER, 0, 0, action, COLOR_LIT);
+}
+
+// ---- LAUNCH DISC ----
+void ripps2RenderLaunch(void)
+{
+    ripps2DrawBackground();
+    ripps2RenderCategoryBar();
+    renderStartPrompt("START DISC", 423);
+    fntRenderString(gTheme->fonts[3], 320, 450, ALIGN_CENTER, 0, 0, "INSERT PS1/PS2 GAME OR CD/DVD MEDIA", COLOR_DIM);
+}
+
+void ripps2HandleInputLaunch(void)
+{
+    if (getKeyOn(KEY_RIGHT)) {
+        ripps2SetCategory(RIPPS2_CAT_STORAGE);
+    } else if (getKeyOn(KEY_START)) {
+        sfxPlay(SFX_CONFIRM);
+        // success never returns; a cancelled wait is not an error
+        int r = sysLaunchDisc(&guiRenderProbeFrame);
+        if (r < 0 && r != SYS_DISC_CANCELLED)
+            guiMsgBox(_l(_STR_DISC_LAUNCH_ERR), 0, NULL);
+        readPads();
+    }
+}
+
+// ---- MEMORY FILES ----
+void ripps2RenderMemory(void)
+{
+    char count[16];
+    GSTEXTURE *l1 = thmGetTexture(L1_ICON), *r1 = thmGetTexture(R1_ICON);
+
+    ripps2DrawBackground();
+    ripps2RenderCategoryBar();
+    // the same footnotes as LAUNCH DISC: the prompt where START DISC sits, the formation on the line of
+    // the disc note (small, between small L1 / R1), its count just under it
+    renderStartPrompt("START BROWSER", 423);
+
+    const char *name = formationName[gRipps2Formation];
+    int half = fntCalcDimensions(gTheme->fonts[3], name) / 2, gw = l1 ? glyphWidth(l1) * 3 / 4 : 0;
+    fntRenderString(gTheme->fonts[3], 320, 450, ALIGN_CENTER, 0, 0, name, COLOR_SOFT);
+    if (l1)
+        rmDrawPixmap(l1, 320 - half - 10 - gw / 2, 450, ALIGN_CENTER, gw, GLYPH_H * 3 / 4, SCALING_RATIO, COLOR_TEX, 0);
+    if (r1)
+        rmDrawPixmap(r1, 320 + half + 10 + gw / 2, 450, ALIGN_CENTER, gw, GLYPH_H * 3 / 4, SCALING_RATIO, COLOR_TEX, 0);
+    snprintf(count, sizeof(count), "%02d / %02d", gRipps2Formation + 1, FORMATION_COUNT);
+    fntRenderString(gTheme->fonts[3], 320, 467, ALIGN_CENTER, 0, 0, count, COLOR_DIM);
+}
+
+void ripps2HandleInputMemory(void)
+{
+    // the triggers play with the orbs: L2 held shows their paths, R2 held speeds them up
+    ripps2SetOrbInput(getKeyPressed(KEY_L2), getKeyPressed(KEY_R2));
+
+    if (getKeyOn(KEY_LEFT)) {
+        ripps2SetCategory(RIPPS2_CAT_STORAGE);
+    } else if (getKeyOn(KEY_L1)) {
+        gRipps2Formation = (gRipps2Formation + FORMATION_COUNT - 1) % FORMATION_COUNT;
+        formationDirty = 1;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKeyOn(KEY_R1)) {
+        gRipps2Formation = (gRipps2Formation + 1) % FORMATION_COUNT;
+        formationDirty = 1;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKeyOn(KEY_START)) {
+        // RIPPS2 23c: Start opens the browser built in here; the orbs keep moving behind it
+        if (formationDirty) {
+            ripps2SaveSettingsInBackground();
+            formationDirty = 0;
+        }
+        ripps2FilesEnter();
+    }
+}
+
+// ---- STORAGE art panel ----
+// The glass over the game's BG art (theme element Ripps2PanelGlass): a navy tint, light at the top
+// so the art shows, deep where the text sits, and a thin PS2-blue frame. Text elements come after it
+// and stay on top. With no game selected (before a device starts, or nothing listed) it is clear
+// glass: a light even tint over the pillars and the frame, nothing else. Drawn procedurally, so it
+// stays crisp at any size.
+
+#define RGBA_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00) // untextured: 0x80 = opaque
+
+static void panelFrame(int x, int y, int w, int h)
+{
+    u64 edge = RGBA_PRIM(0x4A, 0x72, 0xDC, 0x80), shine = RGBA_PRIM(0x9C, 0xB8, 0xFF, 0x50);
+    rmDrawLine(x, y, x + w, y, edge);
+    rmDrawLine(x, y + h, x + w, y + h, edge);
+    rmDrawLine(x, y, x, y + h, edge);
+    rmDrawLine(x + w, y, x + w, y + h, edge);
+    rmDrawLine(x + 1, y + 1, x + w - 1, y + 1, shine); // glass catching the light along the top
+}
+
+// Menus, settings, dialogs and message boxes: one large clear-glass panel behind everything on the
+// page, the same glass as the Storage placeholder with a little more tint for the denser text
+void ripps2DrawPagePanel(void)
+{
+    const int x = 14, y = 10, w = 612, h = 460;
+    u64 tint = RGBA_PRIM(0x04, 0x0C, 0x2E, 0x30);
+    rmDrawQuadGouraud(x, y, tint, x + w, y, tint, x, y + h, tint, x + w, y + h, tint);
+    panelFrame(x, y, w, h);
+}
+
+// The settings help text: the deep end of the viewport glass, with the same frame
+void ripps2DrawHintBox(int x, int y, int w, int h)
+{
+    u64 deep = RGBA_PRIM(0x03, 0x08, 0x22, 0x6C);
+    rmDrawQuadGouraud(x, y, deep, x + w, y, deep, x, y + h, deep, x + w, y + h, deep);
+    panelFrame(x, y, w, h);
+}
+
+// ---- Screen switches: one glass panel moves between pages (no fade through black) ----
+#define MORPH_GLASS_A 0x60 // the travelling panel's tint: a veiled panel's depth, so the hand-offs match
+
+// Deep glass over a panel, `amount` 0..1: how a page's content dims before its panel moves off, and
+// how the next page's content comes up once the panel has arrived
+void ripps2DrawPanelVeil(int x, int y, int w, int h, float amount)
+{
+    if (amount <= 0.0f)
+        return;
+    u64 veil = RGBA_PRIM(0x03, 0x08, 0x22, (int)(MORPH_GLASS_A * fminf(1.0f, amount)));
+    rmDrawQuadGouraud(x, y, veil, x + w, y, veil, x, y + h, veil, x + w, y + h, veil);
+}
+
+// The pillars, and the glass panel p (0..1) of the way from rect a to rect b: it glides and resizes,
+// easing out of the first page's place and into the next one's
+void ripps2DrawPanelMorph(int ax, int ay, int aw, int ah, int bx, int by, int bw, int bh, float p)
+{
+    float e = easeInOutCubic(p < 0.0f ? 0.0f : p > 1.0f ? 1.0f : p);
+    int x = (int)(ax + (bx - ax) * e), y = (int)(ay + (by - ay) * e);
+    int w = (int)(aw + (bw - aw) * e), h = (int)(ah + (bh - ah) * e);
+    u64 glass = RGBA_PRIM(0x03, 0x08, 0x22, MORPH_GLASS_A);
+
+    ripps2DrawBackground();
+    rmDrawQuadGouraud(x, y, glass, x + w, y, glass, x, y + h, glass, x + w, y + h, glass);
+    panelFrame(x, y, w, h);
+}
+
+void ripps2DrawPanelGlass(int x, int y, int w, int h, int hasItem)
+{
+    if (!hasItem) {
+        u64 clear = RGBA_PRIM(0x04, 0x0C, 0x2E, 0x1C); // ~22%: the pillars read through
+        rmDrawQuadGouraud(x, y, clear, x + w, y, clear, x, y + h, clear, x + w, y + h, clear);
+        panelFrame(x, y, w, h);
+        return;
+    }
+
+    // tint: 23% over the upper art, deepening to 72% by the text zone (from about a third down), so
+    // the art and the pillars still read through
+    int y1 = y + (h * 22) / 100, y2 = y + (h * 38) / 100;
+    u64 light = RGBA_PRIM(0x04, 0x0C, 0x2E, 0x1E), mid = RGBA_PRIM(0x04, 0x0C, 0x2E, 0x34), deep = RGBA_PRIM(0x03, 0x08, 0x22, 0x5C);
+    rmDrawQuadGouraud(x, y, light, x + w, y, light, x, y1, light, x + w, y1, light);
+    rmDrawQuadGouraud(x, y1, light, x + w, y1, light, x, y2, mid, x + w, y2, mid);
+    rmDrawQuadGouraud(x, y2, mid, x + w, y2, mid, x, y + h, deep, x + w, y + h, deep);
+    panelFrame(x, y, w, h);
+}
+
+// ---- STORAGE and INFO pages: right-stick view tilt ----
+// The stick tips the art viewport with everything on it (and, on the info page, the disc and case in
+// the same plane) a few degrees in any direction about the group's centre. The view eases after the
+// stick and starts level whenever a page opens. Pushing a side sends that side away. A group can turn
+// further than the default (theme key tilt_scale).
+#define TILT_YAW_MAX   0.16f // ~9 degrees
+#define TILT_PITCH_MAX 0.12f // ~7 degrees
+
+static float tiltYaw = 0.0f, tiltPitch = 0.0f;
+static clock_t tiltLast = 0;
+
+void ripps2UpdateTilt(void)
+{
+    int sx, sy;
+    clock_t now = clock();
+    float dt = tiltLast != 0 ? (float)(now - tiltLast) / (float)CLOCKS_PER_SEC : 1.0f;
+    tiltLast = now;
+    if (dt > 0.25f) { // the page just opened
+        tiltYaw = 0.0f;
+        tiltPitch = 0.0f;
+        dt = 0.016f;
+    }
+    padGetRightStick(&sx, &sy);
+    float k = fminf(1.0f, dt * 8.0f);
+    tiltYaw += (-(sx / 128.0f) * TILT_YAW_MAX - tiltYaw) * k;
+    tiltPitch += ((sy / 128.0f) * TILT_PITCH_MAX - tiltPitch) * k;
+}
+
+void ripps2TiltBegin(int cx, int cy, int scalePct)
+{
+    if (fabsf(tiltYaw) > 0.0005f || fabsf(tiltPitch) > 0.0005f)
+        rmSetTilt(1, cx, cy, tiltYaw * scalePct / 100.0f, tiltPitch * scalePct / 100.0f);
+}
+
+void ripps2TiltEnd(void)
+{
+    rmSetTilt(0, 0, 0, 0.0f, 0.0f);
+}
