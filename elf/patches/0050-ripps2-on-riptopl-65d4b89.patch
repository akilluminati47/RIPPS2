+void metaDbInvalidate(void); // the drives changed: look for archives again
+
+// Fill in the keys the game's own CFG lacks, as runtime-only '#' keys (never saved)
+void metaDbMerge(config_set_t *config, const char *prefix, const char *sep, const char *gameKey);
+
+// A displayed attribute: the game's own value, else the database's
+int metaDbGetStr(config_set_t *config, const char *key, const char **value);
+
+#endif
