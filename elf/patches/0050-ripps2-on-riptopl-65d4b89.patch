+static void fbFixScroll(void)
+{
+    if (fbCursor >= fbCount)
+        fbCursor = fbCount > 0 ? fbCount - 1 : 0;
+    if (fbCursor < 0)
+        fbCursor = 0;
+    if (fbCursor < fbTop)
+        fbTop = fbCursor;
+    if (fbCursor >= fbTop + FB_ROWS)
+        fbTop = fbCursor - FB_ROWS + 1;
+    if (fbTop < 0)
+        fbTop = 0;
