+// Two modes are one source for a favourite when equal or both BDM (a stick can change slots)
+static int mixModesMatch(int a, int b)
+{
+    if (a >= BDM_MODE && a <= BDM_MODE_LAST && b >= BDM_MODE && b <= BDM_MODE_LAST)
+        return 1;
+    return a == b;
