+static void fbMenuBuild(void)
+{
+    int inFolder = fbPath[0] != '\0', haveItem = inFolder && fbCount > 0;
+    fbMenuCount = 0;
+    if (haveItem) {
+        fbMenuItems[fbMenuCount++] = FB_ACT_COPY;
+        fbMenuItems[fbMenuCount++] = FB_ACT_CUT;
+    }
+    if (inFolder && fbClipCount > 0)
+        fbMenuItems[fbMenuCount++] = FB_ACT_PASTE;
+    if (haveItem) {
+        fbMenuItems[fbMenuCount++] = FB_ACT_DELETE;
+        fbMenuItems[fbMenuCount++] = FB_ACT_RENAME;
+    }
+    if (inFolder) {
