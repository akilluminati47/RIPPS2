+static void fbUp(void)
+{
+    char parent[256], last[FB_NAME];
+    int len = strlen(fbPath), i;
+
+    sfxPlay(SFX_CANCEL);
+    if (len == 0) { // the drive list: back to the orbs
+        guiSwitchScreen(GUI_SCREEN_RIPPS2_MEMORY);
+        return;
+    }
+    if (len >= 2 && fbPath[len - 2] == ':') { // a drive's root ("mass0:/"): back to the drive list
+        snprintf(last, sizeof(last), "%s", fbPath);
+        fbOpenPath("", last);
+        return;
+    }
+    // "mass0:/A/B/" -> "mass0:/A/", with "B" under the cursor
+    for (i = len - 2; i >= 0 && fbPath[i] != '/'; i--)
+        ;
+    if (i < 0) {
+        fbOpenPath("", NULL);
+        return;
+    }
+    snprintf(last, sizeof(last), "%.*s", len - 2 - i, fbPath + i + 1);
+    snprintf(parent, sizeof(parent), "%.*s", i + 1, fbPath);
+    fbOpenPath(parent, last);
+}
