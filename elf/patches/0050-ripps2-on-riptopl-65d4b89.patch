+#include <kernel.h>
+#include <sifrpc.h>
+#include <iopcontrol.h>
+#include <string.h>
+#include <stdio.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <strings.h>
+#include <dirent.h>
+#include <libcdvd.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/system.h"
+#include "include/iosupport.h"
+#include "include/ioman.h"
+#include "include/ripps2.h"
+
+// ---- DVD video from LAUNCH DISC ----
+//
+// Sony's DVD player switches the video output to YPbPr for DVD video whatever the console is set to,
+// so a PS2 on an RGB (SCART) cable shows films green. The known fix is krHACKen's modified DVD
+// player, which keeps RGB. It is built from Sony's player, so RIPPS2 never ships it: the user installs
+// it, signed for their console (KELF Twin Signer), where the browser looks for DVD player updates --
+// mc0:/ or mc1:/B?EXEC-DVDPLAYER/dvdplayer.elf, ? being the console's region letter.
+// LAUNCH DISC boots that player when it is there, and the console's own ROM player otherwise.
+
+static const char *dvdUpdateFolders[] = {"BEEXEC-DVDPLAYER", "BAEXEC-DVDPLAYER", "BIEXEC-DVDPLAYER", "BCEXEC-DVDPLAYER"};
+
+static int r2FileExists(const char *path)
+{
+    int fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return 0;
+    close(fd);
+    return 1;
+}
+
+int ripps2LaunchDvdPlayer(void)
+{
+    static char playerArg[64], eromdrvArg[24], dvdelfArg[24];
+    char path[48], *args[4];
+    int port, i;
+    char c;
+
+    // 1. an installed DVD player update (the RGB-patched player), booted like the browser boots it
+    for (port = 0; port < 2; port++) {
+        for (i = 0; i < (int)(sizeof(dvdUpdateFolders) / sizeof(dvdUpdateFolders[0])); i++) {
+            snprintf(path, sizeof(path), "mc%d:/%s/dvdplayer.elf", port, dvdUpdateFolders[i]);
+            if (r2FileExists(path)) {
+                LOG("RIPPS2 DVD: booting the player update %s\n", path);
+                snprintf(playerArg, sizeof(playerArg), "-x %s", path);
+                ripps2PlayLaunchSequence();
+                deinit(NO_EXCEPTION, IO_MODE_SELECTED_ALL);
+                args[0] = "-m rom0:SIO2MAN";
+                args[1] = "-m rom0:MCMAN";
+                args[2] = "-m rom0:MCSERV";
+                args[3] = playerArg;
+                LoadExecPS2("moduleload", 4, args);
+                return -1; // unreachable on success
+            }
+        }
+    }
+
+    // 2. the console's own player: region-specific on later consoles (EROMDRVx + DVDPLx), else the
+    //    original EROMDRV + DVDELF pair. When rom1: cannot be probed, the original pair is the bet.
+    snprintf(eromdrvArg, sizeof(eromdrvArg), "-k rom1:EROMDRV");
+    snprintf(dvdelfArg, sizeof(dvdelfArg), "-x erom0:DVDELF");
+    if (!r2FileExists("rom1:DVDID")) {
+        for (c = 'A'; c <= 'Z'; c++) {
+            snprintf(path, sizeof(path), "rom1:DVDID%c", c);
+            if (r2FileExists(path)) {
+                snprintf(eromdrvArg, sizeof(eromdrvArg), "-k rom1:EROMDRV%c", c);
+                snprintf(dvdelfArg, sizeof(dvdelfArg), "-x erom0:DVDPL%c", c);
+                break;
+            }
+        }
+    }
+    LOG("RIPPS2 DVD: booting the ROM player (%s %s)\n", eromdrvArg, dvdelfArg);
+    ripps2PlayLaunchSequence();
+    deinit(NO_EXCEPTION, IO_MODE_SELECTED_ALL);
+    args[0] = eromdrvArg;
+    args[1] = "-m erom0:UDFIO";
+    args[2] = dvdelfArg;
+    LoadExecPS2("moduleload2 rom1:UDNL rom1:DVDCNF", 3, args);
+    return -1; // unreachable on success
+}
+
+// ---- ESR-patched PS2 games from LAUNCH DISC ----
+//
+// ESR patches a PS2 game disc so the drive reads it as DVD video; such a disc boots through ESR,
+// which the user installs (RIPPS2 does not ship it). Launch Disc looks for it where it is usually
+// kept: any esr*.elf in APPS, BOOT or ESR on either memory card, or on the first USB drive. A DVD
+// video disc that also carries a PS2 SYSTEM.CNF is an ESR game and starts straight away; for any
+// other DVD video disc, with ESR installed, the user picks ESR or the DVD player.
+
+static const char *esrFolders[] = {"mc0:/APPS/", "mc0:/BOOT/", "mc0:/ESR/", "mc1:/APPS/", "mc1:/BOOT/", "mc1:/ESR/",
+                                   "mass0:/APPS/", "mass0:/ESR/", "mass0:/", NULL};
+
+static int r2EndsWith(const char *name, const char *suffix)
+{
+    int n = strlen(name), s = strlen(suffix);
+    return n >= s && !strcasecmp(name + n - s, suffix);
+}
+
+static int r2FindEsr(char *out, int size)
+{
+    int i;
+    for (i = 0; esrFolders[i] != NULL; i++) {
+        DIR *d = opendir(esrFolders[i]);
+        struct dirent *e;
+        if (d == NULL)
+            continue;
+        while ((e = readdir(d)) != NULL) {
+            if (!strncasecmp(e->d_name, "esr", 3) && r2EndsWith(e->d_name, ".elf")) {
+                snprintf(out, size, "%s%s", esrFolders[i], e->d_name);
+                closedir(d);
+                return 1;
+            }
+        }
+        closedir(d);
+    }
+    return 0;
+}
+
+int ripps2LaunchDvdVideo(void)
+{
+    static char esrPath[160];
+    char *argv[1];
+
+    if (r2FindEsr(esrPath, sizeof(esrPath))) {
+        sceCdDiskReady(0);
+        int esr = r2FileExists("cdrom0:\\SYSTEM.CNF;1"); // the game's own files sit beside the video ones
+        if (!esr)
+            esr = guiMsgBox("This disc reads as DVD video. Start it with ESR, for an ESR-patched PS2 game? Choose No for the DVD player.", 1, NULL);
+        if (esr) {
+            LOG("RIPPS2 ESR: booting %s\n", esrPath);
+            argv[0] = esrPath;
+            ripps2PlayLaunchSequence();
+            deinit(UNMOUNT_EXCEPTION, IO_MODE_SELECTED_ALL_SPARE); // keep the drive ESR is on
+            sysLoadELFApp(esrPath, NULL, 1, argv, 1, 0);
+            ripps2LaunchAborted();
+            return -1; // reached only when the handoff failed
+        }
+    }
+    return ripps2LaunchDvdPlayer();
+}
+
+// ---- PlayStation discs from LAUNCH DISC ----
+//
+// PS1DRV takes the boot file's name (SYSTEM.CNF's BOOT line, without its path or ;1) and the disc's
+// VER value, "???" standing in for either when the disc does not say. A disc with no SYSTEM.CNF but a
+// PSX.EXE is a generic PlayStation title.
+
+// Copies the value of "key = value" from SYSTEM.CNF text into out (trimmed); 0 when absent
+static int r2CnfValue(const char *cnf, const char *key, char *out, int size)
+{
+    const char *p = cnf;
+    int klen = strlen(key);
+    while (*p) {
+        while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')
+            p++;
+        if (strncmp(p, key, klen) == 0) {
+            const char *q = p + klen;
+            while (*q == ' ' || *q == '\t')
+                q++;
+            if (*q == '=') {
+                int n = 0;
+                q++;
+                while (*q == ' ' || *q == '\t')
+                    q++;
+                while (*q && *q != '\r' && *q != '\n' && n < size - 1)
+                    out[n++] = *q++;
+                while (n > 0 && (out[n - 1] == ' ' || out[n - 1] == '\t'))
+                    n--;
+                out[n] = '\0';
+                return 1;
+            }
+        }
+        while (*p && *p != '\n')
+            p++;
+    }
+    return 0;
+}
+
+int ripps2LaunchPs1Disc(void)
+{
+    static char bootArg[32], verArg[16];
+    char cnf[2048], line[128], *args[2];
+    int fd, n;
+
+    snprintf(bootArg, sizeof(bootArg), "???");
+    snprintf(verArg, sizeof(verArg), "???");
+
+    fd = open("cdrom0:\\SYSTEM.CNF;1", O_RDONLY);
+    if (fd >= 0) {
+        n = read(fd, cnf, sizeof(cnf) - 1);
+        close(fd);
+        cnf[n > 0 ? n : 0] = '\0';
+        if (r2CnfValue(cnf, "BOOT", line, sizeof(line))) {
+            // "cdrom:\SLUS_000.67;1" -> "SLUS_000.67"
+            char *start = line, *c;
+            for (c = line; *c; c++)
+                if (*c == '\\' || *c == ':')
+                    start = c + 1;
+            for (c = start; *c && *c != ';'; c++)
+                ;
+            *c = '\0';
+            if (*start)
+                snprintf(bootArg, sizeof(bootArg), "%s", start);
+        }
+        if (r2CnfValue(cnf, "VER", line, sizeof(line)) && line[0])
+            snprintf(verArg, sizeof(verArg), "%s", line);
+    } else if (!r2FileExists("cdrom0:\\PSX.EXE;1")) {
+        LOG("RIPPS2 PS1: no SYSTEM.CNF or PSX.EXE on the disc\n");
+        return -2;
+    }
+
+    LOG("RIPPS2 PS1: booting %s (VER %s)\n", bootArg, verArg);
+    ripps2PlayLaunchSequence();
+    deinit(NO_EXCEPTION, IO_MODE_SELECTED_ALL);
+    args[0] = bootArg;
+    args[1] = verArg;
+    LoadExecPS2("rom0:PS1DRV", 2, args);
+    return -1; // unreachable on success
+}
diff --git a/src/ripps2bg.c b/src/ripps2bg.c
new file mode 100644
index 0000000..4fadb14
--- /dev/null
+++ b/src/ripps2bg.c
@@ -0,0 +1,1192 @@
+/*
+  RIPPS2 native backgrounds, drawn by the PS2 in place of RiptOPL's plasma:
+    - Pillars: a field of glass towers (Storage, Launch Disc and every other screen)
+    - Orbs: glowing orbs in the current formation (Memory Files)
+  Ports of the RIPPS2 web theme, sized for a vsync-locked frame: the towers are culled and
+  sorted on the EE and drawn as gradient quads; the orbs are additive gradient fans.
+
+  The EE time spent here is measured every frame (COP0 Count, 294.912 MHz) and shown in the
+  corner of beta builds together with the frame rate, both in PS2 time, so the numbers are
+  true however fast the host runs an emulator.
+*/
+
+#include <math.h>
+#include <time.h>
+#include <stdio.h>
+
+#include "include/opl.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/gui.h"
+#include "include/pad.h"
+#include "include/ripps2.h"
+
+#define RIPPS2_PERF_HUD 0 // 1: show the background's EE time and the FPS in the corner (dev builds)
+
+#define PI   3.14159265f
+#define TAU  6.28318531f
+#define PHI  1.61803399f
+#define CX   320.0f
+#define CY   240.0f
+#define RGBA(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+
+typedef struct
+{
+    float x, y, z;
+} v3;
+
+typedef struct
+{
+    float x, y, z;
+    int ok;
+} p2;
+
+static float nowSeconds(void)
+{
+    return (float)clock() / (float)CLOCKS_PER_SEC;
+}
+
+static inline unsigned int cpuTicks(void)
+{
+    unsigned int c;
+    __asm__ __volatile__("mfc0 %0, $9" : "=r"(c));
+    return c;
+}
+
+// ---------------------------------------------------------------- camera
+
+static v3 camEye, camR, camU, camF;
+static float camFocal;
+
+static v3 vsub(v3 a, v3 b) { v3 r = {a.x - b.x, a.y - b.y, a.z - b.z}; return r; }
+static float vdot(v3 a, v3 b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
+static v3 vnorm(v3 a)
+{
+    float l = sqrtf(vdot(a, a));
+    v3 r = {a.x / l, a.y / l, a.z / l};
+    return r;
+}
+static v3 vcross(v3 a, v3 b)
+{
+    v3 r = {a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x};
+    return r;
+}
+
+static void camLook(v3 eye, v3 target, float fovDeg)
+{
+    v3 up = {0.0f, 1.0f, 0.0f};
+    camEye = eye;
+    camF = vnorm(vsub(target, eye));
+    camR = vnorm(vcross(camF, up));
+    camU = vcross(camR, camF);
+    camFocal = 240.0f / tanf(fovDeg * PI / 360.0f);
+}
+
+static p2 project(v3 p)
+{
+    v3 d = vsub(p, camEye);
+    p2 o;
+    o.z = vdot(d, camF);
+    o.ok = o.z > 0.5f;
+    if (o.ok) {
+        o.x = CX + vdot(d, camR) / o.z * camFocal;
+        o.y = CY - vdot(d, camU) / o.z * camFocal;
+    }
+    return o;
+}
+
+// ---------------------------------------------------------------- pillars
+//
+// One continuous scene clock drives three phases of the same field:
+//   boot   - the web theme's intro: the camera starts low and close and pulls back while the towers
+//            rise from the centre outward, settling exactly into the idle Storage view
+//   idle   - the towers breathe and a slow swell rolls across them
+//   launch - shock rings roll out from the centre and light the towers up, each one sending a
+//            beam of light up from its top as a ring passes; the camera pushes in and looks up
+//            the beams, and a white flash peaks before the handoff (the last frame holds on screen)
+
+#define GRID        11
+#define MAX_TOWERS  (GRID * GRID)
+#define SPACING     2.4f
+#define MAX_HEIGHT  13.0f
+#define INTRO_S     5.0f    // boot swoop length (the web theme's)
+#define INTRO_UI_S  3.2f    // the menu appears here, while the camera finishes settling
+#define LAUNCH_S    2.1f    // launch light-up length
+#define SAFE_XY     1800.0f // keep projected points well inside the GS's 12.4 fixed-point range
+
+typedef struct
+{
+    float x, z, w, base, phase, d, depth, h, heat;
+} tower_t;
+
+static tower_t towers[MAX_TOWERS];
+static int towerIdx[MAX_TOWERS];
+static int towerCount = 0;
+static unsigned int rngState = 47;
+
+static float sceneT0 = -1.0f;  // clock() seconds at the first pillars frame
+static float launchT0 = -1.0f; // scene time a launch began; < 0 when not launching
+static int launchHeld = 0;     // the launch's final frame is on screen and must stay there
+
+static float clamp01(float x) { return x < 0.0f ? 0.0f : (x > 1.0f ? 1.0f : x); }
+static float lerpf(float a, float b, float t) { return a + (b - a) * t; }
+static float easeOutCubicf(float x)
+{
+    float k = 1.0f - x;
+    return 1.0f - k * k * k;
+}
+static float easeInOutCubicf(float x)
+{
+    if (x < 0.5f)
+        return 4.0f * x * x * x;
+    float k = -2.0f * x + 2.0f;
+    return 1.0f - k * k * k / 2.0f;
+}
+
+// Boot screens before the intro loop (the config load) hold one pose of the swoop -- the centre
+// towers already rising, the camera still low -- and the swoop then carries on from that pose.
+#define BOOT_POSE_S 1.1f
+static int bootFreeze = 0, bootPoseShown = 0;
+
+static float sceneTime(void)
+{
+    if (bootFreeze && sceneT0 < 0.0f)
+        return BOOT_POSE_S;
+    float now = nowSeconds();
+    if (sceneT0 < 0.0f)
+        sceneT0 = now - (bootPoseShown ? BOOT_POSE_S : 0.0f);
+    return now - sceneT0;
+}
+
+static int onScreen(p2 p)
+{
+    return p.ok && fabsf(p.x - CX) < SAFE_XY && fabsf(p.y - CY) < SAFE_XY;
+}
+
+static float rnd(void)
+{
+    rngState = rngState * 1664525u + 1013904223u;
+    return (float)(rngState >> 8) / 16777216.0f;
+}
+
+static void pillarsInit(void)
+{
+    int gx, gz;
+    float half = (GRID - 1) / 2.0f;
+    towerCount = 0;
+    for (gx = 0; gx < GRID; gx++) {
+        for (gz = 0; gz < GRID; gz++) {
+            float x = gx - half, z = gz - half;
+            float d = sqrtf(x * x + z * z) / half;
+            if (d > 1.02f)
+                continue;
+            tower_t *t = &towers[towerCount];
+            float falloff = 0.22f + 0.78f * expf(-(d * d) / (2.0f * 0.38f * 0.38f));
+            t->base = falloff * (0.45f + rnd() * 0.55f);
+            if (rnd() < 0.06f)
+                t->base = fminf(1.15f, t->base * 1.6f);
+            t->x = x * SPACING;
+            t->z = z * SPACING;
+            t->w = SPACING * (0.42f + rnd() * 0.2f);
+            t->phase = rnd() * TAU;
+            t->d = d;
+            t->heat = 0.0f;
+            towerIdx[towerCount] = towerCount;
+            towerCount++;
+        }
+    }
+}
+
+static void drawSky(u64 top, u64 horizon, u64 floor)
+{
+    rmDrawQuadGouraud(0, 0, top, 640, 0, top, 0, 290, horizon, 640, 290, horizon);
+    rmDrawQuadGouraud(0, 290, horizon, 640, 290, horizon, 0, 480, floor, 640, 480, floor);
+}
+
+// A floor line, clipped against a near plane so the low boot camera keeps the grid under it
+static void gridLine(v3 a, v3 b, u64 c)
+{
+    const float zn = 3.0f;
+    float za = vdot(vsub(a, camEye), camF), zb = vdot(vsub(b, camEye), camF);
+    if (za < zn && zb < zn)
+        return;
+    if (za < zn || zb < zn) {
+        float t = (zn - za) / (zb - za);
+        v3 m = {a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t};
+        if (za < zn)
+            a = m;
+        else
+            b = m;
+    }
+    p2 pa = project(a), pb = project(b);
+    if (onScreen(pa) && onScreen(pb))
+        rmDrawLine((int)pa.x, (int)pa.y, (int)pb.x, (int)pb.y, c);
+}
+
+static void drawFloorGrid(float glowAll)
+{
+    int i;
+    const float ext = 9.0f * SPACING;
+    u64 c = RGBA(0x1C + (int)(0x30 * glowAll), 0x34 + (int)(0x40 * glowAll), 0x80 + (int)(0x50 * glowAll), 0x30 + (int)(0x20 * glowAll));
+    for (i = -9; i <= 9; i++) {
+        float k = (i + 0.5f) * SPACING;
+        v3 a = {k, 0.0f, -ext}, b = {k, 0.0f, ext}, e = {-ext, 0.0f, k}, f = {ext, 0.0f, k};
+        gridLine(a, b, c);
+        gridLine(e, f, c);
+    }
+}
+
+// ---- the sky's stars and the motes drifting up through the field ----
+#define STAR_N 64
+#define MOTE_N 24
+static float starX[STAR_N], starY[STAR_N], starPh[STAR_N], starB[STAR_N];
+static v3 motePos[MOTE_N];
+static float motePh[MOTE_N];
+static int skyReady = 0;
+
+static void skyInit(void)
+{
+    int i;
+    for (i = 0; i < STAR_N; i++) {
+        starX[i] = rnd() * 640.0f;
+        starY[i] = rnd() * rnd() * 250.0f; // denser toward the top
+        starPh[i] = rnd() * TAU;
+        starB[i] = 0.35f + rnd() * 0.65f;
+    }
+    for (i = 0; i < MOTE_N; i++) {
+        v3 m = {(rnd() - 0.5f) * 30.0f, rnd() * 16.0f, (rnd() - 0.5f) * 30.0f};
+        motePos[i] = m;
+        motePh[i] = rnd() * TAU;
+    }
+    skyReady = 1;
+}
+
+static void drawStars(float t, float turn, float glowAll)
+{
+    int i;
+    rmSetBlendAdditive(1);
+    for (i = 0; i < STAR_N; i++) {
+        float x = fmodf(starX[i] - turn * 160.0f + 6400.0f, 640.0f); // drift with the camera's turn
+        float twinkle = 0.55f + 0.45f * sinf(t * (0.8f + starB[i]) + starPh[i]);
+        int a = (int)(0x50 * starB[i] * twinkle * (1.0f - 0.7f * glowAll));
+        if (a < 4)
+            continue;
+        rmDrawRect((int)x, (int)starY[i], starB[i] > 0.85f ? 2 : 1, 1, RGBA(0x9C, 0xC0, 0xFF, a));
+    }
+    rmSetBlendAdditive(0);
+}
+
+// A mote: a small additive glow
+static void moteGlow(float x, float y, float r, int a)
+{
+    int k;
+    const int seg = 6;
+    u64 centre = RGBA(0xB0, 0xD0, 0xFF, a), rim = RGBA(0xB0, 0xD0, 0xFF, 0);
+    float px = x + r, py = y;
+    for (k = 1; k <= seg; k++) {
+        float ang = TAU * k / seg, nx = x + cosf(ang) * r, ny = y + sinf(ang) * r;
+        rmDrawTriGouraud(x, y, centre, px, py, rim, nx, ny, rim);
+        px = nx;
+        py = ny;
+    }
+}
+
+// The motes rise slowly and sway; the far half is drawn before the towers and the near half after,
+// so towers hide the ones behind them
+static void drawMotes(float t, int nearPass)
+{
+    int i;
+    rmSetBlendAdditive(1);
+    for (i = 0; i < MOTE_N; i++) {
+        float y = fmodf(motePos[i].y + t * 0.35f, 16.0f);
+        v3 w = {motePos[i].x + sinf(t * 0.3f + motePh[i]) * 0.8f, y, motePos[i].z + cosf(t * 0.25f + motePh[i]) * 0.8f};
+        p2 p = project(w);
+        if (!onScreen(p) || p.z < 4.0f || (p.z < 32.0f) != nearPass)
+            continue;
+        int a = (int)(0x48 * sinf(PI * y / 16.0f)); // fade in at the floor, out at the top
+        if (a > 2)
+            moteGlow(p.x, p.y, 140.0f / p.z, a);
+    }
+    rmSetBlendAdditive(0);
+}
+
+// Tower face colour at shade k, pushed toward a hot blue-white by heat
+static u64 shadeHot(float k, float heat, int a)
+{
+    float hk = fminf(1.0f, heat * 0.45f);
+    return RGBA((int)lerpf(0x1A * k, 0x7E, hk), (int)lerpf(0x3A * k, 0xB4, hk), (int)lerpf(0x9A * k, 0xFF, hk), a);
+}
+
+// A point on a tower face: u across (0 left, 1 right), at height y (world units)
+static p2 facePoint(const v3 *c, float u, float y)
+{
+    float h = c[2].y - c[0].y, f = h > 0.0f ? y / h : 0.0f;
+    v3 l = {c[0].x + (c[2].x - c[0].x) * f, c[0].y + (c[2].y - c[0].y) * f, c[0].z + (c[2].z - c[0].z) * f};
+    v3 r = {c[1].x + (c[3].x - c[1].x) * f, c[1].y + (c[3].y - c[1].y) * f, c[1].z + (c[3].z - c[1].z) * f};
+    v3 p = {l.x + (r.x - l.x) * u, l.y + (r.y - l.y) * u, l.z + (r.z - l.z) * u};
+    return project(p);
+}
+
+// One side of a tower. c[] = BL, BR, TL, TR in world space; n = outward normal; phase seeds its
+// flickering cell.
+static void drawSide(const v3 *c, v3 n, float k, float heat, float phase, float t)
+{
+    v3 mid = {(c[0].x + c[3].x) * 0.5f, (c[0].y + c[3].y) * 0.5f, (c[0].z + c[3].z) * 0.5f};
+    if (vdot(n, vsub(camEye, mid)) <= 0.0f)
+        return; // back face
+    p2 bl = project(c[0]), br = project(c[1]), tl = project(c[2]), tr = project(c[3]);
+    if (!onScreen(bl) || !onScreen(br) || !onScreen(tl) || !onScreen(tr))
+        return;
+    float hk = fminf(1.0f, heat);
+    u64 bottom = RGBA(0x04 + (int)(0x10 * hk), 0x0A + (int)(0x1C * hk), 0x24 + (int)(0x40 * hk), 0x80);
+    u64 top = shadeHot(k, heat, 0x80);
+    rmDrawQuadGouraud(tl.x, tl.y, top, tr.x, tr.y, top, bl.x, bl.y, bottom, br.x, br.y, bottom);
+
+    // glowing vertical edges and the rim at the top, brighter as the tower heats; seams every 2.4
+    // units up the face; now and then one window cell flickers on. Edges antialiased by the GS.
+    rmSetBlendAdditive(1);
+    rmSetLineAA(1);
+    u64 edge = RGBA(0x40, 0x80, 0xFF, 0x38 + (int)(0x48 * hk)), rim = RGBA(0x7E, 0xC2, 0xFF, 0x60 + (int)(0x20 * hk));
+    rmDrawLine((int)bl.x, (int)bl.y, (int)tl.x, (int)tl.y, edge);
+    rmDrawLine((int)br.x, (int)br.y, (int)tr.x, (int)tr.y, edge);
+    rmDrawLine((int)tl.x, (int)tl.y, (int)tr.x, (int)tr.y, rim);
+    float h = c[2].y - c[0].y, ys;
+    u64 seam = RGBA(0x40, 0x80, 0xFF, 0x14 + (int)(0x20 * hk));
+    for (ys = 2.4f; ys < h - 0.4f; ys += 2.4f) {
+        p2 a = facePoint(c, 0.0f, ys), b = facePoint(c, 1.0f, ys);
+        rmDrawLine((int)a.x, (int)a.y, (int)b.x, (int)b.y, seam);
+    }
+    rmSetLineAA(0);
+    if (h > 2.0f && sinf(t * 1.7f + phase * 3.1f) > 0.82f) {
+        float cy = 0.6f + fmodf(phase * 7.3f, 1.0f) * (h - 1.6f), u0 = 0.38f, u1 = 0.62f;
+        p2 q0 = facePoint(c, u0, cy + 0.5f), q1 = facePoint(c, u1, cy + 0.5f), q2 = facePoint(c, u0, cy), q3 = facePoint(c, u1, cy);
+        if (onScreen(q0) && onScreen(q1) && onScreen(q2) && onScreen(q3)) {
+            u64 cell = RGBA(0x9C, 0xC8, 0xFF, 0x48);
+            rmDrawQuadGouraud(q0.x, q0.y, cell, q1.x, q1.y, cell, q2.x, q2.y, cell, q3.x, q3.y, cell);
+        }
+    }
+    rmSetBlendAdditive(0);
+}
+
+// A tower's light path: a beam rising from its top, bright at the base and fading upward
+static void drawBeam(float x, float z, float y0, float w, float b)
+{
+    if (b <= 0.02f)
+        return;
+    v3 base = {x, y0, z}, tip = {x, y0 + 38.0f, z};
+    p2 pb = project(base), pt = project(tip);
+    if (!onScreen(pb) || !onScreen(pt))
+        return;
+    float hwb = w * 0.5f * camFocal / pb.z, hwt = w * 0.5f * camFocal / pt.z;
+    int a = (int)(0x58 * fminf(1.0f, b));
+    u64 c0 = RGBA(0x5C, 0x98, 0xFF, a), c1 = RGBA(0x5C, 0x98, 0xFF, 0);
+    u64 k0 = RGBA(0xDC, 0xEA, 0xFF, a), k1 = RGBA(0xDC, 0xEA, 0xFF, 0);
+    rmSetBlendAdditive(1);
+    rmDrawQuadGouraud(pt.x - hwt, pt.y, c1, pt.x + hwt, pt.y, c1, pb.x - hwb, pb.y, c0, pb.x + hwb, pb.y, c0);
+    rmDrawQuadGouraud(pt.x - hwt * 0.25f, pt.y, k1, pt.x + hwt * 0.25f, pt.y, k1, pb.x - hwb * 0.25f, pb.y, k0, pb.x + hwb * 0.25f, pb.y, k0); // hot core
+    rmSetBlendAdditive(0);
+}
+
+void ripps2DrawPillars(void)
+{
+    int i, j, k;
+    float t = sceneTime();
+
+    if (towerCount == 0)
+        pillarsInit();
+    if (!skyReady)
+        skyInit();
+
+    float L = launchT0 >= 0.0f ? t - launchT0 : -1.0f;
+    float intro = easeInOutCubicf(clamp01(t / INTRO_S));
+    float push = L >= 0.0f ? easeInOutCubicf(clamp01(L / 1.8f)) : 0.0f;
+    float glowAll = L >= 0.0f ? easeInOutCubicf(clamp01(L / 1.5f)) : 0.0f;
+
+    drawSky(RGBA(0x01, 0x02, 0x09 + (int)(0x10 * glowAll), 0x80),
+            RGBA(0x0B + (int)(0x12 * glowAll), 0x19 + (int)(0x24 * glowAll), 0x4C + (int)(0x44 * glowAll), 0x80),
+            RGBA(0x02, 0x04, 0x10 + (int)(0x10 * glowAll), 0x80));
+
+    // Camera: the boot swoop eases into the idle Storage view,
+    // then drifts slowly round; a launch pushes in and tilts up the beams, with a short shake
+    // (idle: radius 32, height 8, looking at 11.8: the field closer and sitting lower on screen)
+    float a = t * 0.03f + 0.7f;
+    float radius = lerpf(12.0f, 32.0f, intro) - 12.0f * push;
+    float camY = lerpf(1.6f, 8.0f, intro) + 4.0f * push;
+    float lookY = lerpf(9.0f, 11.8f, intro) + 4.2f * push;
+    v3 eye = {cosf(a) * radius, camY, sinf(a) * radius};
+    if (L >= 0.0f) {
+        float kick = expf(-L * 3.5f);
+        eye.y += sinf(t * 47.0f) * kick * 0.22f;
+        eye.x += sinf(t * 39.0f + 1.3f) * kick * 0.18f;
+    }
+    v3 target = {0.0f, lookY, 0.0f};
+    camLook(eye, target, 40.0f);
+
+    drawStars(t, a, glowAll);
+    rmSetLineAA(1);
+    drawFloorGrid(glowAll);
+    rmSetLineAA(0);
+    drawMotes(t, 0);
+
+    // heights: the boot rise, breathing, the idle swell, and the launch heat
+    for (i = 0; i < towerCount; i++) {
+        tower_t *tw = &towers[i];
+        float rise = easeOutCubicf(clamp01((t - 0.3f - tw->d * 1.6f) / 1.8f));
+        float breathe = 0.9f + 0.1f * sinf(t * 0.5f + tw->phase);
+        float swell = 0.5f + 0.5f * sinf(tw->x * 0.18f + tw->z * 0.11f - t * 0.6f);
+        float heat = 0.0f;
+        if (L >= 0.0f) {
+            float dist = sqrtf(tw->x * tw->x + tw->z * tw->z);
+            for (k = 0; k < 3; k++) { // three rings, 0.28 s apart
+                float age = L - k * 0.28f;
+                if (age < 0.0f || age > 1.8f)
+                    continue;
+                float q = (dist - age * 16.0f) / (2.2f * 1.6f);
+                heat += expf(-q * q) * 1.6f * powf(1.0f - age / 1.8f, 1.5f);
+            }
+            heat = fminf(2.4f, heat + glowAll * 0.8f);
+        }
+        tw->heat = heat;
+        tw->h = fmaxf(0.05f, (tw->base * breathe * MAX_HEIGHT + swell * 1.4f + heat * 3.2f) * rise);
+        v3 c = {tw->x, tw->h * 0.5f, tw->z};
+        tw->depth = vdot(vsub(c, camEye), camF);
+    }
+    // back to front (insertion sort: the order barely changes frame to frame)
+    for (i = 1; i < towerCount; i++) {
+        int v = towerIdx[i];
+        for (j = i - 1; j >= 0 && towers[towerIdx[j]].depth < towers[v].depth; j--)
+            towerIdx[j + 1] = towerIdx[j];
+        towerIdx[j + 1] = v;
+    }
+
+    float beamIn = L >= 0.0f ? clamp01(L / 0.25f) : 0.0f;
+    for (i = 0; i < towerCount; i++) {
+        tower_t *tw = &towers[towerIdx[i]];
+        float hw = tw->w * 0.5f, h = tw->h;
+        float x0 = tw->x - hw, x1 = tw->x + hw, z0 = tw->z - hw, z1 = tw->z + hw;
+        float kk = 0.35f + 0.65f * fminf(1.0f, h / MAX_HEIGHT);
+        v3 s1[4] = {{x0, 0, z1}, {x1, 0, z1}, {x0, h, z1}, {x1, h, z1}}; // +z
+        v3 s2[4] = {{x1, 0, z0}, {x0, 0, z0}, {x1, h, z0}, {x0, h, z0}}; // -z
+        v3 s3[4] = {{x1, 0, z1}, {x1, 0, z0}, {x1, h, z1}, {x1, h, z0}}; // +x
+        v3 s4[4] = {{x0, 0, z0}, {x0, 0, z1}, {x0, h, z0}, {x0, h, z1}}; // -x
+        v3 nz = {0, 0, 1}, nnz = {0, 0, -1}, nx = {1, 0, 0}, nnx = {-1, 0, 0};
+        drawSide(s1, nz, kk * 0.85f, tw->heat, tw->phase, t);
+        drawSide(s2, nnz, kk * 0.85f, tw->heat, tw->phase + 1.7f, t);
+        drawSide(s3, nx, kk * 0.65f, tw->heat, tw->phase + 3.4f, t);
+        drawSide(s4, nnx, kk * 0.65f, tw->heat, tw->phase + 5.1f, t);
+        if (camEye.y > h) { // top cap
+            v3 a0 = {x0, h, z0}, a1 = {x1, h, z0}, a2 = {x0, h, z1}, a3 = {x1, h, z1};
+            p2 q0 = project(a0), q1 = project(a1), q2 = project(a2), q3 = project(a3);
+            if (onScreen(q0) && onScreen(q1) && onScreen(q2) && onScreen(q3)) {
+                float hk = fminf(1.0f, tw->heat * 0.5f);
+                u64 cap = RGBA((int)lerpf(0x16, 0xA0, hk), (int)lerpf(0x30, 0xC8, hk), (int)lerpf(0x80, 0xFF, hk), 0x80);
+                rmDrawQuadGouraud(q0.x, q0.y, cap, q1.x, q1.y, cap, q2.x, q2.y, cap, q3.x, q3.y, cap);
+            }
+        }
+        if (beamIn > 0.0f)
+            drawBeam(tw->x, tw->z, h, tw->w * 0.34f, fminf(1.0f, tw->heat * 0.6f) * beamIn);
+    }
+
+    drawMotes(t, 1);
+
+    // the flash: peaks at 1.45 s and settles to a light haze that holds through the handoff
+    if (L >= 0.0f) {
+        float q = (L - 1.45f) / 0.32f;
+        float f = fmaxf(expf(-q * q), 0.12f * clamp01((L - 1.45f) / 0.3f));
+        int fa = (int)(0x70 * f);
+        if (fa > 0)
+            rmDrawRect(0, 0, 640, 480, RGBA(0xE8, 0xF0, 0xFF, fa));
+    }
+}
+
