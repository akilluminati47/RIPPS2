+// build 141: the browser itself, choosing a program for Manage's launch keys: the drives, START DRIVES and the folders as
+// ever, in a loop of its own, and back where it was afterwards. 1 with its path (and a drive's BDM type) when one was chosen
+int ripps2FilesPick(const char *title, char *out, int size, int *bdmType)
+{
+    char savedPath[256], savedName[FB_NAME];
+    int waited = 0;
+
+    while (fbBusy && waited++ < 500)
+        DelayThread(10000);
+    if (fbBusy)
+        return 0;
+    snprintf(savedPath, sizeof(savedPath), "%s", fbPath);
+    snprintf(savedName, sizeof(savedName), "%s", fbCount > 0 && fbCursor < fbCount ? fbList[fbCursor].name : "");
+    fbPickTitle = title;
+    fbPicking = 1;
+    fbPickDone = 0;
+    fbGridOpen = fbGridClosing = 0;
+    fbMenuOpen = 0;
+    fbPicked[0] = '\0';
+    fbDevForce = 1; // drives may have come or gone
+    fbOpenPath("", NULL);
+    while (!fbPickDone) {
+        readPads();
+        rmStartFrame();
+        ripps2RenderFiles();
+        rmEndFrame();
+        ripps2HandleInputFiles();
+    }
+    fbPicking = 0;
+    fbOpenPath(savedPath, savedName[0] ? savedName : NULL);
+    readPads();
+    if (fbPickDone < 0)
+        return 0;
+    snprintf(out, size, "%s", fbPicked);
+    if (bdmType != NULL)
+        *bdmType = !strncmp(out, "mass", 4) ? bdmSlotDeviceType(out[4] - '0') : -1;
+    return 1;
+}
