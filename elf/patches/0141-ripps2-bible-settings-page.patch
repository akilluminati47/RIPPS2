+    if (fbHeldStep(KEY_UP)) {
+        if (fbCursor > 0) {
+            fbCursor--;
+            sfxPlay(SFX_CURSOR);
+        }
+    } else if (fbHeldStep(KEY_DOWN)) {
+        if (fbCursor < fbCount - 1) {
+            fbCursor++;
+            sfxPlay(SFX_CURSOR);
+        }
+    } else if (getKeyOn(KEY_L1)) {
+        fbCursor -= FB_ROWS;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKeyOn(KEY_R1)) {
+        fbCursor += FB_ROWS;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKeyOn(openKey) && fbCount > 0) {
+        fb_entry_t *e = &fbList[fbCursor];
+        char path[256];
+        switch (e->kind) {
+            case FB_KIND_HERE:
+                break;
+            case FB_KIND_START:
+                fbOpen();
+                break;
+            case FB_KIND_DEVICE:
+                if (!strcmp(e->name, "hdd0:")) { // partitions, not files: its path can be typed
+                    sfxPlay(SFX_CANCEL);
+                    fbSetToast(_t("CHOOSE AN ELF"));
+                    break;
+                }
+                sfxPlay(SFX_CONFIRM);
+                fbOpenPath(e->name, NULL);
+                break;
+            case FB_KIND_DIR:
+            case FB_KIND_SAVE:
+                sfxPlay(SFX_CONFIRM);
+                snprintf(path, sizeof(path), "%s%s/", fbPath, e->name);
+                fbOpenPath(path, NULL);
+                break;
+            case FB_KIND_ELF:
+                sfxPlay(SFX_CONFIRM);
+                fbJoin(fbPicked, sizeof(fbPicked), fbPath, e->name);
+                fbPickDone = 1;
+                break;
+            default:
+                sfxPlay(SFX_CANCEL);
+                fbSetToast(_t("CHOOSE AN ELF"));
+                break;
+        }
+    } else if (getKeyOn(backKey)) {
+        if (fbPath[0])
+            fbUp();
+        else {
+            sfxPlay(SFX_CANCEL);
+            fbPickDone = -1;
+        }
+    } else if (getKeyOn(KEY_SELECT)) {
+        sfxPlay(SFX_CONFIRM);
+        if (fbCount > 0 && fbCursor < fbCount)
+            snprintf(fbKeepName, sizeof(fbKeepName), "%s", fbList[fbCursor].name);
+        fbDevForce = 1;
+        fbRun(FB_OP_SCAN, _t("READING"));
+    }
+    fbFixScroll();
+}
