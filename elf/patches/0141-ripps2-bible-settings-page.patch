+/* ---- a page in the Settings look (build 141) ----
+
+   The user, 11/04: "the bible manage menu should be like the update we did for the rename matching the rest of the settings
+   layouts, this enhances it and allows tooltips to display". The same title, line, faces and hint row as Set Metadata (Rename),
+   label on the left, value on the right, the chosen row's tip in the band above the hints. The caller keeps the cursor, so
+   a change never sends it back to the top. */
+#define PG_Y 52
+
+static struct
+{
+    const char *title;
+    const ripps2_page_row_t *rows;
+    int count, cursor;
+} pgView;
+static int pgTop = 0;
+
+static u64 pgRaw(unsigned int c) // as it is: what BIBLE will draw, not turned by the Color Theme
+{
+    return (u64)((c >> 16) & 0xFF) | ((u64)((c >> 8) & 0xFF) << 8) | ((u64)(c & 0xFF) << 16) | ((u64)0x80 << 24);
+}
+
+static void pgDraw(void)
+{
+    const ripps2_page_row_t *cur = &pgView.rows[pgView.cursor];
+    int hintY = gTheme->usedHeight - 32, tipY = hintY - MD_TIP_H, room = tipY - PG_Y - 2, rowH = room / pgView.count, visible, i, hw = 0, hx;
+
+    if (rowH > 26)
+        rowH = 26;
+    if (rowH < 19)
+        rowH = 19;
+    visible = room / rowH;
+    if (pgView.cursor < pgTop)
+        pgTop = pgView.cursor;
+    if (pgView.cursor >= pgTop + visible)
+        pgTop = pgView.cursor - visible + 1;
+    if (pgTop > pgView.count - visible)
+        pgTop = pgView.count - visible;
+    if (pgTop < 0)
+        pgTop = 0;
+
+    guiDrawBGPlasma();
+    fntRenderString(RIPPS2_DIA_FONT, 20, 16, ALIGN_NONE, 0, 0, pgView.title, gTheme->selTextColor);
+    rmDrawLine(20, 46, 620, 46, gColWhite);
+
+    for (i = 0; i < visible && pgTop + i < pgView.count; i++) {
+        const ripps2_page_row_t *r = &pgView.rows[pgTop + i];
+        int on = pgTop + i == pgView.cursor, y = PG_Y + i * rowH, cy = y + rowH / 2, lx = ED_X + 4, lw = 0, vRight = ED_RIGHT;
+        if (on) {
+            rmDrawRect(ED_X - 6, y, ED_RIGHT - ED_X + 12, rowH - 1, ED_PRIM(0x1E, 0x3C, 0x96, 0x58));
+            rmDrawRect(ED_X - 6, y, 3, rowH - 1, ED_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+        }
+        if (r->value != NULL) {
+            lw = rmUnScaleX(fntCalcDimensions(RIPPS2_DIA_FONT, r->label));
+            if (lw > 300)
+                lw = 300;
+        } else
+            lw = ED_RIGHT - lx;
+        fntRenderStringFit(RIPPS2_DIA_FONT, lx, cy, ALIGN_VCENTER, lw, r->label, on ? ED_LIT : ED_SOFT, on);
+        if (r->sky != NULL) { // the sky, as BIBLE draws it: top to horizon, horizon to floor
+            int sw = 44, sh = rowH - 6, sx = ED_RIGHT - sw, sy = y + 2, hz = sy + sh * 290 / 480;
+            rmDrawQuadGouraud(sx, sy, pgRaw(r->sky[0]), sx + sw, sy, pgRaw(r->sky[0]), sx, hz, pgRaw(r->sky[1]), sx + sw, hz, pgRaw(r->sky[1]));
+            rmDrawQuadGouraud(sx, hz, pgRaw(r->sky[1]), sx + sw, hz, pgRaw(r->sky[1]), sx, sy + sh, pgRaw(r->sky[2]), sx + sw, sy + sh, pgRaw(r->sky[2]));
+            vRight = sx - 8;
+        }
+        if (r->value != NULL) {
+            int vw = rmUnScaleX(fntCalcDimensions(RIPPS2_DIA_FONT, r->value)), vRoom = vRight - (lx + lw + 16);
+            int vx = vw > vRoom ? vRight - vRoom : vRight - vw;
+            fntRenderStringFit(RIPPS2_DIA_FONT, vx, cy, ALIGN_VCENTER, vRoom, r->value, on ? ED_LIT : ED_SOFT, on);
+        }
+    }
+    if (pgView.count > visible) { // where you are on a long page
+        int h = visible * rowH, bar = h * visible / pgView.count;
+        rmDrawRect(ED_RIGHT + 10, PG_Y + h * pgTop / pgView.count, 2, bar < 8 ? 8 : bar, ED_PRIM(0x6A, 0x9A, 0xFF, 0x60));
+    }
+    rmDrawLine(20, tipY, 620, tipY, ED_PRIM(0x4A, 0x72, 0xDC, 0x40));
+    if (cur->tip != NULL)
+        mdTip(cur->tip, ED_X + 4, tipY + 12, ED_RIGHT - ED_X - 8);
+
+    if (cur->confirm != NULL)
+        hw += 24 + ripps2HintWidth(cur->confirm) + 18;
+    if (cur->clears)
+        hw += 24 + ripps2HintWidth(_t("CLEAR")) + 18;
+    hw += 24 + ripps2HintWidth(_t("BACK"));
+    hx = (640 - hw) / 2;
+    if (cur->confirm != NULL)
+        edHint(gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, cur->confirm, &hx, hintY + 10);
+    if (cur->clears)
+        edHint(SQUARE_ICON, _t("CLEAR"), &hx, hintY + 10);
+    edHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, _t("BACK"), &hx, hintY + 10);
+}
+
+int ripps2Page(const char *title, const ripps2_page_row_t *rows, int count, int *cursor, int *action)
+{
+    int backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE, c = *cursor;
+
+    if (c >= count)
+        c = count - 1;
+    if (c < 0)
+        c = 0;
+    *action = RIPPS2_PAGE_CHOOSE;
+    pgView.title = title;
+    pgView.rows = rows;
+    pgView.count = count;
+    while (1) {
+        const ripps2_page_row_t *r = &rows[c];
+        readPads();
+        pgView.cursor = c;
+        rmStartFrame();
+        pgDraw();
+        rmEndFrame();
+        if (getKey(KEY_UP)) { // round from the first to the last, as Settings does
+            c = c > 0 ? c - 1 : count - 1;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN)) {
+            c = c < count - 1 ? c + 1 : 0;
+            sfxPlay(SFX_CURSOR);
+        } else if (r->steps && getKey(KEY_LEFT)) {
+            sfxPlay(SFX_CURSOR);
+            *action = RIPPS2_PAGE_PREV;
+            break;
+        } else if (r->steps && getKey(KEY_RIGHT)) {
+            sfxPlay(SFX_CURSOR);
+            *action = RIPPS2_PAGE_NEXT;
+            break;
+        } else if (r->confirm != NULL && getKeyOn(gSelectButton)) {
+            sfxPlay(r->steps ? SFX_CURSOR : SFX_CONFIRM);
+            *action = r->steps ? RIPPS2_PAGE_NEXT : RIPPS2_PAGE_CHOOSE;
+            break;
+        } else if (r->clears && getKeyOn(KEY_SQUARE)) {
+            sfxPlay(SFX_CANCEL);
+            *action = RIPPS2_PAGE_CLEAR;
+            break;
+        } else if (getKeyOn(backKey)) {
+            sfxPlay(SFX_CANCEL);
+            *cursor = c;
+            return -1;
+        }
+    }
+    *cursor = c;
+    return c;
+}
+
+int ripps2PageList(const char *const *items, int count, int start)
+{
+    int r;
+    edBehind = pgDraw;
+    r = edMenuFrom(items, count, start);
+    edBehind = NULL;
+    return r;
+}
