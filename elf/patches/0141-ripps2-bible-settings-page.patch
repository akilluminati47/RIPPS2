+    guiMsgBoxSound(SFX_ERROR);
+    snprintf(msg, sizeof(msg), _t("BIBLE's settings file (%s) could not be written. Check that the memory card is in and has room, then try again."), blSetPath);
+    guiMsgBox(msg, 0, NULL);
+}
+
+// ---- launch keys (build 141) ----
+//
+// BIBLE's spec: "for each button its name and up to ten paths picked with the Memory Files browser (choose an ELF instead of
+// typing a path), plus ARG_<KEY>_E<n>". BIBLE tries a button's paths in order and starts the first it finds; with a settings file,
+// a button with no lines starts nothing, and a file with no paths at all sends BIBLE to its rescue mode, so the last path stays.
+#define BL_KEYS  17
+#define BL_PATHS 10
+#define BL_ARGS  8
+static const char *const blKeyIds[BL_KEYS] = {"AUTO", "CROSS", "CIRCLE", "SQUARE", "TRIANGLE", "UP", "DOWN", "LEFT", "RIGHT", "L1", "R1", "L2", "R2", "L3", "R3", "START", "SELECT"};
+
+static const struct
+{
+    const char *command, *word;
+} blCommands[] = {
+    {"$OSDSYS", N_("The console's browser")},
+    {"$CDVD", N_("The disc in the tray")},
+    {"$CDVD_NO_PS2LOGO", N_("The disc, without the PS2 logo")},
+    {"$CREDITS", N_("BIBLE's credits")},
+};
+#define BL_COMMANDS ((int)(sizeof(blCommands) / sizeof(blCommands[0])))
+
+// How many paths the whole file has
+static int blPathsInFile(void)
+{
+    const char *p = blText, *e;
+    char k[48];
+    int len, n = 0;
+    while (*p) {
+        const char *eq;
+        e = strchr(p, '\n');
+        len = e != NULL ? (int)(e - p) : (int)strlen(p);
+        blKey(p, len, k, sizeof(k));
+        if (!strncasecmp(k, "LK_", 3) && (eq = memchr(p, '=', len)) != NULL) {
+            eq++;
+            while (eq < p + len && (*eq == ' ' || *eq == '\t' || *eq == '\r'))
+                eq++;
+            n += eq < p + len;
+        }
+        p = e != NULL ? e + 1 : p + len;
+    }
+    return n;
+}
+
+// The card's BIBLE cannot reach this path (its name for the build, or NULL): it moves on to the next
+static const char *blBuildMisses(const char *path)
+{
+    const char *b;
+    if (strncmp(blSetPath, "mc", 2) || (blSetPath[2] != '0' && blSetPath[2] != '1'))
+        return NULL;
+    if ((b = blCards[blSetPath[2] - '0'].bibleBuild) == NULL)
+        return NULL;
+    if (!strncasecmp(path, "mmce", 4))
+        return strcmp(b, "MMCE") ? b : NULL;
+    if (!strncasecmp(path, "mx4sio", 6) || !strncasecmp(path, "massX", 5))
+        return strcmp(b, "MX4SIO") ? b : NULL;
+    if (!strncasecmp(path, "hdd", 3) || !strncasecmp(path, "ata", 3))
+        return b; // a card's BIBLE has neither driver
+    return NULL;
+}
+
+// A path the browser chose, as BIBLE's settings write it; 0 when it has no way to say it
+static int blPickedPath(const char *picked, int bdmType, char *out, int size)
+{
+    if (!strncmp(picked, "pfs0:", 5)) // the HDD's OPL home
+        return gOPLPart[0] != '\0' && snprintf(out, size, "%s:pfs:/%s", gOPLPart, picked[5] == '/' ? picked + 6 : picked + 5) < size;
+    return blPathFor(1, picked, bdmType, out, size);
+}
+
+static int blPathSet(const char *id, int e, const char *path)
+{
+    char key[32], val[256];
+    int i;
+
+    snprintf(key, sizeof(key), "LK_%s_E%d", id, e);
+    if (path == NULL || !path[0]) {
+        if (blIniGet(key, val, sizeof(val)) && val[0] && blPathsInFile() <= 1) {
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox(_t("BIBLE needs at least one path in its settings, or it starts in its rescue mode, so this one stays."), 0, NULL);
+            return 0;
+        }
+        snprintf(key, sizeof(key), "ARG_%s_E%d", id, e);
+        for (i = 0; i < BL_ARGS * 2 && blIniGet(key, val, sizeof(val)); i++)
+            blIniEdit(key, 0, NULL, id);
+        snprintf(key, sizeof(key), "LK_%s_E%d", id, e);
+        return blIniEdit(key, 0, NULL, id);
+    }
+    return blIniEdit(key, 0, path, id);
+}
+
+// One path's arguments: BIBLE hands over one per ARG_ line, in the file's order
+static void blArgsMenu(const char *id, const char *button, int e)
+{
+    static ripps2_page_row_t rows[BL_ARGS];
+    static char labels[BL_ARGS][32], vals[BL_ARGS][128], title[96], where[64];
+    char key[32], text[128];
+    int cursor = 0, n, i, pick, action;
+
+    snprintf(key, sizeof(key), "ARG_%s_E%d", id, e);
+    snprintf(where, sizeof(where), _t("%s, path %d"), button, e);
+    snprintf(title, sizeof(title), _t("Arguments: %s"), where);
+    while (1) {
+        for (n = 0; n < BL_ARGS; n++) {
+            int has = blIniGetN(key, n, vals[n], sizeof(vals[n]));
+            snprintf(labels[n], sizeof(labels[n]), _t("Argument %d"), n + 1);
+            memset(&rows[n], 0, sizeof(rows[n]));
+            rows[n].label = labels[n];
+            rows[n].value = has ? vals[n] : "-";
+            rows[n].tip = _t("BIBLE hands these to the program, in this order.");
+            rows[n].confirm = _t("EDIT");
+            rows[n].clears = has;
+            if (!has) {
+                n++;
+                break; // one empty row to add to
+            }
+        }
+        pick = ripps2Page(title, rows, n, &cursor, &action);
+        if (pick < 0)
+            return;
+        if (action == RIPPS2_PAGE_CLEAR) {
+            if (!blIniEdit(key, pick, NULL, id))
+                blIniFailed();
+            continue;
+        }
+        i = blIniGetN(key, pick, text, sizeof(text));
+        if (!i)
+            text[0] = '\0';
+        if (diaShowKeyb(text, sizeof(text), 0, labels[pick]) && !blIniEdit(key, pick, text[0] ? text : NULL, id))
+            blIniFailed();
+        readPads();
+    }
+}
