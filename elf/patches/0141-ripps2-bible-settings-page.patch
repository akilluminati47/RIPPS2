+// How many of the buttons start something
+static int blKeysSet(void)
+{
+    char key[32], val[256];
+    int k, e, n = 0;
+    for (k = 0; k < BL_KEYS; k++)
+        for (e = 1; e <= BL_PATHS; e++) {
+            snprintf(key, sizeof(key), "LK_%s_E%d", blKeyIds[k], e);
+            if (blIniGet(key, val, sizeof(val)) && val[0]) {
+                n++;
+                break;
+            }
+        }
+    return n;
+}
