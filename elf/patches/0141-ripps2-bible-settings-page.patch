+
+    snprintf(title, sizeof(title), _t("Launch Keys: %s"), button);
+    while (1) {
+        snprintf(key, sizeof(key), "NAME_%s", id);
+        blIniGet(key, vals[0], sizeof(vals[0]));
+        memset(rows, 0, sizeof(rows));
+        rows[0].label = _t("Name");
+        rows[0].value = vals[0][0] ? vals[0] : "-";
+        rows[0].tip = locked ? _t("BOOT LOCK holds this line. Turn BOOT LOCK off to change it.") : _t("What BIBLE's splash calls this button, with Splash on Logo and Names.");
+        rows[0].confirm = locked ? NULL : _t("EDIT");
+        rows[0].clears = !locked && vals[0][0];
+        for (e = 1; e <= BL_PATHS; e++) {
+            const char *miss;
+            snprintf(key, sizeof(key), "LK_%s_E%d", id, e);
+            blIniGet(key, vals[e], sizeof(vals[e]));
+            snprintf(labels[e - 1], sizeof(labels[e - 1]), _t("Path %d"), e);
+            rows[e].label = labels[e - 1];
+            rows[e].value = vals[e][0] ? vals[e] : "-";
+            rows[e].confirm = locked && e == 1 ? NULL : _t("CHANGE");
+            rows[e].clears = !(locked && e == 1) && vals[e][0];
+            rows[e].tip = tips[e];
