+// mc0:/SYS-CONF/PS2BBL.TMP beside the file
+static int blTmpPath(char *out, int size)
+{
+    const char *dot = strrchr(blSetPath, '.');
+    if (dot == NULL || strncmp(blSetPath, "mc", 2))
+        return 0;
+    return snprintf(out, size, "%.*s.TMP", (int)(dot - blSetPath), blSetPath) < size;
+}
+
+// A power cut between taking the old file out and naming the new one left only the temporary one: it is the file
+static void blIniRecover(void)
+{
+    char tmp[104];
+    struct stat st;
+    if (!blTmpPath(tmp, sizeof(tmp)) || stat(tmp, &st) != 0)
+        return;
+    if (stat(blSetPath, &st) == 0)
+        remove(tmp);
+    else if (blMcRename(blSetPath[2] - '0', tmp + 5, strrchr(blSetPath, '/') + 1))
+        ripps2Diag("bible: %s came back from its temporary copy", blSetPath);
+}
+
+// The spec's safe write: a temporary file, read back whole, then it takes the old one's name, so a pulled card leaves BIBLE
+// a whole file. 1 when the file holds blText
+static int blIniFlush(void)
+{
+    char tmp[104];
+    int n = strlen(blText), waited = 0, fd, got = 0, ok = 0;
+
+    if (!blDirty)
+        return 1;
+    while (ioWorkPending() && waited++ < 100) // let a settings save or art read finish with the cards first
+        DelayThread(10000);
+    if (!blTmpPath(tmp, sizeof(tmp)))
+        ok = blWrite(blSetPath, blText, n) == 0;
+    else if (blWrite(tmp, blText, n) == 0) {
+        if ((fd = open(tmp, O_RDONLY)) >= 0) {
+            got = read(fd, blOut, sizeof(blOut));
+            close(fd);
+        }
+        if (got == n && !memcmp(blOut, blText, n)) {
+            remove(blSetPath);
+            ok = blMcRename(blSetPath[2] - '0', tmp + 5, strrchr(blSetPath, '/') + 1);
+            if (!ok) { // the card would not rename it: written straight
+                ok = blWrite(blSetPath, blText, n) == 0;
+                remove(tmp);
+            }
+        } else
+            remove(tmp);
+    }
+    ripps2Diag("bible: %s %s (%d bytes)", blSetPath, ok ? "saved" : "NOT saved", n);
+    if (ok)
+        blDirty = 0;
+    return ok;
+}
