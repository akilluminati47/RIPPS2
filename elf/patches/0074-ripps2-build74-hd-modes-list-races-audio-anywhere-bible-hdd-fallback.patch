+// RIPPS2 build 74: room in the draw queue. gsKit checks no bounds in a release build (its check is
+// GSKIT_DEBUG only): a frame that outgrows its queue writes on past it, into whatever memory follows.
+// The HD modes (720p, 1080i) draw into gsKit's 256 KB persistent queues and replay them for every
+// band of the screen -- a quarter of the 1 MB the other modes get -- and RIPPS2's towers, orbs and
+// glass can fill that. Each primitive is now dropped once less than RM_QUEUE_RESERVE is left (the
+// frame loses detail, the console keeps running), and the last frame's use is kept so the towers
+// draw simpler before it comes to that.
+#define RM_QUEUE_RESERVE (16 * 1024)
+static unsigned int rmQueueDropped = 0;
+static int rmQueueUsePct = 0;
+
+static int rmQueueFull(void)
+{
+    GSQUEUE *q = gsGlobal != NULL ? gsGlobal->CurQueue : NULL;
+    if (q == NULL || q->pool_max[q->dbuf] == NULL)
+        return 0;
+    if ((u32)q->pool_max[q->dbuf] - (u32)q->pool_cur > RM_QUEUE_RESERVE)
+        return 0;
+    if (rmQueueDropped++ == 0)
+        LOG("RENDERMAN: draw queue full in vmode %d; dropping primitives this frame\n", vmode);
+    return 1;
+}
+
+static void rmQueueFrameEnd(void)
+{
+    GSQUEUE *q = gsGlobal != NULL ? gsGlobal->CurQueue : NULL;
+    if (q != NULL && q->pool_max[q->dbuf] != NULL && q->pool[q->dbuf] != NULL) {
+        u32 size = (u32)q->pool_max[q->dbuf] - (u32)q->pool[q->dbuf];
+        u32 used = (u32)q->pool_cur - (u32)q->pool[q->dbuf];
+        rmQueueUsePct = size > 0 ? (int)((u64)used * 100 / size) : 0;
+    }
+    rmQueueDropped = 0;
+}
+
+int rmQueueBusy(void)
+{
+    return hires || rmQueueUsePct >= 60;
+}
