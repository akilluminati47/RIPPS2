+// RIPPS2 build 74: where the AUDIO folder is. Beside RIPPS2 first: the quickest, and where the boot
+// sound comes from before any drive is up. Then the memory cards and every drive that has started, at
+// its top or in its APPS folder, and the HDD's data home (where its ART is): so RIPPS2 started from a
+// memory card (BIBLE, quick) plays the AUDIO kept on the HDD or a USB drive. out gets the folder the
+// AUDIO folder is in ("...APPS/"), as oplGetRipps2Dir gives RIPPS2's own. 1 when one was found.
+static int audioHas(const char *base)
+{
+    char path[280];
+    DIR *d;
+    snprintf(path, sizeof(path), "%sAUDIO", base);
+    if ((d = opendir(path)) == NULL) {
+        snprintf(path, sizeof(path), "%sSOUND", base);
+        d = opendir(path);
+    }
+    if (d == NULL) {
+        snprintf(path, sizeof(path), "%sMUSIC", base);
+        d = opendir(path);
+    }
+    if (d != NULL)
+        closedir(d);
+    return d != NULL;
+}
+
+static char audioBase[256];
+static volatile int audioBaseFound = 0;
+
+// searchDrives: only on the IO worker (the boot's sound load, ripps2AudioLateCheck): a memory card
+// must never be asked from two threads at once. Every other caller takes what was found.
+int ripps2AudioBase(char *out, int size, int searchDrives)
+{
+    static const char *const roots[] = {"mc0:/", "mc1:/", "mass0:/", "mass1:/", "mass2:/", "mass3:/", "mass4:/", "mass5:/",
+                                        "mass6:/", "mass7:/", "mmce0:/", "mmce1:/", NULL};
+    static const char *const subs[] = {"", "APPS/"};
+    char base[256];
+    int i, j;
+
+    if (audioBaseFound)
+        return snprintf(out, size, "%s", audioBase) < size;
+    if (oplGetRipps2Dir(base, sizeof(base) - 8) && audioHas(base)) {
+        snprintf(audioBase, sizeof(audioBase), "%s", base);
+        audioBaseFound = 1;
+        return snprintf(out, size, "%s", audioBase) < size;
+    }
+    if (searchDrives) {
+        if (gHDDPrefix != NULL && gHDDPrefix[0] && audioHas(gHDDPrefix)) {
+            snprintf(audioBase, sizeof(audioBase), "%s", gHDDPrefix);
+            audioBaseFound = 1;
+        }
+        for (i = 0; !audioBaseFound && roots[i] != NULL; i++) {
+            if (!strncmp(roots[i], "mass", 4) && !bdmSlotEverConnected(BDM_MODE + (roots[i][4] - '0')))
+                continue; // never ask an empty slot
+            for (j = 0; j < 2 && !audioBaseFound; j++) {
+                snprintf(base, sizeof(base), "%s%s", roots[i], subs[j]);
+                if (audioHas(base)) {
+                    snprintf(audioBase, sizeof(audioBase), "%s", base);
+                    audioBaseFound = 1;
+                }
+            }
+        }
+        if (!audioBaseFound && gHDDPrefix != NULL && (audioHas("pfs0:/") || audioHas("pfs0:/APPS/"))) {
+            snprintf(audioBase, sizeof(audioBase), audioHas("pfs0:/") ? "pfs0:/" : "pfs0:/APPS/");
+            audioBaseFound = 1;
+        }
+        if (audioBaseFound)
+            LOG("AUDIO: using the AUDIO folder in %s\n", audioBase);
