+// RIPPS2 build 73: texSetProbe(buf, size) makes texDiscoverLoad on the CALLING thread report the path
+// it would try (without its extension) into buf and load nothing: the cover art download asks every
+// source where its covers live. Other threads (the art worker) load as usual meanwhile.
+static char *texProbeOut = NULL;
+static int texProbeSize = 0, texProbeThread = -1;
