index b4c4031..e9be679 100644
--- a/modules/network/ps2ips/ps2ips.c
+++ b/modules/network/ps2ips/ps2ips.c
@@ -166,6 +166,26 @@ static void do_recv( void * rpcBuffer, int size )
 	s_offset = 64 - srest;
 	recvlen = MIN(BUFF_SIZE, recv_pkt->length);
 
+	/* RIPPS2 fix (build 73): the RA fix below cuts a tail longer than
+	   RESTS_EBUF_MAX after lwIP has already handed those bytes over, so
+	   they were lost from the TCP stream (TLS records then fail their
+	   MAC: the cover art download). Peek first and, when the tail would
+	   not fit, take only up to the last 64-byte boundary of the EE
+	   buffer; the rest stays queued in lwIP for the next call. A reply
+	   with no tail (every RA receive) is unchanged. */
+	if(recvlen > 64)
+	{
+		rlen = recv(recv_pkt->socket, lwip_buffer + s_offset, recvlen, recv_pkt->flags | MSG_PEEK);
+		if(rlen <= 0) goto recv_end;
+		if(rlen > 64)
+		{
+			erest = ((int)recv_pkt->ee_addr + rlen) & 0x3F;
+			if(erest > RESTS_EBUF_MAX)
+				rlen -= erest;
+		}
+		recvlen = rlen;
+	}
+
 	// Do actual TCP recv
 	rlen = recv(recv_pkt->socket, lwip_buffer + s_offset, recvlen, recv_pkt->flags);
 
@@ -579,7 +599,13 @@ static void do_gethostbyname( void *rpcBuffer, int size )
 		resPtr->result = 0;
 		resPtr->hostent.h_addrtype = ret->h_addrtype;
 		resPtr->hostent.h_length = ret->h_length;
-		memcpy(&resPtr->hostent.h_addr, &ret->h_addr_list[0], sizeof(resPtr->hostent.h_addr));
+		/* RIPPS2 fix (build 73): h_addr_list[0] points at the address;
+		   the stock code copied the pointer itself, so every lookup
+		   answered an IOP address (0x8001xxxx) instead of the host's.
+		   ps2sdk's EE wrapper still reads none of it (tcpip.h's h_addr
+		   macro shrinks its reply to 8 bytes): RIPPS2 asks with its own
+		   16-byte reply (ripps2art.c artLookup). */
+		memcpy(&resPtr->hostent.h_addr, ret->h_addr_list[0], sizeof(resPtr->hostent.h_addr));
 	}else{
 		resPtr->result = -1;
 	}
