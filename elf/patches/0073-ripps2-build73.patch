+// ---- BIBLE on the HDD (build 73) ----
+//
+// PS2BBL 1.2.0's HDD build (El Isra's HSYSTEM.XLF, signed for the HDD's boot area as FHDB's is) goes
+// in __mbr's boot area, the way FHDB, OSDMenu MBR and the HDD-OSD installers put theirs: sector 0x2000
+// of __mbr on, then the __mbr header pointed at it. RIPPS2's APA driver allows those two writes and no
+// others (modules/hdd/apa, ripps2InOsdArea); the partition table stays fenced. The boot program that
+// was there is read out first and kept in __sysconf/RIPPS2, and RESTORE puts it back. RIPPS2 itself is
+// copied to __sysconf too, so the HDD starts it with nothing else plugged in.
+
+#define BL_HDD_PART      "hdd0:__sysconf"
+#define BL_HDD_MNT       "pfs1:"
+#define BL_HDD_ELF       "hdd0:__sysconf:pfs:/RIPPS2/RIPPS2.ELF" // as PS2BBL's config reaches it
+#define BL_HDD_BACKUP    BL_HDD_MNT "/RIPPS2/MBR-BACKUP.KELF"
+#define BL_HDD_AREA      0x2000 // the boot area's first sector, inside __mbr
+#define BL_HDD_BLOCK     2      // sectors a write carries (fileXio's RPC buffer is small)
+#define BL_HDD_MAX_BACK  8192   // sectors of an old boot program kept (4 MB: any real one is far smaller)
+
+static int blHddUsable(void)
+{
+    return hddCheck() == 0 && fileXioDevctl("hdd0:", HDIOC_STATUS, NULL, 0, NULL, 0) == 0;
+}
+
+// sectors from the drive; 0 on success
+static int blHddRead(u32 lba, u32 count, unsigned char *out)
+{
+    unsigned char arg[sizeof(hddAtaTransfer_t)] __attribute__((aligned(64)));
+    while (count > 0) {
+        u32 n = count > 16 ? 16 : count;
+        ((hddAtaTransfer_t *)arg)->lba = lba;
+        ((hddAtaTransfer_t *)arg)->size = n;
+        if (fileXioDevctl("hdd0:", HDIOC_READSECTOR, arg, sizeof(arg), out, n * 512) < 0)
+            return -1;
+        lba += n;
+        count -= n;
+        out += n * 512;
+    }
+    return 0;
+}
+
+// The boot program as the __mbr header has it now: its first sector and its size in sectors
+static int blHddCurrent(u32 *start, u32 *size)
+{
+    unsigned char sec[512] __attribute__((aligned(64)));
+    if (blHddRead(0, 1, sec) != 0 || memcmp(sec + 0x10, "__mbr", 6) != 0)
+        return 0;
+    memcpy(start, sec + 0x130, 4); // apa_header_t mbr.osdStart / osdSize
+    memcpy(size, sec + 0x134, 4);
+    return 1;
+}
+
+// A boot program into the boot area, read back, then the header pointed at it; 0 on success
+static int blHddWriteBoot(const unsigned char *data, int size, const char *what)
+{
+    unsigned char buf[sizeof(hddAtaTransfer_t) + BL_HDD_BLOCK * 512] __attribute__((aligned(64)));
+    unsigned char check[BL_HDD_BLOCK * 512] __attribute__((aligned(64)));
+    char status[96];
+    iox_stat_t st;
+    hddSetOsdMBR_t mbr;
+    u32 start, sectors = (size + 511) / 512, i;
+
+    if (fileXioGetStat("hdd0:__mbr", &st) < 0)
+        return -1;
+    start = st.private_5 + BL_HDD_AREA;
+    for (i = 0; i < sectors; i += BL_HDD_BLOCK) {
+        u32 n = sectors - i > BL_HDD_BLOCK ? BL_HDD_BLOCK : sectors - i;
+        int bytes = size - (int)(i * 512);
+        if (bytes > (int)(n * 512))
+            bytes = n * 512;
+        if ((i & 31) == 0) {
+            snprintf(status, sizeof(status), "%s (%d%%)", what, (int)(i * 100 / sectors));
+            guiRenderTextScreen(status);
+        }
+        memset(((hddAtaTransfer_t *)buf)->data, 0, BL_HDD_BLOCK * 512);
+        memcpy(((hddAtaTransfer_t *)buf)->data, data + i * 512, bytes);
+        ((hddAtaTransfer_t *)buf)->lba = start + i;
+        ((hddAtaTransfer_t *)buf)->size = n;
+        if (fileXioDevctl("hdd0:", HDIOC_WRITESECTOR, buf, sizeof(hddAtaTransfer_t) + n * 512, NULL, 0) < 0)
+            return -2;
+        if (blHddRead(start + i, n, check) != 0 || memcmp(check, ((hddAtaTransfer_t *)buf)->data, n * 512) != 0)
+            return -3;
+    }
+    mbr.start = start;
+    mbr.size = sectors;
+    if (fileXioDevctl("hdd0:", HDIOC_SETOSDMBR, &mbr, sizeof(mbr), NULL, 0) < 0)
+        return -4;
+    return 0;
+}
+
+// The console's own setting that makes it start the HDD's boot program at power on (the HDDLOAD flag,
+// config block 1 of the MechaCon's): set when it is not, as the HDD installers do
+static int blHddBootOn(void)
+{
+    char cfg[15];
+    u32 res;
+    int tries, ret;
+
+    for (tries = 0; tries < 100 && (sceCdOpenConfig(0, 0, 1, &res) == 0 || (res & 0x9)); tries++)
+        DelayThread(10000);
+    if (tries >= 100)
+        return 0;
+    for (tries = 0; tries < 100 && ((ret = sceCdReadConfig(cfg, &res)) == 0 || (res & 0x9)); tries++)
+        DelayThread(10000);
+    sceCdCloseConfig(&res);
+    if (tries >= 100)
+        return 0;
+    if ((cfg[0] & 0x3) == 0x2)
+        return 1; // already on
+    cfg[0] = (cfg[0] & ~0x3) | 0x2;
+    for (tries = 0; tries < 100 && (sceCdOpenConfig(0, 1, 1, &res) == 0 || (res & 0x9)); tries++)
+        DelayThread(10000);
+    if (tries >= 100)
+        return 0;
+    for (tries = 0; tries < 100 && ((ret = sceCdWriteConfig(cfg, &res)) == 0 || (res & 0x9)); tries++)
+        DelayThread(10000);
+    sceCdCloseConfig(&res);
+    return tries < 100;
+}
+
+static int blHddMount(void)
+{
+    fileXioUmount(BL_HDD_MNT);
+    return fileXioMount(BL_HDD_MNT, BL_HDD_PART, FIO_MT_RDWR) == 0;
+}
+
+static void blHddInstall(void)
+{
+    char msg[900], boot[256], alt[160] = "";
+    unsigned char *old = NULL;
+    u32 oldStart = 0, oldSize = 0;
+    int ok, bootOn, kept = 0, keptConfig = 0, len, fd, r;
+
+    if (!ripps2GetBootPath(boot, sizeof(boot)))
+        boot[0] = '\0';
+    // RIPPS2 as it is now goes second, when PS2BBL's HDD build can reach it (a card or a USB drive)
+    if (boot[0] && strncmp(boot, "hdd", 3) && strncmp(boot, "pfs", 3))
+        blPathFor(0, boot, ripps2GetBootBdmType(), alt, sizeof(alt));
+    if (!strncmp(alt, "massX:", 6))
+        alt[0] = '\0'; // the HDD build has no MX4SIO driver
+
+    snprintf(msg, sizeof(msg),
+             "INSTALL BIBLE ON THE INTERNAL HDD\n"
+             "- RIPPS2 is copied to %s.\n"
+             "- The HDD's boot program now in __mbr is read out and kept in __sysconf/RIPPS2 (RESTORE puts it back).\n"
+             "- PS2BBL 1.2.0's HDD build is written in its place, and the console set to start it at power on.\n"
+             "- Its config, hdd0:__sysconf:pfs:/PS2BBL/CONFIG.INI, starts RIPPS2 first, BOOT LOCK on.\n"
+             "This needs a console that boots from its HDD (a fat PS2 with the network adapter). Keep it on until it says done.",
+             BL_HDD_ELF);
+    guiMsgBoxSound(SFX_MESSAGE);
+    guiMsgBoxStartOption("INSTALL BIBLE");
+    if (guiMsgBox(msg, 0, NULL) != 2)
+        return;
+
+    ioBlockOps(1);
+    if (!blHddMount()) {
+        ioBlockOps(0);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("RIPPS2 could not open the HDD's __sysconf partition, where BIBLE keeps its config. Nothing was changed.", 0, NULL);
+        return;
+    }
+    mkdir(BL_HDD_MNT "/RIPPS2", 0777);
+    mkdir(BL_HDD_MNT "/PS2BBL", 0777);
+
+    // 1. RIPPS2 onto the HDD (a copy that is already there is written over: it may be older)
+    if (!boot[0] || !blCopy(boot, BL_HDD_MNT "/RIPPS2/RIPPS2.ELF", "the HDD")) {
+        fileXioUmount(BL_HDD_MNT);
+        ioBlockOps(0);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("BIBLE could not copy RIPPS2 to the HDD's __sysconf partition. Check its free space. Nothing else was changed.", 0, NULL);
+        return;
+    }
+
+    // 2. what boots from the HDD now, kept (once: a repair never writes BIBLE over the first backup)
+    if ((fd = open(BL_HDD_BACKUP, O_RDONLY)) >= 0) {
+        close(fd);
+        kept = 1;
+    } else if (blHddCurrent(&oldStart, &oldSize) && oldSize > 0 && oldSize <= BL_HDD_MAX_BACK && oldStart >= BL_HDD_AREA) {
+        guiRenderTextScreen("BIBLE: keeping the HDD's boot program");
+        if ((old = memalign(64, oldSize * 512)) == NULL || blHddRead(oldStart, oldSize, old) != 0 ||
+            blWrite(BL_HDD_BACKUP, (const char *)old, oldSize * 512) != 0) {
+            free(old);
+            remove(BL_HDD_BACKUP);
+            fileXioUmount(BL_HDD_MNT);
+            ioBlockOps(0);
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox("BIBLE could not keep a copy of the HDD's boot program, so it stopped before changing it. RIPPS2 was copied to __sysconf; nothing else was changed.", 0, NULL);
+            return;
+        }
+        free(old);
+        kept = 1;
+    }
+
+    // 3. the config: one PS2BBL owners already have stays, BOOT LOCK set in it; else BIBLE's
+    len = 0;
+    if (blRead(BL_HDD_MNT "/PS2BBL/CONFIG.INI") >= 0) {
+        keptConfig = 1;
+        if ((len = blUnlocked(blText)) >= 0)
+            memcpy(blText, blOut, len + 1);
+    } else
+        len = blBibleConfig(alt, "");
+    if (len >= 0)
+        len = blLocked(blText, BL_HDD_ELF);
+    if (len < 0 || blWrite(BL_HDD_MNT "/PS2BBL/CONFIG.INI", blOut, len) != 0) {
+        fileXioUmount(BL_HDD_MNT);
+        ioBlockOps(0);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("BIBLE could not write its config to the HDD's __sysconf partition. The boot program was not changed.", 0, NULL);
+        return;
+    }
+    fileXioUmount(BL_HDD_MNT);
+
+    // 4. the boot program itself, then the console's setting
+    r = blHddWriteBoot(bible_hdd_xlf, (int)size_bible_hdd_xlf, "BIBLE: writing PS2BBL to the HDD's boot area");
+    bootOn = r == 0 && blHddBootOn();
+    ioBlockOps(0);
+    if (r != 0) {
+        guiMsgBoxSound(SFX_ERROR);
+        snprintf(msg, sizeof(msg), "BIBLE could not write the HDD's boot program (step %d). %s", -r,
+                 kept ? "The one that was there is kept in __sysconf/RIPPS2/MBR-BACKUP.KELF: BOOT LOADER > MANAGE > RESTORE puts it back." : "");
+        guiMsgBox(msg, 0, NULL);
+        return;
+    }
+    guiMsgBoxSound(bootOn ? SFX_SAVE : SFX_ERROR);
+    ok = snprintf(msg, sizeof(msg), "BIBLE is installed on the internal HDD and BOOT LOCK is on: at power on the console starts RIPPS2 from %s, at once.%s%s",
+                  BL_HDD_ELF, kept ? " The HDD's old boot program is kept (MANAGE > RESTORE)." : "",
+                  keptConfig ? " Your own PS2BBL config on the HDD was kept, BOOT LOCK set in it." : " Hold TRIANGLE at power on for the browser, START for a disc.");
+    if (!bootOn && ok < (int)sizeof(msg))
+        snprintf(msg + ok, sizeof(msg) - ok, " The console would not take the setting that starts its HDD at power on: set it with the HDD utility, or install again.");
+    guiMsgBox(msg, 0, NULL);
+}
+
+static void blHddRestore(void)
+{
+    unsigned char *data;
+    int fd, size, r;
+
+    guiMsgBoxSound(SFX_MESSAGE);
+    guiMsgBoxStartOption("RESTORE");
+    if (guiMsgBox("PUT BACK THE HDD'S OLD BOOT PROGRAM\nThe one BIBLE kept (__sysconf/RIPPS2/MBR-BACKUP.KELF) goes back in __mbr, in BIBLE's place. RIPPS2 and the PS2BBL config stay on __sysconf.", 0, NULL) != 2)
+        return;
+    ioBlockOps(1);
+    if (!blHddMount() || (fd = open(BL_HDD_BACKUP, O_RDONLY)) < 0) {
+        fileXioUmount(BL_HDD_MNT);
+        ioBlockOps(0);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("There is no kept boot program on this HDD. Nothing was changed.", 0, NULL);
+        return;
+    }
+    size = lseek(fd, 0, SEEK_END);
+    lseek(fd, 0, SEEK_SET);
+    data = size > 0 ? memalign(64, size) : NULL;
+    if (data == NULL || read(fd, data, size) != size) {
+        close(fd);
+        free(data);
+        fileXioUmount(BL_HDD_MNT);
+        ioBlockOps(0);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("RIPPS2 could not read the kept boot program. Nothing was changed.", 0, NULL);
+        return;
+    }
+    close(fd);
+    fileXioUmount(BL_HDD_MNT);
+    r = blHddWriteBoot(data, size, "BIBLE: putting the HDD's boot program back");
+    free(data);
+    ioBlockOps(0);
+    guiMsgBoxSound(r == 0 ? SFX_SAVE : SFX_ERROR);
+    guiMsgBox(r == 0 ? "The HDD's old boot program is back. BIBLE no longer starts from the HDD." : "RIPPS2 could not write the boot program back. Try again; the kept copy is untouched.", 0, NULL);
+}
+
+static int blHddHasBackup(void)
+{
+    int fd, has = 0;
+    ioBlockOps(1);
+    if (blHddMount() && (fd = open(BL_HDD_BACKUP, O_RDONLY)) >= 0) {
+        close(fd);
+        has = 1;
+    }
+    fileXioUmount(BL_HDD_MNT);
+    ioBlockOps(0);
+    return has;
+}
