+    {{(unsigned char *)TA5_DN, sizeof TA5_DN}, BR_X509_TA_CA, {BR_KEYTYPE_EC, {.ec = {24, (unsigned char *)TA5_EC_Q, sizeof TA5_EC_Q}}}},
+    {{(unsigned char *)TA6_DN, sizeof TA6_DN}, BR_X509_TA_CA, {BR_KEYTYPE_RSA, {.rsa = {(unsigned char *)TA6_RSA_N, sizeof TA6_RSA_N, (unsigned char *)TA6_RSA_E, sizeof TA6_RSA_E}}}},
+};
+#define RIPPS2_TAS_NUM 7
+
+#endif
