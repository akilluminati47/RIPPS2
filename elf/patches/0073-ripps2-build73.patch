+/*
+  RIPPS2 build 73: POPSTARTER on board.
+
+  POPSTARTER (krHACKen's PS1 launcher) rides inside RIPPS2.ELF as released. A PS1 launch that finds no
+  POPSTARTER of the user's own (the path set in Settings, the drive's POPS, APPS and top folders, the
+  game's own XX.<name>.ELF, the memory cards) writes this copy to the drive's POPS folder and goes on.
+  A copy the user already has always wins: nothing here overwrites a file.
+*/
+
+extern void *popstarter_elf_bin; // misc/popstarter_elf.bin: elf/popstarter/POPSTARTER.ELF
+extern int size_popstarter_elf_bin;
+
+#define POPSTARTER_ELF_SIZE  167700
+#define POPSTARTER_ELF_CRC32 0x59ebabb9u
+
+int ripps2PopstarterInstall(const char *elfPath)
+{
+    char dir[256];
+    const char *slash = strrchr(elfPath, '/'), *bslash = strrchr(elfPath, '\\');
+    const char *sep = slash > bslash ? slash : bslash;
+    int fd, done = 0;
+
+    if (size_popstarter_elf_bin != POPSTARTER_ELF_SIZE ||
+        crc32(0L, (const unsigned char *)&popstarter_elf_bin, size_popstarter_elf_bin) != POPSTARTER_ELF_CRC32)
+        return 0;
+    if (sep == NULL || (int)(sep - elfPath) >= (int)sizeof(dir))
+        return 0;
+    fd = open(elfPath, O_RDONLY);
+    if (fd >= 0) { // one is there already: it is the user's, and it is used as it is
+        close(fd);
+        return 1;
+    }
+    snprintf(dir, sizeof(dir), "%.*s", (int)(sep - elfPath), elfPath);
+    mkdir(dir, 0777); // the POPS folder: there already when the drive has PS1 games
+
+    fd = open(elfPath, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd < 0) {
+        LOG("POPSTARTER: cannot write %s\n", elfPath);
+        return 0;
+    }
+    while (done < size_popstarter_elf_bin) {
+        int n = size_popstarter_elf_bin - done;
+        if (n > EMBER_CHUNK)
+            n = EMBER_CHUNK;
+        if (write(fd, (const unsigned char *)&popstarter_elf_bin + done, n) != n)
+            break;
+        done += n;
+        ripps2LaunchPump();
+    }
+    close(fd);
+    if (done != size_popstarter_elf_bin) {
+        LOG("POPSTARTER: install failed (%d of %d bytes)\n", done, size_popstarter_elf_bin);
+        remove(elfPath);
+        return 0;
+    }
+    LOG("POPSTARTER: installed %s\n", elfPath);
+    return 1;
+}
