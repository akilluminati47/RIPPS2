diff --git a/src/ripps2art.c b/src/ripps2art.c
new file mode 100644
index 0000000..e4bfe96
--- /dev/null
+++ b/src/ripps2art.c
@@ -0,0 +1,696 @@
+/*
+  RIPPS2 build 73: Cover Art Download (Settings > Network, after NBD Server).
+
+  For every PS2 game in the started lists that has no cover, the PS2 itself fetches one over HTTPS from
+  xlenore's ps2-covers collection on GitHub (the source ORBIT's launcher uses) and writes it into that
+  drive's ART folder as <ID>_COV.png, where RIPPS2 already looks for covers. Nothing else is touched:
+  a game that already has a cover keeps it. The collection's covers are 512x736 JPEGs and RIPPS2 reads
+  PNG only, so each one is decoded here (libjpeg-turbo, its DCT scaling does most of the shrink) and
+  saved at OPL's cover size, 140x200, like every other cover on the drive.
+
+  Each source is asked where its covers live by drawing nothing: texDiscoverLoad in probe mode reports
+  the path the source would try (texSetProbe), so every drive type, HDD and network included, gets
+  the folder it really reads from.
+
+  TLS is BearSSL 0.6 by Thomas Pornin (MIT), built by RIPPS2's build.sh from elf/bearssl. The trust
+  anchors (include/ripps2art_ta.h) are the root CAs GitHub's content host has been seen to chain to.
+  The certificate's dates are checked against the console's clock, or this build's date when the
+  clock is behind it (a dead clock battery reads 2000).
+
+  Receiving: libps2ips forwards recv over SIF RPC, and its short or unaligned pieces travel a second
+  path that misbehaved on hardware for the achievements client (ranet.c). Every recv here lands in a
+  64-byte-aligned bounce buffer and asks for a multiple of 64 bytes, and a failure is reported with
+  its stage and BearSSL's error code, so a tester's photo says where it broke. The IOP side used to
+  drop the end of a piece whose tail did not fit its reply (TLS then failed with BR_ERR_BAD_MAC);
+  RIPPS2's ps2ips.irx now leaves such a tail queued for the next call.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <strings.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <kernel.h>
+#include <delaythread.h>
+#include <timer.h>
+#include <libcdvd.h>
+#include <sifrpc.h>
+#include <ps2ips.h>
+#include <ps2ip_rpc.h>
+#include <setjmp.h>
+#include <jpeglib.h>
+#include <png.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/pad.h"
+#include "include/sound.h"
+#include "include/ioman.h"
+#include "include/iosupport.h"
+#include "include/libview.h"
+#include "include/netsupport.h"
+#include "include/texcache.h"
+#include "include/artindex.h"
+#include "include/ripps2.h"
+
+#include <bearssl.h>
+#include "include/ripps2art_ta.h"
+#include "include/ripps2tint.h" // RIPPSettings Color Theme: last, so every colour below goes through it
+
+#define ART_HOST      "raw.githubusercontent.com"
+#define ART_URI       "/xlenore/ps2-covers/main/covers/default/%s.jpg"
+#define ART_MAX_BYTES (1024 * 1024) // a cover is ~200 KB
+#define ART_MAX_GAMES 512
+#define ART_RECV_MAX  960 // the IOP side moves 1024 bytes a call (ranet.c rule 3)
+
+#define AR_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define AR_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define AR_DIM  GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+#define AR_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+
+typedef struct
+{
+    char serial[16]; // SLUS-20398, the collection's name
+    char path[256];  // <prefix>ART/SLUS_203.98_COV, without the extension
+    char title[64];
+} art_target_t;
+
+static art_target_t *artTargets = NULL;
+static int artCount = 0;
+
+// ---------------------------------------------------------------- the page
+static const char *artStage = "";
+static char artLine[96] = "", artLine2[96] = "";
+static int artDone = 0, artGot = 0, artMissing = 0, artFailed = 0;
+
+static void artDraw(void)
+{
+    rmStartFrame();
+    ripps2DrawBackground();
+    ripps2DrawPagePanel();
+    fntRenderString(gTheme->fonts[4], 60, 66, ALIGN_VCENTER, 0, 0, "COVER ART", AR_LIT);
+    rmDrawLine(60, 82, 580, 82, AR_PRIM(0x4A, 0x72, 0xDC, 0x60));
+    fntRenderString(RIPPS2_CASE_FONT, 60, 110, ALIGN_VCENTER, 0, 0, artStage, AR_SOFT);
+    if (artCount > 0) {
+        char n[64];
+        snprintf(n, sizeof(n), "%d / %d", artDone, artCount);
+        fntRenderString(gTheme->fonts[4], 60, 150, ALIGN_VCENTER, 0, 0, n, AR_LIT);
+        int w = 520 * artDone / artCount;
+        rmDrawRect(60, 170, 520, 6, AR_PRIM(0x10, 0x1C, 0x40, 0x80));
+        rmDrawRect(60, 170, w, 6, AR_PRIM(0x5C, 0x98, 0xFF, 0x80));
+        snprintf(n, sizeof(n), "%d new, %d not in the collection, %d failed", artGot, artMissing, artFailed);
+        fntRenderString(RIPPS2_CASE_FONT, 60, 196, ALIGN_VCENTER, 0, 0, n, AR_DIM);
+    }
+    fntRenderString(RIPPS2_CASE_FONT, 60, 240, ALIGN_VCENTER, 520, 0, artLine, AR_SOFT);
+    fntRenderString(RIPPS2_CASE_FONT, 60, 264, ALIGN_VCENTER, 520, 0, artLine2, AR_DIM);
+    int hx = 60;
+    hx = ripps2HintText(hx, 448, gSelectButton == KEY_CIRCLE ? "Cross: stop" : "Circle: stop", AR_SOFT);
+    (void)hx;
+    rmEndFrame();
+}
+
+static int artCancelled(void)
+{
+    readPads();
+    return getKeyOn(gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE);
+}
+
+// ---------------------------------------------------------------- what to fetch
+// OPL's startup, SLUS_203.98, as the collection names it: SLUS-20398
+static int artSerial(const char *startup, char *out, int size)
+{
+    int i;
+    if (startup == NULL || strlen(startup) != 11 || startup[4] != '_' || startup[8] != '.')
+        return 0;
+    for (i = 0; i < 4; i++)
+        if (startup[i] < 'A' || startup[i] > 'Z')
+            return 0;
+    for (i = 5; i < 11; i++)
+        if (i != 8 && (startup[i] < '0' || startup[i] > '9'))
+            return 0;
+    snprintf(out, size, "%.4s-%.3s%.2s", startup, startup + 5, startup + 9);
+    return 1;
+}
+
+static int artHasCover(const char *base)
+{
+    static const char *const ext[] = {"png", NULL}; // what texDiscoverLoad reads: a lone .jpg shows nothing
+    char p[272];
+    int i, fd;
+    for (i = 0; ext[i] != NULL; i++) {
+        snprintf(p, sizeof(p), "%s.%s", base, ext[i]);
+        if ((fd = open(p, O_RDONLY)) >= 0) {
+            close(fd);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static void artCollect(void)
+{
+    int mode, id;
+    GSTEXTURE probeTex;
+
+    artCount = 0;
+    for (mode = 0; mode < MODE_COUNT && artCount < ART_MAX_GAMES; mode++) {
+        if (mode == APP_MODE || mode == FAV_MODE || mode == MIX_MODE)
+            continue; // apps have no covers here; Favorites and All Games repeat other lists
+        opl_io_module_t *mod = oplGetModule(mode);
+        item_list_t *list = mod != NULL ? mod->support : NULL;
+        if (list == NULL || !list->enabled || list->itemGetCount == NULL || list->itemGetStartup == NULL || list->itemGetImage == NULL)
+            continue;
+        int count = list->itemGetCount(list);
+        for (id = 0; id < count && artCount < ART_MAX_GAMES; id++) {
+            if (libListRowView(list, id) == LIB_VIEW_PS1)
+                continue; // the collection is PS2 covers
+            char *startup = list->itemGetStartup(list, id);
+            art_target_t *t = &artTargets[artCount];
+            if (!artSerial(startup, t->serial, sizeof(t->serial)))
+                continue;
+            t->path[0] = '\0';
+            memset(&probeTex, 0, sizeof(probeTex));
+            texSetProbe(t->path, sizeof(t->path)); // where this source reads covers from
+            list->itemGetImage(list, "ART", 1, startup, "COV", &probeTex, GS_PSM_CT24);
+            texSetProbe(NULL, 0);
+            if (t->path[0] == '\0' || artHasCover(t->path))
+                continue;
+            snprintf(t->title, sizeof(t->title), "%s", list->itemGetName != NULL ? list->itemGetName(list, id) : startup);
+            artCount++;
+        }
+    }
+}
+
+// ---------------------------------------------------------------- TLS
+static br_ssl_client_context sc;
+static br_x509_minimal_context xc;
+static unsigned char artIo[BR_SSL_BUFSIZE_BIDI];
+static br_sslio_context ioc;
+static int artSock = -1;
+static unsigned char artBounce[ART_RECV_MAX] __attribute__((aligned(64)));
+
+static int artSockRead(void *ctx, unsigned char *buf, size_t len)
+{
+    int ask = (int)(len < ART_RECV_MAX ? len : ART_RECV_MAX);
+    if (ask >= 64)
+        ask &= ~63; // whole 64-byte blocks: the DMA path, not the side path
+    int n = recv(*(int *)ctx, artBounce, ask, 0);
+    if (n <= 0)
+        return -1;
+    memcpy(buf, artBounce, n);
+    return n;
+}
+
+static int artSockWrite(void *ctx, const unsigned char *buf, size_t len)
+{
+    int n = send(*(int *)ctx, (void *)buf, len, 0);
+    return n <= 0 ? -1 : n;
+}
+
+// days since 1 January of year 0 (proleptic Gregorian), what BearSSL's certificate check takes
+static unsigned int artDays(int y, int m, int d)
+{
+    y -= m <= 2;
+    int era = (y >= 0 ? y : y - 399) / 400;
+    unsigned int yoe = (unsigned int)(y - era * 400);
+    unsigned int doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+    unsigned int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    return (unsigned int)(era * 146097 + (int)doe - 719468) + 719528;
+}
+
+static int bcd(unsigned char v)
+{
+    return (v >> 4) * 10 + (v & 0x0F);
+}
+
+static void artClock(unsigned int *days, unsigned int *secs)
+{
+    static const char *const mon = "JanFebMarAprMayJunJulAugSepOctNovDec";
+    const char *b = __DATE__; // "Oct  5 2026": this build's own date
+    int bm = (int)((strstr(mon, (char[]){b[0], b[1], b[2], 0}) - mon) / 3) + 1;
+    unsigned int built = artDays(atoi(b + 7), bm, atoi(b + 4));
+    sceCdCLOCK c;
+    *days = built;
+    *secs = 12 * 3600;
+    if (sceCdReadClock(&c)) {
+        unsigned int now = artDays(2000 + bcd(c.year), bcd(c.month & 0x1F), bcd(c.day));
+        if (now >= built) { // a clock behind this build is a dead battery, not the date
+            *days = now;
+            *secs = bcd(c.hour) * 3600 + bcd(c.minute) * 60 + bcd(c.second);
+        }
+    }
+}
+
+// The session's randomness: the 64-bit timer, the CPU's cycle counter between sleeps of uneven
+// length, the clock and the pads, all through SHA-256. It keys a download of public pictures.
+static void artSeed(unsigned char seed[32])
+{
+    br_sha256_context h;
+    int i;
+    br_sha256_init(&h);
+    for (i = 0; i < 64; i++) {
+        u64 t = GetTimerSystemTime();
+        u32 c;
+        asm volatile("mfc0 %0, $9" : "=r"(c));
+        br_sha256_update(&h, &t, sizeof(t));
+        br_sha256_update(&h, &c, sizeof(c));
+        DelayThread(97 + (c & 0x3FF));
+    }
+    sceCdCLOCK clk;
+    if (sceCdReadClock(&clk))
+        br_sha256_update(&h, &clk, sizeof(clk));
+    int sx = 0, sy = 0;
+    padGetRightStick(&sx, &sy);
+    br_sha256_update(&h, &sx, sizeof(sx));
+    br_sha256_update(&h, &sy, sizeof(sy));
+    br_sha256_out(&h, seed);
+}
+
+// "185.199.108.133" as an address in network order
+static unsigned int artIp(const char *s)
+{
+    unsigned int v[4] = {0, 0, 0, 0};
+    sscanf(s, "%u.%u.%u.%u", &v[0], &v[1], &v[2], &v[3]);
+    return htonl((v[0] << 24) | (v[1] << 16) | (v[2] << 8) | v[3]);
+}
+
+// The host's address, asked of ps2ips.irx directly, in network order (0: no answer). ps2sdk's EE
+// gethostbyname never sees the address: tcpip.h's "#define h_addr h_addr_list[0]" turns the reply's
+// address member into a zero-length array, so the wrapper asks for an 8-byte reply and reads what
+// was left past it. Same server and call, with room for the address (offset 8).
+static unsigned int artLookup(const char *host)
+{
+    static SifRpcClientData_t cd;
+    static unsigned char buf[256] __attribute__((aligned(64)));
+    unsigned int v;
+    int k;
+
+    for (k = 0; cd.server == NULL && k < 100; k++) {
+        if (sceSifBindRpc(&cd, PS2IP_IRX, 0) < 0)
+            return 0;
+        if (cd.server == NULL)
+            nopdelay();
+    }
+    if (cd.server == NULL)
+        return 0;
+    memset(buf, 0, sizeof(buf));
+    snprintf((char *)buf, sizeof(buf), "%s", host);
+    if (sceSifCallRpc(&cd, PS2IPS_ID_GETHOSTBYNAME, 0, buf, sizeof(buf), buf, 16, NULL, NULL) < 0)
+        return 0;
+    memcpy(&k, buf, sizeof(k)); // result: 0 = found
+    memcpy(&v, buf + 8, sizeof(v));
+    if (k != 0 || buf[4] != AF_INET) // h_addrtype, little-endian s16
+        return 0;
+    k = ntohl(v) >> 24;
+    return (k == 0 || k == 127 || k >= 224) ? 0 : v; // nothing a public host cannot be
+}
+
+static void artClose(void)
+{
+    if (artSock >= 0) {
+        disconnect(artSock);
+        artSock = -1;
+    }
+}
+
+// One TLS session to the host, kept for the whole run (each cover is one request on it)
+static int artOpen(char *err, int errSize)
+{
+    static const char *const fallback[] = {"185.199.108.133", "185.199.109.133", "185.199.110.133", "185.199.111.133"};
+    static int tries = 0;
+    struct sockaddr_in a;
+    unsigned char seed[32];
+    unsigned int days, secs;
+
+    // the addresses to try: what DNS says, then GitHub's content addresses (the same four for years),
+    // each shown on the page as it is dialled, so a photo of a failure says where it went
+    unsigned int addr[8];
+    int n = 0, k, ok = 0;
+    artClose();
+    if ((addr[0] = artLookup(ART_HOST)) != 0)
+        n = 1;
+    for (k = 0; k < 4; k++)
+        addr[n++] = artIp(fallback[(tries + k) & 3]);
+    tries++;
+    for (k = 0; k < n && !ok; k++) {
+        unsigned int h = ntohl(addr[k]);
+        memset(&a, 0, sizeof(a));
+        a.sin_family = AF_INET;
+        a.sin_port = htons(443);
+        a.sin_addr.s_addr = addr[k];
+        snprintf(artLine2, sizeof(artLine2), "%s %u.%u.%u.%u%s", k < n - 4 ? "DNS" : "fallback", h >> 24, (h >> 16) & 255,
+                 (h >> 8) & 255, h & 255, n == 4 ? " (no DNS answer)" : "");
+        artDraw();
+        artSock = socket(AF_INET, SOCK_STREAM, 0);
+        if (artSock < 0) {
+            snprintf(err, errSize, "No socket (%d).", artSock);
+            return 0;
+        }
+        if (connect(artSock, (struct sockaddr *)&a, sizeof(a)) < 0)
+            artClose();
+        else
+            ok = 1;
+    }
+    if (!ok) {
+        snprintf(err, errSize, "Could not connect to %s (last tried %s).", ART_HOST, artLine2);
+        return 0;
+    }
+
+    br_ssl_client_init_full(&sc, &xc, RIPPS2_TAS, RIPPS2_TAS_NUM);
+    artClock(&days, &secs);
+    br_x509_minimal_set_time(&xc, days, secs);
+    br_ssl_engine_set_buffer(&sc.eng, artIo, sizeof(artIo), 1);
+    artSeed(seed);
+    br_ssl_engine_inject_entropy(&sc.eng, seed, sizeof(seed));
+    if (!br_ssl_client_reset(&sc, ART_HOST, 0)) {
+        snprintf(err, errSize, "TLS would not start (error %d).", br_ssl_engine_last_error(&sc.eng));
+        artClose();
+        return 0;
+    }
+    br_sslio_init(&ioc, &sc.eng, artSockRead, &artSock, artSockWrite, &artSock);
+    return 1;
+}
+
+// GET one cover on the open session. Returns the HTTP status (200 with *len bytes in buf), or -1
+// with err set when the session failed (the caller reopens it once).
+static int artGet(const char *serial, unsigned char *buf, int bufSize, int *len, char *err, int errSize)
+{
+    char req[256], head[2048];
+    int hl = 0, status = 0, clen = -1, got = 0;
+
+    snprintf(req, sizeof(req), "GET " ART_URI " HTTP/1.1\r\nHost: " ART_HOST "\r\nUser-Agent: RIPPS2\r\nAccept: image/jpeg\r\nConnection: keep-alive\r\n\r\n", serial);
+    if (br_sslio_write_all(&ioc, req, strlen(req)) < 0 || br_sslio_flush(&ioc) < 0)
+        goto tls;
+    // the header, a byte at a time out of BearSSL's buffer (no extra copies off the wire)
+    while (hl < (int)sizeof(head) - 1) {
+        if (br_sslio_read(&ioc, head + hl, 1) <= 0)
+            goto tls;
+        hl++;
+        if (hl >= 4 && !memcmp(head + hl - 4, "\r\n\r\n", 4))
+            break;
+    }
+    head[hl] = '\0';
+    if (sscanf(head, "HTTP/1.%*d %d", &status) != 1) {
+        snprintf(err, errSize, "Not an HTTP answer.");
+        return -1;
+    }
+    for (char *p = head; (p = strchr(p, '\n')) != NULL;) {
+        p++;
+        if (!strncasecmp(p, "Content-Length:", 15))
+            clen = atoi(p + 15);
+        else if (!strncasecmp(p, "Transfer-Encoding:", 18) && !strncasecmp(p + 18 + strspn(p + 18, " "), "chunked", 7)) {
+            snprintf(err, errSize, "The server sent a chunked answer.");
+            return -1;
+        }
+    }
+    if (clen < 0) {
+        snprintf(err, errSize, "No length in the answer (status %d).", status);
+        return -1;
+    }
+    // the body: kept for a 200 that fits, read and dropped otherwise (the session goes on)
+    while (got < clen) {
+        unsigned char sink[512];
+        int want = clen - got, n;
+        if (status == 200 && clen <= bufSize)
+            n = br_sslio_read(&ioc, buf + got, want);
+        else
+            n = br_sslio_read(&ioc, sink, want < (int)sizeof(sink) ? want : (int)sizeof(sink));
+        if (n <= 0)
+            goto tls;
+        got += n;
+    }
+    *len = clen;
+    if (status == 200 && clen > bufSize)
+        status = 413;
+    return status;
+
+tls:
+    snprintf(err, errSize, "Connection lost (TLS error %d).", br_ssl_engine_last_error(&sc.eng));
+    return -1;
+}
+
+// ---------------------------------------------------------------- JPEG in, PNG out
+#define ART_COV_W 140 // OPL's cover size (themes.c THM_COVER_W)
+#define ART_COV_H 200
+#define ART_PNG_MAX (ART_COV_W * ART_COV_H * 3 + 16384) // stored rows, worst case, plus the chunks
+
+struct artJpegErr {
+    struct jpeg_error_mgr pub;
+    jmp_buf jb;
+};
+
+static void artJpegFail(j_common_ptr c)
+{
+    longjmp(((struct artJpegErr *)c->err)->jb, 1);
+}
+
+// The cover as 140x200 RGB in out, or 0 for a picture libjpeg will not read
+static int artDecode(const unsigned char *jpg, int len, unsigned char *out)
+{
+    static struct jpeg_decompress_struct d;
+    static struct artJpegErr je;
+    static unsigned char *src; // static: it outlives a longjmp
+    unsigned int sw, sh, x, y;
+
+    src = NULL;
+    d.err = jpeg_std_error(&je.pub);
+    je.pub.error_exit = artJpegFail;
+    if (setjmp(je.jb)) {
+        jpeg_destroy_decompress(&d);
+        free(src);
+        return 0;
+    }
+    jpeg_create_decompress(&d);
+    jpeg_mem_src(&d, (unsigned char *)jpg, len);
+    jpeg_read_header(&d, TRUE);
+    d.out_color_space = JCS_RGB;
+    d.scale_num = 1; // the smallest 1/2^n the decoder can give that still covers 140x200
+    d.scale_denom = 1;
+    while (d.scale_denom < 8 && d.image_width / (d.scale_denom * 2) >= ART_COV_W && d.image_height / (d.scale_denom * 2) >= ART_COV_H)
+        d.scale_denom *= 2;
+    jpeg_start_decompress(&d);
+    sw = d.output_width;
+    sh = d.output_height;
+    if (d.output_components != 3 || sw == 0 || sh == 0 || (src = (unsigned char *)malloc(sw * sh * 3)) == NULL)
+        longjmp(je.jb, 1);
+    while (d.output_scanline < sh) {
+        JSAMPROW row = src + d.output_scanline * sw * 3;
+        jpeg_read_scanlines(&d, &row, 1);
+    }
+    jpeg_finish_decompress(&d);
+    jpeg_destroy_decompress(&d);
+
+    // the rest of the way by averaging boxes (256x368 to 140x200 for the collection's covers)
+    for (y = 0; y < ART_COV_H; y++) {
+        unsigned int y0 = y * sh / ART_COV_H, y1 = (y + 1) * sh / ART_COV_H;
+        if (y1 <= y0)
+            y1 = y0 + 1;
+        for (x = 0; x < ART_COV_W; x++) {
+            unsigned int x0 = x * sw / ART_COV_W, x1 = (x + 1) * sw / ART_COV_W, sum[3] = {0, 0, 0}, n = 0, i, j, c;
+            if (x1 <= x0)
+                x1 = x0 + 1;
+            for (j = y0; j < y1; j++)
+                for (i = x0; i < x1; i++, n++)
+                    for (c = 0; c < 3; c++)
+                        sum[c] += src[(j * sw + i) * 3 + c];
+            for (c = 0; c < 3; c++)
+                out[(y * ART_COV_W + x) * 3 + c] = (unsigned char)((sum[c] + n / 2) / n);
+        }
+    }
+    free(src);
+    src = NULL;
+    return 1;
+}
+
+typedef struct {
+    unsigned char *p;
+    int n, cap;
+} art_mem_t;
+
+static void artPngWrite(png_structp png, png_bytep data, png_size_t n)
+{
+    art_mem_t *m = (art_mem_t *)png_get_io_ptr(png);
+    if (m->n + (int)n > m->cap)
+        png_error(png, "cover too big");
+    memcpy(m->p + m->n, data, n);
+    m->n += n;
+}
+
+static void artPngFlush(png_structp png)
+{
+    (void)png;
+}
+
+// 140x200 RGB as a PNG in out; its length, or 0
+static int artEncode(const unsigned char *rgb, unsigned char *out, int cap)
+{
+    static art_mem_t m;
+    png_structp png = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
+    png_infop info = png != NULL ? png_create_info_struct(png) : NULL;
+    int y;
+
+    if (png == NULL || info == NULL) {
+        png_destroy_write_struct(&png, &info);
+        return 0;
+    }
+    if (setjmp(png_jmpbuf(png))) {
+        png_destroy_write_struct(&png, &info);
+        return 0;
+    }
+    m.p = out;
+    m.n = 0;
+    m.cap = cap;
+    png_set_write_fn(png, &m, artPngWrite, artPngFlush);
+    png_set_IHDR(png, info, ART_COV_W, ART_COV_H, 8, PNG_COLOR_TYPE_RGB, PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT,
+                 PNG_FILTER_TYPE_DEFAULT);
+    png_set_compression_level(png, 6);
+    png_write_info(png, info);
+    for (y = 0; y < ART_COV_H; y++)
+        png_write_row(png, (png_bytep)(rgb + y * ART_COV_W * 3));
+    png_write_end(png, info);
+    png_destroy_write_struct(&png, &info);
+    return m.n;
+}
+
+static int artSave(const art_target_t *t, const unsigned char *buf, int len)
+{
+    char dir[256], file[272];
+    const char *slash = strrchr(t->path, '/');
+    int fd, w;
+    if (slash != NULL) {
+        snprintf(dir, sizeof(dir), "%.*s", (int)(slash - t->path), t->path);
+        mkdir(dir, 0777); // ART: there already on most drives
+    }
+    snprintf(file, sizeof(file), "%s.png", t->path);
+    if ((fd = open(file, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0)
+        return 0;
+    w = write(fd, buf, len);
+    close(fd);
+    if (w != len) {
+        remove(file);
+        return 0;
+    }
+    return 1;
+}
+
+// ---------------------------------------------------------------- the run
+void ripps2ArtDownload(void)
+{
+    unsigned char *body = NULL, *rgb = NULL;
+    char err[96];
+    int i, len, status, connected = 0, saved;
+
+    artDone = artGot = artMissing = artFailed = 0;
+    artLine[0] = artLine2[0] = '\0';
+    artCount = 0;
+    artTargets = (art_target_t *)malloc(sizeof(art_target_t) * ART_MAX_GAMES);
+    body = (unsigned char *)malloc(ART_MAX_BYTES);
+    rgb = (unsigned char *)malloc(ART_COV_W * ART_COV_H * 3);
+    if (artTargets == NULL || body == NULL || rgb == NULL) {
+        free(artTargets);
+        free(body);
+        free(rgb);
+        artTargets = NULL;
+        guiMsgBox("Not enough memory for the cover download.", 0, NULL);
+        return;
+    }
+
+    artStage = "Looking for games without a cover...";
+    artDraw();
+    ioBlockOps(1); // the lists hold still while they are read
+    artCollect();
+    ioBlockOps(0);
+    if (artCount == 0) {
+        free(artTargets);
+        free(body);
+        free(rgb);
+        artTargets = NULL;
+        guiMsgBox("Every game in your started lists already has a cover. Start a drive's list first to look at its games.", 0, NULL);
+        return;
+    }
+
+    artStage = "Starting the network...";
+    artDraw();
+    if (netLoadInitModules(NET_PROTO_SMB) != 0) {
+        free(artTargets);
+        free(body);
+        free(rgb);
+        artTargets = NULL;
+        guiMsgBox("The network did not start. Check the cable, and the IP settings on this page.", 0, NULL);
+        return;
+    }
+
+    for (i = 0; i < artCount; i++) {
+        art_target_t *t = &artTargets[i];
+        snprintf(artLine, sizeof(artLine), "%s", t->title);
+        snprintf(artLine2, sizeof(artLine2), "%s", t->serial);
+        artStage = "Downloading covers from xlenore's ps2-covers on GitHub";
+        artDraw();
+        if (artCancelled())
+            break;
+        status = -1;
+        for (int attempt = 0; attempt < 2 && status < 0; attempt++) {
+            if (!connected) {
+                artStage = "Connecting to GitHub...";
+                artDraw();
+                connected = artOpen(err, sizeof(err));
+                if (!connected)
+                    break;
+            }
+            status = artGet(t->serial, body, ART_MAX_BYTES, &len, err, sizeof(err));
+            if (status < 0) {
+                artClose();
+                connected = 0;
+            }
+        }
+        saved = 0;
+        if (status == 200 && len > 4 && body[0] == 0xFF && body[1] == 0xD8) {
+            // the JPEG becomes a 140x200 PNG in the same buffer (the JPEG is done with by then)
+            if (!artDecode(body, len, rgb))
+                snprintf(err, sizeof(err), "%s: the picture would not decode.", t->serial);
+            else if ((len = artEncode(rgb, body, ART_MAX_BYTES)) <= 0)
+                snprintf(err, sizeof(err), "%s: the PNG would not encode.", t->serial);
+            else if (!(saved = artSave(t, body, len)))
+                snprintf(err, sizeof(err), "%s: the drive would not take the file.", t->serial);
+            status = saved ? 200 : 0;
+        }
+        if (saved)
+            artGot++;
+        else if (status == 404)
+            artMissing++;
+        else {
+            artFailed++;
+            if (status > 0)
+                snprintf(err, sizeof(err), "%s: the server said %d.", t->serial, status);
+            snprintf(artLine2, sizeof(artLine2), "%s", err);
+            if (status < 0 && artFailed >= 3 && artGot == 0) { // three in a row and nothing worked: say why
+                artDone = i + 1;
+                break;
+            }
+        }
+        artDone = i + 1;
+    }
+    artClose();
+    free(body);
+    free(rgb);
+    free(artTargets);
+    artTargets = NULL;
+
+    // the new covers: let the menu look again
+    cacheInvalidateFailMemo();
+    artIndexInvalidate();
+
+    char msg[256];
+    if (artGot == 0 && artFailed > 0 && artMissing == 0)
+        snprintf(msg, sizeof(msg), "No cover could be downloaded. %s", artLine2);
+    else
+        snprintf(msg, sizeof(msg), "%d new covers. %d of your games are not in the collection%s%s.", artGot, artMissing,
+                 artFailed ? "; failed: " : "", artFailed ? artLine2 : "");
+    guiMsgBox(msg, 0, NULL);
+}
