+// A point q px along the box's edge, clockwise from the top left corner
+static void fbEdgePoint(int l, int t, int r, int b, float q, float *x, float *y)
+{
+    float w = r - l - 1, h = b - t - 1;
+    if (q < w) {
+        *x = l + q;
+        *y = t;
+    } else if (q < w + h) {
+        *x = r - 1;
+        *y = t + (q - w);
+    } else if (q < 2 * w + h) {
+        *x = r - 1 - (q - w - h);
+        *y = b - 1;
+    } else {
+        *x = l;
+        *y = b - 1 - (q - 2 * w - h);
+    }
+}
