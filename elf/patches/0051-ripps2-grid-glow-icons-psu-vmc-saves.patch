+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 saves: what the Memory Files browser does with PS2 saves beyond plain files.
+
+  - PSU, the single-file save format of EMS, uLaunchELF and Apollo: a save folder exported to one,
+    and one unpacked into a folder, onto a memory card, or into a virtual memory card.
+  - PS2 virtual memory card images (OPL's VMC folder, PCSX2's cards): the saves inside listed, read
+    and copied out; on an image without ECC (OPL's own), saves imported into it and deleted from it.
+    An image with ECC (PCSX2's .ps2) is read only here.
+
+  Written for RIPPS2 from the formats: the PS2 memory card file system as ps2sdk's mcman and OPL's
+  genvmc lay it out (superblock, indirect FAT, 512-byte directory entries), and the PSU layout (the
+  save folder's entry, "." and "..", then each file's entry and its data padded to 1 KB with 0xFF).
+  Apollo Save Tool (bucanero/apollo-ps2) was the reference for what a save tool should offer.
+
+  A save is read whole into memory, then written out whole: saves are small, and it keeps every
+  source (folder, PSU, VMC) and every destination independent of each other.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <errno.h>
+#include <delaythread.h>
+
+#include "include/opl.h"
+#include "include/ioman.h"
+#include "include/ripps2.h"
+
+// directory entry modes (mcman's sceMcFileAttr* bits)
+#define MC_READ    0x0001
+#define MC_WRITE   0x0002
+#define MC_EXEC    0x0004
+#define MC_FILE    0x0010
+#define MC_DIR     0x0020
+#define MC_CLOSED  0x0080
+#define MC_0400    0x0400
+#define MC_HIDDEN  0x2000
+#define MC_EXISTS  0x8000
+#define MODE_DIR   (MC_EXISTS | MC_0400 | MC_DIR | MC_EXEC | MC_WRITE | MC_READ)            // 0x8427
+#define MODE_FILE  (MC_EXISTS | MC_0400 | MC_CLOSED | MC_FILE | MC_EXEC | MC_WRITE | MC_READ) // 0x8497
+
+#define FAT_USED 0x80000000u
+#define FAT_FREE 0x7FFFFFFFu
+#define FAT_END  0xFFFFFFFFu
+
+#define ENT_SIZE      512
+#define SAVE_FILES    64                 // files in one save folder
+#define SAVE_MAX_SIZE (8 * 1024 * 1024)  // a whole card
+#define PSU_ALIGN     1024
+
+typedef struct
+{
+    u16 mode;
+    u16 unused;
+    u32 length; // a file's size; a folder's entry count
+    u8 created[8];
+    u32 cluster; // first cluster, relative to the allocatable area
+    u32 dirEntry;
+    u8 modified[8];
+    u32 attr;
+    u8 unused2[28];
+    char name[32];
+    u8 unused3[416];
+} __attribute__((packed)) r2_ent_t;
+
+typedef char r2_ent_is_512[sizeof(r2_ent_t) == ENT_SIZE ? 1 : -1];
+
+typedef struct
+{
+    char name[33];
+    u32 size;
+    u8 created[8], modified[8];
+    u8 *data;
+} r2_file_t;
+
+typedef struct
+{
+    char name[33];
+    u8 created[8], modified[8];
+    int count;
+    r2_file_t files[SAVE_FILES];
+} r2_save_t;
+
+static char r2Err[40];
+
+const char *ripps2SaveError(void)
+{
+    return r2Err;
+}
+
+static int r2Fail(const char *what)
+{
+    snprintf(r2Err, sizeof(r2Err), "%s", what);
+    return 0;
+}
+
+static int r2IsMc(const char *path)
+{
+    return path[0] == 'm' && path[1] == 'c' && (path[2] == '0' || path[2] == '1') && path[3] == ':';
+}
+
+// "mc0:/A/B" in the form RiptOPL's card driver takes, "mc0:A/B"; any other path as it is
+static void r2DevPath(const char *path, char *out, int size)
+{
+    if (r2IsMc(path) && path[4] == '/')
+        snprintf(out, size, "%.4s%s", path, path + 5);
+    else
+        snprintf(out, size, "%s", path);
+}
+
+// A card's date stamp (sceMcStDateTime): reserved, sec, min, hour, day, month, year (LE u16), in Japan
+// time, as the console's clock and every card keep it
+static void r2Stamp(time_t t, u8 out[8])
+{
+    time_t jst = t + 9 * 60 * 60;
+    struct tm *tm = gmtime(&jst);
+    memset(out, 0, 8);
+    if (tm == NULL)
+        return;
+    out[1] = tm->tm_sec;
+    out[2] = tm->tm_min;
+    out[3] = tm->tm_hour;
+    out[4] = tm->tm_mday;
+    out[5] = tm->tm_mon + 1;
+    out[6] = (tm->tm_year + 1900) & 0xFF;
+    out[7] = (tm->tm_year + 1900) >> 8;
+}
+
+static void r2SaveFree(r2_save_t *s)
+{
+    int i;
+    for (i = 0; i < s->count; i++)
+        free(s->files[i].data);
+    s->count = 0;
+}
+
+static int r2ReadAll(int fd, u8 *buf, u32 size)
+{
+    u32 done = 0;
+    while (done < size) {
+        int r = read(fd, buf + done, size - done > 0x10000 ? 0x10000 : size - done);
+        if (r <= 0)
+            return 0;
+        done += r;
+    }
+    return 1;
+}
+
+static int r2WriteAll(int fd, const u8 *buf, u32 size)
+{
+    u32 done = 0;
+    while (done < size) {
+        int w = write(fd, buf + done, size - done > 0x10000 ? 0x10000 : size - done);
+        if (w <= 0)
+            return 0;
+        done += w;
+    }
+    return 1;
+}
+
+// ---- virtual memory card images ----
+
+typedef struct
+{
+    int fd, ecc, writable;
+    int raw, pageLen, ppc, csize; // bytes per stored page (512, or 528 with ECC), page, pages per cluster, cluster
+    u32 clusters, alloc, allocEnd, root;
+    u32 ifc[32];
+    u32 *fat;      // one entry per allocatable cluster
+    u32 *fatAbs;   // where each FAT cluster lives
+    u8 *fatDirty;
+    int fatClusters, epc; // FAT clusters, entries per cluster
+    u8 *cl;        // a cluster's worth of scratch
+} r2_vmc_t;
+
+static u32 r2U32(const u8 *p)
+{
+    return p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24);
+}
+
+static int r2VmcIo(r2_vmc_t *v, u32 abs, u8 *buf, int writing)
+{
+    int p;
+    for (p = 0; p < v->ppc; p++) {
+        if (lseek(v->fd, ((s64)abs * v->ppc + p) * v->raw, SEEK_SET) < 0)
+            return 0;
+        if (writing ? write(v->fd, buf + p * v->pageLen, v->pageLen) != v->pageLen : read(v->fd, buf + p * v->pageLen, v->pageLen) != v->pageLen)
+            return 0;
+    }
+    return 1;
+}
+
+static void r2VmcClose(r2_vmc_t *v)
+{
+    if (v->fd >= 0)
+        close(v->fd);
+    free(v->fat);
+    free(v->fatAbs);
+    free(v->fatDirty);
+    free(v->cl);
+    memset(v, 0, sizeof(*v));
+    v->fd = -1;
+}
+
+// 1 = open; 0 = not a PS2 card image (r2Err says why)
+static int r2VmcOpen(r2_vmc_t *v, const char *image, int forWrite)
+{
+    u8 sb[ENT_SIZE];
+    int k, lastInd = -1;
+    s64 size;
+
+    memset(v, 0, sizeof(*v));
+    v->fd = open(image, forWrite ? O_RDWR : O_RDONLY);
+    if (v->fd < 0)
+        return r2Fail("CANNOT OPEN THE IMAGE");
+    if (read(v->fd, sb, sizeof(sb)) != (int)sizeof(sb) || memcmp(sb, "Sony PS2 Memory Card Format ", 28) != 0) {
+        r2VmcClose(v);
+        return r2Fail("NOT A PS2 CARD IMAGE");
+    }
+    v->pageLen = sb[0x28] | (sb[0x29] << 8);
+    v->ppc = sb[0x2A] | (sb[0x2B] << 8);
+    v->clusters = r2U32(sb + 0x30);
+    v->alloc = r2U32(sb + 0x34);
+    v->allocEnd = r2U32(sb + 0x38);
+    v->root = r2U32(sb + 0x3C);
+    for (k = 0; k < 32; k++)
+        v->ifc[k] = r2U32(sb + 0x50 + k * 4);
+    v->csize = v->pageLen * v->ppc;
+    if (v->pageLen != 512 || v->ppc < 1 || v->ppc > 16 || v->csize > 8192 || v->allocEnd == 0 || v->allocEnd > 0x100000) {
+        r2VmcClose(v);
+        return r2Fail("UNKNOWN CARD LAYOUT");
+    }
+    size = lseek(v->fd, 0, SEEK_END);
+    s64 pages = (s64)v->clusters * v->ppc;
+    if (size >= pages * (v->pageLen + 16)) { // the spare area of every page: ECC (PCSX2's .ps2)
+        v->raw = v->pageLen + 16;
+        v->ecc = 1;
+    } else if (size >= pages * v->pageLen)
+        v->raw = v->pageLen;
+    else {
+        r2VmcClose(v);
+        return r2Fail("THE IMAGE IS CUT SHORT");
+    }
+    v->writable = forWrite && !v->ecc;
+
+    v->epc = v->csize / 4;
+    v->fatClusters = (v->allocEnd + v->epc - 1) / v->epc;
+    v->fat = malloc(v->fatClusters * v->epc * 4);
+    v->fatAbs = malloc(v->fatClusters * 4);
+    v->fatDirty = calloc(v->fatClusters, 1);
+    v->cl = malloc(v->csize);
+    u8 *ind = malloc(v->csize);
+    if (v->fat == NULL || v->fatAbs == NULL || v->fatDirty == NULL || v->cl == NULL || ind == NULL) {
+        free(ind);
+        r2VmcClose(v);
+        return r2Fail("OUT OF MEMORY");
+    }
+    // the indirect FAT names the FAT's clusters; the FAT chains the allocatable ones
+    for (k = 0; k < v->fatClusters; k++) {
+        int i = k / v->epc;
+        if (i >= 32 || (i != lastInd && !r2VmcIo(v, v->ifc[i], ind, 0))) {
+            free(ind);
+            r2VmcClose(v);
+            return r2Fail("BAD CARD TABLE");
+        }
+        lastInd = i;
+        v->fatAbs[k] = r2U32(ind + (k % v->epc) * 4);
+        if (!r2VmcIo(v, v->fatAbs[k], (u8 *)&v->fat[k * v->epc], 0)) {
+            free(ind);
+            r2VmcClose(v);
+            return r2Fail("BAD CARD TABLE");
+        }
+    }
+    free(ind);
+    return 1;
+}
+
+static int r2VmcFlushFat(r2_vmc_t *v)
+{
+    int k, ok = 1;
+    for (k = 0; k < v->fatClusters; k++)
+        if (v->fatDirty[k]) {
+            if (!r2VmcIo(v, v->fatAbs[k], (u8 *)&v->fat[k * v->epc], 1))
+                ok = 0;
+            v->fatDirty[k] = 0;
+        }
+    return ok;
+}
+
+static u32 r2VmcNext(r2_vmc_t *v, u32 c)
+{
+    u32 e;
+    if (c >= v->allocEnd)
+        return FAT_END;
+    e = v->fat[c];
+    if (e == FAT_END || !(e & FAT_USED))
+        return FAT_END;
+    return e & ~FAT_USED;
+}
+
+static void r2VmcSetFat(r2_vmc_t *v, u32 c, u32 value)
+{
+    v->fat[c] = value;
+    v->fatDirty[c / v->epc] = 1;
+}
+
+// The n-th cluster of a chain, or FAT_END
+static u32 r2VmcWalk(r2_vmc_t *v, u32 c, int n)
+{
+    while (n-- > 0 && c != FAT_END)
+        c = r2VmcNext(v, c);
+    return c;
+}
+
+static int r2VmcEnt(r2_vmc_t *v, u32 dir, int index, r2_ent_t *e, int writing)
+{
+    int per = v->csize / ENT_SIZE;
+    u32 c = r2VmcWalk(v, dir, index / per);
+    if (c == FAT_END || !r2VmcIo(v, v->alloc + c, v->cl, 0))
+        return 0;
+    if (!writing) {
+        memcpy(e, v->cl + (index % per) * ENT_SIZE, ENT_SIZE);
+        return 1;
+    }
+    memcpy(v->cl + (index % per) * ENT_SIZE, e, ENT_SIZE);
+    return r2VmcIo(v, v->alloc + c, v->cl, 1);
+}
+
+static int r2NameIs(const r2_ent_t *e, const char *name)
+{
+    return !strncmp(e->name, name, 32) && strlen(name) <= 32;
+}
+
+// A save folder in the card's root: its index there, or -1
+static int r2VmcFindSave(r2_vmc_t *v, const char *name, r2_ent_t *found)
+{
+    r2_ent_t dot, e;
+    int i;
+    if (!r2VmcEnt(v, v->root, 0, &dot, 0))
+        return -1;
+    for (i = 2; i < (int)dot.length; i++)
+        if (r2VmcEnt(v, v->root, i, &e, 0) && (e.mode & MC_EXISTS) && (e.mode & MC_DIR) && r2NameIs(&e, name)) {
+            if (found)
+                *found = e;
+            return i;
+        }
+    return -1;
+}
+
+static int r2VmcReadChain(r2_vmc_t *v, u32 c, u8 *out, u32 size)
+{
+    u32 done = 0;
+    while (done < size) {
+        if (c == FAT_END || !r2VmcIo(v, v->alloc + c, v->cl, 0))
+            return 0;
+        u32 n = size - done > (u32)v->csize ? (u32)v->csize : size - done;
+        memcpy(out + done, v->cl, n);
+        done += n;
+        c = r2VmcNext(v, c);
+    }
+    return 1;
+}
+
+static u32 r2VmcFreeCount(r2_vmc_t *v)
+{
+    u32 c, n = 0;
+    for (c = 0; c < v->allocEnd; c++)
+        if (!(v->fat[c] & FAT_USED))
+            n++;
+    return n;
+}
+
+// A chain of n new clusters (n > 0): its first cluster, or FAT_END when the card is full
+static u32 r2VmcAllocChain(r2_vmc_t *v, int n, u32 *hint)
+{
+    u32 first = FAT_END, prev = FAT_END, c;
+    for (c = *hint; c < v->allocEnd && n > 0; c++) {
+        if (v->fat[c] & FAT_USED)
+            continue;
+        r2VmcSetFat(v, c, FAT_END);
+        if (prev != FAT_END)
+            r2VmcSetFat(v, prev, FAT_USED | c);
+        else
+            first = c;
+        prev = c;
+        n--;
+    }
+    *hint = c;
+    return n == 0 ? first : FAT_END;
+}
+
+static void r2VmcFreeChain(r2_vmc_t *v, u32 c)
+{
+    while (c != FAT_END && c < v->allocEnd) {
+        u32 next = r2VmcNext(v, c);
+        r2VmcSetFat(v, c, FAT_FREE);
+        c = next;
+    }
+}
+
+static int r2LoadVmc(r2_save_t *s, const char *image, const char *name)
+{
+    r2_vmc_t v;
+    r2_ent_t dir, e;
+    int i;
+    u32 total = 0;
+
+    if (!r2VmcOpen(&v, image, 0))
+        return 0;
+    if (r2VmcFindSave(&v, name, &dir) < 0) {
+        r2VmcClose(&v);
+        return r2Fail("NO SUCH SAVE ON THE CARD");
+    }
+    snprintf(s->name, sizeof(s->name), "%.32s", dir.name);
+    memcpy(s->created, dir.created, 8);
+    memcpy(s->modified, dir.modified, 8);
+    for (i = 2; i < (int)dir.length && s->count < SAVE_FILES; i++) {
+        if (!r2VmcEnt(&v, dir.cluster, i, &e, 0)) {
+            r2VmcClose(&v);
+            return r2Fail("CANNOT READ THE SAVE");
+        }
+        if (!(e.mode & MC_EXISTS) || !(e.mode & MC_FILE))
+            continue;
+        r2_file_t *f = &s->files[s->count];
+        snprintf(f->name, sizeof(f->name), "%.32s", e.name);
+        f->size = e.length;
+        memcpy(f->created, e.created, 8);
+        memcpy(f->modified, e.modified, 8);
+        total += f->size;
+        f->data = malloc(f->size ? f->size : 1);
+        if (total > SAVE_MAX_SIZE || f->data == NULL) {
+            free(f->data);
+            r2VmcClose(&v);
+            return r2Fail("SAVE TOO BIG");
+        }
+        s->count++;
+        if (f->size && !r2VmcReadChain(&v, e.cluster, f->data, f->size)) {
+            r2VmcClose(&v);
+            return r2Fail("CANNOT READ THE SAVE");
+        }
+    }
+    r2VmcClose(&v);
+    return 1;
+}
+
+// The save into the card's root, a new folder of its own; -1 when one of that name is already there
+static int r2WriteVmc(const r2_save_t *s, const char *image)
+{
+    r2_vmc_t v;
+    r2_ent_t rootDot, e;
+    int i, slot = -1, per, dirEnts = 2 + s->count, dirClusters, need = 0, grow = 0;
+    u32 hint = 0, dirFirst, c;
+    u32 first[SAVE_FILES];
+    u8 *dirBuf;
+
+    if (!r2VmcOpen(&v, image, 1))
+        return 0;
+    if (!v.writable) {
+        int ecc = v.ecc;
+        r2VmcClose(&v);
+        return r2Fail(ecc ? "READ ONLY: AN ECC IMAGE" : "THE IMAGE IS READ ONLY");
+    }
+    if (r2VmcFindSave(&v, s->name, NULL) >= 0) {
+        r2VmcClose(&v);
+        snprintf(r2Err, sizeof(r2Err), "ALREADY ON THE CARD");
+        return -1;
+    }
+    if (!r2VmcEnt(&v, v.root, 0, &rootDot, 0)) {
+        r2VmcClose(&v);
+        return r2Fail("CANNOT READ THE CARD");
+    }
+    // a root slot: the first one a deleted save left, else one more on the end
+    for (i = 2; i < (int)rootDot.length && slot < 0; i++)
+        if (r2VmcEnt(&v, v.root, i, &e, 0) && !(e.mode & MC_EXISTS))
+            slot = i;
+    per = v.csize / ENT_SIZE;
+    if (slot < 0) {
+        slot = rootDot.length;
+        grow = slot % per == 0; // the root's last cluster is full
+    }
+
+    dirClusters = (dirEnts + per - 1) / per;
+    need = dirClusters + grow;
+    for (i = 0; i < s->count; i++)
+        need += (s->files[i].size + v.csize - 1) / v.csize;
+    if ((u32)need > r2VmcFreeCount(&v)) {
+        r2VmcClose(&v);
+        return r2Fail("NOT ENOUGH ROOM ON THE CARD");
+    }
+
+    // the files' data
+    for (i = 0; i < s->count; i++) {
+        const r2_file_t *f = &s->files[i];
+        int n = (f->size + v.csize - 1) / v.csize, k;
+        first[i] = FAT_END;
+        if (n == 0)
+            continue;
+        first[i] = r2VmcAllocChain(&v, n, &hint);
+        for (k = 0, c = first[i]; k < n; k++, c = r2VmcNext(&v, c)) {
+            u32 off = k * v.csize, len = f->size - off > (u32)v.csize ? (u32)v.csize : f->size - off;
+            memset(v.cl, 0xFF, v.csize);
+            memcpy(v.cl, f->data + off, len);
+            if (!r2VmcIo(&v, v.alloc + c, v.cl, 1)) {
+                r2VmcClose(&v);
+                return r2Fail("CANNOT WRITE THE IMAGE");
+            }
+        }
+    }
+
+    // the save's folder: ".", "..", then its files (mcman's layout for a new folder)
+    dirFirst = r2VmcAllocChain(&v, dirClusters, &hint);
+    dirBuf = calloc(dirClusters, v.csize);
+    if (dirBuf == NULL) {
+        r2VmcClose(&v);
+        return r2Fail("OUT OF MEMORY");
+    }
+    r2_ent_t *d = (r2_ent_t *)dirBuf;
+    d[0].mode = MODE_DIR;
+    memcpy(d[0].created, s->created, 8);
+    memcpy(d[0].modified, s->modified, 8);
+    d[0].cluster = v.root; // "." names the parent folder and this folder's place in it
+    d[0].dirEntry = slot;
+    strcpy(d[0].name, ".");
+    d[1].mode = MODE_DIR;
+    memcpy(d[1].created, rootDot.created, 8);
+    memcpy(d[1].modified, rootDot.created, 8);
+    d[1].cluster = rootDot.cluster;
+    d[1].dirEntry = rootDot.dirEntry;
+    strcpy(d[1].name, "..");
+    for (i = 0; i < s->count; i++) {
+        r2_ent_t *f = &d[2 + i];
+        f->mode = MODE_FILE;
+        f->length = s->files[i].size;
+        memcpy(f->created, s->files[i].created, 8);
+        memcpy(f->modified, s->files[i].modified, 8);
+        f->cluster = first[i];
+        strncpy(f->name, s->files[i].name, 32);
+    }
+    for (i = 0, c = dirFirst; i < dirClusters; i++, c = r2VmcNext(&v, c))
+        if (!r2VmcIo(&v, v.alloc + c, dirBuf + i * v.csize, 1)) {
+            free(dirBuf);
+            r2VmcClose(&v);
+            return r2Fail("CANNOT WRITE THE IMAGE");
+        }
+    free(dirBuf);
+
+    // room in the root for one more entry
+    if (grow) {
+        u32 last = v.root, add;
+        while (r2VmcNext(&v, last) != FAT_END)
+            last = r2VmcNext(&v, last);
+        add = r2VmcAllocChain(&v, 1, &hint);
+        memset(v.cl, 0, v.csize);
+        if (add == FAT_END || !r2VmcIo(&v, v.alloc + add, v.cl, 1)) {
+            r2VmcClose(&v);
+            return r2Fail("CANNOT WRITE THE IMAGE");
+        }
+        r2VmcSetFat(&v, last, FAT_USED | add);
+    }
+    if (!r2VmcFlushFat(&v)) {
+        r2VmcClose(&v);
+        return r2Fail("CANNOT WRITE THE IMAGE");
+    }
+
+    // and last, the save appears: its entry in the root, then the root's count
+    memset(&e, 0, sizeof(e));
+    e.mode = MODE_DIR;
+    e.length = dirEnts;
+    memcpy(e.created, s->created, 8);
+    memcpy(e.modified, s->modified, 8);
+    e.cluster = dirFirst;
+    strncpy(e.name, s->name, 32);
+    int ok = r2VmcEnt(&v, v.root, slot, &e, 1);
+    if (ok && slot >= (int)rootDot.length) {
+        rootDot.length = slot + 1;
+        ok = r2VmcEnt(&v, v.root, 0, &rootDot, 1);
+    }
+    r2VmcClose(&v);
+    return ok ? 1 : r2Fail("CANNOT WRITE THE IMAGE");
+}
+
+int ripps2VmcProbe(const char *image)
+{
+    r2_vmc_t v;
+    if (!r2VmcOpen(&v, image, 0))
+        return 0;
+    int ro = v.ecc;
+    r2VmcClose(&v);
+    return ro ? 2 : 1;
+}
+
+int ripps2VmcList(const char *image, const char *save, ripps2_vmc_ent_t *out, int max, unsigned int *freeKb)
+{
+    r2_vmc_t v;
+    r2_ent_t dir, e;
+    int i, n = 0;
+    u32 cluster;
+
+    if (!r2VmcOpen(&v, image, 0))
+        return -1;
+    if (freeKb)
+        *freeKb = r2VmcFreeCount(&v) * (v.csize / 1024);
+    if (save == NULL || save[0] == '\0') {
+        if (!r2VmcEnt(&v, v.root, 0, &dir, 0)) {
+            r2VmcClose(&v);
+            return -1;
+        }
+        cluster = v.root;
+    } else {
+        if (r2VmcFindSave(&v, save, &dir) < 0) {
+            r2VmcClose(&v);
+            return -1;
+        }
+        cluster = dir.cluster;
+    }
+    for (i = 0; i < (int)dir.length && n < max; i++) {
+        if (!r2VmcEnt(&v, cluster, i, &e, 0))
+            break;
+        if (!(e.mode & MC_EXISTS) || !strcmp(e.name, ".") || !strcmp(e.name, ".."))
+            continue;
+        snprintf(out[n].name, sizeof(out[n].name), "%.32s", e.name);
+        out[n].isDir = (e.mode & MC_DIR) != 0;
+        out[n].size = (e.mode & MC_DIR) ? 0 : e.length;
+        n++;
+    }
+    r2VmcClose(&v);
+    return n;
+}
+
+// Up to size bytes of one file in a save on the card (its icon.sys, say): the bytes read, or -1
+int ripps2VmcReadFile(const char *image, const char *save, const char *file, void *buf, int size)
+{
+    r2_vmc_t v;
+    r2_ent_t dir, e;
+    int i, got = -1;
+
+    if (!r2VmcOpen(&v, image, 0))
+        return -1;
+    if (r2VmcFindSave(&v, save, &dir) >= 0)
+        for (i = 2; i < (int)dir.length; i++)
+            if (r2VmcEnt(&v, dir.cluster, i, &e, 0) && (e.mode & MC_EXISTS) && (e.mode & MC_FILE) && r2NameIs(&e, file)) {
+                u32 n = e.length < (u32)size ? e.length : (u32)size;
+                u8 *all = malloc(e.length ? e.length : 1);
+                if (all != NULL && r2VmcReadChain(&v, e.cluster, all, e.length)) {
+                    memcpy(buf, all, n);
+                    got = n;
+                }
+                free(all);
+                break;
+            }
+    r2VmcClose(&v);
+    return got;
+}
+
+// One file out of a save on the card, to dst; -1 when dst is already there
+int ripps2VmcExtractFile(const char *image, const char *save, const char *file, const char *dst)
+{
+    r2_vmc_t v;
+    r2_ent_t dir, e;
+    char dev[320];
+    int i, fd = -1, tries, ok = 0;
+    u8 *all = NULL;
+
+    r2Err[0] = '\0';
+    if ((fd = open(dst, O_RDONLY)) >= 0) {
+        close(fd);
+        snprintf(r2Err, sizeof(r2Err), "ALREADY THERE");
+        return -1;
+    }
+    if (!r2VmcOpen(&v, image, 0))
+        return 0;
+    if (r2VmcFindSave(&v, save, &dir) >= 0)
+        for (i = 2; i < (int)dir.length; i++)
+            if (r2VmcEnt(&v, dir.cluster, i, &e, 0) && (e.mode & MC_EXISTS) && (e.mode & MC_FILE) && r2NameIs(&e, file)) {
+                all = malloc(e.length ? e.length : 1);
+                ok = all != NULL && r2VmcReadChain(&v, e.cluster, all, e.length);
+                break;
+            }
+    r2VmcClose(&v);
+    if (!ok) {
+        free(all);
+        return r2Fail("CANNOT READ IT FROM THE CARD");
+    }
+    r2DevPath(dst, dev, sizeof(dev));
+    for (tries = 0; tries < 4; tries++) {
+        fd = open(dev, O_WRONLY | O_CREAT | (r2IsMc(dst) ? 0 : O_TRUNC), 0666);
+        if (fd >= 0 || !r2IsMc(dst))
+            break;
+        DelayThread(50 * 1000);
+    }
+    if (fd < 0) {
+        free(all);
+        return r2Fail("CANNOT MAKE THE FILE");
+    }
+    ok = r2WriteAll(fd, all, e.length);
+    close(fd);
+    free(all);
+    if (!ok) {
+        remove(dst);
+        return r2Fail("CANNOT WRITE THE FILE");
+    }
+    return 1;
+}
+
+int ripps2VmcDeleteSave(const char *image, const char *save)
+{
+    r2_vmc_t v;
+    r2_ent_t dir, e;
+    int i, at;
+
+    if (!r2VmcOpen(&v, image, 1))
+        return 0;
+    if (!v.writable) {
+        int ecc = v.ecc;
+        r2VmcClose(&v);
+        return r2Fail(ecc ? "READ ONLY: AN ECC IMAGE" : "THE IMAGE IS READ ONLY");
+    }
+    at = r2VmcFindSave(&v, save, &dir);
+    if (at < 0) {
+        r2VmcClose(&v);
+        return r2Fail("NO SUCH SAVE ON THE CARD");
+    }
+    for (i = 2; i < (int)dir.length; i++)
+        if (r2VmcEnt(&v, dir.cluster, i, &e, 0) && (e.mode & MC_EXISTS) && (e.mode & MC_FILE) && e.length > 0)
+            r2VmcFreeChain(&v, e.cluster);
+    r2VmcFreeChain(&v, dir.cluster);
+    dir.mode &= ~MC_EXISTS; // the slot stays, empty, as mcman leaves it
+    int ok = r2VmcEnt(&v, v.root, at, &dir, 1) && r2VmcFlushFat(&v);
+    r2VmcClose(&v);
+    return ok ? 1 : r2Fail("CANNOT WRITE THE IMAGE");
+}
+
+// ---- PSU ----
+
+static int r2LoadPsu(r2_save_t *s, const char *path)
+{
+    r2_ent_t e;
+    int fd = open(path, O_RDONLY), i, n;
+    u32 total = 0;
+
+    if (fd < 0)
+        return r2Fail("CANNOT OPEN THE PSU");
+    if (read(fd, &e, ENT_SIZE) != ENT_SIZE || !(e.mode & MC_DIR) || e.length < 2 || e.name[0] == '\0') {
+        close(fd);
+        return r2Fail("NOT A PSU SAVE");
+    }
+    snprintf(s->name, sizeof(s->name), "%.32s", e.name);
+    memcpy(s->created, e.created, 8);
+    memcpy(s->modified, e.modified, 8);
+    n = e.length - 2;
+    lseek(fd, 2 * ENT_SIZE, SEEK_CUR); // "." and ".."
+    for (i = 0; i < n; i++) {
+        if (read(fd, &e, ENT_SIZE) != ENT_SIZE) {
+            close(fd);
+            return r2Fail("THE PSU IS CUT SHORT");
+        }
+        if (!(e.mode & MC_FILE)) // a folder inside a save: nothing follows it
+            continue;
+        if (s->count >= SAVE_FILES) {
+            close(fd);
+            return r2Fail("TOO MANY FILES IN THE PSU");
+        }
+        r2_file_t *f = &s->files[s->count];
+        snprintf(f->name, sizeof(f->name), "%.32s", e.name);
+        f->size = e.length;
+        memcpy(f->created, e.created, 8);
+        memcpy(f->modified, e.modified, 8);
+        total += f->size;
+        f->data = malloc(f->size ? f->size : 1);
+        if (total > SAVE_MAX_SIZE || f->data == NULL) {
+            free(f->data);
+            close(fd);
+            return r2Fail("SAVE TOO BIG");
+        }
+        s->count++;
+        if (!r2ReadAll(fd, f->data, f->size)) {
+            close(fd);
+            return r2Fail("THE PSU IS CUT SHORT");
+        }
+        if (f->size % PSU_ALIGN)
+            lseek(fd, PSU_ALIGN - f->size % PSU_ALIGN, SEEK_CUR);
+    }
+    close(fd);
+    return 1;
+}
+
+static int r2WritePsu(const r2_save_t *s, const char *path)
+{
+    r2_ent_t e;
+    u8 pad[PSU_ALIGN];
+    int fd, i, ok = 1;
+
+    if ((fd = open(path, O_RDONLY)) >= 0) {
+        close(fd);
+        snprintf(r2Err, sizeof(r2Err), "ALREADY THERE");
+        return -1;
+    }
+    fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd < 0)
+        return r2Fail("CANNOT MAKE THE PSU");
+    memset(pad, 0xFF, sizeof(pad));
+    memset(&e, 0, sizeof(e));
+    e.mode = MODE_DIR;
+    e.length = s->count + 2;
+    memcpy(e.created, s->created, 8);
+    memcpy(e.modified, s->modified, 8);
+    strncpy(e.name, s->name, 32);
+    ok &= write(fd, &e, ENT_SIZE) == ENT_SIZE;
+    e.length = 0;
+    memset(e.name, 0, sizeof(e.name));
+    strcpy(e.name, ".");
+    ok &= write(fd, &e, ENT_SIZE) == ENT_SIZE;
+    strcpy(e.name, "..");
+    ok &= write(fd, &e, ENT_SIZE) == ENT_SIZE;
+    for (i = 0; i < s->count && ok; i++) {
+        const r2_file_t *f = &s->files[i];
+        memset(&e, 0, sizeof(e));
+        e.mode = MODE_FILE;
+        e.length = f->size;
+        memcpy(e.created, f->created, 8);
+        memcpy(e.modified, f->modified, 8);
+        strncpy(e.name, f->name, 32);
+        ok &= write(fd, &e, ENT_SIZE) == ENT_SIZE;
+        ok &= r2WriteAll(fd, f->data, f->size);
+        if (ok && f->size % PSU_ALIGN)
+            ok &= write(fd, pad, PSU_ALIGN - f->size % PSU_ALIGN) == (int)(PSU_ALIGN - f->size % PSU_ALIGN);
+    }
+    close(fd);
+    if (!ok) {
+        remove(path);
+        return r2Fail("CANNOT WRITE THE PSU");
+    }
+    return 1;
+}
+
+int ripps2PsuSaveName(const char *psu, char *name, int size)
+{
+    r2_ent_t e;
+    int fd = open(psu, O_RDONLY), ok;
+    if (fd < 0)
+        return 0;
+    ok = read(fd, &e, ENT_SIZE) == ENT_SIZE && (e.mode & MC_DIR) && e.name[0];
+    close(fd);
+    if (ok)
+        snprintf(name, size, "%.32s", e.name);
+    return ok;
+}
+
+// ---- folders ----
+
+static int r2LoadFolder(r2_save_t *s, const char *parent, const char *name)
+{
+    char dir[320], path[384];
+    DIR *d;
+    struct dirent *de;
+    struct stat st;
+    u32 total = 0;
+    int i, names = 0;
+    char (*list)[33] = malloc(SAVE_FILES * 33);
+
+    if (list == NULL)
+        return r2Fail("OUT OF MEMORY");
+    snprintf(dir, sizeof(dir), "%s%s/", parent, name);
+    d = opendir(dir);
+    if (d == NULL) {
+        free(list);
+        return r2Fail("CANNOT OPEN THE FOLDER");
+    }
+    // the names first, then each file (memory cards allow few open handles)
+    while ((de = readdir(d)) != NULL) {
+        if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, ".."))
+            continue;
+        snprintf(path, sizeof(path), "%s%s", dir, de->d_name);
+        if (stat(path, &st) == 0 && S_ISDIR(st.st_mode))
+            continue; // saves hold files only
+        if (names >= SAVE_FILES || strlen(de->d_name) > 32) {
+            closedir(d);
+            free(list);
+            return r2Fail(names >= SAVE_FILES ? "TOO MANY FILES FOR A SAVE" : "A NAME IS TOO LONG FOR A CARD");
+        }
+        snprintf(list[names++], 33, "%s", de->d_name);
+    }
+    closedir(d);
+    if (strlen(name) > 32) {
+        free(list);
+        return r2Fail("THE NAME IS TOO LONG FOR A CARD");
+    }
+    snprintf(s->name, sizeof(s->name), "%s", name);
+    r2Stamp(time(NULL), s->created);
+    memcpy(s->modified, s->created, 8);
+    for (i = 0; i < names; i++) {
+        r2_file_t *f = &s->files[s->count];
+        int fd;
+        snprintf(path, sizeof(path), "%s%s", dir, list[i]);
+        fd = open(path, O_RDONLY);
+        if (fd < 0) {
+            free(list);
+            return r2Fail("CANNOT READ A FILE");
+        }
+        int len = lseek(fd, 0, SEEK_END);
+        lseek(fd, 0, SEEK_SET);
+        if (len < 0 || total + len > SAVE_MAX_SIZE) {
+            close(fd);
+            free(list);
+            return r2Fail("SAVE TOO BIG");
+        }
+        snprintf(f->name, sizeof(f->name), "%s", list[i]);
+        f->size = len;
+        f->data = malloc(len ? len : 1);
+        if (f->data == NULL) {
+            close(fd);
+            free(list);
+            return r2Fail("OUT OF MEMORY");
+        }
+        s->count++;
+        total += len;
+        if (stat(path, &st) == 0)
+            r2Stamp(st.st_mtime, f->modified);
+        else
+            memcpy(f->modified, s->created, 8);
+        memcpy(f->created, f->modified, 8);
+        if (!r2ReadAll(fd, f->data, len)) {
+            close(fd);
+            free(list);
+            return r2Fail("CANNOT READ A FILE");
+        }
+        close(fd);
+    }
+    free(list);
+    return 1;
+}
+
+// A new folder <parent><name>/ holding the save; -1 when a folder of that name is already there
+static int r2WriteFolder(const r2_save_t *s, const char *parent)
+{
+    char path[320], dev[320];
+    int i, tries, fd;
+
+    snprintf(path, sizeof(path), "%s%s", parent, s->name);
+    r2DevPath(path, dev, sizeof(dev));
+    DIR *d = opendir(path);
+    if (d != NULL) {
+        closedir(d);
+        snprintf(r2Err, sizeof(r2Err), "ALREADY THERE");
+        return -1;
+    }
+    // a memory card answers "changed card" to the first access after it is seen: ask again
+    for (tries = 0; tries < 4 && mkdir(dev, 0777) < 0; tries++)
+        DelayThread(50 * 1000);
+    for (i = 0; i < s->count; i++) {
+        const r2_file_t *f = &s->files[i];
+        snprintf(path, sizeof(path), "%s%s/%s", parent, s->name, f->name);
+        r2DevPath(path, dev, sizeof(dev));
+        for (tries = 0; tries < 4; tries++) {
+            fd = open(dev, O_WRONLY | O_CREAT | (r2IsMc(path) ? 0 : O_TRUNC), 0666);
+            if (fd >= 0 || !r2IsMc(path))
+                break;
+            DelayThread(50 * 1000);
+        }
+        if (fd < 0) {
+            snprintf(r2Err, sizeof(r2Err), "CANNOT MAKE %.18s E%d", f->name, errno);
+            return 0;
+        }
+        int ok = r2WriteAll(fd, f->data, f->size);
+        close(fd);
+        if (!ok) {
+            snprintf(r2Err, sizeof(r2Err), "CANNOT WRITE %.18s", f->name);
+            return 0;
+        }
+    }
+    return 1;
+}
+
+// ---- the one entry point ----
+
+int ripps2SaveCopy(int fromKind, const char *from, const char *saveName, int toKind, const char *to)
+{
+    static r2_save_t s; // ~2 KB of names and pointers; one copy at a time (the IO worker)
+    int r = 0;
+    char psu[320];
+
+    r2Err[0] = '\0';
+    memset(&s, 0, sizeof(s));
+    if (fromKind == RIPPS2_SAVE_VMC)
+        r = r2LoadVmc(&s, from, saveName);
+    else if (fromKind == RIPPS2_SAVE_PSU)
+        r = r2LoadPsu(&s, from);
+    else
+        r = r2LoadFolder(&s, from, saveName);
+    if (r) {
+        if (toKind == RIPPS2_SAVE_VMC)
+            r = r2WriteVmc(&s, to);
+        else if (toKind == RIPPS2_SAVE_PSU) {
+            snprintf(psu, sizeof(psu), "%s%s.psu", to, s.name);
+            r = r2WritePsu(&s, psu);
+        } else
+            r = r2WriteFolder(&s, to);
+    }
+    r2SaveFree(&s);
+    if (r == 0) {
+        LOG("RIPPS2 SAVES: %s %s -> %s: %s\n", from, saveName ? saveName : "", to, r2Err);
+    }
+    return r;
+}
