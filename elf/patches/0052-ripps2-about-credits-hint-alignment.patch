diff --git a/src/ripps2about.c b/src/ripps2about.c
new file mode 100644
index 0000000..c585082
--- /dev/null
+++ b/src/ripps2about.c
@@ -0,0 +1,230 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 About (Storage > Menu > About): who made what, as a column of credits that drifts up through
+  the glass on its own. The right stick (or Up / Down) scrolls it by hand, and the drift waits a few
+  seconds before it carries on. RIPPS2's own credits and everything RIPPS2 brought in come first; the
+  RiptOPL and Open PS2 Loader credits RIPPS2 inherited follow, as they stood in RiptOPL's About.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/pad.h"
+#include "include/sound.h"
+#include "include/ripps2.h"
+
+#define AB_TOP     54  // the column shows between these
+#define AB_BOTTOM  424
+#define AB_FADE    28  // rows fade out over this many px at each edge
+#define AB_SPEED   16.0f // px a second, on its own
+#define AB_WAIT    4.0f  // seconds the drift waits after a hand scroll
+#define AB_HEAD_H  30
+#define AB_LINE_H  20
+#define AB_GAP     16
+
+#define AB_LIT  0x80
+#define AB_TEXT 0x67
+
+// A credit row: H = a heading, T = a line of names, S = a quieter note, G = space
+typedef struct
+{
+    char kind;
+    const char *text;
+} ab_row_t;
+
+static char abVersion[64], abBuild[64];
+
+static const ab_row_t abRows[] = {
+    {'H', "RIPPS2"},
+    {'S', "A teardown and rebuild of RiptOPL, the Open PS2 Loader fork,"},
+    {'S', "with its own look, launchers, file browser and save tools."},
+    {'T', abVersion},
+    {'G', NULL},
+    {'H', "MADE BY"},
+    {'T', "akilluminati47: design, direction and testing"},
+    {'S', "Built with Claude (Anthropic)"},
+    {'G', NULL},
+    {'H', "TESTERS"},
+    {'T', "akilluminati47 - ripto - nuno6573 - zackcage6 - FifthFox"},
+    {'S', "Feedback makes RIPPS2. Thank you."},
+    {'G', NULL},
+    {'H', "LAUNCH DISC"},
+    {'T', "ESR by ffgriever"},
+    {'S', "started from your own copy (APPS, BOOT or ESR folders)"},
+    {'T', "DVD video: your console's player, or krHACKen's RGB player"},
+    {'S', "from your memory card's DVD player update folder"},
+    {'G', NULL},
+    {'H', "MEMORY FILES"},
+    {'T', "wLaunchELF by the ps2homebrew team"},
+    {'S', "the file manager RIPPS2's browser and settings grid follow"},
+    {'T', "wLaunchELF R3Z by NathanNeurotic"},
+    {'S', "behaviour reference"},
+    {'T', "Apollo Save Tool by bucanero"},
+    {'S', "the save tool reference: PSU export and import, card images"},
+    {'T', "ps2sdk by the ps2dev team"},
+    {'S', "mcman's card file system, the USB keyboard driver"},
+    {'T', "mymc by Ross Ridge, mymcplus by Florian Maerkl"},
+    {'S', "what RIPPS2's card image writes are checked against"},
+    {'G', NULL},
+    {'H', "LOOK AND TYPE"},
+    {'T', "Planet N Compact by Iconian Fonts"},
+    {'T', "RIPPS2 Sleek and Sleek Bold, drawn for RIPPS2"},
+    {'S', "PS1 and PS2 marks drawn from public SVGs; trademarks of Sony"},
+    {'G', NULL},
+    {'G', NULL},
+    {'H', "BUILT ON RIPTOPL"},
+    {'T', "RiptOPL by NathanNeurotic"},
+    {'S', "and the Open PS2 Loader team, whose credits follow"},
+    {'G', NULL},
+    {'H', "OPEN PS2 LOADER DEVELOPERS"},
+    {'T', "BatRastard - bbsan2k - belek666 - crazyc"},
+    {'T', "dlanor - doctorxyz - hominem.te.esse - ifcaro"},
+    {'T', "izdubar - jimmikaelkael - KrahJohlito - kr_ps2"},
+    {'T', "Maximus32 - misfire - Polo35 - reprep"},
+    {'T', "saildot4k - SP193 - volca - darkladark (LUNA)"},
+#ifdef RETROACHIEVEMENTS
+    {'T', "hacan359 - oMrRexD"},
+#endif
+    {'T', "techwritescode (PSUManager)"},
+    {'S', "... and the anonymous ..."},
+    {'G', NULL},
+    {'H', "QUALITY ASSURANCE"},
+    {'T', "algol - Berion - Blade1984 - El_Patas - EP"},
+    {'T', "gledson999 - jolek - lee4 - LocalH - RandQalan"},
+    {'T', "ShaolinAssassin - yoshi314 - zero35 - zackcage6"},
+    {'G', NULL},
+    {'H', "NETWORK UPDATE"},
+    {'T', "icyson55"},
+    {'G', NULL},
+    {'H', "FINANCIAL SUPPORT"},
+    {'T', "Akilluminati47"},
+    {'G', NULL},
+    {'H', "BUILD DETAILS"},
+    {'T', abBuild},
+    {'G', NULL},
+    {'H', "SUPPORT"},
+    {'T', "psx-place.com"},
+    {'T', "github.com/akilluminati47/RIPPS2"},
+};
+#define AB_COUNT ((int)(sizeof(abRows) / sizeof(abRows[0])))
+
+static int abRowH(char kind)
+{
+    return kind == 'H' ? AB_HEAD_H : kind == 'G' ? AB_GAP : AB_LINE_H;
+}
+
+static int abHeight(void)
+{
+    int i, h = 0;
+    for (i = 0; i < AB_COUNT; i++)
+        h += abRowH(abRows[i].kind);
+    return h;
+}
+
+static void abDraw(float scroll)
+{
+    int i, y = AB_TOP + (AB_BOTTOM - AB_TOP) / 3 - (int)scroll; // the first heading starts a third of the way down
+    for (i = 0; i < AB_COUNT; i++) {
+        const ab_row_t *r = &abRows[i];
+        int h = abRowH(r->kind), mid = y + h / 2;
+        y += h;
+        if (r->kind == 'G' || mid < AB_TOP - 10 || mid > AB_BOTTOM + 10)
+            continue;
+        // fade in from the bottom edge, out at the top
+        float a = 1.0f;
+        if (mid < AB_TOP + AB_FADE)
+            a = (float)(mid - AB_TOP) / AB_FADE;
+        else if (mid > AB_BOTTOM - AB_FADE)
+            a = (float)(AB_BOTTOM - mid) / AB_FADE;
+        if (a <= 0.0f)
+            continue;
+        if (a > 1.0f)
+            a = 1.0f;
+        int alpha = (int)(0x80 * a);
+        if (r->kind == 'H') {
+            fntRenderString(gTheme->fonts[4], 320, mid + 3, ALIGN_CENTER, 0, 0, r->text, GS_SETREG_RGBA(AB_LIT, AB_LIT, AB_LIT, alpha));
+            int w = fntCalcDimensions(gTheme->fonts[4], r->text) / 2 + 18;
+            rmDrawLine(320 - w - 40, mid + 3, 320 - w, mid + 3, GS_SETREG_RGBAQ(0x4A, 0x72, 0xDC, alpha / 2, 0));
+            rmDrawLine(320 + w, mid + 3, 320 + w + 40, mid + 3, GS_SETREG_RGBAQ(0x4A, 0x72, 0xDC, alpha / 2, 0));
+        } else if (r->kind == 'T')
+            fntRenderString(gTheme->fonts[5], 320, mid, ALIGN_CENTER, 0, 0, r->text, GS_SETREG_RGBA(AB_TEXT, AB_TEXT + 4, AB_TEXT + 0x13, alpha));
+        else
+            fntRenderString(gTheme->fonts[10], 320, mid, ALIGN_CENTER, 0, 0, r->text, GS_SETREG_RGBA(0x4C, 0x52, 0x64, alpha));
+    }
+}
+
+void ripps2ShowAbout(const char *version, const char *build)
+{
+    float scroll = 0.0f, waited = AB_WAIT, end;
+    clock_t last = clock();
+    int closeKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+
+    snprintf(abVersion, sizeof(abVersion), "%s", version);
+    snprintf(abBuild, sizeof(abBuild), "%s", build);
+    end = (float)abHeight() + (AB_BOTTOM - AB_TOP) / 3.0f; // scrolled this far, the last row has left the top
+
+    while (1) {
+        clock_t now = clock();
+        float dt = (float)(now - last) / CLOCKS_PER_SEC;
+        int sx, sy;
+        last = now;
+        if (dt > 0.1f)
+            dt = 0.1f;
+
+        readPads();
+        padGetRightStick(&sx, &sy);
+        float hand = 0.0f;
+        if (sy > 24 || sy < -24)
+            hand = (float)sy / 127.0f * 360.0f; // stick down scrolls down the credits
+        if (getKey(KEY_DOWN))
+            hand = 240.0f;
+        else if (getKey(KEY_UP))
+            hand = -240.0f;
+        if (hand != 0.0f) {
+            scroll += hand * dt;
+            waited = 0.0f;
+        } else {
+            waited += dt;
+            if (waited >= AB_WAIT)
+                scroll += AB_SPEED * dt;
+        }
+        if (scroll < -(AB_BOTTOM - AB_TOP) / 3.0f)
+            scroll = -(AB_BOTTOM - AB_TOP) / 3.0f;
+        if (scroll > end) // round again from below
+            scroll = -(float)(AB_BOTTOM - AB_TOP) * 2.0f / 3.0f;
+
+        rmStartFrame();
+        guiDrawBGPlasma();
+        fntRenderString(gTheme->fonts[4], 30, 30, ALIGN_VCENTER, 0, 0, "ABOUT", GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80));
+        fntRenderString(gTheme->fonts[4], 610 - fntCalcDimensions(gTheme->fonts[4], "RIPPS2"), 30, ALIGN_VCENTER, 0, 0, "RIPPS2", GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80));
+        rmDrawLine(30, 46, 610, 46, GS_SETREG_RGBAQ(0x4A, 0x72, 0xDC, 0x60, 0));
+        abDraw(scroll);
+        // the hints
+        int hx = 44;
+        GSTEXTURE *t = thmGetTexture(closeKey == KEY_CROSS ? CROSS_ICON : CIRCLE_ICON);
+        if (t != NULL) {
+            rmDrawPixmap(t, hx, 438, ALIGN_NONE, 20, 20, SCALING_RATIO, GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80), 0);
+            hx += 24;
+        }
+        fntRenderString(gTheme->fonts[4], hx, 448, ALIGN_VCENTER, 0, 0, "BACK", GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80));
+        hx += fntCalcDimensions(gTheme->fonts[4], "BACK") + 18;
+        fntRenderString(gTheme->fonts[4], hx, 448, ALIGN_VCENTER, 0, 0, "RIGHT STICK OR UP / DOWN: SCROLL", GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80));
+        rmEndFrame();
+
+        if (getKeyOn(closeKey) || getKeyOn(KEY_START)) {
+            sfxPlay(SFX_CANCEL);
+            break;
+        }
+    }
+    readPads();
+}
