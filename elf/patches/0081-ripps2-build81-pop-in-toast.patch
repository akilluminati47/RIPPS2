-    }
-    int lx = (aligned & ALIGN_HCENTER) ? x - total / 2 : x;
-    short va = (aligned & ALIGN_VCENTER) ? ALIGN_VCENTER : ALIGN_NONE;
-    int baseA = (colour >> 24) & 0xFF;
-    for (i = 0; i < n; i++) {
-        ch[0] = text[i];
-        int cw = rmUnScaleX(fntCalcDimensions(font, ch));
-        float li = (t - SRC_STEP_S * i) / SRC_IN_S;
-        if (li > 0.0f && ch[0] != ' ') {
-            if (li > 1.0f)
-                li = 1.0f;
-            int ly = y + (int)((1.0f - easeOutBack(li)) * 10.0f);
