+int gRipps2PaletteShown = 0; // build 81: the Color Theme drawn (ripps2tint.h): the setting, or the theme's color_theme
+int gRipps2UserSet = 0;      // build 81: RIPPS2_SET_* bits, the Colors and More rows the user has changed (saved)
+
+// build 81: a theme's own defaults for Colors and More (conf_theme.cfg: color_theme, category_bar,
+// button_hints, dpad_glyphs, category_order, source_name). The user always wins: a theme's value shows
+// only for a row the user has never changed (gRipps2UserSet) and that still holds its own default, so a
+// choice made in any build, the default itself included once picked, stays the user's.
+static int themeDefault(int setting, int settingDefault, int themeValue, int bit)
+{
+    if ((gRipps2UserSet & bit) || setting != settingDefault || themeValue < 0)
+        return setting;
+    return themeValue;
+}
+
+static int hintsMode(void)
+{
+    return themeDefault(gRipps2Hints, RIPPS2_SHOW_ON, gTheme != NULL ? gTheme->hintsDef : -1, RIPPS2_SET_HINTS);
+}
+
+static int catBarMode(void)
+{
+    return themeDefault(gRipps2CatBar, RIPPS2_SHOW_ON, gTheme != NULL ? gTheme->catBarDef : -1, RIPPS2_SET_CATBAR);
+}
+
+static int glyphsMode(void)
+{
+    return themeDefault(gRipps2Glyphs, RIPPS2_GLYPHS_HIDDEN, gTheme != NULL ? gTheme->glyphsDef : -1, RIPPS2_SET_GLYPHS);
+}
+
+static int catSwapMode(void)
+{
+    return themeDefault(gRipps2CatSwap, 0, gTheme != NULL ? gTheme->catSwapDef : -1, RIPPS2_SET_CATSWAP);
+}
+
+void ripps2PaletteSync(void)
+{
+    gRipps2PaletteShown = themeDefault(gRipps2Palette, 0, gTheme != NULL ? gTheme->paletteDef : -1, RIPPS2_SET_PALETTE);
+}
+
+// What Colors and More shows for a row: what is in effect, the theme's default included
+int ripps2ColorsShown(int bit)
+{
+    switch (bit) {
+        case RIPPS2_SET_GLYPHS:
+            return glyphsMode();
+        case RIPPS2_SET_PALETTE:
+            ripps2PaletteSync();
+            return gRipps2PaletteShown;
+        case RIPPS2_SET_HINTS:
+            return hintsMode();
+        case RIPPS2_SET_CATBAR:
+            return catBarMode();
+        case RIPPS2_SET_CATSWAP:
+            return catSwapMode();
+        case RIPPS2_SET_SRCNAME:
+            return ripps2SourceNameMode();
+    }
+    return 0;
+}
 
