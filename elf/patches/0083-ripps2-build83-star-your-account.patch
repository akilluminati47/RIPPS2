+// build 83: words laid out in lines that fit `w` (unscaled units), one fntRenderString per line, so a
+// message wraps whole instead of being clipped mid-word
+static void raWrap(int font, int x, int y, int w, int lineh, const char *text, u64 col)
+{
+    char line[160], word[64];
+    const char *p = text;
+    line[0] = '\0';
+    while (*p) {
+        int k = 0;
+        while (*p == ' ')
+            p++;
+        while (*p && *p != ' ' && k < (int)sizeof(word) - 1)
+            word[k++] = *p++;
+        word[k] = '\0';
+        if (k == 0)
+            break;
+        char next[160];
+        snprintf(next, sizeof(next), "%s%s%s", line, line[0] ? " " : "", word);
+        if (line[0] && rmUnScaleX(fntCalcDimensions(font, next)) > w) {
+            fntRenderString(font, x, y, ALIGN_VCENTER, 0, 0, line, col);
+            y += lineh;
+            snprintf(line, sizeof(line), "%s", word);
+        } else
+            snprintf(line, sizeof(line), "%s", next);
+    }
+    if (line[0])
+        fntRenderString(font, x, y, ALIGN_VCENTER, 0, 0, line, col);
+}
