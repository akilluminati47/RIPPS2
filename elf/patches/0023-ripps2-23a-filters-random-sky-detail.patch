+// ---- the sky's stars and the motes drifting up through the field ----
+#define STAR_N 64
+#define MOTE_N 24
+static float starX[STAR_N], starY[STAR_N], starPh[STAR_N], starB[STAR_N];
+static v3 motePos[MOTE_N];
+static float motePh[MOTE_N];
+static int skyReady = 0;
+
+static void skyInit(void)
+{
+    int i;
+    for (i = 0; i < STAR_N; i++) {
+        starX[i] = rnd() * 640.0f;
+        starY[i] = rnd() * rnd() * 250.0f; // denser toward the top
+        starPh[i] = rnd() * TAU;
+        starB[i] = 0.35f + rnd() * 0.65f;
+    }
+    for (i = 0; i < MOTE_N; i++) {
+        v3 m = {(rnd() - 0.5f) * 30.0f, rnd() * 16.0f, (rnd() - 0.5f) * 30.0f};
+        motePos[i] = m;
+        motePh[i] = rnd() * TAU;
+    }
+    skyReady = 1;
+}
+
+static void drawStars(float t, float turn, float glowAll)
+{
+    int i;
+    rmSetBlendAdditive(1);
+    for (i = 0; i < STAR_N; i++) {
+        float x = fmodf(starX[i] - turn * 160.0f + 6400.0f, 640.0f); // drift with the camera's turn
+        float twinkle = 0.55f + 0.45f * sinf(t * (0.8f + starB[i]) + starPh[i]);
+        int a = (int)(0x50 * starB[i] * twinkle * (1.0f - 0.7f * glowAll));
+        if (a < 4)
+            continue;
+        rmDrawRect((int)x, (int)starY[i], starB[i] > 0.85f ? 2 : 1, 1, RGBA(0x9C, 0xC0, 0xFF, a));
+    }
+    rmSetBlendAdditive(0);
+}
+
+// A mote: a small additive glow
+static void moteGlow(float x, float y, float r, int a)
+{
+    int k;
+    const int seg = 6;
+    u64 centre = RGBA(0xB0, 0xD0, 0xFF, a), rim = RGBA(0xB0, 0xD0, 0xFF, 0);
+    float px = x + r, py = y;
+    for (k = 1; k <= seg; k++) {
+        float ang = TAU * k / seg, nx = x + cosf(ang) * r, ny = y + sinf(ang) * r;
+        rmDrawTriGouraud(x, y, centre, px, py, rim, nx, ny, rim);
+        px = nx;
+        py = ny;
+    }
+}
+
+// The motes rise slowly and sway; the far half is drawn before the towers and the near half after,
+// so towers hide the ones behind them
+static void drawMotes(float t, int nearPass)
+{
+    int i;
+    rmSetBlendAdditive(1);
+    for (i = 0; i < MOTE_N; i++) {
+        float y = fmodf(motePos[i].y + t * 0.35f, 16.0f);
+        v3 w = {motePos[i].x + sinf(t * 0.3f + motePh[i]) * 0.8f, y, motePos[i].z + cosf(t * 0.25f + motePh[i]) * 0.8f};
+        p2 p = project(w);
+        if (!onScreen(p) || (p.z < 32.0f) != nearPass)
+            continue;
+        int a = (int)(0x48 * sinf(PI * y / 16.0f)); // fade in at the floor, out at the top
+        if (a > 2)
+            moteGlow(p.x, p.y, 140.0f / p.z, a);
+    }
+    rmSetBlendAdditive(0);
+}
