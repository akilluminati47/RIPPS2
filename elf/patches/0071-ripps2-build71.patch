diff --git a/src/ripps2ember.c b/src/ripps2ember.c
new file mode 100644
index 0000000..1fe7ae4
--- /dev/null
+++ b/src/ripps2ember.c
@@ -0,0 +1,96 @@
+/*
+  RIPPS2 build 71: Ember on board.
+
+  Ember, the PS1 emulator for the PS2 by Gageformer, rides inside RIPPS2.ELF gzip-compressed, with its
+  licence. Launching an Ember game from a drive whose EMBER folder has no ember.elf writes the build
+  there, unmodified (the gzip trailer's CRC and the size are checked), with LICENSE-BETA.txt beside
+  it, and the launch goes on. Only the launch paths do this: a list scan never writes 1.6 MB.
+
+  Bundled under the Ember Public Beta Testing Licence (elf/ember/LICENSE-BETA.txt in ps2-pillars):
+  unmodified and complete, with its licence, credited in About with its release page, and free.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <zlib.h>
+#include <sys/stat.h>
+
+#include "include/opl.h"
+#include "include/ioman.h"
+#include "include/ripps2.h"
+
+extern void *ember_elf_gz; // misc/ember_elf.gz: elf/ember/ember.elf, gzip -9 by RIPPS2's build.sh
+extern int size_ember_elf_gz;
+extern void *ember_licence_txt; // misc/ember_licence.txt: elf/ember/LICENSE-BETA.txt
+extern int size_ember_licence_txt;
+
+#define EMBER_ELF_SIZE 1611956 // the bundled build, Beta-2, as released
+#define EMBER_CHUNK    (32 * 1024)
+
+static unsigned char emberOut[EMBER_CHUNK] __attribute__((aligned(64)));
+
+int ripps2EmberInstall(const char *elfPath)
+{
+    char dir[256], lic[288];
+    const char *slash = strrchr(elfPath, '/'), *bslash = strrchr(elfPath, '\\');
+    const char *sep = slash > bslash ? slash : bslash;
+    z_stream zs;
+    int fd, total = 0, ret, ok = 1, writes = 0;
+
+    if (sep == NULL || (int)(sep - elfPath) >= (int)sizeof(dir))
+        return 0;
+    snprintf(dir, sizeof(dir), "%.*s", (int)(sep - elfPath), elfPath);
+    mkdir(dir, 0777); // the EMBER folder: there already when the drive has Ember games
+    snprintf(lic, sizeof(lic), "%.*sLICENSE-BETA.txt", (int)(sep - elfPath + 1), elfPath);
+
+    fd = open(elfPath, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd < 0) {
+        LOG("EMBER: cannot write %s\n", elfPath);
+        return 0;
+    }
+    memset(&zs, 0, sizeof(zs));
+    zs.next_in = (unsigned char *)&ember_elf_gz;
+    zs.avail_in = size_ember_elf_gz;
+    if (inflateInit2(&zs, 15 + 16) != Z_OK) { // 15 + 16: a gzip stream
+        close(fd);
+        remove(elfPath);
+        return 0;
+    }
+    do {
+        zs.next_out = emberOut;
+        zs.avail_out = EMBER_CHUNK;
+        ret = inflate(&zs, Z_NO_FLUSH);
+        if (ret != Z_OK && ret != Z_STREAM_END) {
+            ok = 0;
+            break;
+        }
+        int n = EMBER_CHUNK - zs.avail_out;
+        if (n > 0 && write(fd, emberOut, n) != n) {
+            ok = 0;
+            break;
+        }
+        total += n;
+        if ((++writes & 3) == 0)
+            ripps2LaunchPump(); // the towers keep moving while it writes
+    } while (ret != Z_STREAM_END);
+    inflateEnd(&zs);
+    close(fd);
+
+    if (!ok || total != EMBER_ELF_SIZE) {
+        LOG("EMBER: install failed (%d of %d bytes)\n", total, EMBER_ELF_SIZE);
+        remove(elfPath);
+        return 0;
+    }
+    fd = open(lic, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd < 0 || write(fd, &ember_licence_txt, size_ember_licence_txt) != size_ember_licence_txt) {
+        if (fd >= 0)
+            close(fd);
+        remove(elfPath); // Ember goes with its licence, or not at all
+        return 0;
+    }
+    close(fd);
+    LOG("EMBER: installed %s\n", elfPath);
+    return 1;
+}
