+// RIPPS2 build 71: Show Recents. The game about to launch goes to the top of recents.bin (it is
+// moved there if it is already in it), which keeps the nine most recent.
+#define FAV_RECENTS_MAX 9
+void favPushRecent(int mode, int id, int icon_id, int text_id, const char *text, int kind)
+{
+    int count = 0, n = 1, i;
+    fav_raw_t *recs, *out;
+
+    if (text == NULL || text[0] == '\0')
+        return;
+    recs = favReadNamed("recents.bin", &count);
+    out = (fav_raw_t *)calloc(FAV_RECENTS_MAX, sizeof(fav_raw_t));
+    if (out == NULL) {
+        free(recs);
+        return;
+    }
+    out[0].mode = mode;
+    out[0].id = id;
+    out[0].icon_id = icon_id;
+    out[0].text_id = text_id;
+    out[0].kind = kind;
+    snprintf(out[0].text, FAV_TEXT_MAX, "%s", text);
+    for (i = 0; i < count && n < FAV_RECENTS_MAX; i++)
+        if (!favSameRecord(&recs[i], &out[0]))
+            out[n++] = recs[i];
+    favWriteNamed("recents.bin", out, n);
+    free(out);
+    free(recs);
+}
