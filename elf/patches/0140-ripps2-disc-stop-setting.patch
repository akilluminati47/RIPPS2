+/* RIPPS2 build 140 (the user, 11/04: "played another sound effect after its playback", and earlier a confirm-like sound and a transition after one cursor move: the
+   sound trace shows nothing asked for them). audsrv never sets a voice's loop address, and a block flagged "end, no repeat" (flags 1: every rip's last sound
+   block, Media Studio's last block) sends the voice to that address: only a block with the loop-start flag sets it, and on these files the one block that has
+   it comes after the end, so it is never read. The address left over from an earlier sound is where the voice goes, reading another sound's memory for as long as
+   it is still sounding. Here the "end, no repeat" flag comes off and the sound ends on a silent block that loops on itself (flags 7), which sets the loop
+   address to its own and raises the end bit audsrv checks, so a voice can never leave its own sound. A sound that loops on purpose (repeat) is left alone. The
+   buffer has room for one more block. The new size. */
+static int sfxSealEnd(unsigned char *buf, int size)
+{
+    unsigned char *b = buf + 16;
+    int n = (size - 16) / 16, i, k;
+
+    for (i = 0; i < n && !(b[i * 16 + 1] & 1); i++)
+        ;
+    if (i < n && (b[i * 16 + 1] & 2)) {
+        // already looping: a silent tail is kept, and takes filter 0 so nothing rings from the decoder's history
+        if (b[i * 16 + 1] == 7) {
+            for (k = 2; k < 16 && b[i * 16 + k] == 0; k++)
+                ;
+            if (k == 16)
+                b[i * 16] = 0;
+        }
+        return size;
+    }
+    if (i < n)
+        b[i * 16 + 1] &= ~1;
+    k = i < n ? i + 1 : n;
+    memset(b + k * 16, 0, 16);
+    b[k * 16 + 1] = 7;
+    return 16 + (k + 1) * 16;
+}
