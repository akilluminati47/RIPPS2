+/* build 140 (the user, 11/04: spamming R1 to reach far into a film crashed the player: "a scrub guard like launch guard"). Every press stopped the player and started it again
+   at once, the next press landing mid-restart. Now L1 / R1 only move a target on a timeline in the hint row's place: a tap 10 s, held it runs (30 s a second, then 2, then
+   10 minutes a second). The player seeks once, 0.6 s after the last input and only when its last seek has its first frame up; the confirm button goes now, cancel keeps the place. */
+static void vpClock(int ms, char *out, int size)
+{
+    int s = ms / 1000;
+    snprintf(out, size, "%d:%02d:%02d", s / 3600, (s / 60) % 60, s % 60);
+}
+
+static void vpPaintSeek(int target, int dur, int pos)
+{
+    unsigned char *b = vpHints;
+    char text[16];
+    int font = ripps2HintFontId(), x, y, x0 = 104, x1 = 536, w = x1 - x0;
+    int at = dur > 0 ? (int)((s64)target * w / dur) : 0, now = dur > 0 ? (int)((s64)pos * w / dur) : 0;
+
+    memset(b, 0, VP_HINT_W * VP_HINT_H * 4);
+    for (y = 0; y < VP_HINT_H; y++)
+        for (x = 0; x < VP_HINT_W; x++)
+            vpOver(b + (y * VP_HINT_W + x) * 4, 0, 0, 0, 0x50);
+    for (y = 18; y < 22; y++)
+        for (x = 0; x < w; x++)
+            vpOver(b + (y * VP_HINT_W + x0 + x) * 4, 0xFF, 0xFF, 0xFF, x < at ? 0x70 : 0x20);
+    for (y = 15; y < 25; y++) // where it is playing, dim, and where it will go
+        vpOver(b + (y * VP_HINT_W + x0 + now) * 4, 0xFF, 0xFF, 0xFF, 0x40);
+    for (y = 12; y < 28; y++)
+        for (x = -1; x <= 1; x++)
+            vpOver(b + (y * VP_HINT_W + x0 + at + x) * 4, 0xFF, 0xFF, 0xFF, 0x80);
+    vpClock(target, text, sizeof(text));
+    vpText(b, VP_HINT_W, VP_HINT_H, font, 15, text, 22, 25, 0xFFFFFF);
+    vpClock(dur, text, sizeof(text));
+    vpText(b, VP_HINT_W, VP_HINT_H, font, 15, text, x1 + 18, 25, 0xA8B0C8);
+}
