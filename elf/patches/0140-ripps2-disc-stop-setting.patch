+enum { SFX_TR_PLAY = 0, SFX_TR_NOVOICE, SFX_TR_OFF, SFX_TR_HOLD, SFX_TR_BUSY, SFX_TR_NOSOUND, SFX_TR_DRIVE, SFX_TR_PEND, SFX_TR_SAME, SFX_TR_PRESS, SFX_TR_MUTE, SFX_TR_LOAD, SFX_TR_LOADED, SFX_TR_BOOT };
