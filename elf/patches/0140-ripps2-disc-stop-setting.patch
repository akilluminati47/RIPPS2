+typedef struct
+{
+    u32 ms;
+    u32 from;
+    signed char asked, played, voice;
+    unsigned char what, live;
+    unsigned char pad[3];
+} sfxTrace_t;
+#define SFX_TRACE_MAX 512
+static sfxTrace_t sfxTraceRing[SFX_TRACE_MAX];
+static volatile unsigned int sfxTraceCount = 0;
+
+static void sfxTrace(int asked, int played, int voice, int what, void *from)
+{
+    sfxTrace_t *e;
+    unsigned int n;
+    int v, live = 0;
