+        if (voiceBusy(v) && !voiceMuted[v])
+            live++;
+    DIntr();
+    n = sfxTraceCount++;
+    EIntr();
+    e = &sfxTraceRing[n % SFX_TRACE_MAX];
+    e->ms = (u32)(clock() / (CLOCKS_PER_SEC / 1000));
+    e->from = (u32)from;
+    e->asked = (signed char)asked;
+    e->played = (signed char)played;
+    e->voice = (signed char)voice;
+    e->what = (unsigned char)what;
+    e->live = (unsigned char)live;
+}
