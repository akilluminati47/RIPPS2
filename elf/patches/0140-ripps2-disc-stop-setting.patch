+/* build 140 (the user, 11/04: "disclose that renaming does not break the art lookup ... make sure if its drive related that the tooltip would reflect it"). What the file
+   name row of Set Metadata (Rename) says on this row, and whether it can rename. A PS2 game's art and CFG go by its game ID (itemGetStartup); a PS1 game's and an Ember
+   title's go by name, so sbRenameSidecars takes them along; an app's title is only its title. ps1: the row came through the apps' and PS1 games' menu. */
+static const char *menuRenameTip(item_list_t *support, int ps1, int *can)
+{
+    item_list_t *rs = support;
+    *can = 0;
+    if (support != NULL && support->mode == FAV_MODE)
+        return _t("This list shows games from other drives. Rename a game on its own drive's page.");
+    if (selected_item != NULL && selected_item->item->current != NULL && selected_item->item->current->item.favourited)
+        return _t("A starred game cannot be renamed. Take off its star (R3), rename it, then star it again.");
+    if (support != NULL && MODE_IS_MIX(support->mode) && selected_item != NULL && selected_item->item->current != NULL) {
+        int sm = mixGetItemSourceMode(support->mode, selected_item->item->current->item.id);
+        opl_io_module_t *m = sm >= 0 ? oplGetModule(sm) : NULL;
+        rs = m != NULL ? m->support : NULL;
+        if (rs == NULL)
+            return _t("This game's drive has not answered yet. Wait for it, then try again.");
+    }
+    if (rs == NULL || rs->itemRename == NULL)
+        return _t("This drive cannot rename its files. The details can still be set.");
+    if (!ps1 && rs->mode == HDD_MODE)
+        return _t("On an APA HDD a PS2 game's name lives in the partition table, so it cannot be renamed here. Its details can still be set.");
+    *can = 1;
+    if (rs->mode == APP_MODE)
+        return _t("Renames the app in your list. Its ELF and its art keep their names.");
+    return ps1 ? _t("Renames the game on its drive. PS1 games find their art and settings by name, so RIPPS2 renames those with it. Art in an ART Pack needs the pack built again.") :
+                 _t("Renames the game's file on its drive. PS2 games find their art and settings by game ID, so nothing is lost.");
