+   would leave them behind. They go with it: CFG/<name>.cfg and every ART/<name>_*. An ART Pack keeps its copies under the old name until it is built again (the page says so). */
+void sbRenameSidecars(const char *prefix, const char *sep, const char *oldName, const char *newName)
+{
+    static char names[64][128];
+    char from[384], to[384];
+    struct dirent *e;
+    size_t ol = strlen(oldName);
+    int n = 0, i, moved = 0;
+    DIR *d;
+
+    snprintf(from, sizeof(from), "%sCFG%s%s.cfg", prefix, sep, oldName);
+    snprintf(to, sizeof(to), "%sCFG%s%s.cfg", prefix, sep, newName);
+    if (rename(from, to) == 0)
+        moved++;
+    snprintf(from, sizeof(from), "%sART", prefix);
+    if ((d = opendir(from)) != NULL) { // the names first: a directory is not renamed in as it is read
+        while (n < 64 && (e = readdir(d)) != NULL)
+            if (!strncmp(e->d_name, oldName, ol) && e->d_name[ol] == '_' && strlen(e->d_name) < sizeof(names[0]))
+                snprintf(names[n++], sizeof(names[0]), "%s", e->d_name);
+        closedir(d);
+    }
+    for (i = 0; i < n; i++) {
+        snprintf(from, sizeof(from), "%sART%s%s", prefix, sep, names[i]);
+        snprintf(to, sizeof(to), "%sART%s%s%s", prefix, sep, newName, names[i] + ol);
+        if (rename(from, to) == 0)
+            moved++;
+    }
+    ripps2Diag("rename: %d settings and art files went with %s", moved, newName);
+}
