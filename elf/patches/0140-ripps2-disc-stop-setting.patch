+#define MD_TIP_H 54
+
+// The tip, at most three lines, broken at spaces where there are any (and between characters where a language has none)
+static void mdTip(const char *text, int x, int y, int width)
+{
+    char line[256];
+    const char *p = text;
+    int row;
+
+    for (row = 0; row < 3 && *p; row++) {
+        int len = 0, fit = 0, space = 0;
+        while (p[len] && len < (int)sizeof(line) - 5) {
+            int n = 1;
+            while ((p[len + n] & 0xC0) == 0x80)
+                n++;
+            memcpy(line, p, len + n);
+            line[len + n] = '\0';
+            if (rmUnScaleX(fntCalcDimensions(RIPPS2_DIA_FONT, line)) > width)
+                break;
+            len += n;
+            fit = len;
+            if (p[len] == ' ')
+                space = len;
+        }
+        if (p[fit] && space > 0)
+            fit = space;
+        memcpy(line, p, fit);
+        line[fit] = '\0';
+        fntRenderString(RIPPS2_DIA_FONT, x, y + row * 18, ALIGN_VCENTER, 0, 0, line, ED_SOFT);
+        p += fit;
+        while (*p == ' ')
+            p++;
+    }
+}
