+// RIPPS2: category switches cut straight to the next screen. The fade above would black out the
+// PS2 mark's flight between LAUNCH DISC / STORAGE / MEMORY FILES, which is the transition there.
+void guiSwitchScreenInstant(int target)
+{
+    if (screenHandlerTarget != NULL)
+        return; // a faded switch is already under way; let it finish
+    sfxPlay(SFX_TRANSITION);
+    screenHandler = &screenHandlers[target];
+}
