+// ---- STORAGE art panel ----
+// Two theme layers around the game's BG art (elements Ripps2PanelBack and Ripps2PanelGlass):
+//   back  - under the art: an opaque PS2-blue backdrop with the PS2 mark. It is the panel's
+//           placeholder, seen before a device starts and for games without art.
+//   glass - over the art: a navy tint, light at the top so the art shows, deep where the text
+//           sits, and a thin PS2-blue frame. Text elements come after it and stay on top.
+//           With no game selected it carries the placeholder line (start the device / empty).
+// Both are drawn procedurally, so they stay crisp at any panel size.
+
+#define RGBA_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00) // untextured: 0x80 = opaque
+
+static void panelFrame(int x, int y, int w, int h)
+{
+    u64 edge = RGBA_PRIM(0x4A, 0x72, 0xDC, 0x80), shine = RGBA_PRIM(0x9C, 0xB8, 0xFF, 0x50);
+    rmDrawLine(x, y, x + w, y, edge);
+    rmDrawLine(x, y + h, x + w, y + h, edge);
+    rmDrawLine(x, y, x, y + h, edge);
+    rmDrawLine(x + w, y, x + w, y + h, edge);
+    rmDrawLine(x + 1, y + 1, x + w - 1, y + 1, shine); // glass catching the light along the top
+}
+
+void ripps2DrawPanelBack(int x, int y, int w, int h)
+{
+    u64 top = RGBA_PRIM(0x10, 0x26, 0x6C, 0x80), bottom = RGBA_PRIM(0x03, 0x08, 0x1E, 0x80);
+    rmDrawQuadGouraud(x, y, top, x + w, y, top, x, y + h, bottom, x + w, y + h, bottom);
+
+    GSTEXTURE *mark = thmGetTexture(RIPPS2_MARK);
+    if (mark) {
+        int mw = (w * 44) / 100, mh = (mw * mark->Height) / mark->Width;
+        rmDrawPixmap(mark, x + w / 2, y + (h * 34) / 100, ALIGN_CENTER, mw, mh, SCALING_RATIO, GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x60), 0);
+    }
+}
+
+void ripps2DrawPanelGlass(int x, int y, int w, int h, int hasItem, int started)
+{
+    // tint: 30% over the upper art, deepening to 85% by the text zone (the lower 44%)
+    int y1 = y + (h * 38) / 100, y2 = y + (h * 56) / 100;
+    u64 light = RGBA_PRIM(0x04, 0x0C, 0x2E, 0x26), mid = RGBA_PRIM(0x04, 0x0C, 0x2E, 0x40), deep = RGBA_PRIM(0x03, 0x08, 0x22, 0x6C);
+    rmDrawQuadGouraud(x, y, light, x + w, y, light, x, y1, light, x + w, y1, light);
+    rmDrawQuadGouraud(x, y1, light, x + w, y1, light, x, y2, mid, x + w, y2, mid);
+    rmDrawQuadGouraud(x, y2, mid, x + w, y2, mid, x, y + h, deep, x + w, y + h, deep);
+    panelFrame(x, y, w, h);
+
+    if (hasItem)
+        return; // the game's own Description element draws next
+
+    // Placeholder line where the game's description would start (same x/y as that element)
+    int tx = x + 16, ty = y + h - 122;
+    if (!started) {
+        GSTEXTURE *btn = thmGetTexture(gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON);
+        int px = fntRenderString(gTheme->fonts[3], tx, ty, ALIGN_NONE, 0, 0, "PRESS", COLOR_SOFT) + 6;
+        if (btn) {
+            int bw = (btn->Width * 18) / btn->Height;
+            rmDrawPixmap(btn, px + bw / 2, ty + 6, ALIGN_CENTER, bw, 18, SCALING_RATIO, COLOR_TEX, 0);
+            px += bw + 6;
+        }
+        fntRenderString(gTheme->fonts[3], px, ty, ALIGN_NONE, 0, 0, "TO START THIS DEVICE", COLOR_SOFT);
+    } else {
+        fntRenderString(gTheme->fonts[3], tx, ty, ALIGN_NONE, 0, 0, "NO GAMES FOUND ON THIS DEVICE", COLOR_SOFT);
+    }
+}
