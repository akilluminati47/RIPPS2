+// RIPPS2 art panel layers (ripps2ui.c draws them). Geometry comes from the element's x/y/width/height.
+static void ripps2PanelRect(struct theme_element *elem, int *x, int *y)
+{
+    *x = elem->posX;
+    *y = elem->posY;
+    if (elem->aligned) {
+        *x -= elem->width >> 1;
+        *y -= elem->height >> 1;
+    }
+}
+
+static void drawRipps2PanelBack(struct menu_list *menu, struct submenu_list *item, config_set_t *config, struct theme_element *elem)
+{
+    int x, y;
+    ripps2PanelRect(elem, &x, &y);
+    ripps2DrawPanelBack(x, y, elem->width, elem->height);
+}
+
+static void drawRipps2PanelGlass(struct menu_list *menu, struct submenu_list *item, config_set_t *config, struct theme_element *elem)
+{
+    int x, y;
+    item_list_t *support = menu->item->userdata;
+    ripps2PanelRect(elem, &x, &y);
+    ripps2DrawPanelGlass(x, y, elem->width, elem->height, item != NULL, support != NULL ? support->enabled : 1);
+}
