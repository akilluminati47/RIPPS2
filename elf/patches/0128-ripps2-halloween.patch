     free(cueGames);
+    if (gRipps2Ps1Prefer == 1 || gRipps2Ps1Prefer == 2) // RIPPS2 build 126: PS1 Duplicates
+        total = ps1DropTwins(merged, vcdCount, cueCount, gRipps2Ps1Prefer);
 
