+// build 126 (the user, 10/31: "the vcd art on mmce is slower than its ps2 iso art ... at hdd game speed"): the other names a
+// picture of <value>_<suffix> goes by (texArtAliases, a PS1 game's other keys included), as key and kind apart, for the
+// art.tar, whose index answers a miss in RAM. Returns how many
+int texArtAliasNames(const char *value, const char *suffix, char keys[][160], char kinds[][8], int max)
+{
+    static const char *const kinds2[] = {"SCR_00", "SCR_01", "BG_00", "COV2", "SCR2", "COV", "ICO", "LAB", "LGO", "SCR", "BG"};
+    char path[256], out[TEX_ART_ALIASES][256];
+    int n, i, k, got = 0;
+
+    if (value == NULL || suffix == NULL || snprintf(path, sizeof(path), "ART/%s_%s", value, suffix) >= (int)sizeof(path))
+        return 0;
+    n = texArtAliases(path, 1, out);
+    for (i = 0; i < n && got < max; i++) {
+        const char *name = out[i] + 4; // past "ART/"
+        size_t len = strlen(name);
+        for (k = 0; k < (int)(sizeof(kinds2) / sizeof(kinds2[0])); k++) {
+            size_t kl = strlen(kinds2[k]);
+            if (len > kl + 1 && name[len - kl - 1] == '_' && !strcmp(&name[len - kl], kinds2[k]) && len - kl - 1 < 160) {
+                memcpy(keys[got], name, len - kl - 1);
+                keys[got][len - kl - 1] = '\0';
+                snprintf(kinds[got], 8, "%s", kinds2[k]);
+                got++;
+                break;
+            }
+        }
+    }
+    return got;
+}
