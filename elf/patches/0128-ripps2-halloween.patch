+/* RIPPS2 build 126 (ahavasi, 10/30: "I used POPStarterGameInstallerforOPL for PSX stuff, my ps1 games are listed as random
+   numbers. is it possible to use conf_apps.cfg to get game names?"): that installer names each game's files with a number
+   and writes the game's name into conf_apps.cfg, "<name>=mass:/POPS/XX.<number>.ELF". A PS1 row whose file is the one a
+   conf_apps.cfg line launches shows that line's name. Display only: the row's identity (art, CFG, launch) stays the file
+   name. The lines are read into a table, by the launcher's name, once each time conf_apps.cfg changes */
+#define VCD_APPS_MAX 512
+static struct
+{
+    char base[64];  // the launcher's file name without XX. and .ELF, upper case
+    char title[64]; // conf_apps.cfg's name for it
+} vcdApps[VCD_APPS_MAX];
+static int vcdAppsCount = -1;
+static u32 vcdAppsUid = 0;
+
+static int vcdAppsCmp(const void *a, const void *b)
+{
+    return strcmp((const char *)a, (const char *)b); // base is the first member
+}
+
+static void vcdAppsLoad(config_set_t *apps)
+{
+    struct config_value_t *v;
+    vcdAppsCount = 0;
+    for (v = apps != NULL ? apps->head : NULL; v != NULL && vcdAppsCount < VCD_APPS_MAX; v = v->next) {
+        const char *base = strrchr(v->val, '/'), *colon = strrchr(v->val, ':');
+        size_t len;
+        if (v->key[0] == '$' || v->key[0] == '#' || v->key[0] == '\0')
+            continue;
+        if (base == NULL || (colon != NULL && colon > base))
+            base = colon;
+        base = base != NULL ? base + 1 : v->val;
+        if (!strncasecmp(base, "XX.", 3))
+            base += 3;
+        len = strlen(base);
+        if (len < 5 || strcasecmp(base + len - 4, ".ELF") || len - 4 >= sizeof(vcdApps[0].base))
+            continue;
+        for (size_t i = 0; i < len - 4; i++)
+            vcdApps[vcdAppsCount].base[i] = (char)toupper((unsigned char)base[i]);
+        vcdApps[vcdAppsCount].base[len - 4] = '\0';
+        snprintf(vcdApps[vcdAppsCount].title, sizeof(vcdApps[0].title), "%s", v->key);
+        vcdAppsCount++;
+    }
+    qsort(vcdApps, vcdAppsCount, sizeof(vcdApps[0]), vcdAppsCmp);
+}
+
+static const char *vcdAppsTitle(const char *name)
+{
+    config_set_t *apps = configGetByType(CONFIG_APPS);
+    char key[64];
+    size_t i;
+
+    if (apps == NULL || name == NULL)
+        return NULL;
+    if (vcdAppsCount < 0 || apps->uid != vcdAppsUid) {
+        vcdAppsUid = apps->uid;
+        vcdAppsLoad(apps);
+    }
+    if (vcdAppsCount <= 0)
+        return NULL;
+    for (i = 0; name[i] && i < sizeof(key) - 1; i++)
+        key[i] = (char)toupper((unsigned char)name[i]);
+    key[i] = '\0';
+    const char *hit = bsearch(key, vcdApps, vcdAppsCount, sizeof(vcdApps[0]), vcdAppsCmp);
+    return hit != NULL ? hit + sizeof(vcdApps[0].base) : NULL; // its title
+}
