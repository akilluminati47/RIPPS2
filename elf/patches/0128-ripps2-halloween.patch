+// RIPPS2 build 126 (the user, 10/31: "we are the leaders of .pad"): Controllers > My Pads. Every PADS/VVVV_PPPP.pad beside
+// RIPPS2 read with the reference reader (padfile.c), each with its name or the line and reason it is refused, and how
+// many game maps PADS/GAMES holds. Phase 2 hands them to PADEMU (ps2-pillars docs/plans/pad-spec.md)
+static void guiShowMyPads(void)
+{
+    char dir[256], path[320], msg[1200], line[160], err[96], *text;
+    int len = 0, pads = 0, games = 0, fd;
+    unsigned vid, pid;
+    struct dirent *e;
+    DIR *d;
+
+    if (!oplGetRipps2Dir(dir, sizeof(dir) - 16)) {
+        guiMsgBox(_t("RIPPS2 cannot tell where its folder is, so it cannot look for PADS."), 0, NULL);
+        return;
+    }
+    strcat(dir, "PADS");
+    len = snprintf(msg, sizeof(msg), _t("Pad profiles in %s:"), dir);
+    if ((text = malloc(8192)) != NULL && (d = opendir(dir)) != NULL) {
+        while ((e = readdir(d)) != NULL && len < (int)sizeof(msg) - 200) {
+            pad_def_t def;
+            const char *name = "";
+            int n;
+            if (padFileId(e->d_name, &vid, &pid) != 0)
+                continue;
+            snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
+            n = (fd = open(path, O_RDONLY)) >= 0 ? read(fd, text, 8191) : -1;
+            if (fd >= 0)
+                close(fd);
+            if (n < 0) {
+                snprintf(line, sizeof(line), "\n%04X:%04X  %s", vid, pid, _t("could not be read"));
+            } else if (padDefParse(text, n, vid, pid, &def, err, sizeof(err)) != 0) {
+                snprintf(line, sizeof(line), "\n%04X:%04X  %s", vid, pid, err);
+            } else {
+                text[n] = '\0';
+                if ((name = strstr(text, "name=")) != NULL) { // its name, for the list (not the block's)
+                    char *end = strpbrk((char *)name + 5, "\r\n#");
+                    if (end != NULL)
+                        *end = '\0';
+                    name += 5;
+                } else
+                    name = "";
+                snprintf(line, sizeof(line), "\n%04X:%04X  %s  %s", vid, pid, name[0] ? name : _t("(no name)"), _t("OK"));
+            }
+            len += snprintf(msg + len, sizeof(msg) - len, "%s", line);
+            pads++;
+        }
+        closedir(d);
+        snprintf(path, sizeof(path), "%s/GAMES", dir);
+        if ((d = opendir(path)) != NULL) {
+            while ((e = readdir(d)) != NULL) {
+                size_t l = strlen(e->d_name);
+                games += l > 4 && !strcasecmp(e->d_name + l - 4, ".pad");
+            }
+            closedir(d);
+        }
+    }
+    free(text);
+    if (pads == 0)
+        len += snprintf(msg + len, sizeof(msg) - len, "\n%s", _t("None yet. A profile is a text file named after the pad's ID, like 2563_0575.pad: the format is in RIPPS2's repo (docs/plans/pad-spec.md)."));
+    if (len < (int)sizeof(msg) - 80)
+        snprintf(msg + len, sizeof(msg) - len, games == 1 ? _t("\n1 game button map in GAMES") : _t("\n%d game button maps in GAMES"), games);
+    guiMsgBox(msg, 0, NULL);
+}
