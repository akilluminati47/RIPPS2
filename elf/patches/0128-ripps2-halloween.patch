+{
+    char key[32];
+    snprintf(key, sizeof(key), "ripps2_start_s%d", fam);
+    configSetInt(configGetByType(CONFIG_OPL), key, (int)(secs + 0.5) < 1 ? 1 : (int)(secs + 0.5)); // saved with the settings
