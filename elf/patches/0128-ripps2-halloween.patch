+// on manual and launch from the list. It takes a second attempt"): the wait said a drive "did not answer" at 30 s, and a
+// Manual HDD (its drivers, the spin up, the mount and the first list) can take longer, so the second Cross found it up.
+// It now waits MIX_LAUNCH_WAIT_S, with the time a start of that drive took last (kept in the settings) as the estimate
+#define MIX_LAUNCH_WAIT_S 75.0
+#define MIX_GONE_GRACE_S  3.0 // a first list can come in parts: the game is gone only when it is still missing after this
+static const unsigned char mixStartGuess[MIX_FAM_COUNT] = {12, 10, 5, 6, 8, 6, 4, 12, 8, 10}; // s, until one is measured
+
+static int mixStartEstimate(int fam)
+{
+    char key[32];
+    int s = 0;
+    snprintf(key, sizeof(key), "ripps2_start_s%d", fam);
+    if (!configGetInt(configGetByType(CONFIG_OPL), key, &s) || s < 1 || s > 120)
+        s = mixStartGuess[fam];
+    return s;
+}
