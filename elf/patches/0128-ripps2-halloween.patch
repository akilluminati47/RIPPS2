+// RIPPS2 build 126 (the user, 10/31: "mmce show size"): a game file's size in MiB. stat first; a driver whose stat gives no
+// size (MMCE's mmceman) is asked by its end instead, once, when the info page wants it (sbConfigStatSize)
+static int sbFileSizeMB(const char *path)
+{
+    struct stat st;
+    int fd;
+    long long end;
+
+    if (stat(path, &st) == 0 && st.st_size > 0)
+        return (int)(st.st_size >> 20);
+    if ((fd = open(path, O_RDONLY)) < 0)
+        return 0;
+    end = lseek64(fd, 0, SEEK_END);
+    close(fd);
+    return end > 0 ? (int)(end >> 20) : 0;
+}
