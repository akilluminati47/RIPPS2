+// build 126 (the user, 10/31: "the boot sound option should show on (fast) for a third setting ... (if this isn't ideal then
+// make the setting put it on the boot memory card next to the elf no folder)"): Boot Sound > On (fast), and STATUS's row.
+// The boot sound beside RIPPS2 on the memory card it starts from is read before any drive is up, so it plays as the
+// pillars rise. Offers the copy when it is not there; 1 when the boot sound is read at once (the copy, or a set on a card)
+int ripps2BootSoundFast(void)
+{
+    char base[256], dir[288], dst[300];
+    struct stat st;
+
+    if (!sfxCardBootPath(dst, sizeof(dst))) {
+        guiMsgBox(_t("On (fast) keeps the boot sound beside RIPPS2 on the memory card it starts from, and RIPPS2 did not start "
+                     "from one. The boot sound plays as On."),
+                  0, NULL);
+        return 0;
+    }
+    if (stat(dst, &st) == 0 && st.st_size > 0)
+        return 1;
+    if (!ripps2AudioBase(base, sizeof(base) - 8, 0)) {
+        guiMsgBox(_t("There is no boot sound to copy yet: Audio settings > BIOS Sounds rips this console's."), 0, NULL);
+        return 0;
+    }
+    snprintf(dir, sizeof(dir), "%sAUDIO/", base);
+    if (!strncmp(dir, "mc", 2))
+        return 1; // the set is on a card already: read at once
+    rbsOfferCardBoot(dir);
+    return stat(dst, &st) == 0 && st.st_size > 0;
+}
