+// at most, so a slow drive never holds the page; placeholders show at once as before
+#define MAIN_GROUP_WAIT_S 0.6f
+static struct
+{
+    void *item;
+    unsigned int frame;
+    int pendingThis, pendingLast;
+    int released;
+    clock_t start, release;
+} mainGroup;
+
+static void mainGroupFrame(void *item)
+{
+    if (mainGroup.item != item || guiFrameId - mainGroup.frame > 2) {
+        mainGroup.item = item;
+        mainGroup.frame = guiFrameId;
+        mainGroup.pendingThis = 0;
+        mainGroup.pendingLast = 1;
+        mainGroup.released = 0;
+        mainGroup.start = clock();
+    } else if (mainGroup.frame != guiFrameId) {
+        mainGroup.pendingLast = mainGroup.pendingThis;
+        mainGroup.pendingThis = 0;
+        mainGroup.frame = guiFrameId;
+    }
+    if (!mainGroup.released && (mainGroup.pendingLast == 0 ||
+                                (float)(clock() - mainGroup.start) / (float)CLOCKS_PER_SEC >= MAIN_GROUP_WAIT_S)) {
+        mainGroup.released = 1;
+        mainGroup.release = clock();
+    }
+}
+
+static float mainGroupAlpha(void)
+{
+    if (!mainGroup.released)
+        return 0.0f;
+    float f = (float)(clock() - mainGroup.release) / (float)CLOCKS_PER_SEC / 0.35f; // ART_FADE_S
+    if (f >= 1.0f)
+        return 1.0f;
+    return f * f * (3.0f - 2.0f * f);
+}
