index 0ac51e9..b91af71 100644
--- a/src/cuesupport.c
+++ b/src/cuesupport.c
@@ -1026,6 +1026,42 @@ int cueFillGameList(const char *devPrefix, base_game_info_t **outGames)
 
 static int ps1ScanIncomplete;
 
+/* RIPPS2 build 126 (the user, 10/31: "make a filter so you can hide pops elfs for the iso files to be ember ... have the
+   ember named ones win over pops named"): Settings > Interface > PS1 Duplicates. A game both as a POPSTARTER VCD and as an
+   Ember image shows once: 0 both rows (as before), 1 the Ember one, 2 the POPSTARTER one. A twin is the same title, letter
+   case and a leading disc ID ("SLUS_005.94.") aside */
+int gRipps2Ps1Prefer = 0;
+
+static const char *ps1TwinKey(const char *name)
+{
+    size_t n = strlen(name);
+    if (n > 12 && name[4] == '_' && name[8] == '.' && (name[11] == '.' || name[11] == '_' || name[11] == ' '))
+        return name + 12;
+    return name;
+}
+
+static int ps1DropTwins(base_game_info_t *rows, int vcdCount, int cueCount, int prefer)
+{
+    int i, j, out = 0, total = vcdCount + cueCount;
+    unsigned char *drop = calloc(total, 1);
+    if (drop == NULL)
+        return total;
+    for (i = 0; i < vcdCount; i++)
+        for (j = vcdCount; j < total; j++)
+            if (!strcasecmp(ps1TwinKey(rows[i].name), ps1TwinKey(rows[j].name))) {
+                drop[prefer == 1 ? i : j] = 1;
+                break;
+            }
+    for (i = 0; i < total; i++)
+        if (!drop[i]) {
+            if (out != i)
+                rows[out] = rows[i];
+            out++;
+        }
+    free(drop);
+    return out;
+}
+
 int ps1GameListNeedsRetry(void)
 {
     return ps1ScanIncomplete;
