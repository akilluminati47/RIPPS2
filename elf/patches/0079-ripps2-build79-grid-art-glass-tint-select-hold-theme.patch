+// build 79: the selection breathes -- a soft glow in the theme's selection colour, swelling and easing
+// over 2.4 s, under a crisp frame
+static void drawGridGlow(int cx, int cy, int w, int h)
+{
+    float t = (float)(clock() % (CLOCKS_PER_SEC * 12)) / (float)CLOCKS_PER_SEC;
+    float breath = 0.5f + 0.5f * sinf(t * 2.0f * 3.14159265f / 2.4f);
+    u64 sel = gTheme->selTextColor;
+    int r = sel & 0xFF, g = (sel >> 8) & 0xFF, b = (sel >> 16) & 0xFF, i;
+
+    rmSetBlendAdditive(1);
+    for (i = 3; i >= 1; i--) { // three soft rings, wider and fainter outwards
+        int grow = i * 3 + (int)(breath * 3.0f), alpha = (int)((0x10 + 0x10 * breath) / i);
+        u64 c = GS_SETREG_RGBA(r, g, b, alpha);
+        int x0 = cx - w / 2 - grow, y0 = cy - h / 2 - grow, x1 = cx + w / 2 + grow, y1 = cy + h / 2 + grow;
+        rmDrawRect(x0, y0, x1 - x0, i + 1, c);
+        rmDrawRect(x0, y1 - i - 1, x1 - x0, i + 1, c);
+        rmDrawRect(x0, y0, i + 1, y1 - y0, c);
+        rmDrawRect(x1 - i - 1, y0, i + 1, y1 - y0, c);
+    }
+    rmSetBlendAdditive(0);
+    u64 frame = GS_SETREG_RGBA(r, g, b, 0x60 + (int)(0x20 * breath));
+    rmDrawRect(cx - w / 2 - 2, cy - h / 2 - 2, w + 4, 2, frame);
+    rmDrawRect(cx - w / 2 - 2, cy + h / 2, w + 4, 2, frame);
+    rmDrawRect(cx - w / 2 - 2, cy - h / 2, 2, h, frame);
+    rmDrawRect(cx + w / 2, cy - h / 2, 2, h, frame);
+}
