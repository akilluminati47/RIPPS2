+// RIPPS2 build 79: SELECT held 4.2 s on the game list -- the next theme in the Theme list (the built-in
+// ones and every theme found on a drive), applied the way Settings applies one, without a device
+// refresh, and saved quietly so it is there next time
+void guiCycleTheme(void)
+{
+    const char **names = thmGetGuiList();
+    int n = 0, cur = thmGetGuiValue(), next;
+    char msg[96];
+
+    while (names != NULL && names[n] != NULL)
+        n++;
+    if (n < 2)
+        return;
+    next = (cur + 1) % n;
+    padRumbleFlush();
+    if (isBgmPlaying())
+        bgmStop(); // a theme may bring its own music
+    applyConfig(next, -1, 1);
+    sfxInit(0);
+    if (gEnableBGM && !isBgmPlaying())
+        bgmStart();
+    if (thmGetGuiValue() == next) {
+        ripps2SaveSettingsInBackground();
+        snprintf(msg, sizeof(msg), "%s", thmGetGuiList()[next]);
+        guiWarning(msg, 3);
+    }
+}
