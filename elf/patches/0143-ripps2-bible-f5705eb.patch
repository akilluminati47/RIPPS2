+/* RIPPS2 build 143 (nuno6573's SCPH-90004, ROM 2.30E, 11/04): BIBLE as a plain ELF, started by OpenTuna or FunTuna from
+   mc?:/BOOT/BOOT.ELF on a console that cannot run a system update. Nothing is bound, so it is told by the whole file: its size,
+   then its CRC-32. BIBLE's own settings rows follow from it; RIPPS2 carries no plain ELF and does not install one. */
+static const struct
+{
+    int size;
+    unsigned int crc;
+    const char *name;
+} blBiblePlain[] = {
+    {169428, 0xFA50666Cu, "MMCE"}, {166692, 0x79D0611Cu, "MX4SIO"}, {116436, 0x6930956Au, "memory card"}, {160036, 0x9510BFF7u, "HDD"}, // f5705eb
+    {179060, 0x3ABBDFB0u, "MMCE"}, {176404, 0x7B0DCE86u, "MX4SIO"}, {117028, 0x93D37D70u, "memory card"},                               // 301de13, the first test
+};
+
+static const char *blPlainBibleOf(int port)
+{
+    char path[32];
+    unsigned char *buf;
+    const char *found = NULL;
+    int fd, k, size, known = 0;
+
+    snprintf(path, sizeof(path), "mc%d:/BOOT/BOOT.ELF", port);
+    if ((fd = open(path, O_RDONLY)) < 0)
+        return NULL;
+    size = lseek(fd, 0, SEEK_END);
+    for (k = 0; k < (int)(sizeof(blBiblePlain) / sizeof(blBiblePlain[0])); k++)
+        if (size == blBiblePlain[k].size)
+            known = 1;
+    if (known && (buf = malloc(size)) != NULL) {
+        lseek(fd, 0, SEEK_SET);
+        if (read(fd, buf, size) == size) {
+            unsigned int crc = (unsigned int)crc32(0L, buf, size);
+            for (k = 0; k < (int)(sizeof(blBiblePlain) / sizeof(blBiblePlain[0])) && found == NULL; k++)
+                if (size == blBiblePlain[k].size && crc == blBiblePlain[k].crc)
+                    found = blBiblePlain[k].name;
+        }
+        free(buf);
+    }
+    close(fd);
+    return found;
+}
+
+static void blScanCardUpdate(int port);
+
 static void blScanCard(int port)
+{
+    blCard_t *c = &blCards[port];
+    const char *plain;
+
+    blScanCardUpdate(port);
+    // a card with a system update is that loader's: what the console starts at power on is what the list has to say
+    if (c->present && !c->folder[0] && c->kind == BL_NONE && (plain = blPlainBibleOf(port)) != NULL) {
+        c->bibleBuild = plain;
+        c->bible = 1;
+        c->plain = 1;
+        c->kind = BL_PS2BBL;
+    }
+}
