+        int fw = done >= total ? w : w * done / total;
+        rmDrawRect(x, y, fw, h, RA_PRIM(0x7A, 0x60, 0x20, a));
+        rmDrawRect(x + fw - 2, y, 2, h, RA_PRIM(0xFF, 0xE0, 0x90, a));
+    }
+}
