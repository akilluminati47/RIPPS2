+    NEUTRINO 1.8.0      rickgaiser, AFL-3.0 (elf/neutrino)
+    POPSTARTER          krHACKen (elf/popstarter)
+    EMBER Beta-2        Gageformer, Ember Public Beta Testing Licence (elf/ember)
+    BIBLE               PS2BBL 1.2.0 set up for RIPPS2 (elf/bible)
+
+  The look is the ACHIEVEMENTS page's: gold names, soft status lines, a lit bar on the chosen row.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <dirent.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
