+static const char *const raRowName[RA_ROW_COUNT] = {"TELEMETRY", "BADGES", "TEST THE PC LINK", "CHECK THE DISC", "PLAY THE DISC WITH ACHIEVEMENTS", "HOW IT WORKS", "YOUR ACCOUNT"};
+
+/*
+  RIPPS2 build 80: YOUR ACCOUNT. Each CHECK GAME SUPPORT leaves RA/<serial>.inf beside the game's watch
+  list: the title and the achievement counts xeRAbora had for the signed-in account (ranet.c). This page
+  gathers them from every drive into one list, the way the Memory Files browser lists a folder: opened
+  with START (or the select button), read in when it opens, and let go of again when it closes.
+*/
+typedef struct
+{
+    char title[96], serial[24], where[12];
+    int total, unlocked, unsupported;
+} ra_game_t;
+
+#define RA_ACCT_MAX  256
+#define RA_ACCT_ROWS 12
+#define RA_ACCT_ROWH 26
+
+static int raAcctCmp(const void *a, const void *b)
+{
+    const ra_game_t *x = a, *y = b;
+    int px = x->total > 0 && x->unlocked > 0 ? x->unlocked * 1000 / x->total : -1;
+    int py = y->total > 0 && y->unlocked > 0 ? y->unlocked * 1000 / y->total : -1;
+    if (px != py)
+        return py - px; // furthest along first
+    return strcasecmp(x->title, y->title);
+}
+
+static int raAcctLoad(ra_game_t *games)
+{
+    static const char *const dirs[] = {"mass0:/RA", "mass1:/RA", "mmce0:/RA", "mmce1:/RA", "pfs0:/RA", "smb0:RA"};
+    static const char *const names[] = {"USB", "USB 2", "MMCE 1", "MMCE 2", "HDD", "SMB"};
+    int d, n = 0, i;
+
+    for (d = 0; d < (int)(sizeof(dirs) / sizeof(dirs[0])); d++) {
+        DIR *dir = opendir(dirs[d]);
+        struct dirent *de;
+        if (dir == NULL)
+            continue;
+        while ((de = readdir(dir)) != NULL && n < RA_ACCT_MAX) {
+            char path[192], line[128];
+            int len = (int)strlen(de->d_name), dup = 0;
+            FILE *f;
+            if (len < 5 || strcasecmp(de->d_name + len - 4, ".inf") != 0)
+                continue;
+            ra_game_t *g = &games[n];
+            snprintf(g->serial, sizeof(g->serial), "%.*s", len - 4, de->d_name);
+            for (i = 0; i < n; i++) // the share keeps a second copy of what a drive has
+                if (!strcasecmp(games[i].serial, g->serial))
+                    dup = 1;
+            if (dup)
+                continue;
+            snprintf(path, sizeof(path), "%s/%s", dirs[d], de->d_name);
+            if ((f = fopen(path, "rb")) == NULL)
+                continue;
+            g->title[0] = '\0';
+            g->total = 0;
+            g->unlocked = g->unsupported = -1;
+            if (fgets(line, sizeof(line), f) != NULL) {
+                line[strcspn(line, "\r\n")] = '\0';
+                snprintf(g->title, sizeof(g->title), "%s", line[0] ? line : g->serial);
+            }
+            if (fgets(line, sizeof(line), f) != NULL)
+                g->total = atoi(line);
+            if (fgets(line, sizeof(line), f) != NULL)
+                g->unlocked = atoi(line);
+            if (fgets(line, sizeof(line), f) != NULL)
+                g->unsupported = atoi(line);
+            fclose(f);
+            snprintf(g->where, sizeof(g->where), "%s", names[d]);
+            if (g->title[0])
+                n++;
+        }
+        closedir(dir);
+    }
+    qsort(games, n, sizeof(ra_game_t), raAcctCmp);
+    return n;
+}
+
+// a bar of progress: a dim track, a gold fill, a bright tip
+static void raAcctBar(int x, int y, int w, int h, int done, int total, int a)
+{
