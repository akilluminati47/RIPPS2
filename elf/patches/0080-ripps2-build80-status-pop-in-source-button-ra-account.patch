+    stAdd(ROW_ACTION, ACT_POPS_SETTINGS, "PS1 SETTINGS", "POPSTARTER and Ember");
+    stAdd(ROW_ACTION, ACT_POPS_NET, "POPSTARTER NETWORK", "its own IP and SMB files");
+
+    // EMBER: beside the games, in the drive's EMBER folder
+    stAdd(ROW_HEAD, ACT_NONE, "EMBER", "Beta-2  Gageformer");
+    {
+        const char *p[1] = {"mass0:/EMBER/ember.elf"};
+        n = stFound(line, sizeof(line), p, 1, 1);
+        st_row_t *r = stAdd(ROW_STATUS, ACT_NONE, n ? line : "Not found on USB. Starting an Ember game writes it beside the games.", NULL);
+        r->ok = n > 0;
+    }
+    stAdd(ROW_ACTION, ACT_EMBER_INSTALL, "INSTALL RIPPS2'S COPY", "USB EMBER folder");
+
+    // BIBLE: what starts at power on is MANAGE's to show, card by card
+    stAdd(ROW_HEAD, ACT_NONE, "BIBLE", "PS2BBL 1.2.0 for RIPPS2");
+    {
+        int locked = ripps2BootLockState();
+        st_row_t *r = stAdd(ROW_STATUS, ACT_NONE,
+                            locked ? "A PS2BBL with RIPPS2's lock is on this console." : "MANAGE shows what each memory card starts, and installs or repairs BIBLE.", NULL);
+        r->ok = locked;
+    }
+    stAdd(ROW_ACTION, ACT_BIBLE_MANAGE, "MANAGE", "boot loader, card by card");
+}
+
+static int stRowH(const st_row_t *r)
+{
+    return r->kind == ROW_HEAD ? ST_HEAD_H : r->kind == ROW_STATUS ? ST_LINE_H : ST_ROW_H;
+}
+
+static int stNextAction(int from, int dir)
+{
+    int i;
+    for (i = from + dir; i >= 0 && i < stCount; i += dir)
+        if (stRows[i].kind == ROW_ACTION)
+            return i;
+    return from;
+}
+
+static void stHint(int icon, const char *text, int *x, int y)
+{
+    GSTEXTURE *t = thmGetTexture(icon);
+    if (t != NULL) {
+        rmDrawPixmap(t, *x, y - 10, ALIGN_NONE, 20, 20, SCALING_RATIO, ST_LIT, 0);
+        *x += 24;
+    }
+    *x = ripps2HintText(*x, y, text, ST_SOFT) + 18;
+}
+
+static void stTell(int ok, const char *what, const char *where)
+{
+    char msg[200];
+    guiMsgBoxSound(ok ? SFX_MESSAGE : SFX_ERROR);
+    if (ok)
+        snprintf(msg, sizeof(msg), "%s is installed in %s.", what, where);
+    else
+        snprintf(msg, sizeof(msg), "%s could not be written to %s. Check its free space and that it is not write protected.", what, where);
+    guiMsgBox(msg, 0, NULL);
+}
+
+static void stInstallNeutrino(void)
+{
+    const char *labels[3], *dirs[3];
+    int n = 0, pick;
+    if (stDriveThere("mass0:/")) {
+        labels[n] = "USB  (mass0:/neutrino)";
+        dirs[n++] = "mass0:/neutrino";
+    }
+    if (stDriveThere("mc0:/")) {
+        labels[n] = "MEMORY CARD 1  (about 600 KB)";
+        dirs[n++] = "mc0:/neutrino";
+    }
+    if (stDriveThere("mc1:/")) {
+        labels[n] = "MEMORY CARD 2  (about 600 KB)";
+        dirs[n++] = "mc1:/neutrino";
+    }
+    if (n == 0) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("There is no USB drive or memory card to install Neutrino on.", 0, NULL);
+        return;
+    }
+    if ((pick = ripps2PickList(labels, n)) < 0)
+        return;
+    stTell(ripps2NeutrinoInstallTo(dirs[pick]), "Neutrino 1.8.0", dirs[pick]);
+}
+
+static void stInstallPopstarter(void)
+{
+    const char *path = "mass0:/POPS/POPSTARTER.ELF";
+    if (!stDriveThere("mass0:/")) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("Connect the USB drive your PS1 games are on, then try again.", 0, NULL);
+        return;
+    }
+    if (stExists(path)) {
+        guiMsgBoxSound(SFX_MESSAGE);
+        guiMsgBox("There is a POPSTARTER in mass0:/POPS already. It is yours, and RIPPS2 leaves it as it is.", 0, NULL);
+        return;
+    }
+    guiRenderTextScreen("POPSTARTER: writing");
+    stTell(ripps2PopstarterInstall(path), "POPSTARTER", "mass0:/POPS");
+}
+
+static void stInstallEmber(void)
+{
+    const char *path = "mass0:/EMBER/ember.elf";
+    if (!stDriveThere("mass0:/")) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("Connect the USB drive your Ember games are on, then try again.", 0, NULL);
+        return;
+    }
+    if (stExists(path) && guiMsgBox("There is an ember.elf in mass0:/EMBER already. Replace it with RIPPS2's Beta-2?", 1, NULL) != 1)
+        return;
+    guiRenderTextScreen("EMBER: writing");
+    stTell(ripps2EmberInstall(path), "Ember Beta-2", "mass0:/EMBER");
+}
+
+void ripps2Status(void)
+{
+    int openKey = gSelectButton == KEY_CIRCLE ? KEY_CIRCLE : KEY_CROSS, backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+    int sel, scroll = 0, i, changed = 0;
+
+    stScan();
+    sel = stNextAction(-1, 1);
+    readPads();
+    while (1) {
+        readPads();
+        rmStartFrame();
+        ripps2DrawBackground();
+        ripps2DrawPagePanel();
+        fntRenderString(gTheme->fonts[5], ST_X, 44, ALIGN_VCENTER, 0, 0, "STATUS", ST_GOLD);
+        fntRenderString(RIPPS2_CASE_TITLE_FONT, ST_X, 66, ALIGN_VCENTER, 0, 0, "RIPPS2's homebrew", ST_LIT);
+        rmDrawLine(ST_X, 82, ST_X + ST_W, 82, ST_PRIM(0x4A, 0x72, 0xDC, 0x60));
+
+        // keep the chosen row in the viewport, its section's name with it where it fits
+        {
+            int top = 0, y = 0, selTop = 0, selBot = 0, head = 0;
+            for (i = 0; i < stCount; i++) {
+                if (stRows[i].kind == ROW_HEAD)
+                    head = y;
+                if (i == sel) {
+                    selTop = head;
+                    selBot = y + stRowH(&stRows[i]);
+                }
+                y += stRowH(&stRows[i]);
+            }
+            if (selBot - scroll > ST_BOTTOM - ST_TOP)
+                scroll = selBot - (ST_BOTTOM - ST_TOP);
+            if (selTop < scroll)
+                scroll = selTop;
+            if (scroll > y - (ST_BOTTOM - ST_TOP))
+                scroll = y - (ST_BOTTOM - ST_TOP);
+            if (scroll < 0)
+                scroll = 0;
+            (void)top;
+        }
+
+        int y = ST_TOP - scroll;
+        for (i = 0; i < stCount; i++) {
+            st_row_t *r = &stRows[i];
+            int h = stRowH(r);
+            if (y + h > ST_TOP - 4 && y < ST_BOTTOM) {
+                if (r->kind == ROW_HEAD) {
+                    fntRenderString(gTheme->fonts[5], ST_X, y + 20, ALIGN_VCENTER, 0, 0, r->text, ST_GOLD);
+                    fntRenderString(RIPPS2_CASE_FONT, ST_X + ST_W - rmUnScaleX(fntCalcDimensions(RIPPS2_CASE_FONT, r->aside)), y + 20, ALIGN_VCENTER, 0, 0, r->aside, ST_SOFT);
+                    rmDrawLine(ST_X, y + h - 3, ST_X + ST_W, y + h - 3, ST_PRIM(0x4A, 0x72, 0xDC, 0x30));
+                } else if (r->kind == ROW_STATUS) {
+                    rmDrawRect(ST_X, y + 6, 6, 6, r->ok ? ST_PRIM(0x50, 0xC8, 0x78, 0x80) : ST_PRIM(0x60, 0x66, 0x78, 0x80));
+                    fntRenderStringFit(RIPPS2_CASE_FONT, ST_X + 14, y + 9, ALIGN_VCENTER, ST_W - 14, r->text, r->ok ? ST_OK : ST_SOFT, 1);
+                } else {
+                    int cur = i == sel;
+                    if (cur) {
+                        rmDrawRect(ST_X - 8, y, ST_W + 16, h - 4, ST_PRIM(0x1E, 0x3C, 0x96, 0x58));
+                        rmDrawRect(ST_X - 8, y, 3, h - 4, ST_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+                    }
+                    fntRenderString(gTheme->fonts[8], ST_X + 14, y + 12, ALIGN_VCENTER, 0, 0, r->text, cur ? ST_LIT : ST_SOFT);
+                    fntRenderString(RIPPS2_CASE_FONT, ST_X + ST_W - rmUnScaleX(fntCalcDimensions(RIPPS2_CASE_FONT, r->aside)), y + 12, ALIGN_VCENTER, 0, 0, r->aside,
+                                    cur ? ST_SOFT : ST_DIM);
+                }
+            }
+            y += h;
+        }
+        {
+            int hx = ST_X, hy = 448;
+            stHint(gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, "SELECT", &hx, hy);
+            stHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, "BACK", &hx, hy);
+        }
+        rmEndFrame();
+
+        if (getKeyOn(backKey) || getKeyOn(KEY_TRIANGLE) || getKeyOn(KEY_START)) {
+            sfxPlay(SFX_CANCEL);
+            break;
+        }
+        if (getKey(KEY_UP)) {
+            int to = stNextAction(sel, -1);
+            if (to != sel) {
+                sel = to;
+                sfxPlay(SFX_CURSOR);
+            } else
+                scroll = 0; // the top: show the page's start
+        } else if (getKey(KEY_DOWN)) {
+            int to = stNextAction(sel, 1);
+            if (to != sel) {
+                sel = to;
+                sfxPlay(SFX_CURSOR);
+            }
+        } else if (getKeyOn(openKey) && sel >= 0 && sel < stCount) {
+            int act = stRows[sel].action, rescan = 0;
+            sfxPlay(SFX_CONFIRM);
+            switch (act) {
+                case ACT_NT_INSTALL:
+                    stInstallNeutrino();
+                    rescan = 1;
+                    break;
+                case ACT_NT_SETTINGS:
+                    guiShowNeutrinoDefaults();
+                    changed = rescan = 1;
+                    break;
+                case ACT_POPS_INSTALL:
+                    stInstallPopstarter();
+                    rescan = 1;
+                    break;
+                case ACT_POPS_SETTINGS:
+                    guiShowPsEmulationSettings();
+                    rescan = 1;
+                    break;
+                case ACT_POPS_NET:
+                    guiShowPopsNetConfig();
+                    break;
+                case ACT_EMBER_INSTALL:
+                    stInstallEmber();
+                    rescan = 1;
+                    break;
+                case ACT_BIBLE_MANAGE:
+                    ripps2BibleManage();
+                    rescan = 1;
+                    break;
+            }
+            if (rescan)
+                stScan();
+            readPads();
+        }
+    }
+    if (changed)
+        ripps2SaveSettingsInBackground();
+    readPads();
+}
