+// build 80: Source Name's Pop In. The source's name rises in letter by letter, the way L3's view word
+// does (up from below, a touch past, settling, brightest mid-landing), when the page opens or the
+// source changes; then it stays. Returns how far in it is (0-1), for the D-pad glyphs beside it.
+#define SRC_STEP_S 0.045f
+#define SRC_IN_S   0.36f
+float ripps2DrawSourcePop(int font, int x, int y, short aligned, const char *text, u64 colour)
+{
+    static char shown[64];
+    static double startAt = 0.0, seenAt = 0.0;
+    double now = ripps2Seconds();
+    char ch[2] = {0, 0};
+    int i, n = (int)strlen(text), total = 0;
+
+    if (n > (int)sizeof(shown) - 1)
+        n = sizeof(shown) - 1;
+    if (now - seenAt > 0.5 || strncmp(shown, text, sizeof(shown) - 1) != 0) { // the page opened, or another source
+        snprintf(shown, sizeof(shown), "%s", text);
+        startAt = now;
+    }
+    seenAt = now;
+    float t = (float)(now - startAt);
+    for (i = 0; i < n; i++) {
+        ch[0] = text[i];
+        total += rmUnScaleX(fntCalcDimensions(font, ch));
+    }
+    int lx = (aligned & ALIGN_HCENTER) ? x - total / 2 : x;
+    short va = (aligned & ALIGN_VCENTER) ? ALIGN_VCENTER : ALIGN_NONE;
+    int baseA = (colour >> 24) & 0xFF;
+    for (i = 0; i < n; i++) {
+        ch[0] = text[i];
+        int cw = rmUnScaleX(fntCalcDimensions(font, ch));
+        float li = (t - SRC_STEP_S * i) / SRC_IN_S;
+        if (li > 0.0f && ch[0] != ' ') {
+            if (li > 1.0f)
+                li = 1.0f;
+            int ly = y + (int)((1.0f - easeOutBack(li)) * 10.0f);
+            float flare = li < 1.0f ? sinf(3.14159265f * li) : 0.0f;
+            if (flare > 0.0f) {
+                u64 glow = WORD_RGBA(0x50, 0x78, 0xC0, (int)(0x40 * flare));
+                rmSetBlendAdditive(1);
+                fntRenderString(font, lx - 1, ly, va, 0, 0, ch, glow);
+                fntRenderString(font, lx + 1, ly, va, 0, 0, ch, glow);
+                rmSetBlendAdditive(0);
+            }
+            fntRenderString(font, lx, ly, va, 0, 0, ch, withAlpha(colour, (int)(baseA * fminf(1.0f, li * 1.8f))));
+        }
+        lx += cw;
+    }
+    float done = (t - SRC_STEP_S * (n > 0 ? n - 1 : 0)) / SRC_IN_S;
+    return done <= 0.0f ? 0.0f : done >= 1.0f ? 1.0f : smoothUnit(done);
+}
