+// RIPPS2 build 80: Coverflow and Grid give every arrow to the games, so on their game list the cancel
+// button cycles the sources instead (wrapping from the last to the first), with a Source hint. Inside a
+// folder it still climbs out first; the info page keeps it as Back.
+static int menuSourceCycleActive(void)
+{
+    return gTheme->coverflow != NULL || thmGridColumns() > 0;
+}
+
+static void menuSourceCycle(void)
+{
+    struct menu_list *next = selected_item->next, *first = selected_item;
+    while (next != NULL && next->item->visible == 0)
+        next = next->next;
+    if (next == NULL) { // the last one: round to the first visible
+        while (first->prev != NULL)
+            first = first->prev;
+        while (first != NULL && first->item->visible == 0)
+            first = first->next;
+        if (first == NULL || first == selected_item)
+            return;
+        menuFolderResetLeaving(selected_item);
+        selected_item = first;
+        itemConfigId = -1;
+        sfxPlay(SFX_CURSOR);
+        ripps2GlyphsPoke(RIPPS2_GLYPH_DRIVES);
+        return;
+    }
+    menuDriveStep(1);
+}
+
 // RIPPS2 build 78: a Grid theme moves in two dimensions. Left/Right step one cover; Up/Down one row
 // (a whole row of steps, so the list's own paging still follows); past the top or bottom row they
