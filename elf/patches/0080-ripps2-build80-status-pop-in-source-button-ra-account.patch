+    ACT_POPS_INSTALL,
+    ACT_POPS_SETTINGS,
+    ACT_POPS_NET,
+    ACT_EMBER_INSTALL,
+    ACT_BIBLE_MANAGE,
+};
+
+typedef struct
+{
+    int kind, action, ok;
+    char text[112], aside[48];
+} st_row_t;
+
+#define ST_ROWS 24
+static st_row_t stRows[ST_ROWS];
+static int stCount;
+
+static st_row_t *stAdd(int kind, int action, const char *text, const char *aside)
+{
+    st_row_t *r;
+    if (stCount >= ST_ROWS)
+        return &stRows[ST_ROWS - 1];
+    r = &stRows[stCount++];
+    r->kind = kind;
+    r->action = action;
+    r->ok = 0;
+    snprintf(r->text, sizeof(r->text), "%s", text);
+    snprintf(r->aside, sizeof(r->aside), "%s", aside != NULL ? aside : "");
+    return r;
+}
+
+static int stExists(const char *path)
+{
+    int fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return 0;
+    close(fd);
+    return 1;
+}
+
+static int stDriveThere(const char *root) // "mass0:/", "mc0:/"
+{
+    DIR *d = opendir(root);
+    if (d == NULL)
+        return 0;
+    closedir(d);
+    return 1;
+}
+
+// "Installed: mass0:/neutrino, mc0:/neutrino" from the places that have it; how many found
+static int stFound(char *out, int size, const char *const *paths, int n, int folderOnly)
+{
+    int i, found = 0, len = snprintf(out, size, "Installed: ");
+    for (i = 0; i < n && len < size; i++) {
+        if (paths[i] == NULL || paths[i][0] == '\0' || !stExists(paths[i]))
+            continue;
+        const char *slash = folderOnly ? strrchr(paths[i], '/') : NULL;
+        int show = slash != NULL ? (int)(slash - paths[i]) : (int)strlen(paths[i]);
+        len += snprintf(out + len, size - len, "%s%.*s", found ? ", " : "", show, paths[i]);
+        found++;
+    }
+    return found;
+}
