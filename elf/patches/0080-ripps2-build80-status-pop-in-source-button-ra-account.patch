+            snprintf(file, sizeof(file), "%sRA/%s.inf", where[w], serial);
+            f = fopen(file, "wb");
+            if (f != NULL) {
+                fprintf(f, "%s\n%d\n%d\n%d\n", g_infTitle, g_infTotal, g_infUnlocked, g_infUnsupported);
+                fclose(f);
+            }
+
             LOG("RA: list saved: %s (%d bytes)\n", file, total);
         }
 
