+#include "include/lang.h"
+#include "include/ripps2.h"
+#include "include/ripps2tint.h" // RIPPSettings Color Theme: last, so every colour below goes through it
+
+#define ST_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define ST_DIM  GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+#define ST_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define ST_GOLD GS_SETREG_RGBA(0x7A, 0x66, 0x30, 0x80)
+#define ST_OK   GS_SETREG_RGBA(0x50, 0x7A, 0x5A, 0x80)
+#define ST_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+#define ST_X      60
+#define ST_W      520
