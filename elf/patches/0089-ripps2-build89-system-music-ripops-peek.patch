+static int vcdCopyFile(const char *src, const char *dst)
+{
+    int in = open(src, O_RDONLY), out, r, ok = 1;
+    unsigned char *buf;
+
+    if (in < 0)
+        return 0;
+    if ((buf = malloc(64 * 1024)) == NULL || (out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0) {
+        free(buf);
+        close(in);
+        return 0;
+    }
+    while ((r = read(in, buf, 64 * 1024)) > 0)
+        if (write(out, buf, r) != r) {
+            ok = 0;
+            break;
+        }
+    if (r < 0)
+        ok = 0;
+    close(out);
+    close(in);
+    free(buf);
+    if (!ok)
+        unlink(dst);
+    return ok;
+}
