+        n = (hd[o] & 0x7F) + 1;
+        progs[p].used = 1;
+        progs[p].vol = hd[o + 1];
+        progs[p].pan = hd[o + 2];
+        for (k = 0; k < n && k < 8 && o + 8 + (k + 1) * 16 <= (unsigned int)len; k++) {
+            const rbs_u8 *t = hd + o + 8 + k * 16;
+            rbs_tone_t *tn = &progs[p].tone[progs[p].ntones++];
+            tn->keyHi = t[1];
+            tn->root = t[2];
+            tn->fine = (signed char)t[3];
+            tn->addr = rbsLe16(t + 4) * 8;
+            tn->a1 = rbsLe16(t + 6);
+            tn->a2 = rbsLe16(t + 8);
+            tn->keyLo = t[10];
+            tn->vol = t[11];
+            tn->pan = t[12];
+            tn->noise = !(t[15] & 1);
+        }
+    }
+    return 0;
+}
+
+// A sequence (SSsq): volume, ticks per quarter note and tempo, a set-up row per channel (program, volume,
+// pan), then MIDI events. Fills notes and the channels' curves; returns the note count
+static int rbsSequence(const rbs_u8 *sq, int len, rbs_note_t *notes, rbs_chan_t *ch, int *headVol, float *endSec)
+{
+    unsigned int tick = 0, tmT[16];
+    float tmS[16];
+    int tmB[16], ntm = 1, n = 0, i = 0x110, status = 0x90, first = 1, c, k, ppq, cur[16];
+    short held[16][128];
+
+    if (len < 0x110)
+        return -1;
+    *headVol = rbsLe16(sq);
+    ppq = rbsLe16(sq + 2);
+    tmB[0] = rbsLe16(sq + 4);
+    tmT[0] = 0;
+    tmS[0] = 0;
+    if (ppq == 0 || tmB[0] == 0)
+        return -1;
+    memset(ch, 0, sizeof(rbs_chan_t) * 16);
+    memset(held, 0xff, sizeof(held));
+    for (c = 0; c < 16; c++) {
+        cur[c] = 0;
+        for (k = 0; k < 3; k++)
+            ch[c].n[k] = 1;
+        ch[c].v[0][0] = 100 / 127.0f;
+        ch[c].v[1][0] = 1.0f;
+        ch[c].v[2][0] = 64;
+    }
+    for (c = 0; c < 16; c++) {
+        const rbs_u8 *r = sq + 0x10 + c * 16;
+        if (r[1] < 16) {
+            cur[r[1]] = r[2];
+            ch[r[1]].v[0][0] = r[3] / 127.0f;
+            ch[r[1]].v[2][0] = r[4];
+        }
+    }
+#define RBS_SEC(tk) (tmS[ntm - 1] + (float)((tk) - tmT[ntm - 1]) * 60.0f / ((float)tmB[ntm - 1] * ppq))
+    while (i < len) {
+        int b, hi, chn, d0, d1 = 0, nb;
+        float s;
+        if (!first) {
+            unsigned int d = 0;
+            do {
+                if (i >= len)
+                    goto end;
+                b = sq[i++];
+                d = d << 7 | (b & 0x7F);
+            } while (b & 0x80);
+            tick += d;
+        }
+        first = 0;
+        if (i >= len)
+            break;
+        b = sq[i];
+        if (b == 0xFF) {
+            if (i + 3 < len && sq[i + 1] == 0x51) { // a tempo change, in quarter notes a minute
+                int bpm = sq[i + 2] | sq[i + 3] << 8;
+                if (bpm > 0 && bpm != tmB[ntm - 1] && ntm < 16) {
+                    tmS[ntm] = RBS_SEC(tick);
+                    tmT[ntm] = tick;
+                    tmB[ntm] = bpm;
+                    ntm++;
+                }
+                i += 4;
+                continue;
+            }
+            break; // the end
+        }
+        if (b & 0x80) {
+            status = b;
+            i++;
+        }
+        hi = status & 0xF0;
+        chn = status & 0xF;
+        nb = (hi == 0xC0 || hi == 0xD0) ? 1 : 2;
+        if (i + nb > len)
+            break;
+        d0 = sq[i] & 0x7F;
+        if (nb > 1)
+            d1 = sq[i + 1] & 0x7F;
+        i += nb;
+        s = RBS_SEC(tick);
+        if (hi == 0xC0)
+            cur[chn] = d0;
+        else if (hi == 0xB0 && (d0 == 7 || d0 == 11 || d0 == 10)) {
+            k = d0 == 7 ? 0 : d0 == 11 ? 1 : 2;
+            if (ch[chn].n[k] < RBS_POINTS) {
+                ch[chn].t[k][ch[chn].n[k]] = s;
+                ch[chn].v[k][ch[chn].n[k]++] = k == 2 ? (float)d1 : d1 / 127.0f;
+            }
+        } else if (hi == 0x90 && d1 > 0) {
+            if (n < RBS_NOTES) {
+                notes[n].ch = chn;
+                notes[n].note = d0;
+                notes[n].vel = d1;
+                notes[n].prog = cur[chn];
+                notes[n].on = s;
+                notes[n].off = -1;
+                held[chn][d0] = (short)n++;
+            }
+        } else if (hi == 0x80 || hi == 0x90) {
+            if ((k = held[chn][d0]) >= 0) {
+                notes[k].off = s;
+                held[chn][d0] = -1;
+            }
+        }
+    }
+end:
+    *endSec = RBS_SEC(tick);
+#undef RBS_SEC
+    return n;
+}
+
+static float rbsCurve(const rbs_chan_t *c, int k, float t) // a channel curve's step at time t
+{
+    int i;
+    float v = c->v[k][0];
+
+    for (i = 1; i < c->n[k] && c->t[k][i] <= t; i++)
+        v = c->v[k][i];
+    return v;
+}
+
+// One sequence as an event's .adp. NULL when it is not there
+static rbs_u8 *rbsRenderSeq(const rbs_u8 *sq, int sqLen, const rbs_u8 *hd, int hdLen, const rbs_u8 *bd, int bdLen, int *outLen)
+{
+    rbs_prog_t *progs = calloc(RBS_PROGS, sizeof(rbs_prog_t));
+    rbs_note_t *notes = malloc(sizeof(rbs_note_t) * RBS_NOTES);
+    rbs_chan_t *ch = malloc(sizeof(rbs_chan_t) * 16);
+    rbs_smp_t cache[RBS_SAMPLES];
+    float endSec = 0, *mix = NULL, peak = 0;
+    int headVol = 0, nn = 0, total, cap, k, len, ncache = 0;
+    unsigned int seed = 0x2545F491u;
+    rbs_u8 *adp = NULL;
+
+    if (progs == NULL || notes == NULL || ch == NULL || rbsBankPrograms(hd, hdLen, progs) ||
+        (nn = rbsSequence(sq, sqLen, notes, ch, &headVol, &endSec)) <= 0)
+        goto done;
+    total = (int)((endSec + 4.0f) * RBS_RATE) + 1; // the last event and 4 s for the releases, as Audio Studio
+    cap = total + RBS_RATE * 7 / 2;                 // and room for the hall
+    if (endSec > 40 || (mix = calloc(cap, sizeof(float))) == NULL)
+        goto done;
+    for (k = 0; k < nn; k++) {
+        const rbs_note_t *nt = &notes[k];
+        const rbs_prog_t *pg = &progs[nt->prog & (RBS_PROGS - 1)];
+        int i0 = (int)(nt->on * RBS_RATE), koff = nt->off >= 0 ? (int)((nt->off - nt->on) * RBS_RATE) : -1, t;
+        if (!pg->used || i0 >= total)
+            continue;
+        for (t = 0; t < pg->ntones; t++) {
+            const rbs_tone_t *tn = &pg->tone[t];
+            const rbs_smp_t *sp = NULL;
+            float ratio, g, pn, gl, gr, cg = 0, cl = 0, cr = 0, level = 0, hold = 1;
+            unsigned long long pos = 0, step; // where the sample is read, 32.32 fixed point: no drift in pitch
+            int i, c, hi = tn->keyHi > tn->keyLo ? tn->keyHi : tn->keyLo, lastIdx = -1;
+            rbs_env_t env;
+            if (nt->note < tn->keyLo || nt->note > hi)
+                continue;
+#ifdef RBS_TEST_NONOISE // host checks against Audio Studio: no noise voices (random on both sides), no hall
+            if (tn->noise)
+                continue;
+#endif
+            ratio = powf(2.0f, (nt->note - tn->root + tn->fine / 128.0f) / 12.0f);
+            if (tn->noise) { // the SPU2 noise: a random level held for 48000 / rate samples at a time
+                float rate = RBS_NOISE_BASE * ratio / 64.0f;
+                hold = rate > 1.0f ? RBS_RATE / rate : RBS_RATE;
+                if (hold < 1.0f)
+                    hold = 1.0f;
+            } else {
+                for (c = 0; c < ncache; c++)
+                    if (cache[c].addr == tn->addr)
+                        sp = &cache[c];
+                if (sp == NULL && ncache < RBS_SAMPLES) {
+                    cache[ncache].addr = tn->addr;
+                    if ((cache[ncache].s = rbsAdpcm(bd, bdLen, tn->addr, &cache[ncache].n, &cache[ncache].loop)) != NULL)
+                        sp = &cache[ncache++];
+                }
+                if (sp == NULL || sp->n < 2)
+                    continue;
+            }
+            step = (unsigned long long)(ratio * 4294967296.0f);
+            rbsEnvInit(&env, tn->a1, tn->a2);
+            g = nt->vel / 127.0f * tn->vol / 127.0f * pg->vol / 127.0f;
+            pn = ((tn->pan - 64) + (pg->pan - 64)) / 64.0f;
+            pn = pn < -1 ? -1 : pn > 1 ? 1 : pn;
+            gl = cosf((pn + 1) * RBS_PI4);
+            gr = sinf((pn + 1) * RBS_PI4);
+            for (i = 0; i0 + i < total; i++) {
+                float e = rbsEnvNext(&env, i == koff), y;
+                if (env.done)
+                    break; // the voice ends when its envelope does
+                if (tn->noise) {
+                    int idx = (int)(i / hold);
+                    if (idx != lastIdx) {
+                        seed = seed * 1664525u + 1013904223u;
+                        level = (seed >> 8) / 8388608.0f - 1.0f;
+                        lastIdx = idx;
+                    }
+                    y = level;
+                } else {
+                    int a, b;
+                    float f;
+                    if ((pos >> 32) >= (unsigned long long)sp->n) {
+                        if (sp->loop < 0 || sp->loop >= sp->n - 1)
+                            break;
+                        while ((pos >> 32) >= (unsigned long long)sp->n)
+                            pos -= (unsigned long long)(sp->n - sp->loop) << 32;
+                    }
+                    a = (int)(pos >> 32);
+                    f = (unsigned int)pos * (1.0f / 4294967296.0f);
+                    b = a + 1 < sp->n ? a + 1 : sp->n - 1;
+                    y = sp->s[a] * (1 - f) + sp->s[b] * f;
+                    pos += step;
+                }
+                if ((i & 63) == 0) { // the channel's volume, expression and pan where the note is
+                    float tt = (float)(i0 + i) / RBS_RATE, pc;
+                    cg = rbsCurve(&ch[nt->ch], 0, tt) * rbsCurve(&ch[nt->ch], 1, tt);
+                    pc = (rbsCurve(&ch[nt->ch], 2, tt) - 64) / 64.0f;
+                    pc = pc < -1 ? -1 : pc > 1 ? 1 : pc;
+                    cl = cosf((pc + 1) * RBS_PI4) * 1.41421356f;
+                    cr = sinf((pc + 1) * RBS_PI4) * 1.41421356f;
+                }
+                mix[i0 + i] += y * e * g * cg * (gl * cl + gr * cr) * 0.5f; // left and right, summed to mono
+            }
+        }
+    }
+    for (k = 0; k < total; k++)
+        mix[k] *= headVol / 127.0f;
+#if defined(RBS_TEST_NONOISE) || defined(RBS_TEST_DRY)
+    len = total;
+#else
+    len = rbsHall(mix, total, cap, RBS_RATE, 0.4f, 3.0f);
+#endif
+    for (k = 0; k < len; k++)
+        if (fabsf(mix[k]) > peak)
+            peak = fabsf(mix[k]);
+    if (peak > 0)
+        adp = rbsEncode(mix, len, 4096, 0.8f / peak, outLen);
+done:
+    for (k = 0; k < ncache; k++)
+        free(cache[k].s);
+    free(mix);
+    free(progs);
+    free(notes);
+    free(ch);
+    return adp;
+}
