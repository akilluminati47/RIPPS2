-        discPolledAt = clock();
-        if (ioPutRequest(IO_CUSTOM_SIMPLEACTION, &discPollWorker) != IO_OK)
-            discPollBusy = 0;
-    }
+    renderStartPrompt("START LASER", 423);
     if (discLine[0])
