@@ -436,9 +441,14 @@ static void renderStartPrompt(const char *action, int y)
 
 // ---- LAUNCH DISC ----
 //
-// What is in the drive, under START DISC: asked on the IO worker about once a second while the page is
-// up (the drive's own disc type, which costs nothing), and only when that changes is the disc read for
-// its ID, and the ID looked up in the metadata database for a title. Nothing here ever waits on the drive.
+// What is in the drive, under START LASER. Watched from boot, whatever page is up, so the line is
+// ready before Launch Disc is ever opened and leaving the page can never catch a read half done: a
+// few seconds after boot, then every 1.5 s, the drive is asked its disc type (cheap: nothing spins)
+// on the IO worker, and only while the worker has nothing else queued. Only when the type changes
+// (a disc there at boot, one put into an empty drive) is the disc read for its ID, once, and the ID
+// looked up in the metadata database for a title. Nothing on screen ever waits on the drive.
+#define DISC_FIRST_S 3.0f
+#define DISC_EVERY_S 1.5f
 
 static volatile int discPollBusy = 0;
 static clock_t discPolledAt = 0;
@@ -521,17 +531,45 @@ static void discPollWorker(void)
     discPollBusy = 0;
 }
 
+// Every frame from the main loop, whatever the page
+void ripps2DiscWatch(void)
+{
+    static clock_t firstSeen = 0;
+    clock_t now = clock();
+    int t;
+
+    if (firstSeen == 0) {
+        firstSeen = now != 0 ? now : 1;
+        discPolledAt = now;
+    }
+    if (discPollBusy || (float)(now - firstSeen) / CLOCKS_PER_SEC < DISC_FIRST_S ||
+        (float)(now - discPolledAt) / CLOCKS_PER_SEC < DISC_EVERY_S)
+        return;
+    for (t = 1; t < IO_REQ_TYPE_COUNT; t++)
+        if (ioGetPending(t) > 0)
+            return; // lazy: the drive waits behind anything else the worker has to do
+    discPollBusy = 1;
+    discPolledAt = now;
+    if (ioPutRequest(IO_CUSTOM_SIMPLEACTION, &discPollWorker) != IO_OK)
+        discPollBusy = 0;
+}
+
+// The disc watcher's job is all the IO worker has: not worth the loading breath
+int ripps2DiscQuiet(void)
+{
+    int t, n = 0;
+    if (!discPollBusy)
+        return 0;
+    for (t = 1; t < IO_REQ_TYPE_COUNT; t++)
+        n += ioGetPending(t);
+    return n <= 1;
+}
