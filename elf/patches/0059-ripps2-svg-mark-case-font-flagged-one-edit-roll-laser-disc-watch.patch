diff --git a/src/themes.c b/src/themes.c
index bc2636a..86b0fcc 100644
--- a/src/themes.c
+++ b/src/themes.c
@@ -629,6 +629,49 @@ static void initGameCountText(const char *themePath, config_set_t *themeConfig,
 
 // AttributeText ////////////////////////////////////////////////////////////////////////////////////////////////////////////
 
+// RIPPS2: a wrapped text with more lines than its box shows (a long description) rolls slowly up
+// through the box: it holds at the top, rolls at a reading pace, holds at the end, then fades and
+// starts again. Lines feather in and out at the box's edges; another game starts it from the top.
+#define ROLL_HOLD_S 3.0f
+#define ROLL_PX_S   9.0f
+#define ROLL_END_S  2.5f
+#define ROLL_FADE_S 0.45f
+
+static void thmDrawWrapRoll(theme_element_t *elem, mutable_text_t *mt, int step, int lines)
+{
+    float span = (float)(lines * step - elem->height) + 2.0f; // how much taller the text is than the box
+    float roll = span / ROLL_PX_S, period = ROLL_HOLD_S + roll + ROLL_END_S + ROLL_FADE_S;
+    float t = fmodf((float)(clock() - mt->rollStart) / (float)CLOCKS_PER_SEC, period), offset, all;
+    const char *p = mt->currentValue;
+    char line[256];
+    int i, base = (int)((elem->color >> 24) & 0xFF);
+
+    if (span <= 0.0f)
