+// ---- the stream's controls run on a thread of their own ----
+// Starting the stream buffers half a second of the disc, and stopping it waits for the music's
+// threads; on the menu thread both froze the towers mid-step between a press and the music. Now the
+// panel keeps drawing (the towers relax while no new sound arrives) and takes the next press once the
+// last one is done.
+enum { CD_CMD_NONE = 0, CD_CMD_PLAY, CD_CMD_PAUSE, CD_CMD_STOP };
+static volatile int cdCmd = CD_CMD_NONE, cdCmdBusy = 0;
+static volatile u32 cdCmdLsn = 0;
+static int cdCtlSema = -1;
+static u8 cdCtlStack[0x4000] __attribute__((aligned(16)));
+
+static void cdCtlThread(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        WaitSema(cdCtlSema);
+        int c = cdCmd;
+        cdCmd = CD_CMD_NONE;
+        if (c == CD_CMD_PLAY)
+            cdPlayFrom(cdCmdLsn);
+        else if (c == CD_CMD_PAUSE)
+            cdHalt(CD_PAUSED);
+        else if (c == CD_CMD_STOP)
+            cdHalt(CD_STOPPED);
+        cdCmdBusy = 0;
+    }
+}
+
+static void cdPost(int cmd, u32 lsn)
+{
+    if (cdCmdBusy)
+        return;
+    if (cdCtlSema < 0) {
+        ee_sema_t sema;
+        ee_thread_t t;
+        sema.init_count = 0;
+        sema.max_count = 1;
+        sema.option = 0;
+        sema.attr = 0;
+        cdCtlSema = CreateSema(&sema);
+        t.func = &cdCtlThread;
+        t.stack = cdCtlStack;
+        t.stack_size = sizeof(cdCtlStack);
+        t.gp_reg = &_gp;
+        t.initial_priority = 0x30; // below the menu: it works while a frame waits for vsync
+        t.attr = 0;
+        t.option = 0;
+        int id = CreateThread(&t);
+        if (cdCtlSema < 0 || id < 0) { // no thread: do it here, as before
+            if (cmd == CD_CMD_PLAY)
+                cdPlayFrom(lsn);
+            else
+                cdHalt(cmd == CD_CMD_PAUSE ? CD_PAUSED : CD_STOPPED);
+            return;
+        }
+        StartThread(id, NULL);
+    }
+    cdCmdBusy = 1;
+    cdCmdLsn = lsn;
+    cdCmd = cmd;
+    SignalSema(cdCtlSema);
+}
+
+static void cdIdleWait(void) // a press still being carried out, before the player is closed or copies
+{
+    int i;
+    for (i = 0; cdCmdBusy && i < 400; i++)
+        DelayThread(10 * 1000);
+}
