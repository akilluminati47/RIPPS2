+// RIPPS2: a request the user is waiting on (a settings save, a launch's last-played save) goes to
+// the front: right behind the one running, ahead of cover art, list updates and the like
+int ioPutRequestFront(int type, void *data)
+{
+    struct io_request_t *req;
+
+    if (isIOBlocked)
+        return IO_ERR_IO_BLOCKED;
+    if (!ioGetHandler(type))
+        return IO_ERR_INVALID_HANDLER;
+
+    WaitSema(gEndSemaId);
+    if (gReqList == NULL) {
+        int result = ioAppendLocked(type, data);
+        SignalSema(gEndSemaId);
+        if (result == IO_OK)
+            WakeupThread(gIOThreadId);
+        return result;
+    }
+    req = (struct io_request_t *)malloc(sizeof(struct io_request_t));
+    if (!req) {
+        SignalSema(gEndSemaId);
+        return IO_ERR_TOO_MANY_REQUESTS;
+    }
+    req->type = type;
+    req->data = data;
+    req->next = gReqList->next; // the head may be running: never move it
+    gReqList->next = req;
+    if (gReqEnd == gReqList)
+        gReqEnd = req;
+    if (type > 0 && type < IO_REQ_TYPE_COUNT) {
+        gIoPending[type]++;
+        gIoTotal[type]++;
+    }
+    SignalSema(gEndSemaId);
+    WakeupThread(gIOThreadId);
+    return IO_OK;
+}
+
+static void ioNoAction(void)
+{
+}
+
+// RIPPS2: a queued simple action that has not started becomes a no-op, so its caller can run it
+// itself without it ever running twice. 0 when it is running or already gone.
+int ioDefuseRequest(int type, void *data)
+{
+    struct io_request_t *r;
+    int found = 0;
+
+    WaitSema(gEndSemaId);
+    for (r = gReqList; r != NULL && !found; r = r->next)
+        if (r != gReqRunning && r->type == type && r->data == data) {
+            r->data = (void *)&ioNoAction;
+            found = 1;
+        }
+    SignalSema(gEndSemaId);
+    return found;
+}
