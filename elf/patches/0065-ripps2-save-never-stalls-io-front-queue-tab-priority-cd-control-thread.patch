+// RIPPS2: is the worker inside a job right now
+int ioWorkerBusy(void)
+{
+    return gRunType != 0;
+}
+
+// RIPPS2: the worker thread itself, for a deferred IO it never picked up: asleep (a wakeup that went
+// missing), parked on one of the queue's locks, ready but starved, or gone; and the queue behind it
+int ioDescribeWorker(char *out, int size)
+{
+    ee_thread_status_t st;
+    struct io_request_t *r = gReqList;
+    int queued = 0, firstType = 0, i;
+    void *firstData = NULL;
+    const char *state = "UNKNOWN", *first = "";
+    char lock[16];
+
+    if (r != NULL) {
+        firstType = r->type;
+        firstData = r->data;
+    }
+    for (; r != NULL && queued < 999; r = r->next)
+        queued++;
+    if (ReferThreadStatus(gIOThreadId, &st) < 0 || (st.status & THS_DORMANT))
+        state = "GONE";
+    else if (st.status & THS_RUN)
+        state = "RUNNING";
+    else if (st.status & THS_READY)
+        state = "READY BUT STARVED";
+    else if ((st.status & THS_WAIT) && st.waitType == TSW_SLEEP)
+        state = "ASLEEP";
+    else if ((st.status & THS_WAIT) && st.waitType == TSW_SEMA) {
+        snprintf(lock, sizeof(lock), "LOCK %s", (s32)st.waitId == gProcSemaId ? "P" : (s32)st.waitId == gEndSemaId ? "E" : "X");
+        state = lock;
+    }
+    if (firstType == IO_MENU_UPDATE_DEFFERED)
+        first = "GAME LIST UPDATE";
+    else if (firstType == IO_CACHE_LOAD_ART)
+        first = "COVER ART";
+    else if (firstType != 0) {
+        first = "TASK";
+        for (i = 0; i < gIoNameCount; i++)
+            if (gIoNames[i].fn == firstData)
+                first = gIoNames[i].name;
+    }
+    snprintf(out, size, "WORKER %s, %d QUEUED%s%s", state, queued, queued ? ", FIRST " : "", first);
+    return 1;
+}
