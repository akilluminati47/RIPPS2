+// The bind's own IOP session around blInstallBound (build 138): the IOP again with ps2sdk's SECRMAN in the ROM's place
+// (the console binds a KELF through it) and only the card and pad drivers, then as usual again, the drives and sounds
+// back, and DIAG.TXT written beside RIPPS2 once its drive is up. Build 115 (the user, 10/26 evening): RIPPS2 is never
+// copied anywhere for BIBLE; PS2BBL starts it where it is
+static void blInstallOn(int port, const blWhere_t *w, const char *alt)
+{
+    void *img;
+    int imgSize, ok, waited = 0;
+
+    guiRenderTextScreen(_t("RIPPS2: Setting up BIBLE (restarting the I/O processor)"));
+    if ((img = blMakeIoprp("SECRMAN", secrman_irx, size_secrman_irx, &imgSize)) == NULL) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("BIBLE ran out of memory before it started. Nothing was changed."), 0, NULL);
+        return;
+    }
+    ok = ripps2RebootIopForBind(img, imgSize);
+    free(img);
+    if (!ok) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("RIPPS2 was busy reading a drive and could not restart the I/O processor. Nothing was changed: try again in a moment."), 0, NULL);
+        return;
+    }
+    blInstallBound(port, w, alt);
+    guiRenderTextScreen(_t("RIPPS2: Setting up BIBLE (restarting the I/O processor)"));
+    ripps2RebootIopAfterBind();
+    while (ioWorkPending() && waited++ < 250)
+        DelayThread(20000);
+    ripps2DiagBeforeLaunch();
+}
