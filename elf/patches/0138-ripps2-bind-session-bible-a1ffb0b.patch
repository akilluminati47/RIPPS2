index 29cb7d7..de12d9d 100644
--- a/src/opl.c
+++ b/src/opl.c
@@ -5651,6 +5651,69 @@ int ripps2RebootIopWith(const void *ioprp, int size)
     return 1;
 }
 
+/* RIPPS2 build 138 (the user's SD2PSX, 11/03: after ripps2RebootIopWith the card did not log in, "not ready", and the
+   bind was refused, while KELFBinder bound the same card): the bind on its own, as KELFBinder does it. The IOP reboots
+   from the IOPRP image and gets back only the memory card, USB and pad drivers (sysReset), no drives: MMCE is not
+   started, so nothing else talks to an SD2PSX or MMCE card while it logs in and binds, and no sound runs. Requests stay
+   blocked. ripps2RebootIopAfterBind brings the menu back as ripps2RebootIopWith would. 1 = done; 0 = busy, nothing
+   changed */
+int ripps2RebootIopForBind(const void *ioprp, int size)
+{
+    int ret = 0, tries = 0;
+
+    if (!cacheAbortMmceImageLoadsTimed(LWNBD_ART_DRAIN_TICKS) || !cacheCancelPendingImageLoadsTimed(LWNBD_ART_DRAIN_TICKS))
+        return 0;
+    ioBlockOpsTimed(1, LWNBD_IO_DRAIN_TICKS);
+    if (ioHasPendingRequests()) {
+        ioBlockOps(0);
+        return 0;
+    }
+
+    audioEnd();
+    guiExecDeferredOps();
+    deinitAllSupport(NO_EXCEPTION, IO_MODE_SELECTED_ALL);
+    clearErrorMessage();
+    unloadPads();
+
+    sysSetRebootImage(ioprp, size);
+    reset();
+    sysSetRebootImage(NULL, 0);
+
+    LOG_INIT();
+    LOG_ENABLE();
+    padInit(0);
+    while (!ret && tries++ < 100) {
+        ret = startPads();
+        if (!ret)
+            delay(50);
+    }
+    return 1;
+}
+
+// build 138: the bind is over; the IOP again with the console's own SECRMAN, and the drives, pads, music and sounds back
+void ripps2RebootIopAfterBind(void)
+{
+    int ret = 0, tries = 0;
+
+    unloadPads();
+    reset();
+
+    LOG_INIT();
+    LOG_ENABLE();
+    padInit(0);
+    while (!ret && tries++ < 100) {
+        ret = startPads();
+        if (!ret)
+            delay(50);
+    }
+    ioBlockOps(0);
+    initAllSupport(1);
+    audioInit();
+    sfxReload(-1);
+    if (gEnableBGM)
+        bgmStart();
+}
+
