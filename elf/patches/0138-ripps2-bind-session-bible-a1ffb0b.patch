+// build 138 (the user, 11/03: "we arent detecting its BIBLE fork, it said it was BBL by Isra"): the system update itself
+// says whether it is BIBLE, and which build. A console's bind changes only its 32 key bytes (Kbit and Kc, at 40 to 71), so
+// the rest is byte for byte one of the builds RIPPS2 carries, whatever its folder's icon says. Its name, or NULL
+static const char *blBibleBuildOf(const char *path)
+{
+    static const char *const names[3] = {"MMCE", "MX4SIO", "memory card"};
+    const unsigned char *const builds[3] = {bible_mmce_xlf, bible_mx4sio_xlf, bible_xlf};
+    const unsigned int sizes[3] = {size_bible_mmce_xlf, size_bible_mx4sio_xlf, size_bible_xlf};
+    const char *found = NULL;
+    unsigned char *buf;
+    int fd, i, size, n;
+
+    if ((fd = open(path, O_RDONLY)) < 0)
+        return NULL;
+    size = lseek(fd, 0, SEEK_END);
+    for (i = 0; i < 3 && size != (int)sizes[i]; i++)
+        ;
+    if (i < 3 && size > 72 && (buf = malloc(size)) != NULL) {
+        lseek(fd, 0, SEEK_SET);
+        n = read(fd, buf, size);
+        if (n == size && !memcmp(buf, builds[i], 40) && !memcmp(buf + 72, builds[i] + 72, size - 72))
+            found = names[i];
+        free(buf);
+    }
+    close(fd);
+    return found;
+}
