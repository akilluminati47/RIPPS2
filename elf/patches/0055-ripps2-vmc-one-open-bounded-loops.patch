+// Up to size bytes of the file name in the folder whose entry is dir, the image already open: bytes read, or -1
+static int r2VmcReadIn(r2_vmc_t *v, const r2_ent_t *dir, const char *name, void *buf, int size)
+{
+    r2_ent_t e;
+    int i;
+    for (i = 2; i < r2DirLen(dir->length); i++)
+        if (r2VmcEnt(v, dir->cluster, i, &e, 0) && (e.mode & MC_EXISTS) && (e.mode & MC_FILE) && r2NameIs(&e, name)) {
+            u32 n = e.length < (u32)size ? e.length : (u32)size;
+            u32 c = e.cluster, done = 0;
+            while (done < n) { // only the clusters the bytes asked for
+                u32 k = n - done > (u32)v->csize ? (u32)v->csize : n - done;
+                if (c == FAT_END || !r2VmcIo(v, v->alloc + c, v->cl, 0))
+                    return -1;
+                memcpy((u8 *)buf + done, v->cl, k);
+                done += k;
+                c = r2VmcNext(v, c);
+            }
+            return n;
+        }
+    return -1;
+}
