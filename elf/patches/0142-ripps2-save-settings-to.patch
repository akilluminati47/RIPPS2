+/* RIPPS2 build 142: the home Fast Boot's gate names, made ready to read. A typed drive (build 142 writes usb0:/RIPPS2, as
+   config.path has it) loads its one transport, as MMCE always did. A gate from before names a slot, massN:, which is not up
+   this early and an untyped massN: walks every transport: that one is passed over, so the settings pointer decides. */
+static int fastBootHomeReady(char *home, int size)
+{
+    if (!strncmp(home, "mass", 4))
+        return 0;
+    if (!strncmp(home, "mmce", 4) || isTypedBdmSettingsPath(home))
+        return prepareCustomSettingsPath(home, size) >= 0;
+    return 1;
+}
+
+/* RIPPS2 build 142 (nuno6573, 11/04: settings do not stay on MMCE or USB "despite changing configuration destination"; the
+   lab, on 1.4.1: RIPPS2.ELF in mc0:/RIPPS2, Save Settings To > Internal HDD, written and both pointers left, and the next boot
+   back on Memory Card). The pointer was only read once the boot home had no settings (tryAlternateDevice), so any settings
+   file beside the ELF beat it, and when RIPPS2 lives in mc?:/RIPPS2, BIBLE's first AUTO path, that is the card's own home.
+   With a pointer and a file beside the ELF, the pointer goes first and the caller reads prevHome if its drive has nothing.
+   No file beside the ELF goes on to tryAlternateDevice as it did, so a missing drive is not waited for twice. APA keeps its
+   own ownership chain there. */
+static int ripps2PointerFirst(char *prevHome, int prevSize)
+{
+    char redirect[256];
+    const char *home = configGetHomePath();
+
+    if (gBootHomeApa || home[0] == '\0' || !strncmp(home, "hdd", 3) || !bootHomeHasRiptoplMaster(home) ||
+        !readConfigPathRedirect(redirect, sizeof(redirect)))
+        return 0;
+    snprintf(prevHome, prevSize, "%s", home);
+    if (prepareCustomSettingsPath(redirect, sizeof(redirect)) < 0) {
+        ripps2Diag("settings: %s did not answer, reading %s", redirect, prevHome);
+        return 0;
+    }
+    ripps2Diag("settings: Save Settings To says %s, ahead of the file in %s", redirect, prevHome);
+    configSetMove(redirect);
+    return 1;
+}
