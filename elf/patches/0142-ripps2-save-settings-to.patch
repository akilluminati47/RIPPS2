+/* build 142 (nuno6573, 11/04; the lab, on 1.4.1: the drive in the console and its source not started: "NO INTERNAL HDD FOUND").
+   USB and MMCE begin on Manual, so a drive that is there had usually not been started when it was chosen. It is started here
+   the way the boot starts it for a pointer: the typed resolver loads the one transport and gives it the boot's wait. */
+static int ripps2SettingsBdmHome(int type, const char *typed, char *out, int size)
+{
+    char root[16];
+    int known = BDM_TYPE_UNKNOWN;
+
+    if (ripps2SettingsBdmMounted(type, typed, out, size))
+        return 1;
+    snprintf(root, sizeof(root), "%s:/", typed);
+    return bdmResolveBootDir(root, sizeof(root), "", &known) > 0 && ripps2SettingsBdmMounted(type, typed, out, size);
+}
