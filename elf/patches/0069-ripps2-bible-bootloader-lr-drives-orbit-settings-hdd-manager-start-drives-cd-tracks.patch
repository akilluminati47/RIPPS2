+// ---- BIBLE ----
+
+// An IOPRP image holding one module, which the IOP's boot then uses in place of the ROM's module of
+// that name. Its directory: RESET (empty), ROMDIR (the directory itself), EXTINFO, the module (4 bytes
+// of extended info), a blank end entry; then EXTINFO's record (0xFFFF, 0, type 2: what the ROM's
+// loader needs to take the module), then the module, each part padded to 16 bytes.
+static void *blMakeIoprp(const char *name, const void *module, int moduleSize, int *outSize)
+{
+    unsigned char *img;
+    int size = 5 * 16 + 16 + ((moduleSize + 15) & ~15), o = 0;
+
+    if ((img = memalign(64, size)) == NULL)
+        return NULL;
+    memset(img, 0, size);
+#define BL_ENTRY(n, ext, sz)                               \
+    do {                                                   \
+        strncpy((char *)img + o, (n), 10);                 \
+        img[o + 10] = (ext) & 0xFF;                        \
+        img[o + 11] = ((ext) >> 8) & 0xFF;                 \
+        img[o + 12] = (sz) & 0xFF;                         \
+        img[o + 13] = ((sz) >> 8) & 0xFF;                  \
+        img[o + 14] = ((sz) >> 16) & 0xFF;                 \
+        img[o + 15] = ((unsigned int)(sz) >> 24) & 0xFF;   \
+        o += 16;                                           \
+    } while (0)
+    BL_ENTRY("RESET", 0, 0);
+    BL_ENTRY("ROMDIR", 0, 5 * 16);
+    BL_ENTRY("EXTINFO", 0, 4);
+    BL_ENTRY(name, 4, moduleSize);
+    o += 16; // the blank end entry
+#undef BL_ENTRY
+    img[o] = 0xFF;
+    img[o + 1] = 0xFF;
+    img[o + 2] = 0;
+    img[o + 3] = 2;
+    o += 16;
+    memcpy(img + o, module, moduleSize);
+    *outSize = size;
+    return img;
+}
