+    LOG("START DRIVES: MMCE slot 1 %d, slot 2 %d\n", fbMmceSlot[0], fbMmceSlot[1]);
+    DelayThread(1000 * 1000); // a USB stick enumerates a moment after its driver: let it, before the list is read
+    fbDrivesUp = 1;
+    fbDrivesDone = 1;
+}
