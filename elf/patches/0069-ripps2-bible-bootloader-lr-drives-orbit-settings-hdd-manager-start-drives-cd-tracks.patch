+// RIPPS2 build 69: a POPSTARTER.ELF RIPPS2 can see on a drive, written the way the path setting
+// keeps it across boots (usb:/, mx4sio:/, ilink:/, ata:/ by family, not massN: by mount order; mc:/
+// either card; mmce:/ either slot; pfs0:/ the HDD's OPL home). Looked for where people keep it: POPS/,
+// APPS/, APPS/POPSTARTER/, POPSTARTER/ and the drive's top (vcdResolvePopstarter's own list).
+static int guiPopstarterDetect(char *out, int size)
+{
+    static const char *const family[] = {"usb", "ilink", "mx4sio", "ata"}; // BDM_TYPE_USB .. BDM_TYPE_ATA
+    char found[256], prefix[10];
+    int slot, t, n;
+
+    for (slot = 0; slot < 8; slot++) {
+        if (!bdmSlotEverConnected(BDM_MODE + slot) || (t = bdmSlotDeviceType(slot)) < BDM_TYPE_USB || t > BDM_TYPE_ATA)
+            continue;
+        snprintf(prefix, sizeof(prefix), "mass%d:", slot);
+        n = strlen(prefix);
+        if (vcdResolvePopstarter(prefix, found, sizeof(found)) && !strncmp(found, prefix, n))
+            return snprintf(out, size, "%s:%s%s", family[t], found[n] == '/' ? "" : "/", found + n) < size;
+    }
+    for (slot = 0; slot < 2 && mmceGetObject(1) != NULL; slot++) {
+        snprintf(prefix, sizeof(prefix), "mmce%d:", slot);
+        n = strlen(prefix);
+        if (vcdResolvePopstarter(prefix, found, sizeof(found)) && !strncmp(found, prefix, n))
+            return snprintf(out, size, "mmce:%s%s", found[n] == '/' ? "" : "/", found + n) < size;
+    }
+    if (gHDDPrefix != NULL && vcdResolvePopstarter("pfs0:", found, sizeof(found)) && !strncmp(found, "pfs0:", 5))
+        return snprintf(out, size, "%s", found) < size;
+    if (vcdResolvePopstarterMcElf(found, sizeof(found)) && !strncmp(found, "mc", 2) && found[3] == ':')
+        return snprintf(out, size, "mc:%s", found + 4) < size;
+    return 0;
+}
+
+// An empty POPSTARTER path fills in with the one found (it is saved only with the page, like a typed
+// one); a path the user typed is never replaced
+static void guiPopstarterAutofill(struct UIItem *ui)
+{
+    if (popstarterPathEdit[0] != '\0' || !guiPopstarterDetect(popstarterPathEdit, sizeof(popstarterPathEdit))) {
+        return;
+    }
+    LOG("POPSTARTER: path filled in from %s\n", popstarterPathEdit);
+    diaSetString(ui, CFG_POPSTARTER_PATH, popstarterPathEdit);
+}
