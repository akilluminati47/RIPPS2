+    blCard_t *c = &blCards[port];
+    sceMcTblGetDir info;
+
+    // RIPPS2 first, while every drive is up
+    if (w->copyTo[0]) {
+        char parent[160], *slash;
+        snprintf(parent, sizeof(parent), "%s", w->copyTo);
+        if ((slash = strrchr(parent, '/')) != NULL) {
+            *slash = '\0';
+            mkdir(parent, 0777);
+            if (!strncmp(parent, "mc", 2)) {
+                snprintf(path, sizeof(path), "%s/icon.sys", parent);
+                if (!blFileExists(path))
+                    blWriteIcons(parent, "RIPPS2 ", "for BIBLE");
+            }
+        }
+        char boot[256];
+        if (!ripps2GetBootPath(boot, sizeof(boot)) || !blCopy(boot, w->copyTo, w->copyWhat)) {
+            guiMsgBoxSound(SFX_ERROR);
+            snprintf(msg, sizeof(msg), "BIBLE could not copy RIPPS2 to %s. Check the space and that it is not write protected. Nothing else was changed.", w->copyTo);
+            guiMsgBox(msg, 0, NULL);
+            return;
+        }
+    }
+
+    // the IOP again, with ps2sdk's SECRMAN in the ROM's place: the console binds a KELF through it
+    guiRenderTextScreen("BIBLE: restarting the I/O processor with the security module");
+    if ((img = blMakeIoprp("SECRMAN", secrman_irx, size_secrman_irx, &imgSize)) == NULL) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("BIBLE ran out of memory before it started. Nothing was changed.", 0, NULL);
+        return;
+    }
+    ok = ripps2RebootIopWith(img, imgSize);
+    free(img);
+    if (!ok) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("RIPPS2 was busy reading a drive and could not restart the I/O processor. Nothing was changed: try again in a moment.", 0, NULL);
+        return;
+    }
+    guiRenderTextScreen("BIBLE: binding PS2BBL to the memory card");
+    if (sysLoadModuleBuffer(secrsif_irx, size_secrsif_irx, 0, NULL) != 0) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("The security module would not start on this console. Nothing on the memory card was changed.", 0, NULL);
+        return;
+    }
+    SecrInit();
+    {
+        // the drives come back on the IO worker after the restart: let that settle before the card
+        int waited = 0;
+        while (ioWorkPending() && waited++ < 250)
+            DelayThread(20000);
+    }
+    blCardInfo(port, NULL); // the card, authenticated again after the restart
+
+    if ((buf = memalign(64, kelfSize + 4096)) == NULL) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("BIBLE ran out of memory. Nothing on the memory card was changed.", 0, NULL);
+        return;
+    }
+    memcpy(buf, kelf, kelfSize);
+    if (SecrDownloadFile(2 + port, 0, buf) == NULL) {
+        free(buf);
+        guiMsgBoxSound(SFX_ERROR);
+        snprintf(msg, sizeof(msg), "The console would not bind BIBLE to memory card %d (its MagicGate step failed). Nothing on the card was changed. A card that is not a genuine or MagicGate-compatible one cannot hold a system update.", port + 1);
+        guiMsgBox(msg, 0, NULL);
+        return;
+    }
+
+    // what starts from the folder now moves aside, whole (BIBLE itself is simply written over)
+    snprintf(dir, sizeof(dir), "mc%d:/%s", port, blSysFolder);
+    if (blDirExists(dir) && !(c->bible && !strcmp(c->folder, blSysFolder))) {
+        blBackupName(port, blSysFolder, backup, sizeof(backup));
+        if (!blMcRename(port, blSysFolder, backup) || blDirExists(dir)) {
+            free(buf);
+            guiMsgBoxSound(SFX_ERROR);
+            snprintf(msg, sizeof(msg), "BIBLE could not move %s aside to keep it, so it stopped there. Nothing on the card was changed.", dir);
+            guiMsgBox(msg, 0, NULL);
+            return;
+        }
+        if (blFindUpdateIn(port, backup, path, sizeof(path)))
+            snprintf(backupKelf, sizeof(backupKelf), "mc?:/%s/%s", backup, path);
+    }
+
+    // BIBLE: the bound file, read back to be sure, its icon, and the folder marked as a system one
+    mkdir(dir, 0777);
+    snprintf(path, sizeof(path), "%s/%s", dir, blSysFile);
+    ok = blWrite(path, (const char *)buf, kelfSize) == 0;
+    if (ok && (check = malloc(kelfSize)) != NULL) {
+        fd = open(path, O_RDONLY);
+        ok = fd >= 0 && read(fd, check, kelfSize) == kelfSize && !memcmp(check, buf, kelfSize);
+        if (fd >= 0)
+            close(fd);
+        free(check);
+    }
+    free(buf);
+    if (ok)
+        ok = blWriteIcons(dir, "BIBLE ", "PS2BBL");
+    if (!ok) { // put back what was there
+        remove(path);
+        snprintf(path, sizeof(path), "%s/icon.sys", dir);
+        remove(path);
+        snprintf(path, sizeof(path), "%s/bible.icn", dir);
+        remove(path);
+        if (backup[0]) {
+            rmdir(dir);
+            blMcRename(port, backup, blSysFolder);
+        }
+        guiMsgBoxSound(SFX_ERROR);
+        snprintf(msg, sizeof(msg), "BIBLE could not be written to memory card %d, so the card was put back as it was. Check its free space, then try again.", port + 1);
+        guiMsgBox(msg, 0, NULL);
+        return;
+    }
+    memset(&info, 0, sizeof(info));
+    info.AttrFile = sceMcFileAttrReadable | sceMcFileAttrWriteable | sceMcFileAttrExecutable | sceMcFileAttrDupProhibit |
+                    sceMcFileAttrSubdir | sceMcFile0400;
+    snprintf(path, sizeof(path), "/%s", blSysFolder);
+    if (mcSetFileInfo(port, 0, path, &info, sceMcFileInfoAttr) == 0)
+        mcSync(0, NULL, &fd);
+
+    // its config: one the card already has stays (a PS2BBL owner's own); else BIBLE's
+    snprintf(dir, sizeof(dir), "mc%d:/PS2BBL", port);
+    snprintf(conf, sizeof(conf), "%s/CONFIG.INI", dir);
+    if (blRead(conf) >= 0)
+        keptConfig = 1;
+    else {
+        mkdir(dir, 0777);
+        snprintf(path, sizeof(path), "%s/icon.sys", dir);
+        if (!blFileExists(path))
+            blWriteIcons(dir, "BIBLE ", "config");
+        if ((len = blBibleConfig(alt, backupKelf)) < 0 || blWrite(conf, blText, len) != 0) {
+            guiMsgBoxSound(SFX_ERROR);
+            snprintf(msg, sizeof(msg), "BIBLE is on memory card %d, but its config (%s) could not be written, so it starts the browser. Free some space and run MANAGE again to finish.", port + 1, conf);
+            guiMsgBox(msg, 0, NULL);
+            return;
+        }
+    }
+
+    // BOOT LOCK on, with the chosen path, in this config and every other one PS2BBL might read
+    // first (a drive's and slot 2's come before slot 1's)
+    {
+        char where[200];
+        int changed, failed, unreachable;
+        blChosenPath = w->path;
+        blApplyAll(1, &changed, &failed, &unreachable, where, sizeof(where));
+        blChosenPath = NULL;
+    }
+
+    guiMsgBoxSound(SFX_SAVE);
+    {
+        int n = snprintf(msg, sizeof(msg), "BIBLE is installed on memory card %d (mc%d:/%s/%s) and BOOT LOCK is on: at power on the console starts RIPPS2 from %s, at once.",
+                         port + 1, port, blSysFolder, blSysFile, w->path);
+        if (n < (int)sizeof(msg) && backup[0])
+            n += snprintf(msg + n, sizeof(msg) - n, " What was there before is kept in mc%d:/%s%s.", port, backup, backupKelf[0] ? " (hold CIRCLE at power on to start it)" : "");
+        if (n < (int)sizeof(msg) && keptConfig)
+            n += snprintf(msg + n, sizeof(msg) - n, " Your own PS2BBL config was kept (%s), BOOT LOCK set in it: its buttons are as you set them.", conf);
+        else if (n < (int)sizeof(msg))
+            n += snprintf(msg + n, sizeof(msg) - n, " Hold TRIANGLE for the browser, START for a disc. Config: %s.", conf);
+    }
+    guiMsgBox(msg, 0, NULL);
+}
+
+// The steps: which card, where RIPPS2 starts from, then one screen saying everything that will be
+// written, taken only with START
+static void blInstall(void)
+{
+    char items[2][64], what[64], boot[256], msg[900], alt[160] = "";
+    const char *list[6];
+    int ports[2], n = 0, i, port, pick, bootPort, current = -1;
+    blWhere_t where[5];
+    int count = 0, elfKb = 0, fd;
+
+    bootPort = blScan();
+    if (!blSysFolder[0]) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("RIPPS2 cannot tell this console's region from its ROM, so it does not know which system-update folder it reads. BIBLE was not installed.", 0, NULL);
+        return;
+    }
+    for (port = 0; port < 2; port++)
+        if (blCards[port].present) {
+            blCardWhat(port, bootPort, what, sizeof(what));
+            snprintf(items[n], sizeof(items[n]), "MEMORY CARD %d  (%s)", port + 1, what);
+            list[n] = items[n];
+            ports[n++] = port;
+        }
+    if (n == 0) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("There is no formatted PS2 memory card in either slot. BIBLE lives on a memory card: insert one, then try again.", 0, NULL);
+        return;
+    }
+    if ((pick = ripps2PickList(list, n)) < 0)
+        return;
+    port = ports[pick];
+
+    // where RIPPS2 starts from: as it is now when PS2BBL 1.2.0 reaches it, or a copy
+    memset(where, 0, sizeof(where));
+    if (ripps2GetBootPath(boot, sizeof(boot)) && (fd = open(boot, O_RDONLY)) >= 0) {
+        elfKb = (lseek(fd, 0, SEEK_END) + 1023) / 1024;
+        close(fd);
+    } else
+        boot[0] = '\0';
+    // (an HDD path is not one: BIBLE is the memory card build of PS2BBL, which has no HDD driver)
+    if (boot[0] && strncmp(boot, "hdd", 3) && blPathFor(0, boot, ripps2GetBootBdmType(), where[count].path, sizeof(where[count].path)) &&
+        !(ripps2GetBootBdmType() == BDM_TYPE_SDC && port != 0)) {
+        snprintf(where[count].label, sizeof(where[count].label), "WHERE IT IS NOW (%.40s)", where[count].path);
+        where[count].mx4sio = !strncmp(where[count].path, "massX:", 6);
+        current = count++;
+    }
+    if (boot[0] && elfKb > 0) {
+        const char *name = strrchr(boot, '/');
+        name = name ? name + 1 : strchr(boot, ':') + 1;
+        for (i = 0; i < 2; i++) {
+            if (!blCards[i].present || !strncmp(boot, i ? "mc1:" : "mc0:", 4))
+                continue;
+            snprintf(where[count].label, sizeof(where[count].label), "A COPY ON MEMORY CARD %d", i + 1);
+            snprintf(where[count].path, sizeof(where[count].path), "mc?:/RIPPS2/%s", name);
+            snprintf(where[count].copyTo, sizeof(where[count].copyTo), "mc%d:/RIPPS2/%s", i, name);
+            snprintf(where[count].copyWhat, sizeof(where[count].copyWhat), "memory card %d", i + 1);
+            where[count].cardKb = elfKb + 16;
+            where[count].cardPort = i;
+            count++;
+        }
+        char root[16];
+        if (bdmGetDeviceRootByType(BDM_TYPE_USB, root, sizeof(root)) &&
+            !(ripps2GetBootBdmType() == BDM_TYPE_USB && !strncmp(boot, "mass", 4))) {
+            snprintf(where[count].label, sizeof(where[count].label), "A COPY ON THE USB DRIVE");
+            snprintf(where[count].path, sizeof(where[count].path), "mass:/RIPPS2/%s", name);
+            snprintf(where[count].copyTo, sizeof(where[count].copyTo), "%sRIPPS2/%s", root, name);
+            snprintf(where[count].copyWhat, sizeof(where[count].copyWhat), "the USB drive");
+            count++;
+        }
+        if (port == 0 && bdmGetDeviceRootByType(BDM_TYPE_SDC, root, sizeof(root)) &&
+            !(ripps2GetBootBdmType() == BDM_TYPE_SDC && !strncmp(boot, "mass", 4))) {
+            snprintf(where[count].label, sizeof(where[count].label), "A COPY ON MX4SIO");
+            snprintf(where[count].path, sizeof(where[count].path), "massX:/RIPPS2/%s", name);
+            snprintf(where[count].copyTo, sizeof(where[count].copyTo), "%sRIPPS2/%s", root, name);
+            snprintf(where[count].copyWhat, sizeof(where[count].copyWhat), "MX4SIO");
+            where[count].mx4sio = 1;
+            count++;
+        }
+    }
+    if (count == 0) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox("PS2BBL starts programs from a memory card, a USB drive or MX4SIO, and RIPPS2 could not read itself to copy there. Start RIPPS2 from one of those, then try again.", 0, NULL);
+        return;
+    }
+    for (i = 0; i < count; i++)
+        list[i] = where[i].label;
+    if ((pick = ripps2PickList(list, count)) < 0)
+        return;
+    if (pick != current && current >= 0)
+        snprintf(alt, sizeof(alt), "%s", where[current].path); // the copy first, the original after it
+
+    // room on the card: BIBLE, two icons, a config, and a copy of RIPPS2 if it goes there too
+    {
+        int kelfKb = ((where[pick].mx4sio ? size_bible_mx4sio_xlf : size_bible_xlf) + 1023) / 1024;
+        int need = kelfKb + 2 * ((size_save_icn + 1023) / 1024 + 2) + 4 + (where[pick].cardKb && where[pick].cardPort == port ? where[pick].cardKb : 0);
+        if (blCards[port].freeKb < need) {
+            guiMsgBoxSound(SFX_ERROR);
+            snprintf(msg, sizeof(msg), "Memory card %d has %d KB free, and BIBLE needs %d KB there. Free some space, then try again.", port + 1, blCards[port].freeKb, need);
+            guiMsgBox(msg, 0, NULL);
+            return;
+        }
+        if (where[pick].cardKb && where[pick].cardPort != port && blCards[where[pick].cardPort].freeKb < where[pick].cardKb) {
+            guiMsgBoxSound(SFX_ERROR);
+            snprintf(msg, sizeof(msg), "Memory card %d has %d KB free, and the copy of RIPPS2 needs %d KB. Free some space or choose another place.", where[pick].cardPort + 1, blCards[where[pick].cardPort].freeKb, where[pick].cardKb);
+            guiMsgBox(msg, 0, NULL);
+            return;
+        }
+    }
+
+    // everything, said once, and only START goes ahead
+    {
+        const blCard_t *c = &blCards[port];
+        int o = snprintf(msg, sizeof(msg), "INSTALL BIBLE ON MEMORY CARD %d\n", port + 1);
+        char sysDir[48];
+        snprintf(sysDir, sizeof(sysDir), "mc%d:/%s", port, blSysFolder);
+        if (blDirExists(sysDir) && !(c->bible && !strcmp(c->folder, blSysFolder)))
+            o += snprintf(msg + o, sizeof(msg) - o, "- %s (%s) moves to a backup folder first, whole.\n", sysDir, blKindName[c->kind]);
+        if (where[pick].copyTo[0] && o < (int)sizeof(msg))
+            o += snprintf(msg + o, sizeof(msg) - o, "- RIPPS2 is copied to %s.\n", where[pick].copyTo);
+        if (o < (int)sizeof(msg))
+            o += snprintf(msg + o, sizeof(msg) - o, "- PS2BBL 1.2.0 is bound to this card by the console and written as %s/%s.\n- Its config, mc%d:/PS2BBL/CONFIG.INI, starts RIPPS2 from %s, BOOT LOCK on.\n"
+                                                    "The I/O processor restarts for this; music and drives come back after. Keep the card in and the console on until it says done.",
+                          sysDir, blSysFile, port, where[pick].path);
+    }
+    guiMsgBoxSound(SFX_MESSAGE);
+    guiMsgBoxStartOption("INSTALL BIBLE");
+    if (guiMsgBox(msg, 0, NULL) != 2)
+        return;
+    blInstallOn(port, &where[pick], alt);
+}
+
+// BOOT LOADER > MANAGE: what each card starts, and BIBLE to install or repair
+void ripps2BibleManage(void)
+{
+    char msg[900], what[2][64];
+    int boot, removed, port;
+
+    guiRenderTextScreen("Reading the memory cards");
+    boot = blScan();
+    removed = blCleanStrays();
+    for (port = 0; port < 2; port++)
+        blCardWhat(port, boot, what[port], sizeof(what[port]));
+    snprintf(msg, sizeof(msg),
+             "MEMORY CARD 1: %s\nMEMORY CARD 2: %s\n%s\n"
+             "BIBLE is PS2BBL 1.2.0 by El Isra, set up by RIPPS2: no wait at power on, RIPPS2 first, and a button held at power on still reaches the browser (TRIANGLE), a disc (START) and what was there before (CIRCLE). Install or repair it on a memory card?",
+             what[0], what[1],
+             removed ? "(Removed a SYS-CONF/PS2BBL.INI build 68 wrote for a loader that never reads it.)\n" : "");
+    guiMsgBoxSound(SFX_MESSAGE);
+    if (guiMsgBox(msg, 1, NULL) == 1)
+        blInstall();
+}
