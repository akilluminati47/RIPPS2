+// RIPPS2 (BIBLE, ripps2boot.c): reboot the IOP from an IOPRP image, with the menu taken down around
+// it and brought back after, the way the NBD server does it: drives, pads, music and sounds return
+// as they were. 1 = done; 0 = the menu was busy (art or a request would not drain) and nothing changed.
+int ripps2RebootIopWith(const void *ioprp, int size)
+{
+    int ret = 0, tries = 0;
+
+    if (!cacheAbortMmceImageLoadsTimed(LWNBD_ART_DRAIN_TICKS) || !cacheCancelPendingImageLoadsTimed(LWNBD_ART_DRAIN_TICKS))
+        return 0;
+    ioBlockOpsTimed(1, LWNBD_IO_DRAIN_TICKS);
+    if (ioHasPendingRequests()) {
+        ioBlockOps(0);
+        return 0;
+    }
+
+    audioEnd();
+    guiExecDeferredOps();
+    deinitAllSupport(NO_EXCEPTION, IO_MODE_SELECTED_ALL);
+    clearErrorMessage();
+    unloadPads();
+
+    sysSetRebootImage(ioprp, size);
+    reset();
+    sysSetRebootImage(NULL, 0);
+
+    LOG_INIT();
+    LOG_ENABLE();
+    padInit(0);
+    while (!ret && tries++ < 100) {
+        ret = startPads();
+        if (!ret)
+            delay(50);
+    }
+    if (!ret)
+        LOG("ripps2RebootIopWith: pads did not start after the IOP reboot (%d tries)\n", tries);
+
+    ioBlockOps(0);
+    initAllSupport(1);
+    audioInit();
+    sfxInit(0);
+    if (gEnableBGM)
+        bgmStart();
+    return 1;
+}
