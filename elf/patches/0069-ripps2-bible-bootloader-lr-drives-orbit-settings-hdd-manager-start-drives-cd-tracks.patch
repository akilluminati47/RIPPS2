+// A whole file onto another, with progress on screen; 1 when it all landed
+static int blCopy(const char *from, const char *to, const char *what)
+{
+    char status[128];
+    int in = open(from, O_RDONLY), out, total, done = 0, n, ok = 1;
+    unsigned char *buf;
+
+    if (in < 0)
+        return 0;
+    total = lseek(in, 0, SEEK_END);
+    lseek(in, 0, SEEK_SET);
+    if (total <= 0 || (buf = memalign(64, 65536)) == NULL) {
+        close(in);
+        return 0;
+    }
+    if ((out = open(to, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0) {
+        free(buf);
+        close(in);
+        return 0;
+    }
+    while (ok && done < total) {
+        snprintf(status, sizeof(status), "BIBLE: copying RIPPS2 to %s (%d%%)", what, done * 100 / total);
+        guiRenderTextScreen(status);
+        n = read(in, buf, total - done < 65536 ? total - done : 65536);
+        if (n <= 0 || write(out, buf, n) != n)
+            ok = 0;
+        else
+            done += n;
+    }
+    close(out);
+    close(in);
+    free(buf);
+    if (!ok)
+        remove(to);
+    return ok;
+}
