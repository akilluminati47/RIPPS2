+// RIPPS2 build 69: what is mounted at mass<slot>: (BDM_TYPE_*), or -2 when nothing is. The file
+// browser names drives by it (USB, MX4SIO, iLink, exFAT HDD) instead of calling every one "mass".
+int bdmSlotDeviceType(int slot)
+{
+    char path[16], driver[32];
+    int devIndex = -1;
+
+    snprintf(path, sizeof(path), "mass%d:/", slot);
+    if (bdmReadDeviceIdentity(path, driver, sizeof(driver), &devIndex) < 0 && driver[0] == '\0') {
+        int dir = fileXioDopen(path);
+        if (dir < 0)
+            return -2;
+        fileXioDclose(dir);
+        return BDM_TYPE_UNKNOWN;
+    }
+    return bdmDetermineDeviceType(driver);
+}
