+    if (gEnableILK) {
+        r = bdmEnsureTypedSource(BDM_TYPE_ILINK, 1500);
+        LOG("START DRIVES: iLink %d\n", r);
+    }
+    if (!gEnableMX4SIO)
+        ;
+    else if ((d = opendir("mc1:/")) != NULL) {
+        closedir(d);
+        LOG("START DRIVES: a memory card is in slot 2, MX4SIO left out\n");
+    } else {
+        r = bdmEnsureTypedSource(BDM_TYPE_SDC, 2500);
+        LOG("START DRIVES: MX4SIO %d\n", r);
+    }
+    if (hddLoadModulesReady()) {
+        r = bdmEnsureTypedSource(BDM_TYPE_ATA, 2500); // an exFAT internal drive
+        LOG("START DRIVES: ATA %d\n", r);
+        hddInspectSupportHome(); // an APA one: its OPL home, mounted (nothing created)
+        LOG("START DRIVES: APA home %s\n", gHDDPrefix != NULL ? gHDDPrefix : "(none)");
+    } else {
+        // a look, not a failure: the "hard drive not detected" box the driver load raises is not shown
+        clearErrorMessageIf(_STR_HDD_NOT_CONNECTED_ERROR);
+        LOG("START DRIVES: no internal hard drive\n");
+    }
+    // MMCE: the driver, then a ping per slot. A plain memory card does not answer it, and the list
+    // never opens mmceN:/ on a slot that did not (MMCE commands to a plain card only time out)
+    mmceLoadModules();
