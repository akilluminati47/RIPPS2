+        else if (c >= 0x824F && c <= 0x8258)
+            out[o++] = '0' + (c - 0x824F);
+        else if (c >= 0x8260 && c <= 0x8279)
+            out[o++] = 'A' + (c - 0x8260);
+        else if (c >= 0x8281 && c <= 0x829A)
+            out[o++] = 'a' + (c - 0x8281);
+        else if (c == 0x8169 || c == 0x816A)
+            out[o++] = c == 0x8169 ? '(' : ')';
+        else if (c == 0x817C || c == 0x815B)
+            out[o++] = '-';
