+// icon.sys for a BIBLE folder: RIPPS2's own, titled (two lines: first, second) and naming one icon file
+static void blIconSys(unsigned char *sys, const char *first, const char *second)
+{
+    int l1 = strlen(first);
+    memcpy(sys, icon_sys, size_icon_sys);
+    sys[6] = l1 & 0xFF; // the second line starts here
+    sys[7] = (l1 >> 8) & 0xFF;
+    memset(sys + 0xC0, 0, 68);
+    snprintf((char *)sys + 0xC0, 68, "%s%s", first, second);
+    memset(sys + 0x104, 0, 64 * 3);
+    strcpy((char *)sys + 0x104, "bible.icn");
+    strcpy((char *)sys + 0x144, "bible.icn");
+    strcpy((char *)sys + 0x184, "bible.icn");
