+// RIPPS2: what the worker is running, kept as plain values (no pointer into a request that may be
+// freed), so a deferred IO that waited too long can say what it waited behind
+static volatile int gRunType = 0;
+static void *volatile gRunData = NULL;
+static volatile clock_t gRunSince = 0;
+#define IO_NAMES_MAX 24
+static struct
+{
+    void *fn;
+    const char *name;
+} gIoNames[IO_NAMES_MAX];
+static int gIoNameCount = 0;
+
+void ioNameAction(void *fn, const char *name)
+{
+    int i;
+    for (i = 0; i < gIoNameCount; i++)
+        if (gIoNames[i].fn == fn)
+            return;
+    if (gIoNameCount < IO_NAMES_MAX) {
+        gIoNames[gIoNameCount].fn = fn;
+        gIoNames[gIoNameCount].name = name;
+        gIoNameCount++;
+    }
+}
+
+int ioDescribeRunning(char *out, int size)
+{
+    int type = gRunType, i, n;
+    void *data = gRunData;
+    const char *name = NULL;
+    clock_t since = gRunSince;
+
+    out[0] = '\0';
+    if (type == 0)
+        return 0;
+    if (type == IO_MENU_UPDATE_DEFFERED)
+        name = "GAME LIST UPDATE";
+    else if (type == IO_CACHE_LOAD_ART)
+        name = "COVER ART";
+    else
+        for (i = 0; i < gIoNameCount; i++)
+            if (gIoNames[i].fn == data)
+                name = gIoNames[i].name;
+    n = (int)((clock() - since) / CLOCKS_PER_SEC);
+    if (name != NULL)
+        snprintf(out, size, "%s, %d S", name, n);
+    else
+        snprintf(out, size, "TASK %08X, %d S", (unsigned int)data, n);
+    return 1;
+}
