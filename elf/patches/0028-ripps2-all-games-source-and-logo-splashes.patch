diff --git a/src/mixsupport.c b/src/mixsupport.c
new file mode 100644
index 0000000..f96c618
--- /dev/null
+++ b/src/mixsupport.c
@@ -0,0 +1,529 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 All Games (MIX_MODE): one list of every game on every started game source -- APA HDD,
+  the BDM slots, MMCE, SMB, UDPFS and HTTP -- PS2 and PS1 alike, sorted by name. A title found on
+  two sources is listed once; the first source in mixSourceModes keeps it. Like Favourites, the page
+  owns no device: each row proxies launch, config, art, flags and VMC to the list it came from, read
+  through a forced PS2 or PS1 view so the source page's own L3 position never matters. Its own L3
+  ring follows the PS2/PS1 Game Display setting like any device page (ALL / PS1 / PS2).
+
+  Threading follows favsupport.c: the record array is rebuilt on the IO worker (after the submenu
+  that aliases its names has been cleared), and the GUI-thread readers below only scan it.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include "include/opl.h"
+#include "include/iosupport.h"
+#include "include/menusys.h"
+#include "include/ioman.h"
+#include "include/lang.h"
+#include "include/textures.h"
+#include "include/config.h"
+#include "include/supportbase.h"
+#include "include/vcdsupport.h"
+#include "include/cuesupport.h"
+#include "include/libview.h"
+#include "include/folderbrowse.h"
+#include "include/bdmsupport.h"
+#include "include/favsupport.h"
+#include "include/mixsupport.h"
+
+typedef struct
+{
+    item_list_t *owner; // the source list
+    int mode;           // its mode
+    int id;             // the row in the source's PS2 (ISO) or PS1 list when this list was built
+    int kind;           // FAV_KIND_ISO / VCD / CUE
+    int rank;           // source order: the lower one keeps a title found on two sources
+    char *text;         // heap copies, owned here; the submenu aliases text
+    char *startup;      // the art and last-played key (a PS1 row's is its name)
+} mix_rec_t;
+
+static mix_rec_t *mixArray = NULL;
+static int mixCount = 0;
+static int mixForceUpdate = 1; // the first deferred pass builds the list
+static item_list_t mixItemList;
+
+// Where a title found twice is kept from: the internal drive first, then the BDM slots, then the
+// card and the network
+static const int mixSourceModes[] = {HDD_MODE, BDM_MODE, BDM_MODE1, BDM_MODE2, BDM_MODE3, BDM_MODE4, BDM_MODE5,
+                                     BDM_MODE6, BDM_MODE7, MMCE_MODE, ETH_MODE, UDPFS_MODE, HTTP_MODE};
+#define MIX_SOURCE_COUNT ((int)(sizeof(mixSourceModes) / sizeof(mixSourceModes[0])))
+
+static char *mixStrdup(const char *s)
+{
+    int n = (int)strlen(s) + 1;
+    char *p = (char *)malloc(n);
+    if (p != NULL)
+        memcpy(p, s, n);
+    return p;
+}
+
+static int mixKindIsPs1(int kind)
+{
+    return kind == FAV_KIND_VCD || kind == FAV_KIND_CUE;
+}
+
+static void mixFreeRecords(mix_rec_t *arr, int count)
+{
+    int i;
+    if (arr == NULL)
+        return;
+    for (i = 0; i < count; i++) {
+        free(arr[i].text);
+        free(arr[i].startup);
+    }
+    free(arr);
+}
+
+static void mixFreeArray(void)
+{
+    mix_rec_t *arr = mixArray;
+    int count = mixCount;
+
+    // readers see an empty list before anything is freed
+    mixArray = NULL;
+    mixCount = 0;
+    mixFreeRecords(arr, count);
+}
+
+// ---- building ----
+
+typedef struct
+{
+    mix_rec_t *arr;
+    int count, cap;
+} mix_build_t;
+
+static void mixAppend(mix_build_t *b, item_list_t *owner, int mode, int id, int kind, int rank, const char *name, const char *startup)
+{
+    if (b->count == b->cap) {
+        int cap = b->cap ? b->cap * 2 : 256;
+        mix_rec_t *grown = (mix_rec_t *)realloc(b->arr, cap * sizeof(mix_rec_t));
+        if (grown == NULL)
+            return; // OOM: this row is skipped, the list still builds
+        b->arr = grown;
+        b->cap = cap;
+    }
+    char *text = mixStrdup(name), *st = mixStrdup(startup != NULL && startup[0] ? startup : name);
+    if (text == NULL || st == NULL) {
+        free(text);
+        free(st);
+        return;
+    }
+    mix_rec_t *r = &b->arr[b->count++];
+    r->owner = owner;
+    r->mode = mode;
+    r->id = id;
+    r->kind = kind;
+    r->rank = rank;
+    r->text = text;
+    r->startup = st;
+}
+
+// One source's games: its PS2 list, then its PS1 list when it can launch PS1 titles
+static void mixCollect(mix_build_t *b, int mode, int rank)
+{
+    opl_io_module_t *mod = oplGetModule(mode);
+    item_list_t *src, view;
+    int i, count;
+
+    if (mod == NULL || mod->support == NULL || !mod->support->enabled)
+        return;
+    src = mod->support;
+    if (src->itemGetCount == NULL || src->itemGetName == NULL)
+        return;
+    if (mode == ETH_MODE && (!gPCShareName[0] || gNetworkStartup != 0))
+        return; // the share picker or a failed share, not a game list
+
+    view = *src;
+    view.viewOverride = ITEM_VIEW_FORCE_ISO;
+    count = view.itemGetCount(&view);
+    int folders = folderModeSupported(mode) && view.itemGet != NULL;
+    for (i = 0; i < count; i++) {
+        if (folders) {
+            base_game_info_t *game = (base_game_info_t *)view.itemGet(&view, i);
+            if (game != NULL && game->format == GAME_FORMAT_FOLDER)
+                continue;
+        }
+        char *name = view.itemGetName(&view, i);
+        if (name == NULL || name[0] == '\0')
+            continue;
+        mixAppend(b, src, mode, i, FAV_KIND_ISO, rank, name, view.itemGetStartup != NULL ? view.itemGetStartup(&view, i) : NULL);
+    }
+
+    if (!libViewSupported(mode, LIB_VIEW_PS1) || (src->itemLaunchVcd == NULL && src->itemLaunchCue == NULL))
+        return;
+    view.viewOverride = ITEM_VIEW_FORCE_PS1;
+    count = view.itemGetCount(&view);
+    for (i = 0; i < count; i++) {
+        char *name = view.itemGetName(&view, i);
+        int kind = FAV_KIND_VCD;
+        if (name == NULL || name[0] == '\0')
+            continue;
+        // the PS1 list holds both cores: the row says which (as itemFavKind reads it)
+        if (view.itemGet != NULL) {
+            const base_game_info_t *game = (const base_game_info_t *)view.itemGet(&view, i);
+            if (game == NULL || strcmp(game->name, name) != 0)
+                continue;
+            if (cueIsCueEntry(game))
+                kind = FAV_KIND_CUE;
+        }
+        // only a row this source can launch (UDPBD carries the POPSTARTER hook but cannot use it)
+        if (kind == FAV_KIND_VCD && (src->itemLaunchVcd == NULL || bdmSupportIsUDPBD(src)))
+            continue;
+        if (kind == FAV_KIND_CUE && src->itemLaunchCue == NULL)
+            continue;
+        mixAppend(b, src, mode, i, kind, rank, name, name);
+    }
+}
+
+// By name (ignoring case), PS2 before PS1 for the same name, then source order
+static int mixCompare(const void *a, const void *b)
+{
+    const mix_rec_t *x = (const mix_rec_t *)a, *y = (const mix_rec_t *)b;
+    int c = strcasecmp(x->text, y->text);
+    if (c != 0)
+        return c;
+    if (mixKindIsPs1(x->kind) != mixKindIsPs1(y->kind))
+        return mixKindIsPs1(x->kind) ? 1 : -1;
+    return x->rank - y->rank;
+}
+
+// ---- item_list_t callbacks ----
+
+static int mixGetTextId(item_list_t *itemList) { return _STR_RIPPS2_ALL_GAMES; }
+static int mixGetIconId(item_list_t *itemList) { return BDM_ICON; }
+
+static void mixInit(item_list_t *itemList)
+{
+    itemList->enabled = 1;
+}
+
+static int mixNeedsUpdate(item_list_t *itemList)
+{
+    // the L3 dirty flag is consumed first and always, so a forced rebuild clears it too (as favNeedsUpdate)
+    int viewToggled = libViewConsumeDirty(MIX_MODE);
+    if (mixForceUpdate) {
+        mixForceUpdate = 0;
+        return 1;
+    }
+    return viewToggled;
+}
+
+// One pass: gather every source, sort, drop the second copy of a title, keep the rows the current
+// view shows (ALL, PS1 or PS2). updateMenuFromGameList appends the submenu from the count returned.
+static int mixUpdateItemList(item_list_t *itemList)
+{
+    mix_build_t b = {NULL, 0, 0};
+    int i, kept = 0, view = libViewActive(MIX_MODE);
+
+    mixFreeArray();
+    for (i = 0; i < MIX_SOURCE_COUNT; i++)
+        mixCollect(&b, mixSourceModes[i], i);
+    if (b.count == 0) {
+        free(b.arr);
+        return 0;
+    }
+    qsort(b.arr, b.count, sizeof(mix_rec_t), &mixCompare);
+
+    for (i = 0; i < b.count; i++) {
+        mix_rec_t *r = &b.arr[i];
+        int drop = (kept > 0 && mixKindIsPs1(b.arr[kept - 1].kind) == mixKindIsPs1(r->kind) &&
+                    strcasecmp(b.arr[kept - 1].text, r->text) == 0);
+        if (!drop && view == LIB_VIEW_PS1 && !mixKindIsPs1(r->kind))
+            drop = 1;
+        if (!drop && view == LIB_VIEW_ISO && mixKindIsPs1(r->kind))
+            drop = 1;
+        if (drop) {
+            free(r->text);
+            free(r->startup);
+            continue;
+        }
+        b.arr[kept++] = *r;
+    }
+    mixArray = b.arr; // published whole, after it is complete
+    mixCount = kept;
+    return mixCount;
+}
+
+static int mixGetItemCount(item_list_t *itemList) { return mixCount; }
+
+static int mixValidIndex(int id) { return mixArray != NULL && id >= 0 && id < mixCount; }
+
+// A stack copy of a row's source, forced to the list the row came from
+static item_list_t *mixOwnerView(int id, item_list_t *view)
+{
+    if (!mixValidIndex(id) || view == NULL || mixArray[id].owner == NULL)
+        return NULL;
+    *view = *mixArray[id].owner;
+    view->viewOverride = mixKindIsPs1(mixArray[id].kind) ? ITEM_VIEW_FORCE_PS1 : ITEM_VIEW_FORCE_ISO;
+    return view;
+}
+
+// The row's id in its source's list right now. The source may have rescanned since this list was
+// built (its rebuild queues ours right behind it): trust the stored id only while it still names the
+// same game, else find the game again by name. -1 when it is gone.
+static int mixOwnerId(int id, item_list_t *o)
+{
+    int i, count;
+    char *name;
+
+    if (!mixValidIndex(id) || o == NULL || o->itemGetCount == NULL || o->itemGetName == NULL)
+        return -1;
+    count = o->itemGetCount(o);
+    i = mixArray[id].id;
+    if (i >= 0 && i < count) {
+        name = o->itemGetName(o, i);
+        if (name != NULL && strcmp(name, mixArray[id].text) == 0)
+            return i;
+    }
+    for (i = 0; i < count; i++) {
+        name = o->itemGetName(o, i);
+        if (name != NULL && strcmp(name, mixArray[id].text) == 0)
+            return i;
+    }
+    return -1;
+}
+
+static int mixGetRowView(item_list_t *itemList, int id)
+{
+    (void)itemList;
+    return mixValidIndex(id) ? favKindView(mixArray[id].kind) : -1;
+}
+
+static char *mixGetItemName(item_list_t *itemList, int id)
+{
+    return mixValidIndex(id) ? mixArray[id].text : "";
+}
+
+static int mixGetItemNameLength(item_list_t *itemList, int id)
+{
+    return mixValidIndex(id) ? (int)strlen(mixArray[id].text) + 1 : 0;
+}
+
+static char *mixGetItemStartup(item_list_t *itemList, int id)
+{
+    return mixValidIndex(id) ? mixArray[id].startup : "";
+}
+
+static config_set_t *mixGetConfig(item_list_t *itemList, int id)
+{
+    item_list_t ownerView, *o = mixOwnerView(id, &ownerView);
+    if (o == NULL)
+        return NULL;
+    // A PS1 row's config is keyed by its name under the source's prefix, as on a device page and as
+    // favGetConfig builds it
+    if (mixKindIsPs1(mixArray[id].kind)) {
+        char *prefix = o->itemGetPrefix != NULL ? o->itemGetPrefix(o) : NULL;
+        if (prefix == NULL)
+            return NULL;
+        int pl = (int)strlen(prefix);
+        char sep[2] = {(pl > 0 && prefix[pl - 1] == '\\') ? '\\' : '/', '\0'};
+        base_game_info_t game;
+        memset(&game, 0, sizeof(game));
+        snprintf(game.name, sizeof(game.name), "%s", mixArray[id].text);
+        snprintf(game.extension, sizeof(game.extension), "%s", mixArray[id].kind == FAV_KIND_CUE ? CUE_ROW_EXTENSION : ".VCD");
+        game.parts = 1;
+        game.format = GAME_FORMAT_ISO;
+        return sbPopulateConfig(&game, prefix, sep);
+    }
+    int ownerId = mixOwnerId(id, o);
+    if (o->itemGetConfig == NULL || ownerId < 0)
+        return NULL;
+    return o->itemGetConfig(o, ownerId);
+}
+
+static void mixLaunchItem(item_list_t *itemList, int id, config_set_t *configSet)
+{
+    item_list_t ownerView, *o = mixOwnerView(id, &ownerView);
+    if (o == NULL)
+        return;
+    if (mixKindIsPs1(mixArray[id].kind)) { // PS1 titles launch by name, through the row's own core
+        if (mixArray[id].kind == FAV_KIND_CUE) {
+            if (o->itemLaunchCue != NULL)
+                o->itemLaunchCue(o, mixArray[id].text, configSet);
+        } else if (o->itemLaunchVcd != NULL)
+            o->itemLaunchVcd(o, mixArray[id].text, configSet);
+        return;
+    }
+    int ownerId = mixOwnerId(id, o);
+    if (o->itemLaunch != NULL && ownerId >= 0)
+        o->itemLaunch(o, ownerId, configSet);
+}
+
+// Art: the cache asks with a row's startup (or a PS1 row's strict disc ID); send it to that row's
+// source. Theme attribute images (absolute theme path, keyed by value) pass through any source, as
+// favGetImage does.
+static int mixGetImage(item_list_t *itemList, char *folder, int isRelative, char *value, char *suffix, GSTEXTURE *resultTex, short psm)
+{
+    int i;
+
+    if (mixArray == NULL || value == NULL)
+        return -1;
+    for (i = 0; i < mixCount; i++) {
+        item_list_t ownerView, *o = mixOwnerView(i, &ownerView);
+        if (o == NULL || o->itemGetImage == NULL)
+            continue;
+        if (mixKindIsPs1(mixArray[i].kind)) {
+            if (strcmp(mixArray[i].text, value) != 0) {
+                char key[VCD_ID_MAX];
+                if (!vcdExtractGameId(mixArray[i].text, key, sizeof(key)) || strcmp(key, value) != 0)
+                    continue;
+            }
+            return o->itemGetImage(o, folder, isRelative, value, suffix, resultTex, psm);
+        }
+        if (strcmp(mixArray[i].startup, value) == 0) {
+            int r = o->itemGetImage(o, folder, isRelative, value, suffix, resultTex, psm);
+            if (isRelative || r != -1)
+                return r;
+        }
+    }
+    if (!isRelative) {
+        for (i = 0; i < mixCount; i++) {
+            item_list_t ownerView, *o = mixOwnerView(i, &ownerView);
+            if (o == NULL || o->itemGetImage == NULL)
+                continue;
+            int r = o->itemGetImage(o, folder, isRelative, value, suffix, resultTex, psm);
+            if (r != -1)
+                return r;
+        }
+    }
+    return -1;
+}
+
+int mixGetArtMode(const char *value)
+{
+    int i;
+
+    if (mixArray == NULL || value == NULL)
+        return -1;
+    for (i = 0; i < mixCount; i++) {
+        if (mixKindIsPs1(mixArray[i].kind)) {
+            if (strcmp(mixArray[i].text, value) != 0) {
+                char key[VCD_ID_MAX];
+                if (!vcdExtractGameId(mixArray[i].text, key, sizeof(key)) || strcmp(key, value) != 0)
+                    continue;
+            }
+            return mixArray[i].mode;
+        }
+        if (strcmp(mixArray[i].startup, value) == 0)
+            return mixArray[i].mode;
+    }
+    return -1;
+}
+
+// No renaming or deleting from here (the menu never offers them: both callbacks are NULL)
+
+static void mixCleanUp(item_list_t *itemList, int exception)
+{
+    // the submenu aliases the names; only a rebuild (after the submenu is cleared) or shutdown frees them
+}
+
+static void mixShutdown(item_list_t *itemList)
+{
+    mixFreeArray();
+}
+
+static int mixSelectedId(void)
+{
+    opl_io_module_t *mod = oplGetModule(MIX_MODE);
+    if (mod == NULL || mod->menuItem.current == NULL)
+        return -1;
+    return mod->menuItem.current->item.id;
+}
+
+unsigned char mixGetFlags(item_list_t *itemList)
+{
+    item_list_t ownerView, *o = mixOwnerView(mixSelectedId(), &ownerView);
+    return o != NULL ? o->flags : 0;
+}
+
+static int mixCheckVMC(item_list_t *itemList, char *name, int createSize)
+{
+    item_list_t ownerView, *o = mixOwnerView(mixSelectedId(), &ownerView);
+    if (o == NULL || o->itemCheckVMC == NULL)
+        return -1;
+    return o->itemCheckVMC(o, name, createSize);
+}
+
+// ---- public ----
+
+int mixGetItemSourceMode(int id)
+{
+    return mixValidIndex(id) ? mixArray[id].mode : -1;
+}
+
+int mixGetItemSourceId(int id)
+{
+    item_list_t ownerView, *o = mixOwnerView(id, &ownerView);
+    return o != NULL ? mixOwnerId(id, o) : -1;
+}
+
+int mixGetItemKind(int id)
+{
+    return mixValidIndex(id) ? mixArray[id].kind : -1;
+}
+
+void mixRequestUpdate(void)
+{
+    mixForceUpdate = 1;
+    if (mixItemList.enabled)
+        ioPutRequestUnlessWaiting(IO_MENU_UPDATE_DEFFERED, &mixItemList.mode);
+}
+
+void mixClearStars(void)
+{
+    opl_io_module_t *mod = oplGetModule(MIX_MODE);
+    submenu_list_t *cur;
+    if (mod == NULL)
+        return;
+    for (cur = mod->subMenu; cur != NULL; cur = cur->next)
+        cur->item.favourited = 0;
+}
+
+// Two modes are one source for a favourite when equal or both BDM (a stick can change slots)
+static int mixModesMatch(int a, int b)
+{
+    if (a >= BDM_MODE && a <= BDM_MODE_LAST && b >= BDM_MODE && b <= BDM_MODE_LAST)
+        return 1;
+    return a == b;
+}
+
+void mixMarkStar(int mode, int id, int kind, const char *text)
+{
+    opl_io_module_t *mod = oplGetModule(MIX_MODE);
+    submenu_list_t *cur;
+
+    if (mod == NULL || text == NULL || mixArray == NULL)
+        return;
+    for (cur = mod->subMenu; cur != NULL; cur = cur->next) {
+        int r = cur->item.id;
+        if (!mixValidIndex(r) || mixArray[r].kind != kind || strcmp(mixArray[r].text, text) != 0)
+            continue;
+        // a PS1 favourite is its name; a PS2 one is that row on that source
+        if (!mixKindIsPs1(kind) && !(mixModesMatch(mixArray[r].mode, mode) && mixArray[r].id == id))
+            continue;
+        cur->item.favourited = 1;
+    }
+}
+
+item_list_t *mixGetObject(int initOnly)
+{
+    if (initOnly && !mixItemList.enabled)
+        return NULL;
+    return &mixItemList;
+}
+
+static item_list_t mixItemList = {
+    MIX_MODE, -1, 0, 0, MENU_MIN_INACTIVE_FRAMES, MENU_UPD_DELAY_NOUPDATE, NULL, NULL, &mixGetTextId, NULL, &mixInit, &mixNeedsUpdate, &mixUpdateItemList,
+    &mixGetItemCount, NULL, &mixGetItemName, &mixGetItemNameLength, &mixGetItemStartup, NULL, NULL, &mixLaunchItem,
+    &mixGetConfig, &mixGetImage, &mixCleanUp, &mixShutdown, &mixCheckVMC, &mixGetIconId,
+    NULL, ITEM_VIEW_NATIVE, NULL, NULL, &mixGetRowView, NULL};
