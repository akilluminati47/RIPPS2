diff --git a/src/metadb.c b/src/metadb.c
new file mode 100644
index 0000000..38c1414
--- /dev/null
+++ b/src/metadb.c
@@ -0,0 +1,157 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 metadata database. A game's details (title, description, genre, developer, release, the
+  badge values) come from CFG/cfg.tar on the drive the game is on: one <GAMEID>.cfg per game in OPL's
+  key=value form, the archive layout wOPL already reads, so its packs work too. The game's own
+  CFG/<GAMEID>.cfg keeps its settings, and anything the user writes there wins: the database only
+  fills in keys that file does not have, as runtime-only '#' keys, so saving a game's settings never
+  copies database text into the user's file. '$' settings never come from the database.
+
+  Lookups come from the IO worker (browsing) and the GUI thread (a launch), so one semaphore guards the
+  CFG tar slot. Only '/'-separated drives are read (BDM, MMCE, the HDD data home, UDPFS, HTTP); the
+  SMB share's backslash paths would put the index sidecar in the wrong place.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <kernel.h>
+
+#include "include/opl.h"
+#include "include/config.h"
+#include "include/tar.h"
+#include "include/metadb.h"
+
+#define META_ENTRY_MAX 4096 // one game's entry; a longer one is skipped
+#define META_MISS_MAX  16   // archive paths remembered as absent until the drives change
+#define META_PATH_MAX  128
+
+static int metaSemaId = -1;
+static char metaMiss[META_MISS_MAX][META_PATH_MAX];
+static int metaMissCount = 0;
+static char metaBuf[META_ENTRY_MAX + 1];
+
+void metaDbInit(void)
+{
+    ee_sema_t sema;
+
+    if (metaSemaId >= 0)
+        return;
+    sema.init_count = 1;
+    sema.max_count = 1;
+    sema.option = 0;
+    metaSemaId = CreateSema(&sema);
+}
+
+// The drives changed (hotplug, a Game Sources apply): look for archives again
+void metaDbInvalidate(void)
+{
+    if (metaSemaId < 0)
+        return;
+    WaitSema(metaSemaId);
+    tarInvalidate(TAR_KIND_CFG);
+    metaMissCount = 0;
+    SignalSema(metaSemaId);
+}
+
+static int metaKnownMissing(const char *path)
+{
+    int i;
+    for (i = 0; i < metaMissCount; i++)
+        if (strcmp(metaMiss[i], path) == 0)
+            return 1;
+    return 0;
+}
+
+static void metaMarkMissing(const char *path)
+{
+    if (metaMissCount < META_MISS_MAX)
+        snprintf(metaMiss[metaMissCount++], META_PATH_MAX, "%s", path);
+}
+
+static char *metaTrim(char *s)
+{
+    char *e;
+    while (*s == ' ' || *s == '\t')
+        s++;
+    e = s + strlen(s);
+    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == ';'))
+        *--e = '\0';
+    if (e - s >= 2 && s[0] == '"' && e[-1] == '"') { // a libconfig-style quoted value
+        e[-1] = '\0';
+        s++;
+    }
+    return s;
+}
+
+// Fill in what the game's CFG does not say from one entry's text
+static void metaApply(config_set_t *config, char *text)
+{
+    char *line = text, *next;
+    const char *have;
+
+    for (; line != NULL && *line; line = next) {
+        next = strchr(line, '\n');
+        if (next != NULL)
+            *next++ = '\0';
+        char *eq = strchr(line, '=');
+        if (eq == NULL)
+            continue;
+        *eq = '\0';
+        char *key = metaTrim(line), *val = metaTrim(eq + 1);
+        if (key[0] == '\0' || key[0] == '$' || key[0] == '#' || key[0] == '/' || val[0] == '\0')
+            continue; // settings, runtime keys and comments never come from the database
+        if (strlen(key) + 2 > CONFIG_KEY_NAME_LEN)
+            continue;
+        if (configGetStr(config, key, &have))
+            continue; // the user's own CFG says it: that wins
+        char runtimeKey[CONFIG_KEY_NAME_LEN];
+        snprintf(runtimeKey, sizeof(runtimeKey), "#%s", key);
+        configSetStr(config, runtimeKey, val); // '#': never written back
+    }
+}
+
+void metaDbMerge(config_set_t *config, const char *prefix, const char *sep, const char *gameKey)
+{
+    char path[256], name[24];
+    TarEntryBase *entry;
+
+    if (metaSemaId < 0 || config == NULL || prefix == NULL || sep == NULL || gameKey == NULL)
+        return;
+    if (strcmp(sep, "/") != 0 || gameKey[0] == '\0' || strlen(gameKey) > 15)
+        return; // archive entries are named for disc ids ("SLUS_203.70.cfg", at most 19 characters)
+    if (snprintf(path, sizeof(path), "%sCFG/cfg.tar", prefix) >= META_PATH_MAX)
+        return;
+    snprintf(name, sizeof(name), "%s.cfg", gameKey);
+
+    WaitSema(metaSemaId);
+    if (!metaKnownMissing(path)) {
+        // tarLoadFile keeps the last archive's index, so staying on one drive costs nothing; moving
+        // to another reads that drive's index sidecar
+        if (tarLoadFile(TAR_KIND_CFG, path) == 0) {
+            entry = tarFindExact(TAR_KIND_CFG, name);
+            if (entry != NULL && entry->rawSize > 0 && entry->rawSize <= META_ENTRY_MAX &&
+                tarRead(TAR_KIND_CFG, entry, metaBuf, entry->rawSize) == entry->rawSize) {
+                metaBuf[entry->rawSize] = '\0';
+                metaApply(config, metaBuf);
+            }
+        } else
+            metaMarkMissing(path);
+    }
+    SignalSema(metaSemaId);
+}
+
+// A theme attribute: the game's own value, else the database's
+int metaDbGetStr(config_set_t *config, const char *key, const char **value)
+{
+    char runtimeKey[CONFIG_KEY_NAME_LEN];
+
+    if (configGetStr(config, key, value))
+        return 1;
+    if (key == NULL || key[0] == '#' || strlen(key) + 2 > CONFIG_KEY_NAME_LEN)
+        return 0;
+    snprintf(runtimeKey, sizeof(runtimeKey), "#%s", key);
+    return configGetStr(config, runtimeKey, value);
+}
